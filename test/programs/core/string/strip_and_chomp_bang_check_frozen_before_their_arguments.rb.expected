["strip! bad", FrozenError, "can't modify frozen String: \"\""]
["lstrip! bad", FrozenError, "can't modify frozen String: \"ab\""]
["rstrip! bad", FrozenError, "can't modify frozen String: \"ab\""]
["chomp! empty bad", FrozenError, "can't modify frozen String: \"\""]
["chomp! bad", FrozenError, "can't modify frozen String: \"a\""]
["strip! nothing", FrozenError, "can't modify frozen String: \"ab\""]
["strip! thawed bad", TypeError, "no implicit conversion of Integer into String"]
["strip! selector", "ab"]
["chomp! empty", nil]
["chilled", "ab"]
