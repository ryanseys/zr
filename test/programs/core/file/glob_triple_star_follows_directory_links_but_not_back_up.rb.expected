**/*.rb: ["a/b/x.rb", "a/filelink.rb", "a/y.rb", "other/z.rb"]
***/*.rb: ["a/b/x.rb", "a/filelink.rb", "a/same/x.rb", "a/to_other/z.rb", "a/y.rb", "other/z.rb"]
a/***/*.rb: ["a/b/x.rb", "a/filelink.rb", "a/same/x.rb", "a/to_other/z.rb", "a/y.rb"]
***/: ["a/", "a/b/", "a/b/up/", "a/same/", "a/same/up/", "a/to_other/", "other/"]
a/**/: ["a/", "a/b/"]
a/***/: ["a/", "a/b/", "a/b/up/", "a/same/", "a/same/up/", "a/to_other/"]
**/***/*.rb: ["a/b/x.rb", "a/filelink.rb", "a/same/x.rb", "a/to_other/z.rb", "a/y.rb", "other/z.rb"]
***/**/*.rb: ["a/b/x.rb", "a/filelink.rb", "a/same/x.rb", "a/to_other/z.rb", "a/y.rb", "other/z.rb"]
***/***/z.rb: ["a/to_other/z.rb", "other/z.rb"]
***: ["a", "other"]
***.rb: []
a/***: ["a/b", "a/dangling", "a/filelink.rb", "a/same", "a/to_other", "a/y.rb"]
{a,other}/***/*.rb: ["a/b/x.rb", "a/filelink.rb", "a/same/x.rb", "a/to_other/z.rb", "a/y.rb", "other/z.rb"]
***/up: ["a/b/up", "a/same/up"]
***/up/: ["a/b/up/", "a/same/up/"]
a/b/***/*.rb: ["a/b/up/b/x.rb", "a/b/up/filelink.rb", "a/b/up/to_other/z.rb", "a/b/up/y.rb", "a/b/x.rb"]
dotmatch: ["a/.hid/h.rb", "a/.hidlink/z.rb", "a/b/x.rb", "a/filelink.rb", "a/same/x.rb", "a/to_other/z.rb", "a/y.rb", "other/z.rb"]
base: ["b/x.rb", "filelink.rb", "same/x.rb", "to_other/z.rb", "y.rb"]
fnmatch: false
