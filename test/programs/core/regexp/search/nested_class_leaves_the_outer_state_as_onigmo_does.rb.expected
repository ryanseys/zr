["[[[:alnum:]]-_.]", ["a", "b", "_", "-", ".", "x", "y", "z", "5"]]
["[a[x]-c]", ["a", "b", "x"]]
["[[x]a-c]", ["a", "b", "x"]]
["[a-b[x]-z]", ["a", "b", "-", "x", "z"]]
["[[a]-[b]]", ["a", "b", "-"]]
["[[:alpha:][0-9]-]", ["a", "b", "-", "x", "y", "z", "5"]]
["[x[y]]", ["x", "y"]]
["[[a-c]&&[b]]", ["b"]]
