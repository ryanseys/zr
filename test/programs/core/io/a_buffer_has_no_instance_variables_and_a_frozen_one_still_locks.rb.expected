frozen resize: FrozenError: can't modify frozen IO::Buffer::Storage: #<IO::Buffer::Storage 0xX+4 INTERNAL>
frozen transfer: FrozenError: can't modify frozen IO::Buffer::Storage: #<IO::Buffer::Storage 0xX+4 INTERNAL>
frozen set: FrozenError: can't modify frozen IO::Buffer::Storage: #<IO::Buffer::Storage 0xX+4 INTERNAL>
frozen read: 0
frozen size: 4
dup own bytes: ["abcd", "WXYZ"]
