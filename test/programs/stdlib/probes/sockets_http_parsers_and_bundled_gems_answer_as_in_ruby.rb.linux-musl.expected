tcp: "echo:hi\n"
unix: "ABC"
socketpair: "x"
addrinfo: ["127.0.0.1", 80, true, "#<Addrinfo: 127.0.0.1:80 TCP>"]
http: ["200", "ok", "b", Net::HTTPOK]
http post: ["201", "a=1+2"]
strscan: ["3", ".", "14 is", 7, " pi", " ", " ", false, " p"]
strscan named: ["key", "val", {"k" => "key", "v" => "val"}, ["key", "val"]]
ripper lex: [[:on_ident, "a"], [:on_sp, " "], [:on_op, "="], [:on_sp, " "], [:on_int, "1"], [:on_sp, " "], [:on_comment, "# c"]]
ripper sexp: [:program, [[:def, [:@ident, "f", [1, 4]], [:paren, [:params, [[:@ident, "x", [1, 6]]], nil, nil, nil, nil, nil, nil]], [:bodystmt, [:binary, [:var_ref, [:@ident, "x", [1, 11]]], :+, [:@int, "1", [1, 15]]], nil, nil, nil]]]]
prism: [true, Prism::CallNode, :foo]
prism err: "expected a receiver for the method definition"
etc: [NilClass, true, String, true]
pstore: [[1, 2], [:a]]
matrix: [-2, Matrix[[(-2/1), (1/1)], [(3/2), (-1/2)]], Vector[3, 7], Matrix[[1, 3], [2, 4]], 2, Matrix[[1, 0], [0, 1]]]
prime: [[2, 3, 5, 7, 11], true, [[2, 3], [3, 2], [5, 1]], 19, 8]
ostruct: [{a: 1, b: 2, c: 3}, true, 1, "#<OpenStruct a=1, b=2, c=3>", true]
rdoc markup: ArgumentError: wrong number of arguments (given 1, expected 0)
io wait: NoMethodError: undefined method 'ready?' for an instance of IO
getoptlong: [["--name", "x"], ["-v", ""], ["rest"]]
resolv hosts: []
open-uri file: "hey"
ipsocket: ["AF_INET", 80, "127.0.0.1"]
