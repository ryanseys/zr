["$%", [:compile_error, "'$%' is not allowed as a global variable name"]]
["$", [:compile_error, "'$' without identifiers is not allowed as a global variable name"]]
["@@1", [:compile_error, "'@@1' is not allowed as a class variable name"]]
["@@%", [:compile_error, "'@@' without identifiers is not allowed as a class variable name"]]
["@@", [:compile_error, "'@@' without identifiers is not allowed as a class variable name"]]
["proc{@1}", [:compile_error, "'@1' is not allowed as an instance variable name"]]
["@%", [:compile_error, "'@' without identifiers is not allowed as an instance variable name"]]
["@", [:compile_error, "'@' without identifiers is not allowed as an instance variable name"]]
["/", [:compile_error, "unterminated regexp meets end of file"]]
["<<a", [:compile_error, "can't find string \"a\" anywhere before EOF"]]
["<<\"a\"", [:compile_error, "can't find string \"a\" anywhere before EOF"]]
["<<'a'", [:compile_error, "can't find string \"a\" anywhere before EOF"]]
["<<\"", [:on_parse_error, "unterminated here document identifier"]]
["def b; c(&); end", [:compile_error, "no anonymous block parameter"]]
["def b; c(*) end", [:compile_error, "no anonymous rest parameter"]]
["def b; c(**) end", [:compile_error, "no anonymous keyword rest parameter"]]
["def b; c(k: 1, **) end", [:compile_error, "no anonymous keyword rest parameter"]]
["self = 1", [:on_assign_error, "Can't change the value of self", "self"]]
["nil = 1", [:on_assign_error, "Can't assign to nil", "nil"]]
["$& = 1", [:on_assign_error, "Can't set variable $&", "$&"]]
["$1 = 1", [:on_assign_error, "Can't set variable $1", "$1"]]
["def m\n X = 1\nend", [:on_assign_error, "dynamic constant assignment", "X"]]
["alias $a $1", [:on_alias_error, "can't make alias for the number variables", "$1"]]
["def foo(A) end", [:on_param_error, "formal argument cannot be a constant", "A"]]
["def foo($a) end", [:on_param_error, "formal argument cannot be a global variable", "$a"]]
["def foo(@a) end", [:on_param_error, "formal argument cannot be an instance variable", "@a"]]
["def foo(@@a) end", [:on_param_error, "formal argument cannot be a class variable", "@@a"]]
["proc { |A| }", [:on_param_error, "formal argument cannot be a constant", "A"]]
["def req(a?:) end", [:on_param_error, "formal argument must be local variable", "a?:"]]
["class bad; end", [:on_class_name_error, "class/module name must be CONSTANT", "bad"]]
["module bad; end", [:on_class_name_error, "class/module name must be CONSTANT", "bad"]]
["def foo=() = 42", [:on_parse_error, "setter method cannot be defined in an endless method definition"]]
["def foo.bar=() = 42", [:on_parse_error, "setter method cannot be defined in an endless method definition"]]
["yield", [:on_parse_error, "Invalid yield"]]
["break", [:on_parse_error, "Invalid break"]]
["def req(a, a) end", [:on_parse_error, "duplicated argument name"]]
["\ea", [:compile_error, "Invalid char '\\x1B' in expression"]]
["\"\\xU\"", [:on_parse_error, "invalid hex escape"]]
