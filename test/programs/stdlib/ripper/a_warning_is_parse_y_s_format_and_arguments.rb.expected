$VERBOSE = nil
["a = 1; a -1", [[:operator_ambiguous, :-, "unary operator"]]]
["a = 1; a %[]", [[:operator_ambiguous, :%, "string literal"]]]
["a = 1; a *[1]", [[:operator_ambiguous, :*, "argument prefix"]]]
["a = 1; a **h", [[:operator_ambiguous, :**, "argument prefix"]]]
["a = 1; a &b", [[:operator_ambiguous, :&, "argument prefix"]]]
["a < b < c", [[:warning, "comparison '%s' after comparison", "<"]]]
["if a = 1\nend", [[:warn, "found '= literal' in conditional, should be =="]]]
["def m; END { }; end", [[:warn, "END in method; use at_exit"]]]
["{ a: 1, a: 2 }", [[:warn, "key %+li\v is duplicated and overwritten on line %d", :a, 1]]]
["{ 'k' => 1, 'k' => 2 }", [[:warn, "key %+li\v is duplicated and overwritten on line %d", "k", 1]]]
["{ 1 => 1, 1 => 2 }", [[:warn, "key %+li\v is duplicated and overwritten on line %d", 1, 1]]]
["case 1\nwhen 1\nwhen 1\nend", [[:warning, "'when' clause on line %d duplicates 'when' clause on line %d and is ignored", 3, 2]]]
["1e999", [[:warning, "Float %s out of range", "1e999"]]]
["1; # frozen_string_literal: true", [[:warning, "'%s' is ignored after any tokens", "frozen_string_literal"]]]
["# frozen_string_literal: nottrue", [[:warning, "invalid value for %s: %s", "frozen_string_literal", "nottrue"]]]
["if true\n  end", nil]
["if 1..2\nend", [[:warn, "integer literal in flip-flop"], [:warn, "integer literal in flip-flop"]]]
["p $10000000000", [[:warn, "'%s' is too big for a number variable, always nil", "$10000000000"]]]
["if 1\nend", [[:warning, "literal in condition"]]]
["def m; return; 1; end", [[:warning, "statement not reached"]]]
["1", nil]
["\r;", [[:warn, "encountered \\r in middle of line, treated as a mere space"]]]
["foo *a", [[:warning, "'*' interpreted as argument prefix"]]]
["foo &a", [[:warning, "'&' interpreted as argument prefix"]]]
["foo **a", [[:warning, "'**' interpreted as argument prefix"]]]
["x = 1", nil]
