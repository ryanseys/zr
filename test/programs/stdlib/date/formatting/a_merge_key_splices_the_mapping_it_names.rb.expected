merge	{"b" => {"x" => 1}, "c" => {"x" => 1, "y" => 2}}
merge overrides	{"b" => {"x" => 1}, "c" => {"x" => 9}}
merge list	{"a" => {"x" => 1}, "b" => {"x" => 2, "y" => 3}, "c" => {"x" => 1, "y" => 3}}
merge inline	{"c" => {"x" => 1}}
merge quoted key	{"c" => {"<<" => 1}}
merge of a scalar	{"c" => {"<<" => 1}}
merge of a seq of scalars	{"c" => {"<<" => [1, 2]}}
merge twice	{"a" => {"x" => 1}, "b" => {"y" => 2}, "c" => {"x" => 1, "y" => 2}}
merge self	{"c" => {"x" => 1}}
