; A call through a function pointer: the address of `double` and of
; `negate` are taken, stored to a stack slot, loaded back, and called
; through the same signature. Exit status 0 means every fact held.
function %double(i64) -> i64 system_v {
block0(v0: i64):
    v1 = iadd v0, v0
    return v1
}

function %negate(i64) -> i64 system_v {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = isub v1, v0
    return v2
}

function %main(i32, i64) -> i32 system_v {
    ss0 = explicit_slot 16, align = 8
    sig0 = (i64) -> i64 system_v
    sig1 = (i64) system_v
    fn0 = colocated %double sig0
    fn1 = colocated %negate sig0
    fn2 = %exit sig1

block0(v0: i32, v1: i64):
    v2 = stack_addr.i64 ss0
    v3 = func_addr.i64 fn0
    v4 = func_addr.i64 fn1
    store notrap aligned v3, v2
    store notrap aligned v4, v2+8
    v5 = load.i64 notrap aligned v2
    v6 = load.i64 notrap aligned v2+8
    v7 = iconst.i64 21
    v8 = call_indirect sig0, v5(v7)
    v9 = call_indirect sig0, v6(v8)
    ; v9 is -42; exit with 42 + v9
    v10 = iconst.i64 42
    v11 = iadd v10, v9
    call fn2(v11)
    v12 = iconst.i32 0
    return v12
}
