; The sum 1..100 printed in decimal through a stack buffer: block
; parameters, loops, loads and stores, and a table of powers in a slot.
function %main(i32, i64) -> i32 system_v {
    ss0 = explicit_slot 16, align = 8
    ss1 = explicit_slot 32, align = 8
    sig0 = (i32, i64, i64) -> i64 system_v
    fn0 = %write sig0

block0(v0: i32, v1: i64):
    v2 = iconst.i64 0
    v3 = iconst.i64 1
    v4 = iconst.i64 100
    v40 = stack_addr.i64 ss1
    v41 = iconst.i64 1000
    v42 = iconst.i64 10
    store notrap aligned v41, v40
    store notrap aligned v4, v40+8
    store notrap aligned v42, v40+16
    store notrap aligned v3, v40+24
    jump block1(v3, v2)

block1(v5: i64, v6: i64):
    v7 = icmp sgt v5, v4
    brif v7, block2, block3

block3:
    v8 = iadd v6, v5
    v9 = iadd v5, v3
    jump block1(v9, v8)

block2:
    v10 = stack_addr.i64 ss0
    jump block4(v6, v2, v2, v2)

; v12: what is left, v13: the digit so far, v14: the power offset, v51: the digit position
block4(v12: i64, v13: i64, v14: i64, v51: i64):
    v43 = iconst.i64 8
    v44 = iconst.i64 3
    v45 = iadd v40, v14
    v46 = load.i64 notrap aligned v45
    v15 = icmp sge v12, v46
    brif v15, block5, block6

block5:
    v16 = isub v12, v46
    v17 = iadd v13, v3
    jump block4(v16, v17, v14, v51)

block6:
    v18 = iconst.i64 48
    v19 = iadd v13, v18
    v47 = iadd v10, v51
    store notrap aligned v19, v47
    v48 = iadd v14, v43
    v49 = iconst.i64 32
    v27 = icmp eq v48, v49
    brif v27, block8, block9

block9:
    v52 = iadd v51, v3
    jump block4(v12, v2, v48, v52)

block8:
    v53 = iadd v51, v3
    v34 = iadd v10, v53
    store notrap aligned v42, v34
    v36 = iconst.i32 1
    v50 = iconst.i64 5
    v37 = call fn0(v36, v10, v50)
    v38 = iconst.i32 0
    return v38
}
