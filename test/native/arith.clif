; Overflow flags, select, bit operations, wide and negative constants,
; 32-bit arithmetic, a function call between two functions of this file.
; Every fact becomes one bit of the exit status: 0 means every fact held.
function %check(i64, i64) -> i64 system_v {
block0(v0: i64, v1: i64):
    v2 = icmp eq v0, v1
    v3 = iconst.i64 0
    v4 = iconst.i64 1
    v5 = select v2, v3, v4
    return v5
}

function %main(i32, i64) -> i32 system_v {
    sig0 = (i64, i64) -> i64 system_v
    sig1 = (i64) system_v
    fn0 = colocated %check sig0
    fn1 = %exit sig1

block0(v0: i32, v1: i64):
    ; 2^62 + 2^62 overflows; 1 + 2 does not
    v2 = iconst.i64 4611686018427387904
    v3, v4 = sadd_overflow v2, v2
    v5 = iconst.i64 1
    v6 = iconst.i64 2
    v7, v8 = sadd_overflow v5, v6
    v9 = iconst.i64 3
    v10 = call fn0(v7, v9)
    v11 = iconst.i64 1
    v69 = iconst.i8 1
    v12 = icmp eq v4, v69
    v13 = iconst.i64 0
    v14 = select v12, v13, v11
    v15 = iadd v10, v14
    v16 = iadd v15, v15
    v17 = iconst.i8 0
    v18 = icmp eq v8, v17
    v19 = select v18, v13, v11
    v20 = iadd v16, v19
    v21 = iadd v20, v20
    ; -5 * 7 = -35 with no overflow; 2^62 * 4 overflows
    v22 = iconst.i64 -5
    v23 = iconst.i64 7
    v24, v25 = smul_overflow v22, v23
    v26 = iconst.i64 -35
    v27 = call fn0(v24, v26)
    v28 = iadd v21, v27
    v29 = iadd v28, v28
    v30 = iconst.i64 4
    v31, v32 = smul_overflow v2, v30
    v70 = select v32, v11, v13
    v33 = call fn0(v70, v11)
    v34 = iadd v29, v33
    v35 = iadd v34, v34
    ; 0xF0F0 & 0xFF00 = 0xF000, 0xF0F0 | 0x0F0F = 0xFFFF
    v36 = iconst.i64 61680
    v37 = iconst.i64 65280
    v38 = band v36, v37
    v39 = iconst.i64 61440
    v40 = call fn0(v38, v39)
    v41 = iadd v35, v40
    v42 = iadd v41, v41
    v43 = iconst.i64 3855
    v44 = bor v36, v43
    v45 = iconst.i64 65535
    v46 = call fn0(v44, v45)
    v47 = iadd v42, v46
    v48 = iadd v47, v47
    ; a 64-bit constant with every half set, minus one
    v49 = iconst.i64 81985529216486895
    v50 = isub v49, v5
    v51 = iconst.i64 81985529216486894
    v52 = call fn0(v50, v51)
    v53 = iadd v48, v52
    v54 = iadd v53, v53
    ; 32-bit wrap: 4294967295 + 1 is 0 in i32
    v55 = iconst.i32 -1
    v56 = iconst.i32 1
    v57 = iadd v55, v56
    v58 = iconst.i32 0
    v59 = icmp eq v57, v58
    v60 = select v59, v13, v11
    v61 = iadd v54, v60
    v62 = iconst.i32 0
    call fn1(v61)
    return v62
}
