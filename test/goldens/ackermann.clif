    brif v44, block10, block11

block10:
    call fn2(v41)
    jump block11

block11:
    v46 = load.i64 notrap aligned v41
    store notrap aligned v46, v45
    v47 = load.i64 notrap aligned v41+8
    store notrap aligned v47, v45+8
    v48 = load.i64 notrap aligned v41+16
    store notrap aligned v48, v45+16
    v50 = call fn8(v45, v34, v49)
    brif v50, block1, block12

block12:
    call fn9(v37)
    store notrap aligned v11, v0
    store notrap aligned v11, v0+8
    store notrap aligned v11, v0+16
    jump block2

block2:
    jump block3(v8)

block1:
    jump block3(v51)

block3(v3: i32):
    call fn10()
    return v3
}

