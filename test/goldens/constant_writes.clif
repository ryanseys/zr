    store notrap aligned v5, v0+16
    jump block2

block2:
    jump block3(v10)

block1:
    jump block3(v616)

block3(v3: i32):
    v617 = load.i8 notrap aligned v4
    v618 = icmp uge v617, v38
    brif v618, block200, block201

block200:
    call fn27(v4)
    jump block201

block201:
    call fn29()
    return v3
}

