(seq
  (const-set SPAN
    (range
      (frozen shared "a")
      (frozen shared "c")))
  (const-set DEEP
    (array frozen
      (int 1)
      (frozen shared "s")
      (hash frozen
        (sym :k)
        (array frozen
          (int 2)
          (sym :z)))
      (frozen shared "shareable.rb")))
  (const-set WITH_RANGE
    (send make_shareable
      (const Ractor)
      (array
        (range
          (int 1)
          (int 2)))))
  (const-set HELD
    (send make_shareable
      (const Ractor)
      (array
        (int 1)
        (send ensure_shareable
          (const Ractor)
          (send freeze
            (send b
              (str "s")))
          (str "HELD"))))))
