    (core GC)
    (sym :read_tuning))
  (send __send__
    (send const_get
      (core Ruby)
      (sym :Box))
    (sym :boot))
  (seq
    (const-set SPAN
      (range
        (frozen shared "a")
        (frozen shared "c")))
    (const-set DEEP
      (send make_shareable
        (const Ractor)
        (array
          (int 1)
          (frozen shared "s")
          (hash frozen
            (sym :k)
            (array frozen
              (int 2)
              (sym :z)))
          (send ensure_shareable
