(seq
  (send __send__
    (core GC)
    (sym :read_tuning))
  (send __send__
    (send const_get
      (core Ruby)
      (sym :Box))
    (sym :boot))
  (seq
    (if
      (send include?
        (const ARGV)
        (str "--build-extension"))
      (seq
        (stop "mkmf, which writes a C extension's Makefile: zr runs it in the host ruby when it builds a gem's extension, so mkmf in a program")
        (send self p
          (send self have_header
            (str "stdio.h"))))
      (none))
    (send self p
      (sym :compiled))))
