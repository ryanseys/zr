module Prism
  module Ruby
    # The parser's view of a node: prism.c reads and changes nodes after it
    # creates them, and the nodes are immutable outside the parser, so the
    # writers are a refinement that only the parser's files use.
    #
    # While the parser runs, a node's location and each location field are
    # packed as `(start << 32) | length` (nil for an absent optional one).
    # Inside the refinement their readers answer the packed value; outside,
    # the node's own readers inflate it to a Location.
    #
    # The readers and writers are plain methods rather than attr_accessor:
    # in a zr binary the runtime's own attributes name its hidden fields,
    # while these name the gem's instance variables (VISIBLE_IVARS in
    # lib/zr/hir/build.rb).
    module Mutation
      # Packed locations.
      module Location
        module_function

        def pack(start, finish) = (start << 32) | ((finish - start) & 0xFFFF_FFFF)

        def packed_end(location)
          length = location & 0xFFFF_FFFF
          length -= 0x1_0000_0000 if length >= 0x8000_0000
          (location >> 32) + length
        end
      end

      refine Node do
        def location = @location

        def location=(location)
          @location = location
        end

        def flags = @flags

        def flags=(flags)
          @flags = flags
        end

        # pm_node_flag_set
        def flag_set(flag) = @flags |= flag

        # pm_node_flag_unset
        def flag_unset(flag) = @flags &= ~flag

        # PM_NODE_FLAG_P
        def flag?(flag) = @flags.anybits?(flag)

        # The length is signed in its 32 bits, as the C sets a start past the
        # end for a moment before it sets the end.
        def start_offset = @location >> 32
        def end_offset = Location.packed_end(@location)

        def start_offset=(start)
          @location = Location.pack(start, end_offset)
        end

        # PM_NODE_START_SET_* alone: the C keeps a start and a length, so a
        # new start keeps the length and moves the end.
        def start_offset_keep_length=(start)
          @location = (start << 32) | (@location & 0xFFFF_FFFF)
        end

        def end_offset=(finish)
          @location = Location.pack(start_offset, finish)
        end
      end
      <%- nodes.each do |node| -%>
      <%- next if node.fields.empty? -%>
      <%- locations, others = node.fields.partition { |field| field.is_a?(Prism::Template::LocationField) || field.is_a?(Prism::Template::OptionalLocationField) } -%>

      refine <%= node.name %> do
        <%- locations.each do |field| -%>
        def <%= field.name %> = @<%= field.name %>

        <%- end -%>
        <%- node.fields.each do |field| -%>
        def <%= field.name %>=(<%= field.name %>)
          @<%= field.name %> = <%= field.name %>
        end

        <%- end -%>
        <%- if node.fields.size > 0 -%>
        # The fields in the constructor's order, raw.
        def fields = [<%= node.fields.map { |field| "@#{field.name}" }.join(", ") %>]
        <%- end -%>
      end
      <%- end -%>
    end
  end
end
