#!/usr/bin/env ruby
# frozen_string_literal: true

# zr: a Ruby compiler, written in Ruby. `zr help` lists the commands.
#
# Use require_relative, not require: the collector tuning starts this file
# again, and it must load this same copy of zr. A `zr run` whose binary
# is in the run cache execs it at once. When `zr-dev serve` runs, it
# builds the program (lib/zr/server.rb). A compile starts ruby again with
# the collector limits at its first step of heavy work (lib/zr/gc_tuning.rb).
# `CLI.guard` turns an error into one line and an exit status.
require_relative "../lib/zr/cli"
Zr::CLI.guard do
  # A bad ZR_* value stops here, before the server gets the command.
  Zr::Config.current
  Zr::CLI.kept!(ARGV)
  require_relative "../lib/zr/server"
  Zr::Server.hand_to(ARGV)

  Zr::CLI.tune!(__FILE__, later: true) if Zr::CLI::COMPILE.include?(ARGV.first)
  Zr::CLI.start(ARGV)
end
