#!/usr/bin/env ruby
# frozen_string_literal: true

# zr: a Ruby compiler, written in Ruby. `zr help` names the commands.
#
# require_relative, not require: the collector tuning starts this file
# again, and it must load this same copy of zr. The compiled compiler
# takes a build over first where one is current (lib/zr/compiled_compiler.rb),
# before ruby loads the rest of zr.
require_relative "../lib/zr/compiled_compiler"
Zr::CompiledCompiler.hand_over(ARGV)
require_relative "../lib/zr/cli"

Zr::CLI.tune!(__FILE__)
Zr::CLI.start(ARGV)
