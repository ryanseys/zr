#!/usr/bin/env ruby
# frozen_string_literal: true

# zr: a Ruby compiler, written in Ruby. `zr help` lists the commands, and
# `zr app.rb` or `zr -e 'p 1'` runs a program as ruby does.
#
# Use require_relative, not require: the collector tuning starts this file
# again, and it must load this same copy of zr. A `zr run` whose binary
# is in the run cache execs it at once. When `zr-dev serve` runs, it
# builds the program (lib/zr/server.rb). A compile starts ruby again with
# the collector limits at its first step of heavy work (lib/zr/gc_tuning.rb).
# `CLI.guard` turns an error into one line and an exit status.
#
# RUBYOPT is for the program, which ruby mode reads it for
# (lib/zr/cli/ruby_options.rb). Its -w and -d must not change how zr runs.
$VERBOSE = false
$DEBUG = false
require_relative "../lib/zr/cli"
Zr::CLI.guard do
  # A bad setting stops here, before the server gets the command.
  argv = Zr::CLI.settings!(ARGV)
  Zr::Config.current
  Zr::CLI.kept!(argv)
  require_relative "../lib/zr/server"
  Zr::Server.hand_to(argv)

  Zr::CLI.tune!(__FILE__, later: true) if Zr::CLI.compiles?(argv)
  Zr::CLI.start(argv)
end
