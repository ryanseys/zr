#!/usr/bin/env ruby
# frozen_string_literal: true

# zr: a Ruby compiler, written in Ruby. `zr help` lists the commands.
#
# Use require_relative, not require: the collector tuning starts this file
# again, and it must load this same copy of zr. If a current compiled
# compiler exists, it runs the build first (lib/zr/compiled_compiler.rb),
# before ruby loads the rest of zr.
require_relative "../lib/zr/compiled_compiler"
Zr::CompiledCompiler.hand_over(ARGV)
require_relative "../lib/zr/cli"

Zr::CLI.tune!(__FILE__)
Zr::CLI.start(ARGV)
