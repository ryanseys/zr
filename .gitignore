/vendor/bundle/
# Build output and caches.
/tmp/
# Suite results and gap logs, kept when tmp/ is cleared.
/log/
/pkg/
# The runtime that a platform gem carries (zr.gemspec).
/data/runtime/
*.gem
/.bundle/

# Files that a Mac or an editor writes. An untracked one would change the
# result cache's digest (test/support/result_cache.rb) on another machine.
.DS_Store
/.ruby-lsp/

# Local worktrees.
/.claude/worktrees/

# Local notes.
/CLAUDE.md

# Local databases that tools write in the checkout.
/*.db
