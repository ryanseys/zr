module Zr
  module CLI
    module Commands
      # `zr help [<command>]`, `zr -h` and `zr --help`: the commands of zr,
      # or the page of one command.
      #
      # In `Commands`, `Help` names this class: the words are `CLI::Help`.
      class Help < Command
        def run: (untyped argv) -> untyped
      end
    end
  end
end
