# The types of lib/zr/hir/node.rb. `Node.new` makes each node class, and
# the class is assigned to a constant, which inline RBS cannot type. So
# this file types the whole of node.rb (the Steepfile's RBS_TYPED).
module Zr
  module Hir
    IT: Symbol
    STRING_EVALS: Array[Symbol]

    def self.node?: (untyped value) -> bool
    def self.each_child: (untyped node) { (untyped) -> void } -> Array[untyped]
                       | (untyped node) -> Array[untyped]

    class Node < Struct[untyped]
      def self.new: (*untyped) -> instance
                  | (**untyped) -> instance
    end

    class Program < Node
      attr_accessor file: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor units: untyped
      attr_accessor warnings: untyped
      attr_accessor evals: untyped
      attr_accessor entries: untyped
      attr_accessor traced: untyped
      attr_accessor node_ids: untyped
      attr_accessor spots: untyped
      attr_accessor coverable: untyped
      attr_accessor activations: untyped
      attr_accessor branches: untyped
      attr_accessor defs: untyped
    end

    class Unit < Node
      attr_accessor file: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor warnings: untyped
      attr_accessor internal: untyped
      attr_accessor spots: untyped
      attr_accessor hidden: untyped
      attr_accessor source: untyped
      attr_accessor activates: untyped
      attr_accessor node_ids: untyped
    end

    class Require < Node
      attr_accessor kind: untyped
      attr_accessor feature: untyped
      attr_accessor path: untyped
      attr_accessor unit: untyped
      attr_accessor line: untyped
    end

    class Activations < Node
      attr_accessor count: untyped
      attr_accessor line: untyped
    end

    class Stop < Node
      attr_accessor what: untyped
      attr_accessor line: untyped
    end

    class Autoload < Node
      attr_accessor recv: untyped
      attr_accessor name: untyped
      attr_accessor feature: untyped
      attr_accessor path: untyped
      attr_accessor unit: untyped
      attr_accessor line: untyped
      attr_accessor declared: untyped
    end

    class Seq < Node
      attr_accessor stmts: untyped
      attr_accessor line: untyped
    end

    class Send < Node
      attr_accessor recv: untyped
      attr_accessor name: untyped
      attr_accessor args: untyped
      attr_accessor line: untyped
      attr_accessor vcall: untyped
      attr_accessor opt: untyped
      attr_accessor block: untyped
      attr_accessor kwargs: untyped
      attr_accessor safe: untyped
      attr_accessor write: untyped
      attr_accessor using: untyped
      attr_accessor covers: untyped
      attr_accessor interp: untyped

      def self.of: (untyped recv, untyped name, untyped args, untyped line, ?vcall: untyped, ?opt: untyped, ?block: untyped,
                    ?kwargs: untyped, ?safe: untyped, ?write: untyped, ?using: untyped, ?covers: untyped, ?interp: untyped) -> Send
    end

    class Using < Node
      attr_accessor id: untyped
      attr_accessor from: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class UsingDefaults < Node
      attr_accessor rows: untyped
      attr_accessor line: untyped
    end

    class Slot < Node
      attr_accessor index: untyped
      attr_accessor line: untyped
    end

    class IndexOpAssign < Node
      attr_accessor recv: untyped
      attr_accessor args: untyped
      attr_accessor op: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
      attr_accessor using: untyped
    end

    class AttrOpAssign < Node
      attr_accessor recv: untyped
      attr_accessor name: untyped
      attr_accessor op: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
      attr_accessor safe: untyped
      attr_accessor using: untyped
    end

    class Splat < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class HashSplat < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class BlockPass < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class Block < Node
      attr_accessor params: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
      attr_accessor end_line: untyped
      attr_accessor cover: untyped
    end

    class Lambda < Node
      attr_accessor block: untyped
      attr_accessor line: untyped
    end

    class Params < Node
      attr_accessor required: untyped
      attr_accessor optional: untyped
      attr_accessor rest: untyped
      attr_accessor post: untyped
      attr_accessor keywords: untyped
      attr_accessor kwrest: untyped
      attr_accessor block: untyped

      def positional: () -> Integer
      def spread?: () -> bool
      def plain?: () -> bool
      def names: () -> Array[Symbol]
      def arity: () -> Integer
      def rows: () -> Array[Array[Symbol]]
      def kwrest_rows: () -> Array[Array[Symbol]]
    end

    class Yield < Node
      attr_accessor args: untyped
      attr_accessor line: untyped
      attr_accessor kwargs: untyped
    end

    class Super < Node
      attr_accessor args: untyped
      attr_accessor kwargs: untyped
      attr_accessor block: untyped
      attr_accessor line: untyped
      attr_accessor in_block: untyped
      attr_accessor using: untyped
    end

    class ZSuper < Node
      attr_accessor block: untyped
      attr_accessor line: untyped
    end

    class Break < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class Next < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class Literal < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
      attr_accessor chilled: untyped
    end

    class SelfRef < Node
      attr_accessor line: untyped
    end

    class Def < Node
      attr_accessor name: untyped
      attr_accessor params: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
      attr_accessor receiver: untyped
      attr_accessor evals: untyped
      attr_accessor end_line: untyped
      attr_accessor cover: untyped
    end

    class Local < Node
      attr_accessor name: untyped
      attr_accessor depth: untyped
      attr_accessor line: untyped
    end

    class Trace < Node
      attr_accessor event: untyped
      attr_accessor line: untyped
    end

    class Cover < Node
      attr_accessor id: untyped
      attr_accessor line: untyped
    end

    class Assign < Node
      attr_accessor name: untyped
      attr_accessor depth: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class MultiAssign < Node
      attr_accessor target: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
      attr_accessor taken: untyped
    end

    class MultiTarget < Node
      attr_accessor lefts: untyped
      attr_accessor rest: untyped
      attr_accessor rights: untyped
      attr_accessor line: untyped
      attr_accessor whole: untyped

      def names: () -> Array[Symbol]
    end

    class If < Node
      attr_accessor cond: untyped
      attr_accessor yes: untyped
      attr_accessor no: untyped
      attr_accessor line: untyped
    end

    class While < Node
      attr_accessor cond: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
      attr_accessor body_first: untyped
    end

    class Return < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class And < Node
      attr_accessor left: untyped
      attr_accessor right: untyped
      attr_accessor line: untyped
    end

    class Or < Node
      attr_accessor left: untyped
      attr_accessor right: untyped
      attr_accessor line: untyped
    end

    class Not < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class Core < Node
      attr_accessor name: untyped
      attr_accessor line: untyped
    end

    class Once < Node
      attr_accessor body: untyped
      attr_accessor line: untyped
    end

    class ClassDef < Node
      attr_accessor scope: untyped
      attr_accessor name: untyped
      attr_accessor superclass: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
      attr_accessor end_line: untyped
    end

    class ModuleDef < Node
      attr_accessor scope: untyped
      attr_accessor name: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
      attr_accessor end_line: untyped
    end

    class SingletonClassDef < Node
      attr_accessor target: untyped
      attr_accessor locals: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
      attr_accessor end_line: untyped
    end

    class ConstRead < Node
      attr_accessor scope: untyped
      attr_accessor name: untyped
      attr_accessor line: untyped
    end

    class ConstWrite < Node
      attr_accessor scope: untyped
      attr_accessor name: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class IvarRead < Node
      attr_accessor name: untyped
      attr_accessor line: untyped
    end

    class GvarRead < Node
      attr_accessor name: untyped
      attr_accessor line: untyped
    end

    class GvarWrite < Node
      attr_accessor name: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
      attr_accessor shown: untyped
    end

    class CvarRead < Node
      attr_accessor name: untyped
      attr_accessor line: untyped
    end

    class CvarWrite < Node
      attr_accessor name: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class ConstOrWrite < Node
      attr_accessor scope: untyped
      attr_accessor name: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class Alias < Node
      attr_accessor new_name: untyped
      attr_accessor old_name: untyped
      attr_accessor line: untyped
    end

    class GvarAlias < Node
      attr_accessor new_name: untyped
      attr_accessor old_name: untyped
      attr_accessor line: untyped
    end

    class Undef < Node
      attr_accessor names: untyped
      attr_accessor line: untyped
    end

    class AliasValue < Node
      attr_accessor new_name: untyped
      attr_accessor old_name: untyped
      attr_accessor line: untyped
    end

    class UndefValue < Node
      attr_accessor names: untyped
      attr_accessor line: untyped
    end

    class Defined < Node
      attr_accessor kind: untyped
      attr_accessor target: untyped
      attr_accessor line: untyped
    end

    class Case < Node
      attr_accessor subject: untyped
      attr_accessor clauses: untyped
      attr_accessor else_body: untyped
      attr_accessor line: untyped
      attr_accessor using: untyped
    end

    class IvarWrite < Node
      attr_accessor name: untyped
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class ArrayLit < Node
      attr_accessor elements: untyped
      attr_accessor line: untyped
      attr_accessor frozen: untyped
    end

    class KwSplatElement < Node
      attr_accessor pairs: untyped
      attr_accessor line: untyped
    end

    class HashLit < Node
      attr_accessor pairs: untyped
      attr_accessor line: untyped
      attr_accessor frozen: untyped
    end

    class BackRef < Node
      attr_accessor kind: untyped
      attr_accessor number: untyped
      attr_accessor line: untyped
    end

    class RangeLit < Node
      attr_accessor low: untyped
      attr_accessor high: untyped
      attr_accessor exclusive: untyped
      attr_accessor line: untyped
      attr_accessor static: untyped
    end

    class Interp < Node
      attr_accessor parts: untyped
      attr_accessor line: untyped
    end

    class RegexpOnce < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
    end

    class RegexpLit < Node
      attr_accessor source: untyped
      attr_accessor options: untyped
      attr_accessor pinned: untyped
      attr_accessor line: untyped
    end

    class FrozenString < Node
      attr_accessor value: untyped
      attr_accessor line: untyped
      attr_accessor shared: untyped
    end

    class Begin < Node
      attr_accessor body: untyped
      attr_accessor rescues: untyped
      attr_accessor else_body: untyped
      attr_accessor ensure_body: untyped
      attr_accessor line: untyped
    end

    class Rescue < Node
      attr_accessor classes: untyped
      attr_accessor target: untyped
      attr_accessor body: untyped
      attr_accessor line: untyped
    end

    class Retry < Node
      attr_accessor line: untyped
    end

    class Redo < Node
      attr_accessor line: untyped
    end
  end
end
