module Zr
  module Hir
    class Build
      # Pattern matching, as CRuby compiles it: `case/in`, `value => pattern`
      # and `value in pattern` become tests on hidden locals. A test returns
      # true and binds its captures as it runs. A failed check in a
      # single-pattern form records the reason, and the final raise reads it.
      module Patterns
        @temp_serial: untyped

        # A hidden local of the innermost scope.
        def temp: (untyped hint) -> untyped

        def read: (untyped name, untyped line) -> untyped

        def set: (untyped name, untyped value, untyped line) -> untyped

        def send_to: (untyped recv, untyped name, untyped args, untyped line, **untyped) -> untyped

        # A core class by name. No constant of the program can shadow it.
        def core: (untyped name, untyped line) -> untyped

        # `!value` on truthiness only, so a program's `!` cannot change it.
        # `until` and an `unless` guard test this, as compile.c branches.
        def falsy: (untyped value, untyped line) -> untyped

        # `case value; in pattern [if guard] then body; ...; else other; end`
        def case_match: (untyped node, ?taken: bool) -> untyped

        # `value => pattern`: nil, or the raise.
        def match_required: (untyped node) -> untyped

        # `value in pattern`: true or false.
        def match_predicate: (untyped node) -> untyped

        # `/(?<x>.)/ =~ text`: the named groups are assigned to locals (nil if
        # nothing matched). The value is the result of `=~`.
        #
        # One assignment per name, with the group or nil as its value, not
        # one in each branch: ruby binds a named group once, and
        # `Ractor.shareable_proc` counts a local's bindings.
        def match_write: (untyped node) -> untyped

        # The raise if nothing matched. After several patterns, the message
        # is only the subject's to_s. After a single pattern, it is the
        # subject's inspect and the recorded reason. For a missing key, it
        # is the key error with its key and matchee.
        def no_match: (untyped subject, untyped match, untyped line) -> untyped

        # One match's state: where a failed check records its reason.
        class Match
          @b: untyped

          @why: untyped

          @key: untyped

          @matchee: untyped

          @caches: untyped

          attr_reader why: untyped

          attr_reader key: untyped

          attr_reader matchee: untyped

          def initialize: (untyped build, untyped why, untyped key, untyped matchee) -> void

          # The hidden locals cleared before the match runs: the reason,
          # and every deconstruct cache (a loop runs the same case again).
          def resets: (untyped line) -> untyped

          # An `in` clause's pattern with its guard.
          def clause: (untyped node, untyped subject) -> untyped

          def guarded: (untyped pattern_node, untyped predicate, untyped subject, untyped positive) -> untyped

          # The test for `node` against the hidden local `subject`.
          def pattern: (untyped node, untyped subject) -> untyped

          # `pattern === subject`. The reason gives both.
          def value_pattern: (untyped value, untyped subject, untyped line) -> untyped

          # `x`: the subject bound to the local.
          def bind: (untyped target, untyped value, untyped line) -> untyped

          # `test`, or false with `reason` recorded.
          def failing: (untyped test, untyped reason, untyped line) -> untyped

          def inspect_of: (untyped name, untyped line) -> untyped

          # `Const === subject` if the pattern has a constant.
          def constant_test: (untyped node, untyped subject, untyped line) -> ::Array[untyped]

          # `subject.deconstruct`, called once per subject and kept: an
          # Array, or a TypeError.
          def deconstructed: (untyped subject, untyped line) -> ::Array[untyped]

          def element: (untyped d, untyped index, untyped line) -> untyped

          def size_of: (untyped d, untyped line) -> untyped

          # `[a, b, *rest, c]`, with an optional constant in front.
          def array_pattern: (untyped node, untyped subject, untyped line) -> untyped

          # `[*pre, a, b, *post]`: the first position where the middle matches.
          def find_pattern: (untyped node, untyped subject, untyped line) -> untyped

          # `{k: pattern, j:, **rest}`, with an optional constant in front.
          def hash_pattern: (untyped node, untyped subject, untyped line) -> untyped

          # `d.key?(key)`, else the key error's facts recorded.
          def key_present: (untyped d, untyped key, untyped line) -> untyped

          # A copy of `d` without `keys`.
          def without_keys: (untyped d, untyped keys, untyped line) -> untyped

          # A sub-pattern against `value`, kept in its own hidden local so
          # its deconstruct is called once.
          def nested: (untyped node, untyped value, untyped line) -> untyped

          def conjunction: (untyped steps, untyped line) -> untyped
        end
      end

      include Patterns
    end
  end
end
