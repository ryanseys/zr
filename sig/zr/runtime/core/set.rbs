# set.c, in ruby: Ruby 4.0's core Set. Its table is a Hash from each
# member to true, in insertion order, kept in a hidden slot as the C
# struct keeps its set_table, so a program sees no instance variable on
# a Set. So is the iteration level: a Set that is being walked takes no
# new member, and a frozen one is walked without counting.
class Set
  include Enumerable

  def self.[]: (*untyped items) -> untyped

  def initialize: (?untyped? enum) { (untyped) -> untyped } -> void

  def initialize_copy: (untyped other) -> untyped

  # set_copy: the other's members in place of these, with its
  # compare_by_identity, and no method of either called, as
  # initialize_copy and replace both copy.
  def copy_from: (untyped other) -> self

  def &: (untyped other) -> untyped

  alias intersection &

  def -: (untyped other) -> untyped

  alias difference -

  def ^: (untyped other) -> untyped

  def |: (untyped other) -> untyped

  alias + |

  alias union |

  def <=>: (untyped other) -> (nil | untyped)

  def ==: (untyped other) -> (false | true | untyped)

  alias eql? ==

  def add: (untyped item) -> self

  alias << add

  def add?: (untyped item) -> (nil | self)

  def classify: () ?{ (?) -> untyped } -> untyped

  # set_i_classify, which divide calls as a function: the groups filled
  # through their own tables, so a subclass's add is not called.
  def classified: () { (untyped) -> untyped } -> untyped

  def clear: () -> self

  def collect!: () ?{ (untyped) -> untyped } -> untyped

  alias map! collect!

  def compare_by_identity: () -> (self | untyped)

  def compare_by_identity?: () -> untyped

  def delete: (untyped item) -> self

  def delete?: (untyped item) -> (nil | self)

  def delete_if: () ?{ (untyped) -> untyped } -> (untyped | self)

  def disjoint?: (untyped other) -> untyped

  # set_i_divide: the sets that a two-argument relation joins, with each
  # pair joined only when the relation is true both ways. Otherwise, the
  # classes that a one-argument block returns.
  def divide: () ?{ (untyped, untyped) -> untyped } -> untyped

  def each: () ?{ (?) -> untyped } -> (untyped | self)

  def empty?: () -> untyped

  def flatten: () -> untyped

  def flatten!: () -> (nil | untyped)

  # A Set that contains itself hashes once: the inner visit adds a
  # constant, as rb_exec_recursive does.
  def hash: () -> (3 | untyped)

  def include?: (untyped item) -> untyped

  alias member? include?

  alias === include?

  def inspect: () -> untyped

  alias to_s inspect

  def intersect?: (untyped other) -> (true | false | untyped)

  def join: (?untyped? separator) -> untyped

  def keep_if: () ?{ (untyped) -> untyped } -> (untyped | self)

  def merge: (*untyped sets, **untyped kwargs) -> self

  def proper_subset?: (untyped other) -> untyped

  alias < proper_subset?

  def proper_superset?: (untyped other) -> untyped

  alias > proper_superset?

  def reject!: () ?{ (untyped) -> untyped } -> untyped

  def replace: (untyped other) -> untyped

  def reset: () -> untyped

  def size: () -> untyped

  alias length size

  def select!: () ?{ (untyped) -> untyped } -> untyped

  alias filter! select!

  def subset?: (untyped other) -> untyped

  alias <= subset?

  def subtract: (untyped other) -> self

  def superset?: (untyped other) -> untyped

  alias >= superset?

  def to_a: () -> untyped

  def to_set: (*untyped args) { (?) -> untyped } -> (self | untyped)

  # Ruby 4.0 keeps this subclass, which takes no compatibility layer.
  class CoreSet < Set
  end

  private

  def self.inherited: (untyped subclass) -> (nil | untyped)

  # Set::SubclassCompatible, before the constant refers to it.
  def self.compatible: () -> untyped

  # enum_method_id: `each_entry` where the object has one, else `each`.
  def self.enum_method: (untyped other) -> (:each_entry | :each | untyped)

  # The table, which an allocated Set makes empty on first use.
  def table: () -> untyped

  def iterating?: () -> untyped

  # set_iter: each member, the Set counted as iterating unless frozen.
  def walk: () { (?) -> untyped } -> (nil | untyped)

  # set_i_to_h: what Marshal writes a Set as, a Hash from each member to
  # true that returns false for any other key.
  def marshal_hash: () -> untyped

  # set_i_from_hash: the members such a Hash names.
  def marshal_load_hash: (untyped hash) -> self

  def check_frozen: () -> untyped

  def set_arg: (untyped other) -> untyped

  # set_le: every member of this Set is one of `other`'s.
  def within?: (untyped other) -> (false | true)

  # set_merge_enum_into.
  def merge_from: (untyped other) -> self

  def rebuild: (untyped fresh) -> self

  def any_set?: () -> (true | false)

  def flatten_into: (untyped into, untyped from, untyped seen) -> untyped

  # Union-find over the members' places, with path compression.
  def root_of: (untyped parents, untyped index) -> untyped

  def unite: (untyped parents, untyped i, untyped j) -> untyped
end
