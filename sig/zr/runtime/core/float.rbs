# Float: the constants, and the methods written over the kernel's
# arithmetic.
class Float
  private

  # NUM2LONG's refusal of a Float past the machine word.
  def index_range_error: () -> untyped

  public

  INFINITY: untyped

  NAN: untyped

  EPSILON: ::Float

  MAX: ::Float

  MIN: ::Float

  DIG: 15

  MANT_DIG: 53

  RADIX: 2

  MIN_EXP: -1021

  MAX_EXP: 1024

  MIN_10_EXP: -307

  MAX_10_EXP: 308

  def to_f: () -> self

  def zero?: () -> untyped

  def positive?: () -> untyped

  def negative?: () -> untyped

  # A negative count of digits rounds the Integer the value becomes.
  def floor: (?::Integer digits) -> untyped

  def ceil: (?::Integer digits) -> untyped

  def truncate: (?::Integer digits) -> untyped

  def fdiv: (untyped other) -> untyped

  def quo: (untyped other) -> untyped

  # The quotient and the modulo, as CRuby's flodivmod pairs them. An
  # unknown operand coerces, as flo_divmod passes it on.
  def divmod: (untyped other) -> (untyped | ::Array[untyped])

  alias to_int to_i

  # `Float(other)` beside self, so a String parses and anything with
  # no to_f is refused as Float() refuses it.
  def coerce: (untyped other) -> ::Array[untyped | self]
end

module Kernel
  private

  # `Float(value)`: a Float, an Integer converted, or a String parsed
  # strictly.
  def self?.Float: (untyped arg, ?exception: bool) -> (nil | untyped)
end

class String
  def to_f: () -> untyped
end

# The libm functions, over doubles; an Integer argument converts.
module Math
  PI: ::Float

  E: ::Float

  # The kernel returns immediately for a Float or an Integer in the
  # domain (zr_math_sqrt_fast). Any other value goes through the full
  # conversion, which converts or refuses it.
  def self?.sqrt: (untyped x) -> (untyped | ::Float)

  def self?.cbrt: (untyped x) -> untyped

  def self?.sin: (untyped x) -> untyped

  def self?.cos: (untyped x) -> untyped

  def self?.tan: (untyped x) -> untyped

  def self?.atan: (untyped x) -> untyped

  def self?.exp: (untyped x) -> untyped

  def self?.atan2: (untyped y, untyped x) -> untyped

  def self?.hypot: (untyped x, untyped y) -> untyped

  def self?.sinh: (untyped x) -> untyped

  def self?.cosh: (untyped x) -> untyped

  def self?.tanh: (untyped x) -> untyped

  def self?.expm1: (untyped x) -> untyped

  def self?.log1p: (untyped x) -> untyped

  # rb_math_log, as clang builds it on arm64: the doublings of a wide
  # Bignum join through a fused multiply-add, and a base divides the
  # base-2 logarithms. The difference of the two counts of doublings is
  # a size_t, so it wraps when the base is the wider one.
  def self?.log: (untyped x, ?untyped base) -> (untyped | ::Float)

  def self?.log2: (untyped x) -> untyped

  def self?.log10: (untyped x) -> untyped

  def self?.asin: (untyped x) -> untyped

  def self?.acos: (untyped x) -> untyped

  def self?.asinh: (untyped x) -> untyped

  def self?.acosh: (untyped x) -> untyped

  def self?.atanh: (untyped x) -> untyped

  # Gamma is exact at the small positive integers, and refused at zero's
  # negative side and the negative integers.
  # math_gamma: an infinity and a zero of either sign are poles, and only
  # the negative whole numbers are out of the domain.
  def self?.gamma: (untyped x) -> untyped

  # (n - 1)! for n from 1 to 23: gamma's exact results.
  FACTORIALS: untyped

  def self?.lgamma: (untyped x) -> (::Array[untyped] | ::Array[untyped | 1] | untyped)

  def self?.erf: (untyped x) -> untyped

  def self?.erfc: (untyped x) -> untyped

  def self?.frexp: (untyped x) -> (::Array[untyped | 0] | untyped)

  def self?.ldexp: (untyped fraction, untyped exponent) -> untyped

  # rb_to_float: a Float as it is, any other Numeric through to_f, and
  # nothing else, even if it responds to to_f.
  def self?.check: (untyped x) -> untyped

  # A bignum too wide for a double logs through its top bits: the
  # rest is a count of doublings.
  def self?.split: (untyped x) -> (::Array[untyped | 0] | ::Array[untyped])
end

class Float
  # `half:` decides a tie: :up (the default), :even, or :down. A tie is
  # a scaled value whose fraction is exactly one half in the double.
  def round: (?::Integer digits, ?half: untyped?) -> (self | untyped)

  # numeric.c's round_half_down and round_half_even: `x` scaled by `s`,
  # rounded, and checked against `x` once more after the division.
  def half_down: (untyped x, untyped s) -> untyped

  def half_even: (untyped x, untyped s) -> untyped

  # Past DBL_DIG places the power of ten that the scaling needs is not
  # exact, so ruby works from the exact value of the double. The kernel
  # returns nil to request this.
  def exactly: (untyped digits, untyped verb, **untyped options) -> untyped
end
