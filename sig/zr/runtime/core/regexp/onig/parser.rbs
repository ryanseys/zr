# Onigmo's parser: a pattern's tokens to its tree (regparse.c:
# 2100-2450 and 4200-6853). A port under the BSD-2-Clause license
# reproduced in regexp.rb.
class Regexp
  module Onig
    class Parser
      @reg: untyped

      @pat: untyped

      @end: untyped

      @env: untyped

      @enc: untyped

      @p: untyped

      include Lexer

      # ?:0, *:1, +:2, ??:3, *?:4, +?:5
      POPULAR_Q_STR: ::Array["?" | "*" | "+" | "??" | "*?" | "+?"]

      REDUCE_Q_STR: ::Array["" | "*" | "*?" | "??" | "+ and ??" | "+? and ?"]

      RQ_ASIS: 0

      RQ_DEL: 1

      RQ_A: 2

      RQ_AQ: 3

      RQ_QQ: 4

      RQ_P_QQ: 5

      # ReduceTypeTable[child][parent]
      REDUCE_TYPE_TABLE: ::Array[::Array[untyped]]

      CCS_VALUE: 0

      CCS_RANGE: 1

      CCS_COMPLETE: 2

      CCS_START: 3

      CCV_SB: 0

      CCV_CODE_POINT: 1

      CCV_CLASS: 2

      attr_reader env: untyped

      def initialize: (untyped reg, untyped pattern, untyped warnings) -> void

      # onig_parse_make_tree: the tree, with reg.num_mem set.
      def parse_make_tree: () -> untyped

      def self.popular_quantifier_num: (untyped q) -> (0 | 1 | 2 | 3 | 4 | 5 | -1)

      # onig_reduce_nested_quantifier
      def self.reduce_nested_quantifier: (untyped pnode, untyped cnode) -> (nil | untyped)

      # set_quantifier: 0 when `target` is taken, 1 when the quantifier
      # is {1,1} and dropped, 2 when the target's last character was
      # split off as the target.
      def set_quantifier: (untyped qn, untyped target, untyped group) -> (1 | 2 | 0)

      # BITSET_SET_BIT_CHKDUP
      def bs_set_chkdup: (untyped cc, untyped pos) -> untyped

      def bitset_set_range: (untyped cc, untyped from, untyped to) -> untyped

      # add_ctype_to_cc_by_range
      def add_ctype_to_cc_by_range: (untyped cc, untyped not_, untyped sb_out, untyped mbr) -> untyped

      # ADD_ALL_MULTI_BYTE_RANGE
      def add_all_multi_byte_range: (untyped cc) -> (untyped | nil)

      # add_ctype_to_cc
      def add_ctype_to_cc: (untyped cc, untyped ctype, untyped not_, untyped ascii_range) -> (nil | untyped)

      POSIX_BRACKETS: { "alnum" => untyped, "alpha" => untyped, "blank" => untyped, "cntrl" => untyped, "digit" => untyped, "graph" => untyped, "lower" => untyped, "print" => untyped, "punct" => untyped, "space" => untyped, "upper" => untyped, "xdigit" => untyped, "ascii" => untyped, "word" => untyped }

      POSIX_BRACKET_CHECK_LIMIT_LENGTH: 20

      POSIX_BRACKET_NAME_MIN_LEN: 4

      # parse_posix_bracket: [0, p] when a bracket was read into cc,
      # [1, p] when it is not one after all.
      def parse_posix_bracket: (untyped cc, untyped asc_cc, untyped p) -> (::Array[0 | untyped] | ::Array[1 | untyped])

      # fetch_char_property_to_ctype: [ctype, p] for the name up to `}`.
      def fetch_char_property_to_ctype: (untyped p) -> (::Array[untyped] | untyped)

      # parse_char_property: \p{...} as a class node.
      def parse_char_property: (untyped tok) -> untyped

      # next_state_class: [vs, val_type, state]
      def next_state_class: (untyped cc, untyped asc_cc, untyped vs, untyped type, untyped state) -> ::Array[untyped]

      # next_state_val: [from, from_israw, type, state] after `to` came in.
      def next_state_val: (untyped cc, untyped asc_cc, untyped from, untyped to, untyped from_israw, untyped to_israw, untyped intype, untyped type, untyped state) -> ::Array[untyped]

      # code_exist_check
      def code_exist_check: (untyped c, untyped from, untyped ignore_escaped) -> (true | false)

      # parse_char_class: [node, asc_node] for [...] starting after the '['.
      def parse_char_class: (untyped tok) -> ::Array[untyped]

      # is_singlebyte_range
      def singlebyte_range?: (untyped code) -> (true | false | untyped)

      # cclass_case_fold: `np` (whose class is `cc`) with every case fold
      # added; an alternation with the multi-character folds when there
      # are any.
      def cclass_case_fold: (untyped np, untyped cc, untyped asc_cc) -> untyped

      # node_linebreak: (?>\x0D\x0A|[\x0A-\x0D\x{85}\x{2028}\x{2029}])
      def node_linebreak: () -> untyped

      # propname2ctype: the encoding's lookup, reading the name as ASCII.
      def propname2ctype: (untyped propname) -> untyped

      def add_property_to_cc: (untyped cc, untyped propname, untyped not_) -> untyped

      def create_property_node: (untyped propname) -> untyped

      def quantify_node: (untyped node, untyped lower, untyped upper) -> untyped

      def quantify_property_node: (untyped propname, untyped repetitions) -> untyped

      # create_node_from_array: the nodes as a right-nested list or alternation.
      def node_from_array: (untyped kind, untyped nodes) -> untyped

      # node_extended_grapheme_cluster: \X
      def node_extended_grapheme_cluster: () -> untyped

      # is_onechar_cclass: the one code point in the class, or nil.
      def onechar_cclass: (untyped cc) -> (nil | untyped)

      # parse_enclose: [r, node] for "(" already read; r is 1 for a bare
      # group, 2 for an option-only group, 0 otherwise.
      def parse_enclose: (untyped tok, untyped term) -> (::Array[1 | untyped] | untyped | ::Array[0 | untyped])

      # the `group:` label: (?:...)
      def parse_group: (untyped tok, untyped term) -> untyped

      # the `named_group1:` label: (?<name>...) with `c` the opener.
      def named_group: (untyped c) -> untyped

      # ONOFF
      def onoff: (untyped v, untyped f, untyped negative) -> untyped

      # the option letters of (?imx-imx...) with `c` the first one read.
      def parse_option_group: (untyped tok, untyped term, untyped c, untyped option) -> (::Array[2 | untyped] | ::Array[0 | untyped] | untyped)

      # parse_exp: one term with its quantifiers; tok contains the token after it.
      def parse_exp: (untyped tok, untyped term) -> untyped

      # the `tk_byte:` label: a run of literal characters.
      def parse_string: (untyped tok, untyped term, untyped parse_depth) -> untyped

      # the `string_loop:` label: more literal characters onto `np`.
      def string_loop: (untyped np, untyped tok, untyped _term, untyped parse_depth) -> untyped

      # the `tk_raw_byte:` label: \xHH bytes assembled into one character.
      def parse_raw_byte: (untyped tok, untyped term, untyped parse_depth) -> untyped

      # the `repeat:` loop: the quantifiers after a term. The target's
      # slot moves into the list a split creates, as the C's targetp does.
      def parse_repeat: (untyped np, untyped tok, untyped group, untyped parse_depth) -> untyped

      # parse_branch: the terms up to |, ) or the end, as a list.
      def parse_branch: (untyped tok, untyped term) -> untyped

      # parse_subexp: alternatives up to `term` (EOT or SUBEXP_CLOSE).
      def parse_subexp: (untyped tok, untyped term) -> untyped

      # parse_regexp
      def parse_regexp: () -> untyped
    end
  end
end
