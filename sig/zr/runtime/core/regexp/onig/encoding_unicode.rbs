# Onigmo's Unicode encodings: UTF-8 (enc/utf_8.c), CESU-8 (cesu_8.c),
# UTF-16LE/BE (utf_16le.c, utf_16be.c) and UTF-32LE/BE (utf_32le.c,
# utf_32be.c), over the tables and folds of enc/unicode.c with Unicode
# 17.0's data. A port under the BSD-2-Clause license reproduced in
# regexp.rb.
class Regexp
  module Onig
    module Enc
      # enc/unicode.c: what every Unicode encoding reads the same way,
      # over its own mbc_to_code, code_to_mbc and enclen.
      module UnicodeEncoding
        PROPERTY_NAME_MAX_SIZE: 46

        def unicode?: () -> true

        # onigenc_unicode_is_code_ctype
        def code_ctype?: (untyped code, untyped ctype) -> untyped

        # get_ctype_code_range (utf_8.c, cesu_8.c) and
        # onigenc_utf16_32_get_ctype_code_range: [sb_out, ranges]
        def ctype_code_range: (untyped ctype) -> ::Array[untyped]

        # onigenc_unicode_property_name_to_ctype: the name with spaces,
        # hyphens and underscores dropped and lowercased, looked up.
        def property_name_to_ctype: (untyped s, untyped p, untyped e, ?untyped reader) -> untyped

        # onigenc_unicode_mbc_case_fold: [the folded bytes, the bytes read]
        def unicode_mbc_case_fold: (untyped s, untyped p, untyped e) -> ::Array[untyped]

        # onigenc_unicode_apply_all_case_fold, without the Turkic branch.
        def apply_all_case_fold: (untyped flag) { (untyped, untyped) -> untyped } -> (nil | untyped)

        # onigenc_unicode_get_case_fold_codes_by_str: every string the
        # character(s) at `p` match under case folding, as
        # [byte length, codes] items.
        def case_fold_codes_by_str: (untyped flag, untyped s, untyped p, untyped e) -> untyped
      end

      # OnigEncodingUTF_8 with Unicode 17.0's tables.
      class UTF8 < Base
        include UnicodeEncoding

        INVALID_CODE_FE: 4294967294

        INVALID_CODE_FF: 4294967295

        VALID_CODE_LIMIT: 1114111

        def name: () -> "UTF-8"

        def max_len: () -> 4

        def min_len: () -> 1

        def sb_out: () -> 128

        ACCEPT: -1

        FAILURE: -2

        # utf_8.c's `trans` automaton: the state a lead byte starts, and
        # the state each continuation byte moves to.
        LEAD: untyped

        # [low, high, next state] for each state 1..7.
        TRANS: ::Array[nil | ::Array[128 | 191 | untyped] | ::Array[160 | 191 | 1] | ::Array[128 | 191 | 1] | ::Array[128 | 159 | 1] | ::Array[144 | 191 | 3] | ::Array[128 | 191 | 3] | ::Array[128 | 143 | 3]]

        LENGTHS: untyped

        # mbc_enc_len: the character's length, -1 for an invalid
        # sequence, -1-n when n more bytes past `e` would be needed.
        def precise_len: (untyped s, untyped p, untyped e) -> untyped

        def mbc_to_code: (untyped s, untyped p, untyped e) -> untyped

        def code_to_mbclen: (untyped code) -> (1 | 2 | 3 | 4 | 1 | untyped)

        def code_to_mbc: (untyped code) -> untyped

        def left_adjust_char_head: (untyped s, untyped start, untyped p, untyped _e) -> untyped

        # utf_8.c mbc_case_fold
        def mbc_case_fold: (untyped _flag, untyped s, untyped p, untyped e) -> (::Array[untyped | 1] | untyped)

        def kernel_kind: () -> untyped
      end

      UTF8_ENC: untyped

      # OnigEncodingCESU_8: UTF-8 whose characters past the BMP are two
      # three-byte surrogates.
      class CESU8 < Base
        @len: untyped

        @trans: untyped

        include UnicodeEncoding

        INVALID_CODE_FE: 4294967294

        INVALID_CODE_FF: 4294967295

        VALID_CODE_LIMIT: 1114111

        def name: () -> "CESU-8"

        def max_len: () -> 6

        def min_len: () -> 1

        def sb_out: () -> 128

        def initialize: () -> void

        def precise_len: (untyped s, untyped p, untyped e) -> untyped

        def decode3: (untyped s, untyped p) -> untyped

        def mbc_to_code: (untyped s, untyped p, untyped e) -> untyped

        def code_to_mbclen: (untyped code) -> (1 | 2 | 3 | 6 | 1 | untyped)

        def code_to_mbc: (untyped code) -> untyped

        def left_adjust_char_head: (untyped s, untyped start, untyped p, untyped _e) -> untyped

        def mbc_case_fold: (untyped _flag, untyped s, untyped p, untyped e) -> (::Array[untyped | 1] | untyped)

        def kernel_kind: () -> untyped

        def kernel_tables: () -> { len: untyped, trans: untyped }
      end

      # UTF16_IS_SURROGATE_FIRST, _SECOND and UTF16_IS_SURROGATE (regenc.h)
      def self.surrogate_first?: (untyped c) -> untyped

      def self.surrogate_second?: (untyped c) -> untyped

      def self.surrogate?: (untyped c) -> untyped

      # UNICODE_VALID_CODEPOINT_P
      def self.valid_codepoint?: (untyped c) -> untyped

      # The two UTF-16 encodings.
      class UTF16 < Base
        include UnicodeEncoding

        def max_len: () -> 4

        def min_len: () -> 2

        def sb_out: () -> 0

        def code_to_mbclen: (untyped code) -> (4 | 2)

        def allowed_reverse_match?: (untyped _s, untyped _p, untyped _e) -> false
      end

      class UTF16LE < UTF16
        def name: () -> "UTF-16LE"

        def precise_len: (untyped s, untyped p, untyped e) -> (untyped | 2 | 4)

        def mbc_newline?: (untyped s, untyped p, untyped e) -> untyped

        def mbc_to_code: (untyped s, untyped p, untyped _e) -> untyped

        def code_to_mbc: (untyped code) -> untyped

        def mbc_case_fold: (untyped _flag, untyped s, untyped p, untyped e) -> (::Array[untyped | 2] | untyped)

        def left_adjust_char_head: (untyped s, untyped start, untyped p, untyped _e) -> untyped

        def kernel_kind: () -> untyped
      end

      class UTF16BE < UTF16
        def name: () -> "UTF-16BE"

        def precise_len: (untyped s, untyped p, untyped e) -> (untyped | 4)

        def mbc_newline?: (untyped s, untyped p, untyped e) -> untyped

        def mbc_to_code: (untyped s, untyped p, untyped _e) -> untyped

        def code_to_mbc: (untyped code) -> untyped

        def mbc_case_fold: (untyped _flag, untyped s, untyped p, untyped e) -> (::Array[untyped | 2] | untyped)

        def left_adjust_char_head: (untyped s, untyped start, untyped p, untyped _e) -> untyped

        def kernel_kind: () -> untyped
      end

      # The two UTF-32 encodings.
      class UTF32 < Base
        include UnicodeEncoding

        def max_len: () -> 4

        def min_len: () -> 4

        def sb_out: () -> 0

        def code_to_mbclen: (untyped _code) -> 4

        def allowed_reverse_match?: (untyped _s, untyped _p, untyped _e) -> false

        def precise_len: (untyped s, untyped p, untyped e) -> (untyped | 4)

        def left_adjust_char_head: (untyped _s, untyped start, untyped p, untyped _e) -> untyped
      end

      class UTF32LE < UTF32
        def name: () -> "UTF-32LE"

        def mbc_newline?: (untyped s, untyped p, untyped e) -> untyped

        def mbc_to_code: (untyped s, untyped p, untyped _e) -> untyped

        def code_to_mbc: (untyped code) -> untyped

        def mbc_case_fold: (untyped _flag, untyped s, untyped p, untyped e) -> (::Array[untyped | 4] | untyped)

        def kernel_kind: () -> untyped
      end

      class UTF32BE < UTF32
        def name: () -> "UTF-32BE"

        def mbc_newline?: (untyped s, untyped p, untyped e) -> untyped

        def mbc_to_code: (untyped s, untyped p, untyped _e) -> untyped

        def code_to_mbc: (untyped code) -> untyped

        def mbc_case_fold: (untyped _flag, untyped s, untyped p, untyped e) -> (::Array[untyped | 4] | untyped)

        def kernel_kind: () -> untyped
      end
    end

    # The Unicode tables as the engine reads them. The generated file
    # contains each as a String. A table is decoded the first time a
    # pattern needs it, so a program that uses no property and no case
    # folding decodes none.
    module Unicode
      self.@ranges: untyped

      self.@folds: untyped

      self.@properties: untyped

      self.@range_ends: untyped

      # Each normalized property keyword to its table index.
      def self.properties: () -> untyped

      def self.table_count: () -> untyped

      def self.range_ends: () -> untyped

      # Bit `ctype` of the Latin-1 entry for `code`, under 256.
      def self.ctype_bit?: (untyped code, untyped ctype) -> untyped

      # The ranges of table `index` as a flat [low, high, ...] Array.
      def self.ranges: (untyped index) -> untyped

      # A fold table as a Hash from its key to the codes it maps to, in
      # the table's order: 0 is CASE_FOLD and 1 to 3 the unfold tables
      # by key width. A one-code key is the Integer, a wider one an Array.
      def self.folds: (untyped width) -> untyped

      # onig_is_in_code_range: a binary search of the (low, high) pairs.
      def self.in_code_range?: (untyped ranges, untyped code) -> untyped

      def self.fold: (untyped code) -> untyped

      def self.unfold1: (untyped code) -> untyped

      def self.unfold2: (untyped codes) -> untyped

      def self.unfold3: (untyped codes) -> untyped
    end
  end
end
