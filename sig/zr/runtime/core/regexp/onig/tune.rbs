# Onigmo's tree setup between the parse and the compile (regcomp.c:
# 1895-4200): group renumbering, match lengths, subexpression calls,
# look-behind checks, the possessive rewrite, case fold expansion of
# strings, and setup_tree itself. A port under the BSD-2-Clause license
# reproduced in regexp.rb.
class Regexp
  module Onig
    module Tune
      IN_ALT: untyped

      IN_NOT: untyped

      IN_REPEAT: untyped

      IN_VAR_REPEAT: untyped

      IN_CALL: untyped

      IN_RECCALL: untyped

      IN_LOOK_BEHIND: untyped

      RECURSION_EXIST: 1

      RECURSION_INFINITE: 2

      FOUND_CALLED_NODE: 1

      GET_CHAR_LEN_VARLEN: -1

      GET_CHAR_LEN_TOP_ALT_VARLEN: -2

      EXPAND_STRING_MAX_LENGTH: 100

      THRESHOLD_CASE_FOLD_ALT_FOR_EXPANSION: 8

      # noname_disable_map: the node with its unnamed groups gone and its
      # named ones renumbered; `map[old]` takes the new number.
      def self?.noname_disable_map: (untyped node, untyped map, untyped counter) -> untyped

      def self?.renumber_node_backref: (untyped node, untyped map, untyped num_mem) -> untyped

      def self?.renumber_by_map: (untyped node, untyped map, untyped num_mem) -> untyped

      def self?.numbered_ref_check: (untyped node) -> untyped

      # disable_noname_group_capture: the new root.
      def self?.disable_noname_group_capture: (untyped root, untyped reg, untyped env) -> untyped

      # quantifiers_memory_node_info (USE_MONOMANIAC_CHECK_CAPTURES_IN_ENDLESS_REPEAT)
      def self?.quantifiers_memory_node_info: (untyped node) -> untyped

      def self?.min_match_length: (untyped node, untyped env) -> (0 | untyped)

      def self?.max_match_length: (untyped node, untyped env) -> untyped

      # get_char_length_tree1: [r, len]; r is 0, GET_CHAR_LEN_VARLEN or
      # GET_CHAR_LEN_TOP_ALT_VARLEN.
      def self?.char_length_tree1: (untyped node, untyped reg, untyped level) -> ::Array[untyped]

      # get_char_length_tree: the character count, or nil when it varies.
      def self?.char_length_tree: (untyped node, untyped reg) -> untyped

      def self?.code_sb_word?: (untyped enc, untyped code) -> untyped

      # is_not_included: x is not included in y.
      def self?.not_included?: (untyped x, untyped y, untyped reg) -> (untyped | false | true)

      # get_head_value_node
      def self?.head_value_node: (untyped node, untyped exact, untyped reg) -> untyped

      # check_type_tree: true when a node outside the masks is found.
      def self?.check_type_tree: (untyped node, untyped type_mask, untyped enclose_mask, untyped anchor_mask) -> (true | untyped | false)

      LOOKAROUNDS: ::Array[untyped]

      def self?.subexp_inf_recursive_check: (untyped node, untyped env, untyped head) -> (untyped | 0)

      def self?.subexp_inf_recursive_check_trav: (untyped node, untyped env) -> untyped

      def self?.subexp_recursive_check: (untyped node) -> (0 | 1 | untyped)

      def self?.subexp_recursive_check_trav: (untyped node, untyped env) -> untyped

      def self?.setup_subexp_call: (untyped node, untyped env) -> untyped

      # divide_look_behind_alternatives: (?<=A|B) ==> (?<=A)|(?<=B),
      # (?<!A|B) ==> (?<!A)(?<!B), in place.
      def self?.divide_look_behind_alternatives: (untyped node) -> untyped

      def self?.setup_look_behind: (untyped node, untyped reg) -> untyped

      # next_setup: what a greedy endless quantifier knows about what
      # follows it, and a*b ==> (?>a*)b when a cannot start b.
      def self?.next_setup: (untyped node, untyped next_node, untyped reg) -> untyped

      # update_string_node_case_fold: the node's bytes folded.
      def self?.update_string_node_case_fold: (untyped reg, untyped node) -> untyped

      def self?.expand_case_fold_make_rem_string: (untyped s, untyped reg) -> untyped

      def self?.case_fold_variable_len?: (untyped items, untyped slen) -> untyped

      # expand_case_fold_string_alt: [varlen (0 or 1), the alternation node]
      def self?.expand_case_fold_string_alt: (untyped items, untyped s, untyped p, untyped slen, untyped e, untyped reg) -> ::Array[untyped]

      # expand_case_fold_string: a string under /i as the alternatives
      # its case folds make, in place.
      def self?.expand_case_fold_string: (untyped node, untyped reg, untyped state) -> (nil | untyped)

      ALLOWED_TYPE_IN_LB: untyped

      ALLOWED_ENCLOSE_IN_LB: untyped

      ALLOWED_ENCLOSE_IN_LB_NOT: untyped

      ALLOWED_ANCHOR_IN_LB: untyped

      ALLOWED_ANCHOR_IN_LB_NOT: untyped

      # setup_tree: empty loops, case folds, memory status bits, the
      # look-behind checks, repeated strings expanded.
      def self?.setup_tree: (untyped node, untyped reg, untyped state, untyped env) -> untyped
    end
  end
end
