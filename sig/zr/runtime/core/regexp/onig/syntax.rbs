# Onigmo's constants: the options, the Ruby syntax, the character
# types, the node and anchor kinds, and the limits. A port of the
# definitions in onigmo.h, regint.h, regparse.h and regparse.c:47-82
# of CRuby 4.0.7 (Onigmo 6.2.0), under the BSD-2-Clause license
# reproduced in regexp.rb.
class Regexp
  module Onig
    # ONIG_OPTION_*: compile-time options, then the search-time ones,
    # then the ctype range options the Ruby syntax turns on by default.
    module Option
      NONE: 0

      IGNORECASE: 1

      EXTEND: untyped

      MULTILINE: untyped

      DOTALL: untyped

      SINGLELINE: untyped

      FIND_LONGEST: untyped

      FIND_NOT_EMPTY: untyped

      NEGATE_SINGLELINE: untyped

      DONT_CAPTURE_GROUP: untyped

      CAPTURE_GROUP: untyped

      NOTBOL: untyped

      NOTEOL: untyped

      NOTBOS: untyped

      NOTEOS: untyped

      ASCII_RANGE: untyped

      POSIX_BRACKET_ALL_RANGE: untyped

      WORD_BOUND_ALL_RANGE: untyped

      NEWLINE_CRLF: untyped
    end

    # OnigSyntaxRuby, the one syntax ruby compiles with: its operator
    # bits (op), its second operator word (op2), its behavior bits and
    # its default options, with a predicate for each word.
    module Syntax
      # op
      OP_VARIABLE_META_CHARACTERS: untyped

      OP_DOT_ANYCHAR: untyped

      OP_ASTERISK_ZERO_INF: untyped

      OP_ESC_ASTERISK_ZERO_INF: untyped

      OP_PLUS_ONE_INF: untyped

      OP_ESC_PLUS_ONE_INF: untyped

      OP_QMARK_ZERO_ONE: untyped

      OP_ESC_QMARK_ZERO_ONE: untyped

      OP_BRACE_INTERVAL: untyped

      OP_ESC_BRACE_INTERVAL: untyped

      OP_VBAR_ALT: untyped

      OP_ESC_VBAR_ALT: untyped

      OP_LPAREN_SUBEXP: untyped

      OP_ESC_LPAREN_SUBEXP: untyped

      OP_ESC_AZ_BUF_ANCHOR: untyped

      OP_ESC_CAPITAL_G_BEGIN_ANCHOR: untyped

      OP_DECIMAL_BACKREF: untyped

      OP_BRACKET_CC: untyped

      OP_ESC_W_WORD: untyped

      OP_ESC_LTGT_WORD_BEGIN_END: untyped

      OP_ESC_B_WORD_BOUND: untyped

      OP_ESC_S_WHITE_SPACE: untyped

      OP_ESC_D_DIGIT: untyped

      OP_LINE_ANCHOR: untyped

      OP_POSIX_BRACKET: untyped

      OP_QMARK_NON_GREEDY: untyped

      OP_ESC_CONTROL_CHARS: untyped

      OP_ESC_C_CONTROL: untyped

      OP_ESC_OCTAL3: untyped

      OP_ESC_X_HEX2: untyped

      OP_ESC_X_BRACE_HEX8: untyped

      OP_ESC_O_BRACE_OCTAL: untyped

      # op2
      OP2_ESC_CAPITAL_Q_QUOTE: untyped

      OP2_QMARK_GROUP_EFFECT: untyped

      OP2_OPTION_PERL: untyped

      OP2_OPTION_RUBY: untyped

      OP2_PLUS_POSSESSIVE_REPEAT: untyped

      OP2_PLUS_POSSESSIVE_INTERVAL: untyped

      OP2_CCLASS_SET_OP: untyped

      OP2_QMARK_LT_NAMED_GROUP: untyped

      OP2_ESC_K_NAMED_BACKREF: untyped

      OP2_ESC_G_SUBEXP_CALL: untyped

      OP2_ATMARK_CAPTURE_HISTORY: untyped

      OP2_ESC_CAPITAL_C_BAR_CONTROL: untyped

      OP2_ESC_CAPITAL_M_BAR_META: untyped

      OP2_ESC_V_VTAB: untyped

      OP2_ESC_U_HEX4: untyped

      OP2_ESC_GNU_BUF_ANCHOR: untyped

      OP2_ESC_P_BRACE_CHAR_PROPERTY: untyped

      OP2_ESC_P_BRACE_CIRCUMFLEX_NOT: untyped

      OP2_ESC_H_XDIGIT: untyped

      OP2_INEFFECTIVE_ESCAPE: untyped

      OP2_ESC_CAPITAL_R_LINEBREAK: untyped

      OP2_ESC_CAPITAL_X_EXTENDED_GRAPHEME_CLUSTER: untyped

      OP2_ESC_V_VERTICAL_WHITESPACE: untyped

      OP2_ESC_H_HORIZONTAL_WHITESPACE: untyped

      OP2_ESC_CAPITAL_K_KEEP: untyped

      OP2_ESC_G_BRACE_BACKREF: untyped

      OP2_QMARK_SUBEXP_CALL: untyped

      OP2_QMARK_VBAR_BRANCH_RESET: untyped

      OP2_QMARK_LPAREN_CONDITION: untyped

      OP2_QMARK_CAPITAL_P_NAMED_GROUP: untyped

      OP2_QMARK_TILDE_ABSENT: untyped

      # behavior
      CONTEXT_INDEP_ANCHORS: untyped

      CONTEXT_INDEP_REPEAT_OPS: untyped

      CONTEXT_INVALID_REPEAT_OPS: untyped

      ALLOW_UNMATCHED_CLOSE_SUBEXP: untyped

      ALLOW_INVALID_INTERVAL: untyped

      ALLOW_INTERVAL_LOW_ABBREV: untyped

      STRICT_CHECK_BACKREF: untyped

      DIFFERENT_LEN_ALT_LOOK_BEHIND: untyped

      CAPTURE_ONLY_NAMED_GROUP: untyped

      ALLOW_MULTIPLEX_DEFINITION_NAME: untyped

      FIXED_INTERVAL_IS_GREEDY_ONLY: untyped

      ALLOW_MULTIPLEX_DEFINITION_NAME_CALL: untyped

      USE_LEFT_MOST_NAMED_GROUP: untyped

      NOT_NEWLINE_IN_NEGATIVE_CC: untyped

      BACKSLASH_ESCAPE_IN_CC: untyped

      ALLOW_EMPTY_RANGE_IN_CC: untyped

      ALLOW_DOUBLE_RANGE_OP_IN_CC: untyped

      WARN_CC_OP_NOT_ESCAPED: untyped

      WARN_REDUNDANT_NESTED_REPEAT: untyped

      WARN_CC_DUP: untyped

      GNU_REGEX_OP: untyped

      GNU_REGEX_BV: untyped

      # OnigSyntaxRuby (regparse.c:47-82), as CRuby builds it: no \uHHHH
      # (RUBY is defined) and no \< \>.
      RUBY_OP: untyped

      RUBY_OP2: untyped

      RUBY_BV: untyped

      RUBY_OPTIONS: untyped

      # The meta characters: only the escape is in effect.
      ESC: 92

      def self.op?: (untyped bit) -> untyped

      def self.op2?: (untyped bit) -> untyped

      def self.bv?: (untyped bit) -> untyped
    end

    # ONIGENC_CTYPE_*
    module CType
      NEWLINE: 0

      ALPHA: 1

      BLANK: 2

      CNTRL: 3

      DIGIT: 4

      GRAPH: 5

      LOWER: 6

      PRINT: 7

      PUNCT: 8

      SPACE: 9

      UPPER: 10

      XDIGIT: 11

      WORD: 12

      ALNUM: 13

      ASCII: 14

      MAX_STD: untyped
    end

    # ANCHOR_* (regint.h)
    module Anchor
      BEGIN_BUF: untyped

      BEGIN_LINE: untyped

      BEGIN_POSITION: untyped

      END_BUF: untyped

      SEMI_END_BUF: untyped

      END_LINE: untyped

      WORD_BOUND: untyped

      NOT_WORD_BOUND: untyped

      WORD_BEGIN: untyped

      WORD_END: untyped

      PREC_READ: untyped

      PREC_READ_NOT: untyped

      LOOK_BEHIND: untyped

      LOOK_BEHIND_NOT: untyped

      ANYCHAR_STAR: untyped

      ANYCHAR_STAR_ML: untyped

      KEEP: untyped

      ANYCHAR_STAR_MASK: untyped

      END_BUF_MASK: untyped
    end

    # ENCLOSE_* (regparse.h)
    module Enclose
      MEMORY: untyped

      OPTION: untyped

      STOP_BACKTRACK: untyped

      CONDITION: untyped

      ABSENT: untyped
    end

    # NST_*: the status bits of enclose, quantifier, backref and call nodes.
    module Status
      MIN_FIXED: untyped

      MAX_FIXED: untyped

      CLEN_FIXED: untyped

      MARK1: untyped

      MARK2: untyped

      MEM_BACKREFED: untyped

      STOP_BT_SIMPLE_REPEAT: untyped

      RECURSION: untyped

      CALLED: untyped

      ADDR_FIXED: untyped

      NAMED_GROUP: untyped

      NAME_REF: untyped

      IN_REPEAT: untyped

      NEST_LEVEL: untyped

      BY_NUMBER: untyped
    end

    # NQ_TARGET_*: what a quantifier knows about its target's emptiness.
    module TargetEmpty
      ISNOT_EMPTY: 0

      IS_EMPTY: 1

      IS_EMPTY_MEM: 2

      IS_EMPTY_REC: 3
    end

    # NSTR_*: string node flags.
    module StrFlag
      RAW: untyped

      AMBIG: untyped

      DONT_GET_OPT_INFO: untyped
    end

    REPEAT_INFINITE: -1

    INFINITE_DISTANCE: untyped

    MAX_CAPTURE_GROUP_NUM: 32767

    MAX_BACKREF_NUM: 1000

    MAX_REPEAT_NUM: 100000

    MAX_MULTI_BYTE_RANGES_NUM: 10000

    MAX_ERROR_MESSAGE_LEN: 90

    MAX_CAPTURE_HISTORY_GROUP: 31

    PARSE_DEPTH_LIMIT: 4096

    NODE_BACKREFS_SIZE: 6

    OPT_EXACT_MAXLEN: 24

    BIT_STATUS_BITS_NUM: 32

    INT_MAX_LIMIT: untyped

    LAST_CODE_POINT: 4294967295

    CHAR_TABLE_SIZE: 256

    CASE_FOLD_MULTI_CHAR: untyped

    CASE_FOLD_DEFAULT: untyped

    # BIT_STATUS_AT and friends: a group number past 31 folds onto bit 0.
    def self.bit_status_at?: (untyped stats, untyped n) -> untyped

    def self.bit_status_on_at: (untyped stats, untyped n) -> untyped

    def self.bit_status_on_at_simple: (untyped stats, untyped n) -> untyped

    # The saturating arithmetic of distances (regcomp.c distance_add and
    # distance_multiply).
    def self.distance_add: (untyped d1, untyped d2) -> untyped

    def self.distance_multiply: (untyped d, untyped m) -> (0 | untyped)
  end
end
