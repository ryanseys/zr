# A tree in the shape of Onigmo's print_indent_tree (regcomp.c, under
# ONIG_DEBUG_PARSE_TREE), for the tests and for reading a parse.
class Regexp
  module Onig
    module Dump
      ENCLOSE_NAMES: ::Hash[untyped, "option" | "memory" | "stop-bt" | "condition" | "absent"]

      ANCHOR_NAMES: ::Hash[untyped, "begin buf" | "end buf" | "begin line" | "end line" | "semi end buf" | "begin position" | "word bound" | "not word bound" | "word begin" | "word end" | "prec read" | "prec read not" | "look_behind" | "look_behind_not" | "keep"]

      CTYPE_NAMES: ::Hash[untyped, "word"]

      def self.tree: (untyped node, ?::Integer indent, ?untyped out) -> untyped

      # Nodes are named by their order of appearance, not their address.
      def self.id: (untyped _node) -> ""

      def self.bitset_text: (untyped bs) -> untyped
    end
  end
end
