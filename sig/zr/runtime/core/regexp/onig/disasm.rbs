# The byte code listed as onig_print_compiled_byte_code lists it
# (regcomp.c:6155-6570), for the tests and for reading a compile.
class Regexp
  module Onig
    module Disasm
      ARG_SPECIAL: -1

      ARG_NON: 0

      ARG_RELADDR: 1

      ARG_ABSADDR: 2

      ARG_LENGTH: 3

      ARG_MEMNUM: 4

      ARG_OPTION: 5

      INFO: ::Hash[untyped, ::Array["finish" | untyped] | ::Array["end" | untyped] | ::Array["exact1" | untyped] | ::Array["exact2" | untyped] | ::Array["exact3" | untyped] | ::Array["exact4" | untyped] | ::Array["exact5" | untyped] | ::Array["exactn" | untyped] | ::Array["exactmb2-n1" | untyped] | ::Array["exactmb2-n2" | untyped] | ::Array["exactmb2-n3" | untyped] | ::Array["exactmb2-n" | untyped] | ::Array["exactmb3n" | untyped] | ::Array["exactmbn" | untyped] | ::Array["exact1-ic" | untyped] | ::Array["exactn-ic" | untyped] | ::Array["cclass" | untyped] | ::Array["cclass-mb" | untyped] | ::Array["cclass-mix" | untyped] | ::Array["cclass-not" | untyped] | ::Array["cclass-mb-not" | untyped] | ::Array["cclass-mix-not" | untyped] | ::Array["anychar" | untyped] | ::Array["anychar-ml" | untyped] | ::Array["anychar*" | untyped] | ::Array["anychar-ml*" | untyped] | ::Array["anychar*-peek-next" | untyped] | ::Array["anychar-ml*-peek-next" | untyped] | ::Array["word" | untyped] | ::Array["not-word" | untyped] | ::Array["word-bound" | untyped] | ::Array["not-word-bound" | untyped] | ::Array["word-begin" | untyped] | ::Array["word-end" | untyped] | ::Array["ascii-word" | untyped] | ::Array["not-ascii-word" | untyped] | ::Array["ascii-word-bound" | untyped] | ::Array["not-ascii-word-bound" | untyped] | ::Array["ascii-word-begin" | untyped] | ::Array["ascii-word-end" | untyped] | ::Array["begin-buf" | untyped] | ::Array["end-buf" | untyped] | ::Array["begin-line" | untyped] | ::Array["end-line" | untyped] | ::Array["semi-end-buf" | untyped] | ::Array["begin-position" | untyped] | ::Array["backref1" | untyped] | ::Array["backref2" | untyped] | ::Array["backrefn" | untyped] | ::Array["backrefn-ic" | untyped] | ::Array["backref_multi" | untyped] | ::Array["backref_multi-ic" | untyped] | ::Array["backref_at_level" | untyped] | ::Array["mem-start-push" | untyped] | ::Array["mem-start" | untyped] | ::Array["mem-end-push" | untyped] | ::Array["mem-end-push-rec" | untyped] | ::Array["mem-end" | untyped] | ::Array["mem-end-rec" | untyped] | ::Array["set-option-push" | untyped] | ::Array["set-option" | untyped] | ::Array["keep" | untyped] | ::Array["fail" | untyped] | ::Array["jump" | untyped] | ::Array["push" | untyped] | ::Array["pop" | untyped] | ::Array["push-or-jump-e1" | untyped] | ::Array["push-if-peek-next" | untyped] | ::Array["repeat" | untyped] | ::Array["repeat-ng" | untyped] | ::Array["repeat-inc" | untyped] | ::Array["repeat-inc-ng" | untyped] | ::Array["repeat-inc-sg" | untyped] | ::Array["repeat-inc-ng-sg" | untyped] | ::Array["null-check-start" | untyped] | ::Array["null-check-end" | untyped] | ::Array["null-check-end-memst" | untyped] | ::Array["null-check-end-memst-push" | untyped] | ::Array["push-pos" | untyped] | ::Array["pop-pos" | untyped] | ::Array["push-pos-not" | untyped] | ::Array["fail-pos" | untyped] | ::Array["push-stop-bt" | untyped] | ::Array["pop-stop-bt" | untyped] | ::Array["look-behind" | untyped] | ::Array["push-look-behind-not" | untyped] | ::Array["fail-look-behind-not" | untyped] | ::Array["push-absent-pos" | untyped] | ::Array["absent" | untyped] | ::Array["absent-end" | untyped] | ::Array["call" | untyped] | ::Array["return" | untyped] | ::Array["condition" | untyped]]

      # A reader over the byte code.
      class Cursor
        @bytes: untyped

        @p: untyped

        attr_accessor p: untyped

        def initialize: (untyped bytes, ?::Integer p) -> void

        def byte: () -> untyped

        def rel_addr: () -> untyped

        alias abs_addr rel_addr

        alias length rel_addr

        def mem_num: () -> untyped

        def option: () -> untyped

        def code_point: () -> untyped

        def bytes: (untyped n) -> untyped

        def end?: () -> untyped

        def bitset_on_num: () -> untyped
      end

      def self.p_string: (untyped s) -> ::String

      def self.p_len_string: (untyped len, untyped mb_len, untyped s) -> ::String

      def self.rel: (untyped addr) -> ::String

      # One instruction at the cursor, as "[name:args]".
      def self.instruction: (untyped cur, untyped enc) -> untyped

      # print_compiled_byte_code_list: "code length: N" then five
      # instructions a line, each with its offset.
      def self.listing: (untyped reg) -> untyped

      OPTIMIZE_NAMES: ::Array["NONE" | "EXACT" | "EXACT_BM" | "EXACT_BM_NOT_REV" | "EXACT_IC" | "MAP" | "EXACT_BM_IC" | "EXACT_BM_NOT_REV_IC"]

      def self.anchor_text: (untyped anchor) -> ::String

      def self.distance: (untyped d) -> ("inf" | ::String)

      # print_optimize_info
      def self.optimize_info: (untyped reg) -> untyped
    end
  end
end
