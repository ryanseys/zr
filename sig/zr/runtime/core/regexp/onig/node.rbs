# The parse tree Onigmo builds (regparse.h's Node union) and what it
# is built with: the scan environment, the bit sets and code range
# buffers of a character class, and the name table of a pattern. A
# port of regparse.c:120-2100 under the BSD-2-Clause license
# reproduced in regexp.rb.
class Regexp
  module Onig
    # One node of the tree: the C's union as one class, so that a node
    # can change kind in place as the C's do (`*pnode = *cnode`,
    # SET_NTYPE), with the fields of every kind.
    class Node
      @ntype: untyped

      @s: untyped

      @flag: untyped

      @flags: untyped

      @state: untyped

      STR: 0

      CCLASS: 1

      CTYPE: 2

      CANY: 3

      BREF: 4

      QTFR: 5

      ENCLOSE: 6

      ANCHOR: 7

      LIST: 8

      ALT: 9

      CALL: 10

      SIMPLE: ::Array[untyped]

      # The kind, then every field of every kind (regparse.h).
      attr_accessor ntype: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor s: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor flag: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor flags: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor bs: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor mbuf: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor ctype: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor not: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor ascii_range: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor state: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor target: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor lower: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor upper: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor greedy: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor target_empty_info: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor head_exact: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor next_head_exact: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor is_referred: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor type: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor regnum: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor option: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor call_addr: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor min_len: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor max_len: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor char_len: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor opt_count: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor back_num: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor backs: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor nest_level: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor car: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor cdr: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor group_num: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor name: untyped

      # The kind, then every field of every kind (regparse.h).
      attr_accessor unset_addr_list: untyped

      FLAG_NCCLASS_NOT: 1

      def initialize: (untyped ntype) -> void

      def simple?: () -> untyped

      FIELDS: ::Array[:ntype | :s | :flag | :flags | :bs | :mbuf | :ctype | :not | :ascii_range | :state | :target | :lower | :upper | :greedy | :target_empty_info | :head_exact | :next_head_exact | :is_referred | :type | :regnum | :option | :call_addr | :min_len | :max_len | :char_len | :opt_count | :back_num | :backs | :nest_level | :car | :cdr | :group_num | :name | :unset_addr_list]

      # The C's struct copy: every field of `other`, its kind included.
      # Field by field: the compiled core keeps no ivar table to reflect on.
      def copy_from!: (untyped other) -> self

      # swap_node (regcomp.c): the two nodes exchange their contents.
      def swap!: (untyped other) -> untyped

      def self.str: (untyped bytes) -> untyped

      def self.str_raw: (untyped bytes) -> untyped

      def self.empty: () -> untyped

      def self.str_raw_char: (untyped byte) -> untyped

      def self.cclass: () -> untyped

      def self.ctype: (untyped type, untyped not_, untyped ascii_range) -> untyped

      def self.anychar: () -> untyped

      def self.list: (untyped left, untyped right) -> untyped

      def self.alt: (untyped left, untyped right) -> untyped

      # onig_node_list_add: `x` appended to `list`; the new cons cell.
      def self.list_add: (untyped list, untyped x) -> untyped

      def self.anchor: (untyped type) -> untyped

      def self.backref: (untyped backrefs, untyped by_name, untyped exist_level, untyped nest_level, untyped env) -> untyped

      def self.call: (untyped name, untyped gnum) -> untyped

      def self.quantifier: (untyped lower, untyped upper, untyped by_number) -> untyped

      def self.enclose: (untyped type) -> untyped

      def self.enclose_memory: (untyped option, untyped named) -> untyped

      def self.option: (untyped option) -> untyped

      def str_cat: (untyped bytes) -> untyped

      def str_set: (untyped bytes) -> untyped

      def str_clear: () -> untyped

      def str_len: () -> untyped

      def str_raw?: () -> untyped

      def str_ambig?: () -> untyped

      def str_dont_get_opt_info?: () -> untyped

      # str_node_split_last_char: the last character cut off into a
      # new node, or nil when there is only one.
      def str_split_last_char: (untyped enc) -> (nil | untyped)

      def str_can_be_split?: (untyped enc) -> untyped

      def cclass_not?: () -> untyped

      def cclass_set_not: () -> untyped

      def cclass_clear_not: () -> untyped

      def status?: (untyped bit) -> untyped

      def set_status: (untyped bit) -> untyped

      def clear_status: (untyped bit) -> untyped
    end

    # A 256-bit set as one Integer (regint.h's BitSet).
    module BitSet
      ALL: untyped

      def self.at?: (untyped bs, untyped pos) -> untyped

      def self.set: (untyped bs, untyped pos) -> untyped

      def self.clear: (untyped bs, untyped pos) -> untyped

      def self.invert: (untyped bs) -> untyped

      def self.empty?: (untyped bs) -> untyped
    end

    # The code ranges of a class past the single bytes (regparse.c's
    # BBuf of [n][from][to]... as a flat Array of pairs, nil for none).
    module CodeRange
      def self.count: (untyped buf) -> untyped

      # add_code_range_to_buf0: the buffer with [from, to] merged in,
      # kept sorted and disjoint; a new buffer when `buf` is nil.
      def self.add_to_buf0: (untyped buf, untyped env, untyped from, untyped to, untyped checkdup) -> untyped

      def self.add_to_buf: (untyped buf, untyped env, untyped from, untyped to) -> untyped

      # add_code_range0
      def self.add0: (untyped buf, untyped env, untyped from, untyped to, untyped checkdup) -> untyped

      def self.add: (untyped buf, untyped env, untyped from, untyped to) -> untyped

      # MBCODE_START_POS
      def self.mbcode_start_pos: (untyped enc) -> (0 | 128)

      # SET_ALL_MULTI_BYTE_RANGE
      def self.set_all_multi_byte: (untyped enc, untyped buf, untyped env) -> untyped

      # not_code_range_buf: the complement, as a new buffer (or nil).
      def self.not_buf: (untyped enc, untyped buf, untyped env) -> untyped

      # or_code_range_buf
      def self.or_buf: (untyped enc, untyped buf1, untyped not1, untyped buf2, untyped not2, untyped env) -> (untyped | nil)

      # and_code_range1
      def self.and_range1: (untyped buf, untyped env, untyped from1, untyped to1, untyped data) -> untyped

      # and_code_range_buf
      def self.and_buf: (untyped buf1, untyped not1, untyped buf2, untyped not2, untyped env) -> (untyped | nil)

      # onig_is_code_in_cc_len (regexec.c): whether `code` is in the class.
      def self.code_in_cc_len?: (untyped enclen, untyped code, untyped cc) -> untyped

      def self.code_in_cc?: (untyped enc, untyped code, untyped cc) -> untyped
    end

    # and_cclass and or_cclass (regparse.c:2262-2364): `cc` folded into
    # `dest` in place.
    module CClassOps
      def self.and: (untyped dest, untyped cc, untyped env) -> (nil | untyped)

      def self.or: (untyped dest, untyped cc, untyped env) -> (nil | untyped)
    end

    # A named group's entry in the name table: the group numbers under
    # the name, in the order they were defined (NameEntry).
    class NameEntry
      @name: untyped

      @back_refs: untyped

      attr_reader name: untyped

      attr_reader back_refs: untyped

      def initialize: (untyped name) -> void

      def back_num: () -> untyped
    end

    # The pattern being compiled, as regparse and regcomp see it
    # (regex_t): what the parser records on it, and the name table.
    class Reg
      @options: untyped

      @enc: untyped

      @case_fold_flag: untyped

      @num_mem: untyped

      @name_table: untyped

      @num_repeat: untyped

      @num_null_check: untyped

      @num_call: untyped

      @capture_history: untyped

      @bt_mem_start: untyped

      @bt_mem_end: untyped

      @stack_pop_level: untyped

      @repeat_range: untyped

      attr_accessor options: untyped

      attr_accessor case_fold_flag: untyped

      attr_accessor enc: untyped

      attr_accessor num_mem: untyped

      attr_accessor name_table: untyped

      attr_accessor num_repeat: untyped

      attr_accessor num_null_check: untyped

      attr_accessor num_call: untyped

      attr_accessor capture_history: untyped

      attr_accessor bt_mem_start: untyped

      attr_accessor bt_mem_end: untyped

      attr_accessor stack_pop_level: untyped

      attr_accessor repeat_range: untyped

      attr_accessor optimize: untyped

      attr_accessor threshold_len: untyped

      attr_accessor anchor: untyped

      attr_accessor anchor_dmin: untyped

      attr_accessor anchor_dmax: untyped

      attr_accessor sub_anchor: untyped

      attr_accessor exact: untyped

      attr_accessor map: untyped

      attr_accessor dmin: untyped

      attr_accessor dmax: untyped

      attr_accessor code: untyped

      attr_accessor tree: untyped

      def initialize: (untyped options, untyped enc, ?untyped case_fold_flag) -> void

      def names_clear: () -> untyped

      def number_of_names: () -> (untyped | 0)

      def name_find: (untyped name) -> untyped

      # name_add
      def name_add: (untyped name, untyped backref, untyped env) -> untyped

      # onig_name_to_group_numbers: the numbers, or nil for no such name.
      def name_to_group_numbers: (untyped name) -> untyped

      # onig_foreach_name
      def each_name: () { (?) -> untyped } -> untyped

      # onig_renumber_name_table
      def renumber_name_table: (untyped map) -> untyped

      # onig_noname_group_capture_is_active
      def noname_group_capture_active?: () -> (false | true)
    end

    # ScanEnv: the state that the parser keeps through a pattern.
    class ScanEnv
      @reg: untyped

      @option: untyped

      @case_fold_flag: untyped

      @enc: untyped

      @pattern: untyped

      @warnings: untyped

      @capture_history: untyped

      @bt_mem_start: untyped

      @bt_mem_end: untyped

      @backrefed_mem: untyped

      @num_call: untyped

      @num_mem: untyped

      @num_named: untyped

      @mem_nodes: untyped

      @unset_addr_list: untyped

      @parse_depth: untyped

      @warnings_flag: untyped

      attr_accessor option: untyped

      attr_accessor case_fold_flag: untyped

      attr_accessor enc: untyped

      attr_accessor capture_history: untyped

      attr_accessor bt_mem_start: untyped

      attr_accessor bt_mem_end: untyped

      attr_accessor backrefed_mem: untyped

      attr_accessor pattern: untyped

      attr_accessor reg: untyped

      attr_accessor unset_addr_list: untyped

      attr_accessor num_call: untyped

      attr_accessor num_mem: untyped

      attr_accessor num_named: untyped

      attr_accessor mem_nodes: untyped

      attr_accessor parse_depth: untyped

      attr_accessor warnings_flag: untyped

      attr_accessor warnings: untyped

      def initialize: (untyped reg, untyped pattern, untyped warnings) -> void

      def pattern_end: () -> untyped

      # scan_env_add_mem_entry: the next group number.
      def add_mem_entry: () -> untyped

      def set_mem_node: (untyped num, untyped node) -> untyped

      def ignorecase?: () -> untyped

      def extend?: () -> untyped

      def multiline?: () -> untyped

      def singleline?: () -> untyped

      def ascii_range?: () -> untyped

      def posix_bracket_all_range?: () -> untyped

      def word_bound_all_range?: () -> untyped

      # onig_syntax_warn: `text` with the pattern appended as
      # onig_vsnprintf_with_pattern appends it, when it fits.
      def syntax_warn: (untyped text, ?verbose: bool) -> untyped

      def cc_esc_warn: (untyped c) -> (nil | untyped)

      def close_bracket_without_esc_warn: (untyped c) -> (untyped | nil)

      def cc_dup_warn: (untyped _from, untyped _to) -> (nil | untyped)

      def unknown_esc_warn: (untyped c) -> untyped
    end

    class Warnings
      WARN_BUFSIZE: 256

      # onig_vsnprintf_with_pattern: ": /pattern/" after the text, with the
      # pattern's bytes written as the C writes them, only when all of it
      # fits the 256-byte buffer. The result is BINARY.
      def self.with_pattern: (untyped text, untyped pat, untyped enc) -> untyped
    end
  end
end
