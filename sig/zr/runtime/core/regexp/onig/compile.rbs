# Onigmo's compiler: a tuned tree to its byte code (regcomp.c:386-1894).
# The bytes are laid out as Onigmo lays them out, little-endian: an
# opcode is one byte, a relative or absolute address, a length and a
# repeat number are four, a memory number is two, an option word is
# four, a bit set is thirty-two. A port under the BSD-2-Clause license
# reproduced in regexp.rb.
class Regexp
  module Onig
    # enum OpCode (regint.h)
    module Op
      FINISH: 0

      END_: 1

      EXACT1: 2

      EXACT2: 3

      EXACT3: 4

      EXACT4: 5

      EXACT5: 6

      EXACTN: 7

      EXACTMB2N1: 8

      EXACTMB2N2: 9

      EXACTMB2N3: 10

      EXACTMB2N: 11

      EXACTMB3N: 12

      EXACTMBN: 13

      EXACT1_IC: 14

      EXACTN_IC: 15

      CCLASS: 16

      CCLASS_MB: 17

      CCLASS_MIX: 18

      CCLASS_NOT: 19

      CCLASS_MB_NOT: 20

      CCLASS_MIX_NOT: 21

      ANYCHAR: 22

      ANYCHAR_ML: 23

      ANYCHAR_STAR: 24

      ANYCHAR_ML_STAR: 25

      ANYCHAR_STAR_PEEK_NEXT: 26

      ANYCHAR_ML_STAR_PEEK_NEXT: 27

      WORD: 28

      NOT_WORD: 29

      WORD_BOUND: 30

      NOT_WORD_BOUND: 31

      WORD_BEGIN: 32

      WORD_END: 33

      ASCII_WORD: 34

      NOT_ASCII_WORD: 35

      ASCII_WORD_BOUND: 36

      NOT_ASCII_WORD_BOUND: 37

      ASCII_WORD_BEGIN: 38

      ASCII_WORD_END: 39

      BEGIN_BUF: 40

      END_BUF: 41

      BEGIN_LINE: 42

      END_LINE: 43

      SEMI_END_BUF: 44

      BEGIN_POSITION: 45

      BACKREF1: 46

      BACKREF2: 47

      BACKREFN: 48

      BACKREFN_IC: 49

      BACKREF_MULTI: 50

      BACKREF_MULTI_IC: 51

      BACKREF_WITH_LEVEL: 52

      MEMORY_START: 53

      MEMORY_START_PUSH: 54

      MEMORY_END_PUSH: 55

      MEMORY_END_PUSH_REC: 56

      MEMORY_END: 57

      MEMORY_END_REC: 58

      KEEP: 59

      FAIL: 60

      JUMP: 61

      PUSH: 62

      POP: 63

      PUSH_OR_JUMP_EXACT1: 64

      PUSH_IF_PEEK_NEXT: 65

      REPEAT: 66

      REPEAT_NG: 67

      REPEAT_INC: 68

      REPEAT_INC_NG: 69

      REPEAT_INC_SG: 70

      REPEAT_INC_NG_SG: 71

      NULL_CHECK_START: 72

      NULL_CHECK_END: 73

      NULL_CHECK_END_MEMST: 74

      NULL_CHECK_END_MEMST_PUSH: 75

      PUSH_POS: 76

      POP_POS: 77

      PUSH_POS_NOT: 78

      FAIL_POS: 79

      PUSH_STOP_BT: 80

      POP_STOP_BT: 81

      LOOK_BEHIND: 82

      PUSH_LOOK_BEHIND_NOT: 83

      FAIL_LOOK_BEHIND_NOT: 84

      PUSH_ABSENT_POS: 85

      ABSENT: 86

      ABSENT_END: 87

      CALL: 88

      RETURN: 89

      CONDITION: 90

      STATE_CHECK_PUSH: 91

      STATE_CHECK_PUSH_OR_JUMP: 92

      STATE_CHECK: 93

      STATE_CHECK_ANYCHAR_STAR: 94

      STATE_CHECK_ANYCHAR_ML_STAR: 95

      SET_OPTION_PUSH: 96

      SET_OPTION: 97

      NAMES: untyped

      SIZE_OPCODE: 1

      SIZE_RELADDR: 4

      SIZE_ABSADDR: 4

      SIZE_LENGTH: 4

      SIZE_MEMNUM: 2

      SIZE_REPEATNUM: 4

      SIZE_OPTION: 4

      SIZE_CODE_POINT: 4

      SIZE_BITSET: 32

      SIZE_OP_ANYCHAR_STAR: untyped

      SIZE_OP_ANYCHAR_STAR_PEEK_NEXT: untyped

      SIZE_OP_JUMP: untyped

      SIZE_OP_PUSH: untyped

      SIZE_OP_POP: untyped

      SIZE_OP_PUSH_OR_JUMP_EXACT1: untyped

      SIZE_OP_PUSH_IF_PEEK_NEXT: untyped

      SIZE_OP_REPEAT_INC: untyped

      SIZE_OP_REPEAT_INC_NG: untyped

      SIZE_OP_PUSH_POS: untyped

      SIZE_OP_PUSH_POS_NOT: untyped

      SIZE_OP_POP_POS: untyped

      SIZE_OP_FAIL_POS: untyped

      SIZE_OP_SET_OPTION: untyped

      SIZE_OP_SET_OPTION_PUSH: untyped

      SIZE_OP_FAIL: untyped

      SIZE_OP_MEMORY_START: untyped

      SIZE_OP_MEMORY_START_PUSH: untyped

      SIZE_OP_MEMORY_END_PUSH: untyped

      SIZE_OP_MEMORY_END_PUSH_REC: untyped

      SIZE_OP_MEMORY_END: untyped

      SIZE_OP_MEMORY_END_REC: untyped

      SIZE_OP_PUSH_STOP_BT: untyped

      SIZE_OP_POP_STOP_BT: untyped

      SIZE_OP_NULL_CHECK_START: untyped

      SIZE_OP_NULL_CHECK_END: untyped

      SIZE_OP_LOOK_BEHIND: untyped

      SIZE_OP_PUSH_LOOK_BEHIND_NOT: untyped

      SIZE_OP_FAIL_LOOK_BEHIND_NOT: untyped

      SIZE_OP_CALL: untyped

      SIZE_OP_RETURN: untyped

      SIZE_OP_CONDITION: untyped

      SIZE_OP_PUSH_ABSENT_POS: untyped

      SIZE_OP_ABSENT: untyped

      SIZE_OP_ABSENT_END: untyped

      QUANTIFIER_EXPAND_LIMIT_SIZE: 50
    end

    # The byte code under construction (the BBuf of regex_t).
    class Code
      @bytes: untyped

      attr_reader bytes: untyped

      def initialize: () -> void

      def used: () -> untyped

      def add_opcode: (untyped op) -> untyped

      def add_rel_addr: (untyped addr) -> untyped

      def add_abs_addr: (untyped addr) -> untyped

      def add_length: (untyped len) -> untyped

      def add_mem_num: (untyped num) -> untyped

      def add_option: (untyped option) -> untyped

      def add_bytes: (untyped s) -> untyped

      def add_code_point: (untyped code) -> untyped

      def add_bitset: (untyped bs) -> untyped

      def add_opcode_rel_addr: (untyped op, untyped addr) -> untyped

      def add_opcode_option: (untyped op, untyped option) -> untyped

      # BBUF_WRITE of an absolute address at `offset`.
      def write_abs_addr: (untyped offset, untyped addr) -> untyped
    end

    # compile_tree and compile_length_tree over `reg`.
    class Compiler
      @reg: untyped

      @enc: untyped

      @code: untyped

      include Op

      def initialize: (untyped reg) -> void

      def need_str_len_op_exact?: (untyped op) -> untyped

      # roomof(byte_len, mb_len)
      def roomof: (untyped n, untyped m) -> untyped

      def select_str_opcode: (untyped mb_len, untyped byte_len, untyped ignore_case) -> untyped

      def compile_tree_empty_check: (untyped node, untyped empty_info) -> untyped

      def compile_call: (untyped node) -> untyped

      def compile_tree_n_times: (untyped node, untyped n) -> untyped

      def add_compile_string_length: (untyped mb_len, untyped byte_len, untyped ignore_case) -> untyped

      def add_compile_string: (untyped s, untyped mb_len, untyped byte_len, untyped ignore_case) -> untyped

      # The runs of same-length characters of a string node, as
      # compile_string_node and compile_length_string_node walk them.
      def each_string_run: (untyped node) { (untyped, untyped, untyped, untyped) -> untyped } -> (nil | untyped)

      def compile_length_string_node: (untyped node) -> untyped

      def compile_length_string_raw_node: (untyped node) -> (0 | untyped)

      def compile_string_node: (untyped node) -> untyped

      def compile_string_raw_node: (untyped node) -> (nil | untyped)

      # The multi-byte ranges of a class as the matcher reads them: the
      # count, then the pairs, as words.
      def mbuf_bytes: (untyped mbuf) -> untyped

      def add_multi_byte_cclass: (untyped mbuf) -> untyped

      def compile_length_cclass_node: (untyped cc) -> untyped

      def compile_cclass_node: (untyped cc) -> untyped

      def entry_repeat_range: (untyped id, untyped lower, untyped upper) -> untyped

      def compile_range_repeat_node: (untyped qn, untyped target_len, untyped empty_info) -> untyped

      def anychar_star_quantifier?: (untyped qn) -> untyped

      def compile_length_quantifier_node: (untyped qn) -> untyped

      def compile_quantifier_node: (untyped qn) -> (nil | untyped)

      def multiline?: () -> untyped

      # IS_DYNAMIC_OPTION is 0: an option group compiles to its body.
      def compile_length_option_node: (untyped node) -> untyped

      def compile_option_node: (untyped node) -> untyped

      def bt_mem_start?: (untyped n) -> untyped

      def bt_mem_end?: (untyped n) -> untyped

      def compile_length_enclose_node: (untyped node) -> untyped

      def compile_enclose_node: (untyped node) -> untyped

      def compile_length_anchor_node: (untyped node) -> untyped

      # The character count of a look-behind's target, as the opcode needs it.
      def look_behind_length: (untyped node) -> untyped

      def compile_anchor_node: (untyped node) -> untyped

      def ignorecase?: () -> untyped

      def compile_length_tree: (untyped node) -> untyped

      def compile_tree: (untyped node) -> untyped

      # the `add_bacref_mems:` label: the count, then the numbers last first.
      def add_backref_mems: (untyped node) -> untyped

      # unset_addr_list_fix: every call's dummy address filled in.
      def fix_unset_addrs: (untyped list) -> untyped
    end
  end
end
