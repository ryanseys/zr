# wasi-libc's lseek(2) whence values, which IO defines, and O_NONBLOCK and
# the access modes, which File::Constants also defines. IO opens its own
# descriptors before File exists, so those are IO's own here.
class IO
  SEEK_SET: 0

  SEEK_CUR: 1

  SEEK_END: 2

  O_NONBLOCK: 4

  ACCESS: { read: 67108864, write: 268435456, both: 335544320, mask: 335544320 }
end
