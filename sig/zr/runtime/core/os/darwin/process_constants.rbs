# darwin's waitpid(2) flags, priority targets, resource limits and
# sysconf name, with Process's names for them.
module Process
  WNOHANG: 1

  WUNTRACED: 2

  # The target of a priority query: a process, a process group, a user.
  PRIO_PROCESS: 0

  PRIO_PGRP: 1

  PRIO_USER: 2

  # The resources a limit is set on, and the limit that is none.
  RLIMIT_AS: 5

  RLIMIT_CORE: 4

  RLIMIT_CPU: 0

  RLIMIT_DATA: 2

  RLIMIT_FSIZE: 1

  RLIMIT_MEMLOCK: 6

  RLIMIT_NOFILE: 8

  RLIMIT_NPROC: 7

  RLIMIT_RSS: 5

  RLIMIT_STACK: 3

  RLIM_INFINITY: 9223372036854775807

  RLIM_SAVED_MAX: untyped

  RLIM_SAVED_CUR: untyped

  RLIMITS: { "AS" => untyped, "CORE" => untyped, "CPU" => untyped, "DATA" => untyped, "FSIZE" => untyped, "MEMLOCK" => untyped, "NOFILE" => untyped, "NPROC" => untyped, "RSS" => untyped, "STACK" => untyped }

  RLIM_NAMES: { "INFINITY" => untyped, "SAVED_MAX" => untyped, "SAVED_CUR" => untyped }

  # sysconf's name for the maximum number of supplementary groups, and
  # the maximum that ruby lets a program request.
  SC_NGROUPS_MAX: 4

  MAX_GROUPS: 65536
end
