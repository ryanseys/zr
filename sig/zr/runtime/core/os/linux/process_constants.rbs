# Linux's waitpid(2) flags, priority targets, resource limits and
# sysconf name, with Process's names for them.
module Process
  WNOHANG: 1

  WUNTRACED: 2

  # The target of a priority query: a process, a process group, a user.
  PRIO_PROCESS: 0

  PRIO_PGRP: 1

  PRIO_USER: 2

  # The resources a limit is set on, and the limit that is none: every
  # bit of an rlim_t.
  RLIMIT_AS: 9

  RLIMIT_CORE: 4

  RLIMIT_CPU: 0

  RLIMIT_DATA: 2

  RLIMIT_FSIZE: 1

  RLIMIT_LOCKS: 10

  RLIMIT_MEMLOCK: 8

  RLIMIT_MSGQUEUE: 12

  RLIMIT_NICE: 13

  RLIMIT_NOFILE: 7

  RLIMIT_NPROC: 6

  RLIMIT_RSS: 5

  RLIMIT_RTPRIO: 14

  RLIMIT_RTTIME: 15

  RLIMIT_SIGPENDING: 11

  RLIMIT_STACK: 3

  RLIM_INFINITY: 18446744073709551615

  RLIM_SAVED_MAX: untyped

  RLIM_SAVED_CUR: untyped

  RLIMITS: { "AS" => untyped, "CORE" => untyped, "CPU" => untyped, "DATA" => untyped, "FSIZE" => untyped, "LOCKS" => untyped, "MEMLOCK" => untyped, "MSGQUEUE" => untyped, "NICE" => untyped, "NOFILE" => untyped, "NPROC" => untyped, "RSS" => untyped, "RTPRIO" => untyped, "RTTIME" => untyped, "SIGPENDING" => untyped, "STACK" => untyped }

  RLIM_NAMES: { "INFINITY" => untyped, "SAVED_MAX" => untyped, "SAVED_CUR" => untyped }

  # sysconf's name for the maximum number of supplementary groups, and
  # the maximum that ruby lets a program request.
  SC_NGROUPS_MAX: 3

  MAX_GROUPS: 65536
end
