# What Ruby does to a pattern around its engine (re.c): the preprocess
# that decodes the escapes naming characters (rb_reg_preprocess), the
# encoding a pattern takes and a match reads it in, a compile again
# for a subject of another encoding, and the pattern as messages,
# inspect and to_s show it. `Regexp#source` keeps the text as written.
# Plain Ruby: it loads under CRuby too, for tools/regexp_diff.rb.
class Regexp
  module Pattern
    BYTE_ESCAPES: { "n" => 10, "t" => 9, "r" => 13, "f" => 12, "v" => 11, "a" => 7, "e" => 27, "\\" => 92 }

    # The option bits, with Regexp's names for them; regexp.rb, which
    # defines those, loads after this file.
    IGNORECASE: 1

    EXTENDED: 2

    MULTILINE: 4

    FIXEDENCODING: 16

    NOENCODING: 32

    ENGINE_OPTIONS: untyped

    # The encodings whose characters the engine reads as UTF-8.
    WIDE: ::Array["UTF-8" | "UTF8-MAC" | "UTF8-DoCoMo" | "UTF8-KDDI" | "UTF8-SoftBank"]

    # The engine for a pattern of `enc`: the Onigmo encoding ruby reads
    # it with.
    def self?.engine_for: (untyped enc) -> untyped

    # rb_reg_initialize_str and rb_reg_initialize: `source` compiled under
    # the option `bits`, as [encoding, bits, compiled, warnings]: the
    # pattern's encoding, the bits with the flags that ruby keeps next to
    # them (FIXEDENCODING when a character, an escape or the option fixed
    # the encoding), and the result of Regexp::Onig.compile. Ruby
    # preprocesses under the source's own encoding (BINARY under /n), and
    # the engine reads the text under the pattern's. RegexpError gives
    # the reason, then the pattern as written (rb_reg_raise_str).
    def self?.compile: (untyped source, untyped bits) -> untyped

    # The encoding a pattern read in `enc` takes when its preprocess
    # `fixed` one (or nil), and the option `bits` with FIXEDENCODING
    # where the encoding is fixed.
    def self?.fixed_encoding: (untyped enc, untyped fixed, untyped bits) -> ::Array[untyped]

    # rb_reg_prepare_enc: the encoding a match of a subject of
    # `text_encoding` (`ascii`: all its bytes below 128) reads a pattern
    # in, when the engine reads it in `engine` and the pattern's own is
    # `encoding`, and the warning ruby gives of a /n pattern read as
    # characters: [encoding, warning or nil]. A subject the pattern
    # cannot read is refused.
    def self?.prepared_encoding: (untyped engine, untyped encoding, untyped bits, untyped text_encoding, untyped ascii) -> (::Array[untyped | nil] | ::Array[untyped | ::String])

    def self?.incompatible: (untyped encoding, untyped text_encoding) -> untyped

    # rb_enc_inspect_name.
    def self?.inspect_name: (untyped enc) -> untyped

    # rb_reg_prepare_re: the pattern `source` (of a Regexp with the
    # option `bits`) compiled again for a subject read in `enc`, as
    # [compiled, warnings]. Ruby
    # decodes the escapes under `enc`, as if no option were given; a
    # text that refuses is an ArgumentError, and a text the engine
    # refuses a RegexpError naming the Regexp (rb_reg_raise).
    def self?.recompile: (untyped source, untyped bits, untyped encoding, untyped enc) -> untyped

    # An engine message as ruby formats it, a C string: up to its first NUL.
    def self?.c_text: (untyped message) -> untyped

    # The encoding a reader of messages and inspect sees.
    def self?.result_encoding: () -> untyped

    # rb_enc_reg_error_desc: `message`, then the pattern `source` (read in
    # `enc`) as written between slashes with its option letters, in
    # `enc`.
    def self?.error_desc: (untyped message, untyped source, untyped enc, untyped bits) -> untyped

    # rb_reg_desc: what Regexp#inspect shows of a pattern `source` of
    # `encoding` with the option `bits`.
    def self?.desc: (untyped source, untyped encoding, untyped bits) -> untyped

    # option_to_str.
    def self?.option_letters: (untyped bits) -> ::String

    OPTION_BITS: { "m" => untyped, "i" => untyped, "x" => untyped }

    # rb_reg_str_with_term: Regexp#to_s of a pattern `source` of `encoding`
    # with the option `bits`. A source that is one `(?opts-opts:...)`
    # group (or starts with `(?opts)` runs) folds its letters into the
    # options when the engine takes the group's body alone.
    def self?.str_with_term: (untyped source, untyped encoding, untyped bits, untyped term) -> untyped

    # rb_reg_expr_str: `text` as a message or inspect shows it between
    # `term`s. It is read under `enc`; `resenc` is the encoding that the
    # reader sees (nil for none). Text that is in a valid ASCII-compatible
    # encoding, all printable, with no bare `term` and no non-ASCII
    # character that a reader cannot show, goes as it is. Otherwise an
    # escape keeps its next character, a bare `term` gets a backslash, a
    # character past ASCII is written as \uXXXX (or \xHH) when there is a
    # reader, a character that is not printable and not a space as \xHH,
    # and the others as they are. "Printable" and "space" are the
    # encoding's own classes. The result is bytes; the caller sets the encoding.
    def self?.expr_str: (untyped text, untyped enc, untyped resenc, untyped term) -> untyped

    # rb_str_buf_cat_escaped_char, for a character past ASCII.
    def self?.escaped_char: (untyped code, untyped unicode) -> untyped

    # rb_reg_preprocess: the text that the engine compiles for `source`
    # read in `enc`, and the encoding that its characters and escapes fix,
    # or nil: [text (BINARY), fixed]. Ruby decodes the `\u` escapes and the
    # byte escapes that give a character past ASCII, drops comments, and
    # keeps the rest as written. RegexpError contains only the reason.
    def self?.preprocess: (untyped source, untyped enc, untyped extended) -> ::Array[untyped]

    # unescape_nonascii0 and the escapes it reads, over a pattern's bytes.
    class Preprocess
      @s: untyped

      @b: untyped

      @end: untyped

      @enc: untyped

      @fixed: untyped

      @property: untyped

      @p: untyped

      @buf: untyped

      attr_reader buf: untyped

      attr_reader fixed: untyped

      attr_reader property: untyped

      def initialize: (untyped bytes, untyped enc) -> void

      # The pattern from @p on; with `recurse`, only up to the `)` that
      # closes the group whose `(` was just read.
      def walk: (untyped extended, untyped recurse) -> (nil | untyped)

      # `(?opts:` or `(?opts)` at @p - 1 flipping the extended flag:
      # :group for a group that flips it until its `)`, the new flag for
      # the rest of the pattern, or nil for no change.
      def option_group: (untyped extended) -> (nil | :group | untyped)

      # `(?#...)`, dropped whole; one without its `)` is kept, so the
      # engine reports the error.
      def comment: () -> (nil | untyped)

      def multibyte: (untyped at, untyped len) -> untyped

      def escape: () -> untyped

      def asis: (untyped c) -> untyped

      # The byte escape at @p - 2: kept as written in a US-ASCII pattern,
      # else the character of the encoding it names.
      def escaped_nonascii: () -> (nil | untyped)

      # `\uHHHH` and `\u{H HH ...}`.
      def unicode: () -> untyped

      def unicode_list: () -> untyped

      # append_utf8: a code point below 128 as `\xHH`, any other as its
      # UTF-8 bytes, which fix the pattern to UTF-8.
      def utf8: (untyped code) -> untyped

      def fix: (untyped encoding, untyped message) -> (untyped | untyped | nil)

      # rb_enc_precise_mbclen at `at`, refused when no character starts there.
      def char_len: (untyped at) -> untyped

      def space?: (untyped x) -> untyped
    end

    # rb_enc_mbmaxlen
    def self?.mbmaxlen: (untyped enc) -> untyped

    # MBCLEN_NEEDMORE_P: whether `bytes` are the start of a character of
    # `enc` that more bytes complete.
    def self?.needs_more?: (untyped bytes, untyped enc) -> untyped

    # MBCLEN_INVALID_P: `bytes` are neither a character nor the start of one.
    def self?.invalid?: (untyped bytes, untyped enc) -> untyped

    # One `\M-X` / `\C-X` / `\cX` run at `i` as [byte, index past it].
    def self?.escaped_byte: (untyped b, untyped i) -> ::Array[untyped]

    def self?.hex_byte?: (untyped x) -> untyped
  end
end
