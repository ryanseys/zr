# The Pathname class, which ruby 4.0 includes as a builtin: it works
# without a require, and `require "pathname"` adds the Find and rmtree
# part that ruby keeps on the load path.
#
# This is ruby 4.0.7's pathname_builtin.rb, with `<=>` and `sub`, which
# its pathname.c writes in C, in Ruby here. A Pathname is only a string:
# it never touches the file system for an operation on the name itself,
# and every operation on the file goes to File, Dir or FileTest.
#
class Pathname
  # path_cmp: byte order, with a separator below every other byte.
  def <=>: (untyped other) -> (nil | untyped)

  # path_sub: String#sub over the path, the block and all.
  def sub: (*untyped args) ?{ (?) -> untyped } -> untyped
end

# The rest is also Ruby in CRuby, and reports its parameters by name.
class Pathname
  @path: untyped

  VERSION: "0.4.0"

  private

  # Darwin's file names match case-sensitively as far as File::FNM_SYSCASE
  # says.
  def same_paths?: (untyped a, untyped b) -> untyped

  public

  def path: () -> untyped

  def initialize: (untyped path) -> void

  def freeze: () -> self

  def ==: (untyped other) -> (false | untyped)

  alias === ==

  alias eql? ==

  def hash: () -> untyped

  def to_s: () -> untyped

  alias to_path to_s

  def inspect: () -> ::String

  def sub_ext: (untyped repl) -> untyped

  # The separator is `/` on every target; written as literals, the
  # patterns compile when first used and not as the runtime boots,
  # where the two interpolated ones cost 0.5 ms of a 9 ms start.
  SEPARATOR_LIST: "/"

  SEPARATOR_PAT: ::Regexp

  ABSOLUTE_PATH: ::Regexp

  def mkpath: (?mode: untyped?) -> self

  def cleanpath: (?bool consider_symlink) -> untyped

  def parent: () -> untyped

  def mountpoint?: () -> untyped

  def root?: () -> untyped

  def absolute?: () -> untyped

  def relative?: () -> untyped

  def each_filename: () ?{ (untyped) -> untyped } -> (untyped | nil)

  def descend: () ?{ (untyped) -> untyped } -> (untyped | nil)

  def ascend: () ?{ (untyped) -> untyped } -> untyped

  def +: (untyped other) -> untyped

  alias / +

  def join: (*untyped args) -> (self | untyped)

  def children: (?bool with_directory) -> untyped

  def each_child: (?bool with_directory) { (?) -> untyped } -> untyped

  def relative_path_from: (untyped base_directory) -> untyped

  private

  def chop_basename: (untyped path) -> (nil | ::Array[untyped])

  def split_names: (untyped path) -> ::Array[untyped]

  def prepend_prefix: (untyped prefix, untyped relpath) -> untyped

  def cleanpath_aggressive: () -> untyped

  def has_trailing_separator?: (untyped path) -> (false | untyped)

  def add_trailing_separator: (untyped path) -> untyped

  def del_trailing_separator: (untyped path) -> untyped

  def cleanpath_conservative: () -> untyped

  def plus: (untyped path1, untyped path2) -> untyped
end

# The file's own questions, each one call to File.
class Pathname
  def each_line: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def read: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def binread: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def readlines: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def sysopen: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def write: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def binwrite: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def atime: () -> untyped

  def birthtime: () -> untyped

  def ctime: () -> untyped

  def mtime: () -> untyped

  def chmod: (untyped mode) -> untyped

  def lchmod: (untyped mode) -> untyped

  def chown: (untyped owner, untyped group) -> untyped

  def lchown: (untyped owner, untyped group) -> untyped

  def fnmatch: (untyped pattern, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def fnmatch?: (untyped pattern, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def ftype: () -> untyped

  def make_link: (untyped old) -> untyped

  def open: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def readlink: () -> untyped

  def rename: (untyped to) -> untyped

  def stat: () -> untyped

  def lstat: () -> untyped

  def make_symlink: (untyped old) -> untyped

  def truncate: (untyped length) -> untyped

  def utime: (untyped atime, untyped mtime) -> untyped

  def lutime: (untyped atime, untyped mtime) -> untyped

  def basename: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def dirname: () -> untyped

  def extname: () -> untyped

  def expand_path: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def split: () -> untyped

  def realpath: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def realdirpath: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped
end

# The FileTest questions.
class Pathname
  def blockdev?: () -> untyped

  def chardev?: () -> untyped

  def empty?: () -> untyped

  def executable?: () -> untyped

  def executable_real?: () -> untyped

  def exist?: () -> untyped

  def grpowned?: () -> untyped

  def directory?: () -> untyped

  def file?: () -> untyped

  def pipe?: () -> untyped

  def socket?: () -> untyped

  def owned?: () -> untyped

  def readable?: () -> untyped

  def world_readable?: () -> untyped

  def readable_real?: () -> untyped

  def setuid?: () -> untyped

  def setgid?: () -> untyped

  def size: () -> untyped

  def size?: () -> untyped

  def sticky?: () -> untyped

  def symlink?: () -> untyped

  def writable?: () -> untyped

  def world_writable?: () -> untyped

  def writable_real?: () -> untyped

  def zero?: () -> untyped
end

# The directory's questions.
class Pathname
  def self.glob: (*untyped args, **untyped kwargs) ?{ (untyped) -> untyped } -> untyped

  def glob: (*untyped args, **untyped kwargs) ?{ (untyped) -> untyped } -> untyped

  def self.getwd: () -> untyped

  alias self.pwd self.getwd

  def entries: () -> untyped

  def each_entry: () ?{ (untyped) -> untyped } -> untyped

  def mkdir: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def rmdir: () -> untyped

  def opendir: () { (?) -> untyped } -> untyped

  def unlink: () -> untyped

  alias delete unlink
end

module Kernel
  def self?.Pathname: (untyped path) -> untyped
end
