# ObjectSpace: the weak maps, the finalizers, and the walk over the heap.
module ObjectSpace
  # Keys and values kept weakly, compared by identity.
  class WeakMap
    @table: untyped

    include Enumerable

    def self.allocate: () -> untyped

    def initialize: () -> void

    def []: (untyped key) -> untyped

    def []=: (untyped key, untyped value) -> untyped

    def key?: (untyped key) -> untyped

    alias include? key?

    alias member? key?

    def size: () -> untyped

    alias length size

    def keys: () -> untyped

    def values: () -> untyped

    def delete: (untyped key) ?{ (untyped) -> untyped } -> untyped

    # wmap_each and its kin yield with no enumerator: no block is a
    # LocalJumpError.
    def each: () ?{ (?) -> untyped } -> self

    alias each_pair each

    def each_key: () ?{ (?) -> untyped } -> self

    def each_value: () ?{ (?) -> untyped } -> self

    def inspect: () -> ::String

    # A special value by `inspect`, an object by its address form.
    def self.show: (untyped value) -> untyped
  end

  # Keys kept weakly and compared by `eql?`; values kept strongly.
  class WeakKeyMap
    @table: untyped

    # A value the collector never reclaims cannot be a weak key: the
    # immediates, and the numbers and symbols that live as long as the
    # program does.
    UNCOLLECTABLE: ::Array[untyped]

    def initialize: () -> void

    def []: (untyped key) -> untyped

    def []=: (untyped key, untyped value) -> untyped

    def key?: (untyped key) -> untyped

    def getkey: (untyped key) -> (untyped | nil)

    def delete: (untyped key) ?{ (untyped) -> untyped } -> untyped

    def clear: () -> self

    def inspect: () -> ::String
  end

  # The proc runs with the object's id once the object is collected,
  # or when the program ends.
  def self?.define_finalizer: (untyped obj, ?untyped? callable) { (?) -> untyped } -> ::Array[0 | untyped]

  def self?.undefine_finalizer: (untyped obj) -> untyped

  def self?.garbage_collect: (?full_mark: bool, ?immediate_mark: bool, ?immediate_sweep: bool) -> untyped

  def self?.each_object: (?untyped? mod) ?{ (untyped) -> untyped } -> untyped

  # CRuby's type names for the heap's type tags. This runtime gives a
  # separate tag to some objects that CRuby keeps as an object's own
  # type (an exception, a Proc), and the census counts them under CRuby's name.
  TYPE_NAMES: { 1 => :T_OBJECT, 2 => :T_CLASS, 3 => :T_MODULE, 4 => :T_FLOAT, 5 => :T_STRING, 31 => :T_REGEXP, 7 => :T_ARRAY, 8 => :T_HASH, 24 => :T_OBJECT, 27 => :T_DATA, 29 => :T_DATA, 30 => :T_DATA, 25 => :T_IMEMO, 26 => :T_IMEMO, 28 => :T_ICLASS }

  CENSUS_ORDER: ::Array[:T_OBJECT | :T_CLASS | :T_MODULE | :T_FLOAT | :T_STRING | :T_REGEXP | :T_ARRAY | :T_HASH | :T_DATA | :T_IMEMO | :T_ICLASS]

  # The ids of false, nil and true.
  SPECIAL_IDS: { 0 => false, 4 => nil, 20 => true }

  def self?.count_objects: (?::Hash[untyped, untyped] result) -> untyped

  # id2ref: an id that is a special constant's own word gives that
  # constant; any other names a cell. With more than one ractor, only a
  # shareable object comes back.
  def self?._id2ref: (untyped id) -> untyped

  # The constant whose word `id` is, in a one-item Array, or false for a
  # word that names a cell.
  def self?.immediate_of: (untyped id) -> (::Array[untyped] | false)
end
