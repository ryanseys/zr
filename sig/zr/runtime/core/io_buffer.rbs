# IO::Buffer: a window on bytes, either its own or a String's. A buffer
# made `for` a String keeps that String and reads and writes its bytes
# in place, which is what ruby means by "the string is locked for the
# duration of the block".
class IO
  class Buffer
    self.@announced: untyped

    @bytes: untyped

    @start: untyped

    @size: untyped

    @flags: untyped

    @mapping: untyped

    include Comparable

    PAGE_SIZE: 16384

    DEFAULT_SIZE: 65536

    EXTERNAL: 1

    INTERNAL: 2

    MAPPED: 4

    SHARED: 8

    SLICE: 16

    LOCKED: 32

    PRIVATE: 64

    READONLY: 128

    FILE: 256

    LITTLE_ENDIAN: 4

    BIG_ENDIAN: 8

    HOST_ENDIAN: untyped

    NETWORK_ENDIAN: untyped

    class AccessError < RuntimeError
    end

    class AllocationError < RuntimeError
    end

    class InvalidatedError < RuntimeError
    end

    class LockedError < RuntimeError
    end

    class MaskError < ArgumentError
    end

    # Each data type: its width in bytes, whether it is signed, whether
    # the low byte comes first, and whether it is a Float. An uppercase
    # name is network order, a lowercase one the host's.
    TYPES: { U8: ::Array[1 | false], S8: ::Array[1 | true | false], U16: ::Array[2 | false], S16: ::Array[2 | true | false], U32: ::Array[4 | false], S32: ::Array[4 | true | false], U64: ::Array[8 | false], S64: ::Array[8 | true | false], u16: ::Array[2 | false | true], s16: ::Array[2 | true | false], u32: ::Array[4 | false | true], s32: ::Array[4 | true | false], u64: ::Array[8 | false | true], s64: ::Array[8 | true | false], U128: ::Array[16 | false], S128: ::Array[16 | true | false], u128: ::Array[16 | false | true], s128: ::Array[16 | true | false], F32: ::Array[4 | true | false], F64: ::Array[8 | true | false], f32: ::Array[4 | true], f64: ::Array[8 | true] }

    def self.size_of: (untyped type) -> untyped

    # Ruby says once per process that the class may still change, when
    # the experimental category is on at that first time.
    def self.announce: () -> (nil | untyped)

    def self.row: (untyped type) -> untyped

    # `for` shares the String's bytes. Without a block the window is
    # read-only; with one it is writable for the length of the block.
    def self.for: (untyped string) ?{ (untyped) -> untyped } -> untyped

    # The String a block filled, which is how ruby builds one.
    def self.string: (untyped length) { (untyped) -> untyped } -> untyped

    # A window on a file's bytes, as mmap gives one. The bytes are read in
    # when the map is made; a shared mapping writes each change back to
    # the file at once, and a private one keeps its changes to itself.
    def self.map: (untyped file, ?untyped? size, ?::Integer offset, ?::Integer flags) -> untyped

    def initialize: (?untyped size, ?::Integer flags) -> void

    attr_reader size: untyped

    # A copy owns its bytes, so it is writable even when the original
    # is a read-only window on a String.
    def initialize_copy: (untyped other) -> self

    def external?: () -> untyped

    def internal?: () -> untyped

    def mapped?: () -> untyped

    def shared?: () -> untyped

    def private?: () -> untyped

    def readonly?: () -> untyped

    def locked?: () -> untyped

    # A buffer stays valid over `free` and `transfer`; only a mapping
    # that went away makes one invalid.
    def valid?: () -> true

    def null?: () -> untyped

    def empty?: () -> untyped

    # A freed buffer keeps its object and lets go of its bytes.
    def free: () -> self

    def locked: () { (untyped) -> untyped } -> untyped

    def resize: (untyped size) -> self

    # A window on the same bytes, offset into this one.
    def slice: (?::Integer offset, ?untyped? length) -> untyped

    def get_string: (?::Integer offset, ?untyped? length, ?untyped encoding) -> untyped

    def set_string: (untyped string, ?::Integer offset, ?untyped? length, ?::Integer source_offset) -> untyped

    def get_value: (untyped type, untyped offset) -> untyped

    private

    # An Integer for a type of `width` bytes, checked as CRuby's NUM2ULL,
    # NUM2LL, NUM2UINT and NUM2INT check it: 8 bytes as a long long, the
    # narrower types as an int (and then their bytes wrap).
    def integer_value: (untyped n, untyped width, untyped signed) -> untyped

    public

    def set_value: (untyped type, untyped offset, untyped value) -> untyped

    def get_values: (untyped types, ?::Integer offset) -> untyped

    def set_values: (untyped types, untyped offset, untyped values) -> untyped

    # `each` walks one type across the window and gives the offset next
    # to each value; `values` returns only the values.
    def each: (?::Symbol type, ?::Integer offset, ?untyped? count) ?{ (untyped, untyped) -> untyped } -> (untyped | self)

    def values: (?::Symbol type, ?::Integer offset, ?untyped? count) -> untyped

    def each_byte: (?::Integer offset, ?untyped? count) ?{ (untyped) -> untyped } -> untyped

    def clear: (?::Integer value, ?::Integer offset, ?untyped? length) -> self

    # `copy` reads from `source` into this buffer.
    def copy: (untyped source, ?::Integer offset, ?untyped? length, ?::Integer source_offset) -> untyped

    def <=>: (untyped other) -> untyped

    def &: (untyped other) -> untyped

    def |: (untyped other) -> untyped

    def ^: (untyped other) -> untyped

    def ~: () -> untyped

    def and!: (untyped other) -> untyped

    def or!: (untyped other) -> untyped

    def xor!: (untyped other) -> untyped

    def not!: () -> self

    # rb_io_buffer_read and the related methods. A non-blocking fiber gives
    # the transfer to its scheduler's hook when the scheduler has one.
    # Otherwise the system call runs over the rest of the buffer, again
    # until at least `length` bytes have moved or the stream ends. A
    # `length` of zero is exactly one call. Each returns the bytes moved,
    # or the negative errno. The p-forms take a file position and do not
    # move the stream's own position.
    def read: (untyped io, ?untyped? length, ?untyped? offset) -> untyped

    def pread: (untyped io, untyped from, ?untyped? length, ?untyped? offset) -> untyped

    def write: (untyped io, ?untyped? length, ?untyped? offset) -> untyped

    def pwrite: (untyped io, untyped from, ?untyped? length, ?untyped? offset) -> untyped

    # rb_io_buffer_new over memory that the runtime lends a scheduler hook:
    # locked while the hook has it, and freed when the hook returns.
    def self.lent: (untyped bytes, ?readonly: bool) { (untyped) -> untyped } -> untyped

    def self.io_of: (untyped io) -> untyped

    def transfer: () -> untyped

    # The header ruby shows: the address, the size, and the flags that
    # are set. A window on nothing shows NULL alone.
    def to_s: () -> ::String

    # The bytes go under the header, up to the first 256 of them.
    def inspect: () -> (untyped | ::String)

    # 16 bytes a row: the offset, the bytes in hex in a column of a
    # fixed width, then the printable text.
    def hexdump: (?::Integer offset, ?untyped? length, ?::Integer width, ?untyped base) -> untyped

    private

    # The length and the offset a transfer names, and the length the
    # offset leaves where it names none.
    def extent: (untyped length, untyped offset) -> ::Array[untyped]

    # The system call the block makes at each place in turn, until
    # `length` bytes moved or one moved none: the bytes moved, or the
    # negative errno of the call that failed.
    def moved: (untyped length, untyped offset) { (untyped) -> untyped } -> untyped

    # What a read gave, set in at `at`: its length, 0 at the end, or the
    # negative errno as it came.
    def taken: (untyped chunk, untyped at) -> (untyped | 0)

    # rb_io_buffer_free_locked.
    def release: () -> untyped

    def external: (untyped string, untyped readonly) -> self

    def window: (untyped bytes, untyped start, untyped size, untyped flags, ?untyped? mapping) -> self

    # io_buffer_map_file: the file's bytes from `offset`, and where they
    # go back to when the mapping is shared and writable.
    def mapped: (untyped file, untyped size, untyped offset, untyped flags) -> self

    # A change to a shared mapping reaches the file, as it would through
    # the pages that mmap shares with the file.
    def written: (untyped offset, untyped length) -> (nil | untyped)

    def allocate_like: () -> untyped

    def writable: () -> untyped

    def bounds: (untyped offset, untyped length, ?untyped? type) -> (nil | untyped)

    # A mask repeats over the buffer, so a shorter one is fine and only
    # an empty one is refused.
    def mask: (untyped other) -> untyped

    def combine: (untyped other) { (?) -> untyped } -> untyped

    def in_place: (untyped other) { (?) -> untyped } -> self

    def masked: (untyped other) { (untyped, untyped) -> untyped } -> untyped
  end
end
