# The constants and globals that describe the running program.
RUBY_VERSION: "4.0.7"

RUBY_ENGINE: "ruby"

RUBY_ENGINE_VERSION: "4.0.7"

RUBY_PLATFORM: untyped

RUBY_PATCHLEVEL: 0

RUBY_RELEASE_DATE: "2026-09-15"

RUBY_REVISION: "229531a6cfbf07e3caef30dbac24a2a3f3fed482"

RUBY_COPYRIGHT: "ruby - Copyright (C) 1993-2026 Yukihiro Matsumoto"

RUBY_DESCRIPTION: ::String

# rubygems loads rbconfig before the program starts, and rbconfig says
# this ruby is not a cross-compiling one.
CROSS_COMPILING: nil

ARGV: untyped

# The process environment, read and written through libSystem.
ENV: untyped

module Kernel
  # The directory of the caller's file, absolute.
  def __dir__: () -> (nil | untyped)
end

# CRuby's module functions of Kernel: the same methods, public on
# Kernel itself.
module Kernel
  private

  # rubygems, which ruby loads as it starts, puts its own Ruby method in
  # Kernel#require, and Kernel.require stays the C one.
  def require: (untyped path) -> untyped
end

class Object
  # The kind of file that a require of `feature` would read, and its real
  # path, or nil when no directory on the path contains it. A name that
  # already ends in `.rb` is looked for as it is.
  def self.resolve_feature_path: (untyped feature) -> (::Array[untyped] | nil)

  extend Enumerable

  # env_str_new: what the environment gives is frozen.
  def self.[]: (untyped name) -> untyped

  def self.fetch: (*untyped args) ?{ (untyped) -> untyped } -> untyped

  # ruby_setenv: a name that setenv(3) refuses raises its error, and an
  # unsetenv(3) that fails is quiet.
  def self.[]=: (untyped name, untyped value) -> untyped

  alias self.store self.[]=

  # The value removed; a block gives the value for a name that was not set.
  def self.delete: (untyped name) ?{ (untyped) -> untyped } -> untyped

  def self.key?: (untyped name) -> untyped

  alias self.has_key? self.key?

  alias self.include? self.key?

  alias self.member? self.key?

  def self.each: () ?{ (untyped, untyped) -> untyped } -> (untyped | self)

  alias self.each_pair self.each

  def self.each_key: () ?{ (?) -> untyped } -> (untyped | self)

  def self.each_value: () ?{ (?) -> untyped } -> (untyped | self)

  def self.to_h: () ?{ (?) -> untyped } -> untyped

  alias self.to_hash self.to_h

  def self.keys: () -> untyped

  def self.values: () -> untyped

  def self.size: () -> untyped

  alias self.length self.size

  def self.empty?: () -> untyped

  def self.key: (untyped value) -> untyped

  def self.values_at: (*untyped names) -> untyped

  # Each name is read as a name, so a Symbol refuses here rather than
  # quietly missing.
  def self.slice: (*untyped names) -> untyped

  def self.assoc: (untyped name) -> untyped

  # A value that is not a String names nothing, which is not an error.
  def self.rassoc: (untyped value) -> (nil | untyped)

  def self.select: () { (?) -> untyped } -> untyped

  alias self.filter self.select

  def self.reject: () { (?) -> untyped } -> untyped

  def self.update: (*untyped others) ?{ (untyped, untyped, untyped) -> untyped } -> self

  alias self.merge! self.update

  def self.clear: () -> self

  # A value that is not String-like matches nothing: nil, as env_has_value
  # returns.
  def self.value?: (untyped value) -> (nil | untyped)

  alias self.has_value? self.value?

  def self.invert: () -> untyped

  def self.rehash: () -> nil

  def self.except: (*untyped names) -> untyped

  def self.reject!: () ?{ (untyped, untyped) -> untyped } -> untyped

  def self.delete_if: () ?{ (?) -> untyped } -> (untyped | self)

  def self.select!: () ?{ (untyped, untyped) -> untyped } -> untyped

  alias self.filter! self.select!

  def self.keep_if: () ?{ (?) -> untyped } -> (untyped | self)

  # The names that the Hash gives are set, each checked as it is. Every
  # other name is removed, as env_replace leaves the environment.
  def self.replace: (untyped given) -> self

  def self.shift: () -> untyped

  def self.inspect: () -> untyped

  def self.to_s: () -> untyped

  # ENV is the process environment itself, so there is nothing to copy
  # or to hold still.
  def self.dup: () -> untyped

  def self.clone: (?freeze: untyped?) -> untyped

  def self.freeze: () -> untyped

  private

  # A name or a value as the environment stores it: a String with no NUL
  # byte, because the C environment cannot contain one.
  def self.variable_name: (untyped value, ?untyped role) -> untyped

  public
end
