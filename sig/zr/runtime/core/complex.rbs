# Complex: a real and an imaginary part, each an Integer, Float or
# Rational, kept in hidden ivars as in CRuby's hidden fields.
class Complex < Numeric
  self.@forms: untyped

  private

  def self.build: (untyped real, untyped imag) -> untyped

  # safe_mul: a finite Float times an exact or Float zero is that zero
  # with the Float's sign, as is an infinite one.
  def self.safe_mul: (untyped a, untyped b, untyped az, untyped bz) -> untyped

  # nucomp_real_check: a real number, or a Complex whose imaginary part
  # is zero, as its real part. Else "not a real".
  def self.real_part_of: (untyped num) -> untyped

  public

  def self.rectangular: (untyped real, ?::Integer imag) -> untyped

  alias self.rect self.rectangular

  # CRuby's f_complex_polar: the exact quarter turns stay exact.
  def self.polar: (untyped radius, ?::Integer theta) -> untyped

  private

  # A value of any numeric kind as a Complex, as Kernel#Complex reads
  # it; nil when `exception` is false and it cannot be.
  def self.convert: (untyped value, untyped exception) -> (nil | untyped)

  public

  # A real number's text, as a pattern piece (a String, so the core
  # loads without the regexp engine).
  NUMBER: "[-+]?(?:\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*)?(?:[eE][-+]?\\d+)?(?:\\/\\d+(?:_\\d+)*)?)"

  private

  # The forms in which a Complex is written (the imaginary unit is any
  # of i, I, j and J, as read_comp takes it), compiled on first use (a
  # constant would call the engine at boot).
  def self.forms: () -> untyped

  public

  private

  # "1+2i", "3i", "-i", "2.5", "1/2+3/4i", "1@2" (polar).
  def self.parse: (untyped text, untyped exception) -> (untyped | nil)

  # read_rat reads a denominator as an integer and divides as soon as it
  # has one, so "1/0.0" and "1/0x2" divide by zero before the rest of
  # the text fails to parse.
  def self.zero_denominator: (untyped body) -> (nil | untyped)

  def self.leading: (untyped text) -> untyped

  def self.real_part: (untyped digits) -> untyped

  public

  I: untyped

  def real: () -> untyped

  def imaginary: () -> untyped

  alias imag imaginary

  def real?: () -> false

  def rectangular: () -> ::Array[untyped]

  alias rect rectangular

  # Exact along an axis, as CRuby keeps it: a Float on the other axis
  # changes only the type of the result to Float.
  def abs: () -> untyped

  alias magnitude abs

  def abs2: () -> untyped

  def arg: () -> untyped

  alias angle arg

  alias phase arg

  def polar: () -> ::Array[untyped]

  def conjugate: () -> untyped

  alias conj conjugate

  def -@: () -> untyped

  def +: (untyped other) -> untyped

  def -: (untyped other) -> untyped

  # comp_mul: each product through safe_mul, so an infinite part times a
  # zero part is a signed zero, not NaN.
  def *: (untyped other) -> untyped

  # CRuby's f_divide with quo: scaled by the larger component of the
  # divisor, exact parts canonicalized back to Integers.
  def /: (untyped other) -> untyped

  alias quo /

  def fdiv: (untyped other) -> untyped

  def **: (untyped other) -> untyped

  def ==: (untyped other) -> untyped

  def <=>: (untyped other) -> (nil | untyped)

  def eql?: (untyped other) -> untyped

  def hash: () -> untyped

  def coerce: (untyped other) -> untyped

  # Over the common denominator of both parts.
  def denominator: () -> untyped

  def numerator: () -> untyped

  def finite?: () -> untyped

  def infinite?: () -> (nil | 1)

  def to_c: () -> self

  def to_i: () -> untyped

  def to_f: () -> untyped

  # nucomp_to_r: unlike to_f and to_i, a Float zero imaginary part is real.
  def to_r: () -> untyped

  def rationalize: (?untyped? eps) -> untyped

  def to_s: () -> untyped

  def inspect: () -> untyped

  # f_format: `a+bi`, each part as `form` writes it -- rb_String for
  # `to_s`, rb_inspect for `inspect` -- and the text takes the encoding
  # the real part's does.
  def formatted: (untyped form) -> untyped

  # CRuby's f_signbit: a Float shows its own sign bit, so -0.0 takes
  # the minus and a NaN does not. Any other value is checked with `< 0`.
  def sign_bit?: (untyped v) -> untyped

  private

  def part_text: (untyped x, untyped form) -> untyped

  def exact_real?: () -> untyped

  # A Rational that is whole becomes its Integer.
  def canonical: (untyped x) -> untyped
end

module Kernel
  private

  def self?.Complex: (untyped real, *untyped rest, ?exception: bool) -> (untyped | nil)
end

class Numeric
  def real?: () -> true

  def real: () -> self

  def imaginary: () -> 0

  alias imag imaginary

  def rectangular: () -> ::Array[self | 0]

  alias rect rectangular

  def conjugate: () -> self

  alias conj conjugate

  def abs2: () -> untyped

  def arg: () -> (untyped | 0)

  alias angle arg

  alias phase arg

  def polar: () -> ::Array[untyped]

  def i: () -> untyped

  def to_c: () -> untyped

  # A number's singleton is refused, as every Numeric is a value.
  def singleton_method_added: (untyped name) -> untyped
end

class Complex
end

class Float
  def arg: () -> (self | untyped)

  alias angle arg

  alias phase arg
end

class String
  # The longest leading text that reads as a Complex; 0 when none does.
  def to_c: () -> untyped
end

class NilClass
  def to_c: () -> untyped
end

class Complex
  private

  def marshal_dump: () -> ::Array[untyped]

  def marshal_load: (untyped pair) -> untyped
end
