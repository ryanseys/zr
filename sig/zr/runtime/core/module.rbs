# Module's comparisons over the ancestor chain, and the hooks a program
# may override, which do nothing here.
class Module
  private

  def included: (untyped base) -> nil

  def extended: (untyped base) -> nil

  def prepended: (untyped base) -> nil

  def method_added: (untyped name) -> nil

  def method_removed: (untyped name) -> nil

  def method_undefined: (untyped name) -> nil

  def const_added: (untyped name) -> nil

  public

  # Every argument is checked before any is spliced; then each module,
  # last first, splices itself through `append_features` and hears
  # `included`. Index loops over the kernel's length: the Array
  # iterators are not defined yet when the core's own includes run,
  # and a program may prepend over Array#size itself.
  def include: (*untyped modules) -> untyped

  def prepend: (*untyped modules) -> untyped

  private

  def mixin: (untyped modules, untyped splice, untyped hook) -> self

  public

  def <: (untyped other) -> (false | true | untyped)

  def <=: (untyped other) -> (true | untyped)

  def >: (untyped other) -> (false | untyped)

  def >=: (untyped other) -> (true | untyped)

  def <=>: (untyped other) -> (0 | nil | -1 | 1)
end

class Class
  private

  def inherited: (untyped subclass) -> nil
end

class BasicObject
  # CRuby names BasicObject inside itself too, so a class that inherits
  # from it alone still reaches the name.
  BasicObject: untyped

  private

  def singleton_method_added: (untyped name) -> nil

  def singleton_method_removed: (untyped name) -> nil

  def singleton_method_undefined: (untyped name) -> nil
end

module Kernel
  private

  # rb_obj_init_copy: a copy of itself is nothing to do, a frozen
  # receiver takes no copy, and the copy has to be of the same class.
  def initialize_copy: (untyped orig) -> self

  # nil shows every instance variable in `inspect`; an Array names
  # the ones to show.
  def instance_variables_to_inspect: () -> nil

  def initialize_dup: (untyped orig) -> untyped

  def initialize_clone: (untyped orig, ?freeze: untyped?) -> untyped
end

class Module
  private

  # A module's clone is its own row, as ruby keeps it.
  def initialize_clone: (untyped orig, ?freeze: untyped?) -> untyped
end

class Module
  @__refinements__: untyped

  @__activated__: untyped

  # A literal feature is resolved when the program is compiled; a
  # computed one is required when the constant is first read.
  def autoload: (untyped name, untyped feature) -> untyped

  private

  # A constant name as rb_to_id takes one: a Symbol, or a String or the
  # value of `to_str`.
  def autoload_name: (untyped name) -> untyped

  public

  # A String name may be a `::` path, a leading `::` starting at Object;
  # each segment after the first is read without Object's constants.
  def const_get: (untyped name, ?bool inherit) -> untyped

  def const_defined?: (untyped name, ?bool inherit) -> (untyped | false | true)

  def const_source_location: (untyped name, ?bool inherit) -> untyped

  # What a constant lookup reaches when no scope has the name. A
  # program overrides it to supply a value.
  def const_missing: (untyped name) -> untyped

  private

  # `refine C do ... end`: the methods go in a holder module, never on
  # C itself, so they stay invisible until a `using` of this module.
  def refine: (untyped target) ?{ (?) -> untyped } -> untyped

  public

  def refinements: () -> (untyped | ::Array[untyped])

  private

  # `using` does its work where it is written, which the compiler sees;
  # anywhere else it is the refusal.
  def using: (untyped mod) -> untyped

  # A Symbol, a String, or what to_str makes of the name.
  def const_name: (untyped name) -> untyped

  # Each segment of the path `name`, resolved by the block from the
  # scope before it, with a flag that tells whether an earlier segment
  # resolved. The last value is the return value.
  def walk_const_path: (untyped name, ?untyped segments) { (untyped, untyped, untyped) -> untyped } -> untyped
end

module Kernel
  private

  # On the class where the call is, as rb_f_autoload registers.
  def autoload: (untyped name, untyped feature) -> untyped

  def autoload?: (untyped name, ?bool inherit) -> untyped
end

# The holder that `Module#refine` makes. It has no name of its own; it
# shows the pair that it represents.
class Refinement
  def target: () -> untyped

  private

  # A module's OWN methods copied in at the visibility they were
  # declared with. Ruby copies rather than includes, so what the module
  # inherits stays out.
  def import_methods: (*untyped modules) -> self
end

# A class is not a module to mix in or to refine with: CRuby undefines
# these for Class. It comes last, after Module#refine.
class Class
end

class Object
  private

  # Only the compiler activates a refinement, where the source writes
  # the `using`; the method itself is the refusal every other spot gets.
  def self.using: (untyped mod) -> untyped

  public

  private

  public

  public

  public
end
