# The `Ruby` namespace represents the running ruby. `Ruby::Box` is a
# separate world inside the program: its own toplevel constants, its own
# globals, and its own patches to the shared classes. A box reads the
# shared world as the runtime had it when the program started, never
# with the program's later writes.
module Ruby
  VERSION: untyped

  ENGINE: untyped

  ENGINE_VERSION: untyped

  PLATFORM: untyped

  PATCHLEVEL: untyped

  RELEASE_DATE: untyped

  REVISION: untyped

  COPYRIGHT: untyped

  DESCRIPTION: untyped

  class Box < Module
    @slot: untyped

    @shadows: untyped

    @loaded: untyped

    @globals: untyped

    @load_path: untyped

    @main: untyped

    @cref: untyped

    # A loaded feature, which a box counts for itself.
    class Entry
    end

    # box.c's Loader: require, require_relative and load, each a private
    # method and a singleton method that marks the frame as a box's load
    # and passes the call on to Kernel's. Object includes it when boxes
    # are enabled.
    module Loader
      def self.require: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      def self.require_relative: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      def self.load: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      private

      def require: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      def require_relative: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

      def load: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped
    end

    def self.enabled?: () -> untyped

    # The box the running code belongs to. Ruby counts the box the
    # program itself runs in as one, so main is a box too.
    def self.current: () -> untyped

    def initialize: () -> void

    def eval: (untyped source) -> untyped

    def load_path: () -> untyped

    def require: (untyped feature) -> untyped

    def require_relative: (untyped feature) -> untyped

    def load: (untyped feature) -> untyped

    def inspect: () -> untyped

    private

    # The class that this box sees in place of a shared one: its own, with
    # the shared class under it, so the box reads what it does not patch
    # from there. A shared MODULE's replacement goes into every shadow
    # whose chain already includes the module.
    def __shadow__: (untyped shared) -> untyped

    # A shadow of a class inherits from it. A module has nothing to
    # inherit from, so the shadow INCLUDES it, which reaches the
    # module's methods and its constants the same way.
    def mint: (untyped shared) -> untyped

    # The snippet runs IN the box: what it defines, what it reads and
    # what it writes are the box's own until the call is over.
    def run: (untyped code, untyped _path) -> untyped

    # A file the box reads and runs for itself, so a feature main has
    # already loaded runs again here.
    def load_feature: (untyped feature, untyped once) -> (false | true)

    def resolve: (untyped feature) -> (untyped | nil)
  end
end

class Ruby::Box
  self.@main: untyped

  self.@root: untyped

  self.@master: untyped

  def main?: () -> untyped

  def root?: () -> untyped

  def master?: () -> untyped

  def self.main: () -> untyped

  def self.root: () -> untyped

  def self.master: () -> untyped

  # Module's singleton class has no allocate, so a box takes Class's.
  def self.reserved: (untyped kind, untyped id, untyped tail) -> untyped
end

class Object
  include Ruby::Box::Loader
end
