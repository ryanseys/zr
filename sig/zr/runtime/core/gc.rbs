# The collector as Ruby sees it: one heap, collected on demand. CRuby
# writes most of GC in Ruby (its gc.rb), so those methods return their
# own parameters, under CRuby's names.
module GC
  self.@measure_total_time: untyped

  def self.start: (?full_mark: bool, ?immediate_mark: bool, ?immediate_sweep: bool) -> untyped

  def self.count: () -> untyped

  def self.disable: () -> untyped

  def self.enable: () -> untyped

  # A number sets CRuby's stress flags; this collector reads it as on,
  # and returns the number it was given, as ruby does.
  STRESS: ::Array[nil]

  def self.stress: () -> untyped

  def self.stress=: (untyped flag) -> untyped

  # Every key that CRuby's collector returns, in its order. One arena here
  # is a page, and nothing is moved or finalized later. `zr_collect`
  # decides whether a collection is minor or major. The counts and the two
  # phase times show which ran and what each cost. The trace and the sweep
  # are measured separately because a minor collection traces only the
  # young objects, but its sweep still walks every arena.
  def self.stat: (?untyped? hash_or_key) -> untyped

  def self.counter: (untyped key) -> untyped

  # The one collector here runs a full mark and sweep every time.
  def self.latest_gc_info: (?untyped? hash_or_key) -> untyped

  # The switch that a program reads before it requests a report. The
  # collector keeps no per-run records, so the report is empty.
  module Profiler
    self.@enabled: untyped

    def self.enable: () -> nil

    def self.disable: () -> nil

    def self.enabled?: () -> untyped

    def self.clear: () -> nil

    def self.total_time: () -> ::Float

    def self.result: () -> untyped

    # The rows of each run since the profiler was enabled: this
    # collector keeps none, so the list is empty.
    def self.raw_data: () -> (::Array[untyped] | nil)

    def self.report: (?untyped out) -> nil
  end

  # The build options CRuby reports; this collector is built with none
  # of its own to add.
  OPTS: ::Array["USE_RGENGC" | "RGENGC_ESTIMATE_OLDMALLOC" | "GC_ENABLE_LAZY_SWEEP" | "GC_COMPACTION_SUPPORTED"]

  # The heap's own sizes: cells of 32 to 256 bytes in 4 MiB arenas.
  INTERNAL_CONSTANTS: { DEBUG: false, BASE_SLOT_SIZE: 32, RBASIC_SIZE: 16, RVALUE_OVERHEAD: 0, HEAP_PAGE_OBJ_LIMIT: 131064, HEAP_PAGE_BITMAP_SIZE: 16384, HEAP_PAGE_SIZE: 4194304, HEAP_COUNT: 5, RVARGC_MAX_ALLOCATE_SIZE: 256, RVALUE_OLD_AGE: 3 }

  # Nothing moves here, so a compaction considers no object at all.
  def self.compact: () -> untyped

  def self.latest_compact_info: () -> { considered: ::Hash[untyped, untyped], moved: ::Hash[untyped, untyped], moved_up: ::Hash[untyped, untyped], moved_down: ::Hash[untyped, untyped] }

  def self.verify_compaction_references: (?toward: untyped?, ?double_heap: bool, ?expand_heap: bool) -> untyped

  # Nothing moves here, but the switch keeps what it is set to.
  AUTO_COMPACT: ::Array[false]

  def self.auto_compact: () -> untyped

  def self.auto_compact=: (untyped flag) -> untyped

  def self.verify_internal_consistency: () -> nil

  # The nanoseconds the collector has spent, measured on the monotonic
  # clock around every mark and sweep.
  def self.total_time: () -> untyped

  def self.measure_total_time: () -> untyped

  def self.measure_total_time=: (untyped flag) -> untyped

  CONFIG: { rgengc_allow_full_mark: true }

  # The one setting CRuby's default collector takes, kept as it is set.
  def self.config: (?untyped? hash) -> ::Hash[untyped | :implementation, untyped]

  # The four pools of 32, 64, 128 and 256-byte cells, and a fifth that
  # stays empty, so every pool index that ruby returns is valid here too.
  POOLS: 5

  # One pool's numbers, or every pool's under its index, as
  # rb_gc_impl_stat_heap returns them: into the Hash given, or one of
  # them by name.
  def self.stat_heap: (?untyped? heap_name, ?untyped? hash_or_key) -> untyped

  # Pool `pool`'s numbers written into `out`, in CRuby's key order. An
  # arena here is a page; nothing waits to be finalized or forces a
  # major collection.
  def self.pool_stats: (untyped pool, untyped out) -> untyped

  def garbage_collect: (?full_mark: bool, ?immediate_mark: bool, ?immediate_sweep: bool) -> untyped
end

module Process
  def self?.pid: () -> untyped

  def self?.clock_gettime: (untyped id, ?::Symbol unit) -> untyped

  def self?.clock_getres: (untyped id, ?::Symbol unit) -> untyped

  def self?.uid: () -> untyped

  def self?.euid: () -> untyped

  def self?.gid: () -> untyped

  def self?.egid: () -> untyped

  # A clock is a raw id or the name of one of this module's own CLOCK_
  # constants. The symbol spelling is the portable one: a platform that
  # does not have the clock raises a rescuable Errno::EINVAL here, not a
  # NameError at the constant read. An OS whose clocks ruby identifies
  # with Symbols (WASI) maps each to its id in CLOCK_IDS.
  def self.clock_id: (untyped id, untyped verb) -> untyped

  def self.in_unit: (untyped ns, untyped unit) -> untyped
end
