# Integers past the fixnum range. A bignum is a plain object of class
# Integer whose magnitude is a little-endian Array of base-2^30 limbs
# and whose sign is a flag, both in hidden instance variables; every
# value that fits a fixnum is one. The kernel's fixnum builtins route
# here (`big_op`) when either side is a bignum.
class Integer
  LIMB_BITS: 30

  LIMB_BASE: untyped

  LIMB_MASK: untyped

  # A bignum from a 64-bit word split as `high << 32 | low` by the
  # kernel, for a fixnum sum or difference that overflowed.
  def self.big_from_word: (untyped high, untyped low) -> untyped

  # A bignum from a Float past the fixnum range.
  def self.big_from_float: (untyped f) -> untyped

  # The digits of a literal or a String, in `base`, already checked.
  def self.big_parse: (untyped text, ?::Integer base) -> untyped

  def self.big_build: (untyped neg, untyped mag) -> (0 | untyped)

  # `n.bit_length` for a bignum `n`: the limbs below the top one are
  # full, and the top one's own bits count; a negative reads through
  # its complement, as a fixnum's does.
  def self.big_bit_length: (untyped n) -> untyped

  # Bit `bit` of a bignum `n` (`n[bit]`): a limb's bit for one at or
  # above zero, the shift for one below, whose bits are its
  # complement's.
  def self.big_bit_at: (untyped n, untyped bit) -> (untyped | 0)

  # The limbs of |n|, n any Integer.
  def self.big_mag: (untyped n) -> untyped

  def self.big_neg?: (untyped n) -> untyped

  # The limbs of a non-negative fixnum.
  def self.big_limbs_of: (untyped n) -> untyped

  def self.big_negate: (untyped n) -> untyped

  def self.big_cmp_mag: (untyped a, untyped b) -> untyped

  def self.big_add_mag: (untyped a, untyped b) -> untyped

  # `a - b` for a >= b.
  def self.big_sub_mag: (untyped a, untyped b) -> untyped

  def self.big_mul_mag: (untyped a, untyped b) -> untyped

  # `a * m` for a fixnum m below the limb base.
  def self.big_mul_small_mag: (untyped a, untyped m) -> untyped

  # `[quotient, remainder]` of a magnitude by a fixnum above zero and
  # below the limb base; the remainder is a fixnum.
  def self.big_divmod_small_mag: (untyped a, untyped m) -> untyped

  # `[quotient, remainder]` magnitudes, by Knuth's algorithm D for a
  # divisor of two limbs or more.
  def self.big_divmod_mag: (untyped a, untyped b) -> (::Array[::Array[untyped] | untyped] | ::Array[untyped] | untyped)

  # A magnitude shifted left `bits` (any count) or right (below the
  # limb width, bits lost).
  def self.big_shl_mag: (untyped a, untyped bits) -> untyped

  def self.big_shr_mag: (untyped a, untyped bits) -> untyped

  def self.big_add: (untyped x, untyped y) -> untyped

  def self.big_sub: (untyped x, untyped y) -> untyped

  def self.big_mul: (untyped x, untyped y) -> untyped

  # Floored `[quotient, remainder]`, the remainder taking the
  # divisor's sign.
  def self.big_divmod: (untyped x, untyped y) -> untyped

  def self.big_shl: (untyped x, untyped bits) -> untyped

  # A right shift floors: a negative value with lost bits moves one
  # further from zero.
  def self.big_shr: (untyped x, untyped bits) -> untyped

  def self.big_cmp: (untyped x, untyped y) -> untyped

  # Bitwise operations run over two's complement limbs, with the sign
  # represented by an infinite run of ones.
  def self.big_twos: (untyped x, untyped len) -> untyped

  def self.big_from_twos: (untyped limbs, untyped neg) -> untyped

  def self.big_bitwise: (untyped x, untyped y, untyped op) -> untyped

  # Digits in `base`, by repeated division with the largest power of
  # the base below the limb base.
  def self.big_to_s: (untyped x, untyped base) -> untyped

  # The nearest double: the top 62 bits with a sticky bit for the
  # rest, scaled by the bits dropped, so the one rounding is right.
  def self.big_to_f: (untyped x) -> untyped

  # `x << n` when `left`, else `x >> n`. A Bignum count moves every bit:
  # out to the right it leaves 0, or -1 below zero; to the left only
  # zero can go, as CRuby's rb_int_lshift decides.
  def self.big_shift: (untyped x, untyped n, untyped left) -> (untyped | 0)

  # An exact comparison with a Float: through its integer part, then
  # its fraction.
  def self.big_cmp_float: (untyped x, untyped f) -> (nil | untyped)

  # The kernel's route for a fixnum builtin whose receiver or operand
  # is a bignum: `op` is the builtin's name, `args` its arguments.
  def big_op: (untyped op, *untyped args) ?{ (untyped) -> untyped } -> untyped

  private

  def big_binary: (untyped op, untyped other) -> (untyped | false)

  def big_with_integer: (untyped op, untyped other) -> untyped
end
