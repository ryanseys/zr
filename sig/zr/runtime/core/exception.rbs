# The exception classes other than the ones the kernel raises itself,
# and the methods that describe an exception.
class Exception
  @locations: untyped

  # An attribute that a caller can leave out. The reader then refuses
  # rather than returning nil.
  UNSET: untyped

  # Not the core's own `new`: an `initialize` that the program wrote for a
  # core exception class runs, as ruby's rb_class_new_instance finds it.
  def self.exception: (*untyped args) -> untyped

  # Whether the report an uncaught error prints goes to a terminal.
  def self.to_tty?: () -> untyped

  def message: () -> untyped

  def to_s: () -> untyped

  # `exception(msg)`: this exception, or a clone with the message `msg`.
  def exception: (*untyped args) -> (self | untyped)

  # Ruby compares the message a raise STORED, not the one `to_s`
  # builds, so two uncaught throws of different tags are equal.
  def ==: (untyped other) -> (true | false | untyped)

  def detailed_message: (?highlight: untyped?, **untyped) -> untyped

  # exc_full_message: the report that ruby prints for an uncaught error.
  # All keywords go on to `detailed_message`.
  def full_message: (**untyped opt) -> untyped

  # The backtrace entries that the raise saw, as Location objects: nil
  # before a raise, and unchanged when set_backtrace replaces the
  # strings. Locations given to set_backtrace are used for both.
  def backtrace_locations: () -> (untyped | nil)

  # An Array of Locations sets the locations as well as the strings, as
  # exc_set_backtrace does.
  def set_backtrace: (untyped backtrace) -> untyped

  private

  BOLD: "\e[1m"

  UNDERLINE: "\e[1;4m"

  RESET: "\e[m"

  # rb_ec_error_print: the report of an error that ends the program or
  # a thread, as a String. `stop` is an exception already reported,
  # which the cause chain does not repeat.
  def uncaught_report: (untyped stop) -> untyped

  # rb_get_backtrace: the backtrace, from an override when there is one.
  def report_backtrace: (untyped exc) -> untyped

  # rb_get_detailed_message: a String, or nil.
  def report_message: (untyped exc, untyped opt) -> untyped

  # rb_error_write: the head line, the `from` trail, then the chain of
  # causes, each one once. `:bottom` puts a banner first, numbers the
  # trail and turns the whole report around. `pos` heads an exception
  # with no backtrace.
  def error_write: (untyped out, untyped opt, untyped errat, untyped emesg, untyped highlight, untyped bottom, untyped pos, untyped shown) -> untyped

  def write_one: (untyped out, untyped exc, untyped opt, untyped errat, untyped emesg, untyped highlight, untyped bottom, untyped pos, untyped shown) -> untyped

  def show_cause: (untyped out, untyped exc, untyped opt, untyped highlight, untyped bottom, untyped pos, untyped shown) -> (nil | untyped)

  # The head line: the first frame, the message, or the class for an
  # empty one.
  def print_errinfo: (untyped out, untyped exc, untyped errat, untyped emesg, untyped highlight, untyped pos) -> untyped

  # The frames under the head. A deep SystemStackError shows its first
  # 9 and last 4 frames.
  def print_backtrace: (untyped out, untyped exc, untyped errat, untyped bottom) -> (nil | untyped)

  # Ruby's `rb_decorate_message`: the class rides on the message's first
  # line, and an empty message is the class alone.
  def decorate: (untyped text, untyped highlight) -> untyped

  # setup_exception under $DEBUG: each raise tells $stderr the class,
  # the place of the raise and the message, rescued or not.
  # `raised` holds the place of the raise as its first frame.
  def debug_report: (untyped raised) -> untyped

  def checked_highlight: (untyped value, untyped tty) -> untyped

  def checked_order: (untyped value) -> (false | true | untyped)
end

class NoMemoryError < Exception
end

# Ruby defines these two on Exception itself, so its own reflection
# shows them; each behaves as the method it is in place of.
class Exception
  private

  def method_missing: (untyped name, *untyped args) { (?) -> untyped } -> untyped

  public

  def respond_to_missing?: (untyped name, untyped include_private) -> untyped
end

class ScriptError < Exception
end

class LoadError < ScriptError
  # The feature a require could not load, which CRuby keeps where a
  # program sees it.
  def path: () -> untyped
end

class NotImplementedError < ScriptError
end

class SyntaxError < ScriptError
  # The file the error was read from, which only ruby's own parser
  # fills in, where a program sees it.
  def path: () -> untyped

  def initialize: (?::String message) -> void
end

class SecurityError < Exception
end

class SignalException < Exception
end

class Interrupt < SignalException
end

class SystemExit < Exception
  @status: untyped

  attr_reader status: untyped

  def initialize: (*untyped args) -> void

  def success?: () -> untyped
end

class UncaughtThrowError < ArgumentError
  @tag: untyped

  @value: untyped

  attr_reader tag: untyped

  attr_reader value: untyped

  # The stored message is ruby's own format string; `to_s` puts the tag
  # in. So two throws have the same message.
  def initialize: (untyped tag, untyped value, ?untyped message) -> void

  def to_s: () -> untyped
end

class EncodingError < StandardError
end

class FiberError < StandardError
end

class IOError < StandardError
end

class EOFError < IOError
end

class StopIteration < IndexError
  def result: () -> untyped
end

class ClosedQueueError < StopIteration
end

class NoMatchingPatternError < StandardError
end

class NoMatchingPatternKeyError < NoMatchingPatternError
  def initialize: (?untyped? message, **untyped options) -> void

  def matchee: () -> untyped

  def key: () -> untyped
end

class RangeError < StandardError
end

class FloatDomainError < RangeError
end

module Math
  class DomainError < StandardError
  end
end

class RegexpError < StandardError
end

class SystemCallError < StandardError
end

class ThreadError < StandardError
end

class NameError
  @name: untyped

  @receiver: untyped

  attr_reader name: untyped

  def initialize: (?untyped? message, ?untyped? name, ?receiver: untyped) -> void

  def receiver: () -> untyped

  # The locals of the scope the error was raised in; the lowering's own
  # have no name a program can spell.
  def local_variables: () -> untyped
end

class NoMethodError
  @args: untyped

  @private_call: untyped

  attr_reader args: untyped

  def initialize: (?untyped? message, ?untyped? name, ?untyped? args, ?bool private_call, ?receiver: untyped) -> void

  def private_call?: () -> untyped
end

class KeyError
  @receiver: untyped

  @key: untyped

  def initialize: (?untyped? message, ?receiver: untyped, ?key: untyped) -> void

  def key: () -> untyped

  def receiver: () -> untyped
end

class FrozenError
  @receiver: untyped

  def initialize: (?untyped? message, ?receiver: untyped) -> void

  def receiver: () -> untyped
end

# CRuby sets these two where a program sees them.
class LocalJumpError
  def exit_value: () -> untyped

  def reason: () -> untyped
end

class SignalException
  def signo: () -> untyped

  # A number gives its first signal in Signal.list; a name keeps its own
  # spelling, including an alias.
  def initialize: (?untyped? sig, ?untyped? message) -> void

  def signm: () -> untyped
end

class Interrupt
  def initialize: (?untyped message) -> void
end

class Thread
  class Backtrace
    # `--backtrace-limit`, which zr does not take: every row shows.
    def self.limit: () -> -1

    # One row of `caller_locations`, parsed from its `file:line:in
    # 'label'` form.
    class Location
      @path: untyped

      @lineno: untyped

      @label: untyped

      @row: untyped

      attr_reader path: untyped

      attr_reader lineno: untyped

      attr_reader label: untyped

      # `node_id` is the id of the prism node the row's line ran, which
      # RubyVM::AbstractSyntaxTree.node_id_for_backtrace_location reads.
      def initialize: (untyped row, ?::Integer node_id) -> void

      # The method's own name: no block prefix, no owner.
      def base_label: () -> untyped

      def absolute_path: () -> (untyped | nil)

      def to_s: () -> untyped

      def inspect: () -> untyped
    end
  end
end

module Kernel
  private

  # A Range selects from the locations outward from this method's
  # caller, as `caller_locations(0)[range]`.
  def caller_locations: (?::Integer start, ?untyped? length) -> (untyped | nil)
end

# ruby.c defines these before the gem prelude runs, which loads each
# library only where its module is defined.
module ErrorHighlight
end

module DidYouMean
end

module SyntaxSuggest
end
