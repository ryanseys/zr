# Child processes: `system`, backticks and Process.spawn over
# posix_spawn. A single command string goes through /bin/sh when it
# contains shell syntax or starts with a shell word; else its words run
# directly.
module Process
  SHELL_META: "*?{}[]<>()~&|\\$;'`\"\n#"

  SHELL_WORDS: ::Array["!" | "." | ":" | "break" | "case" | "continue" | "do" | "done" | "elif" | "else" | "esac" | "eval" | "exec" | "exit" | "export" | "fi" | "for" | "if" | "in" | "readonly" | "return" | "set" | "shift" | "then" | "times" | "trap" | "unset" | "until" | "while"]

  # A result from the kernel, or the errno that it gives in its place.
  def self.checked: (untyped result) -> untyped

  # waitpid(2) as rb_waitpid runs it: `[pid, status word]`, `[0, 0]` for
  # a WNOHANG child still running, or the negated errno. A thread among
  # others parks on the pipe SIGCHLD writes to between WNOHANG tries,
  # so its siblings run while the child does; the signal count taken
  # before each try tells a signal that came since from one drained.
  def self.reap: (untyped pid, untyped flags) -> untyped

  # The value that waitpid returned for a child.
  class Status
    @pid: untyped

    @to_i: untyped

    # An allocated status is pid 0 with a status word of 0.
    def self.allocate: () -> untyped

    attr_reader pid: untyped

    attr_reader to_i: untyped

    def initialize: (untyped pid, untyped raw) -> void

    # Process.wait's status and not its pid, leaving `$?` alone: nil
    # while a WNOHANG child still runs, and pid -1 when there is none to
    # wait for.
    def self.wait: (?::Integer pid, ?::Integer flags) -> untyped

    def exited?: () -> untyped

    def signaled?: () -> untyped

    def stopped?: () -> untyped

    def exitstatus: () -> (untyped | nil)

    def termsig: () -> (untyped | nil)

    def stopsig: () -> (untyped | nil)

    def coredump?: () -> untyped

    def success?: () -> (untyped | nil)

    def ==: (untyped other) -> untyped

    def to_s: () -> ::String

    def inspect: () -> untyped
  end

  # What a spawn's options set up for the child: `dups` are (child
  # descriptor, source descriptor) pairs applied in order, `closes` the
  # child's descriptors to close, and `opened` the parent's own streams
  # to close after the child has copies of them.
  class Redirects
    # The standard streams go into the child. All other descriptors of
    # the parent stay in the parent, so a pipe end that the parent keeps
    # cannot keep the child's own read open. An option that refers to
    # one of the three comes later and wins.
    @dups: untyped

    @closes: untyped

    @opened: untyped

    @chdir: untyped

    # -1 leaves the process group and the umask as they are.
    @pgroup: untyped

    @umask: untyped

    @limits: untyped

    STREAMS: { in: 0, out: 1, err: 2 }

    attr_reader dups: untyped

    attr_reader closes: untyped

    attr_reader opened: untyped

    attr_reader chdir: untyped

    attr_reader pgroup: untyped

    attr_reader umask: untyped

    attr_reader limits: untyped

    def initialize: (untyped options) -> void

    # Whether an option needs what only a forked child can do before
    # its exec.
    def forked?: () -> untyped

    # What zr_exec_options applies, in the order it reads them.
    def to_a: () -> ::Array[untyped]

    private

    # rb_execarg_addopt: each option once.
    def add: (untyped key, untyped value) -> untyped

    def pgroup_of: (untyped value) -> (-1 | 0 | untyped)

    # rb_execarg_addopt_rlimit: one limit for both, or [soft, hard].
    def add_limit: (untyped key, untyped value) -> untyped

    # The child's descriptors one option key names.
    def descriptors: (untyped key) -> untyped

    def redirect: (untyped fd, untyped value) -> untyped

    # `[:child, :out]` is the child's own descriptor, so the pair is
    # applied in the order the options list them.
    def from_array: (untyped fd, untyped value) -> untyped

    def dup2: (untyped fd, untyped source) -> untyped

    # A file that does not open closes the ones opened before it, and
    # the error names only the path, as ruby's child reports its open.
    def open_file: (untyped fd, untyped path, untyped mode, untyped perm) -> untyped

    def path_of: (untyped value) -> untyped
  end

  def self.spawn: (*untyped args, **untyped options) -> untyped

  def self?.wait: (?::Integer pid, ?::Integer flags) -> (nil | untyped)

  def self?.waitpid: (?::Integer pid, ?::Integer flags) -> untyped

  def self?.wait2: (?::Integer pid, ?::Integer flags) -> untyped

  def self?.waitpid2: (?::Integer pid, ?::Integer flags) -> untyped

  # Every child that is left, reaped: `[pid, status]` each.
  def self?.waitall: () -> untyped

  def self.last_status: () -> untyped

  def self?.ppid: () -> untyped

  # The process group and the session. Each call returns an id, and a
  # failure arrives as its errno.
  def self?.getpgrp: () -> untyped

  def self?.getpgid: (untyped pid) -> untyped

  def self?.setpgid: (untyped pid, untyped pgrp) -> untyped

  def self?.getsid: (?::Integer pid) -> untyped

  def self?.setsid: () -> untyped

  def self?.groups: () -> untyped

  # The group ids in a list identify groups by id or by name.
  def self?.groups=: (untyped list) -> untyped

  def self?.initgroups: (untyped user, untyped group) -> untyped

  # The maximum number of groups that `groups=` takes: the value that
  # sysconf returns, until a program sets fewer.
  def self?.maxgroups: () -> untyped

  def self?.maxgroups=: (untyped count) -> untyped

  def self?.setpgrp: () -> untyped

  # A resource's `[soft, hard]` limits.
  def self?.getrlimit: (untyped resource) -> untyped

  # A limit is a count or a name: INFINITY, SAVED_MAX or SAVED_CUR. The
  # hard limit is the soft one unless given.
  def self?.setrlimit: (untyped resource, untyped soft, ?untyped? hard) -> nil

  def self?.uid=: (untyped user) -> untyped

  def self?.gid=: (untyped group) -> untyped

  def self?.euid=: (untyped user) -> untyped

  def self?.egid=: (untyped group) -> untyped

  # The name the program was started under, which `$0 =` leaves as it
  # was.
  def self?.argv0: () -> untyped

  # The title that `ps` shows. Darwin gives a process no way to set one,
  # and ruby returns the title whether or not the change worked.
  def self?.setproctitle: (untyped title) -> untyped

  # A hint to settle the heap before forking workers: one collection.
  def self?.warmup: () -> true

  # A niceness is a number that can be negative, so the errno next to
  # it, not the return value, shows whether the call failed.
  def self?.getpriority: (untyped which, untyped who) -> untyped

  def self?.setpriority: (untyped which, untyped who, untyped priority) -> untyped

  Tms: untyped

  # This process's times, then its waited-for children's.
  def self?.times: () -> untyped

  # rb_f_kill: a negative signal goes to each process group. A signal
  # that this process sends to itself is handled before the call returns.
  def self?.kill: (*untyped args) -> untyped

  # rb_daemon where the platform has no daemon(3): the parent ends, and
  # the child leads a session of its own, in "/" unless `nochdir`, with
  # /dev/null as its standard streams unless `noclose`.
  def self?.daemon: (?untyped? nochdir, ?untyped? noclose) -> 0

  def self.exit: (?bool status) -> untyped

  def self.exit!: (?bool status) -> untyped

  def self.abort: (*untyped args) -> untyped

  def self.fork: () { (?) -> untyped } -> untyped

  def self.exec: (*untyped args, **untyped options) -> untyped

  # The fork itself, which Kernel#fork reaches through a send, so a
  # program that wraps `_fork` sees every fork. The streams are written
  # out first, so the child does not write them again; in the child only
  # the thread that forked lives on.
  def self._fork: () -> untyped

  # `fork`: the child's pid in the parent. In the child, nil, or with a
  # block the block runs and the child ends there.
  def self.forked: () ?{ () -> untyped } -> (untyped | nil)

  # The process becomes the command, with its environment and options
  # applied first; only a failure to start returns.
  def self.replaced: (untyped args, untyped options) -> untyped

  # A result that is a failure raises as `rb_sys_fail(0)` does, with
  # no text added to the error's own message.
  def self.set_ids: (untyped group, untyped real, untyped effective) -> untyped

  def self.set_id: (untyped call, untyped id) -> untyped

  # A user (`group` false) or group as the id calls take it: a name
  # looks the id up, and anything else converts as C's unsigned int.
  def self.id_of: (untyped value, untyped group) -> untyped

  # `value` as C converts an unsigned argument of `bits`: through an
  # unsigned long, so a negative count wraps as a cast wraps it.
  def self.unsigned: (untyped value, untyped bits, untyped type) -> untyped

  def self.signed: (untyped limit) -> untyped

  # A String as a C string takes it: one with a NUL byte has no end.
  def self.c_string: (untyped text) -> untyped

  # A resource by its number, or by name as a Symbol or a String.
  def self.rlimit_resource: (untyped resource) -> untyped

  def self.rlimit_value: (untyped limit) -> untyped

  def self.group_limit: () -> untyped

  # While a block given to UID.switch or GID.switch runs, no id of that
  # kind may change.
  def self.switching!: (untyped group) -> (nil | untyped)

  # Runs the command; the child's pid, or nil when it could not start
  # (then `$?` says exit 127).
  # `rb_exec_getargs`: a leading Hash is the environment and a trailing
  # Hash is the options, written as arguments rather than as keywords.
  def self.exec_args: (untyped args, untyped options) -> ::Array[untyped]

  # The error of a command that did not start, named by its program as
  # rb_exec_fail names it: after the environment and options come off.
  # The error names what failed, as ruby's child reports it: the
  # `chdir:` directory when the child could not enter it, else the
  # command.
  def self.start_error: (untyped args, untyped options, untyped pid) -> untyped

  def self.spawn_command: (untyped args, untyped options) -> untyped

  def self.forked_spawn: (untyped path, untyped words, untyped env, untyped redirects) -> untyped

  # pty.c's establishShell: the command, or a login shell, on the far
  # end of a pty pair. The pid, or the negated errno the child could not
  # start with.
  def self.tty_spawn: (untyped args, untyped master, untyped slave) -> untyped

  # The file that a command word runs: the word itself when it is a
  # path, else the first executable file of that name on PATH, as
  # execvp searches.
  def self.executable: (untyped word) -> (untyped | nil)

  # The program and its arguments. One string goes through the shell
  # when it contains shell syntax; a list is the argument vector itself.
  def self.command_words: (untyped args) -> untyped

  def self.shell_words: (untyped command) -> (::Array[untyped] | untyped)

  # The child's whole environment as "KEY=value" strings, or nil to
  # inherit the parent's.
  def self.environment: (untyped env, untyped options) -> (nil | untyped)
end

# The ids a process runs as. Process::Sys makes the system calls by
# their own names; Process::UID and Process::GID change the real,
# effective and saved ids together, the way CRuby does on darwin, and
# keep the saved id themselves where the system shows none.
module Process
  # How each kind of id is read and set: the ids zr_process_ids reads,
  # and the calls that set one id.
  ID_CALLS: { false => { real: 0, effective: 1, set: :setuid, set_real: :setruid, set_effective: :seteuid }, true => { real: 2, effective: 3, set: :setgid, set_real: :setrgid, set_effective: :setegid } }

  module Sys
    def self?.getuid: () -> untyped

    def self?.geteuid: () -> untyped

    def self?.getgid: () -> untyped

    def self?.getegid: () -> untyped

    def self?.setuid: (untyped user) -> untyped

    def self?.setgid: (untyped group) -> untyped

    def self?.setruid: (untyped user) -> untyped

    def self?.setrgid: (untyped group) -> untyped

    def self?.seteuid: (untyped user) -> untyped

    def self?.setegid: (untyped group) -> untyped

    def self?.setreuid: (untyped real, untyped effective) -> nil

    def self?.setregid: (untyped real, untyped effective) -> nil

    def self?.issetugid: () -> untyped
  end

  module UID
    def self?.rid: () -> untyped

    def self?.eid: () -> untyped

    def self?.change_privilege: (untyped user) -> untyped

    def self?.grant_privilege: (untyped user) -> untyped

    # Darwin's setreuid cannot swap the two ids and keep the saved one.
    def self?.re_exchangeable?: () -> false

    def self?.re_exchange: () -> untyped

    def self?.sid_available?: () -> true

    def self?.switch: () { (?) -> untyped } -> untyped

    def self?.from_name: (untyped name) -> untyped

    alias self.eid= self.grant_privilege
  end

  module GID
    def self?.rid: () -> untyped

    def self?.eid: () -> untyped

    def self?.change_privilege: (untyped group) -> untyped

    def self?.grant_privilege: (untyped group) -> untyped

    # Darwin's setregid cannot swap the two ids and keep the saved one.
    def self?.re_exchangeable?: () -> false

    def self?.re_exchange: () -> untyped

    def self?.sid_available?: () -> true

    def self?.switch: () { (?) -> untyped } -> untyped

    def self?.from_name: (untyped name) -> untyped

    alias self.eid= self.grant_privilege
  end

  private

  def self.sys_set: (untyped call, untyped value, untyped group) -> nil

  def self.saved_id: (untyped group) -> untyped

  def self.save_id: (untyped group, untyped id) -> untyped

  # The real and effective ids become `value`: root sets all three at
  # once. Any other user changes them one at a time through the saved
  # id, which accepts only a value that the process already has.
  def self.change_privilege: (untyped value, untyped group) -> untyped

  def self.grant_privilege: (untyped value, untyped group) -> untyped

  # The effective id changes to the other of the real and saved ids;
  # with a block it changes back when the block is done.
  def self.switch: (untyped group) ?{ () -> untyped } -> untyped
end

module Kernel
  private

  # The process becomes the command; only a failure to start returns.
  def self?.exec: (*untyped args, **untyped options) -> untyped

  def self?.fork: () { (?) -> untyped } -> untyped

  def self?.spawn: (*untyped args, **untyped options) -> untyped

  def self?.system: (*untyped args, ?exception: bool, **untyped options) -> (nil | true | false)

  # Backticks: the command's standard output, read through a pipe.
  def self?.`: (untyped command) -> untyped
end

module Kernel
end
