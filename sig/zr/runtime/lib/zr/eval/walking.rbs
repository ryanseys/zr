module Zr
  class Eval
    # The lexical scope, the scopes of a Binding, and the constant,
    # class-variable and global tables. Every method here is in place of
    # one that the compiler emits inline, and returns the same value.
    module World
      # The lexical scope of the calling frame (the caller's, because
      # this method's own frame is on top). A block that the walk made
      # reads it to see whether `class_eval` or `instance_exec` gave it
      # a scope other than the one where it was written.
      def self?.cref: () -> untyped

      # Two crefs, or any two Values, as the same object. A cref accepts
      # no message, so it cannot be compared by a method call on it.
      def self?.same?: (untyped a, untyped b) -> untyped

      # The lexical scope of the frame that called eval, and one scope
      # inside it.
      def self?.cref_under: (untyped mod, untyped outer) -> untyped

      # A lexical scope for a class or module body, which a `def` in it
      # defines into and a constant in it is read under.
      def self?.cref_push: (untyped mod, untyped outer) -> untyped

      # The module a cref names, and the innermost cref that is a
      # lexical scope rather than an eval's.
      def self?.cref_klass: (untyped cref) -> untyped

      def self?.cref_lexical: (untyped cref) -> untyped

      # The visibility that a `def` under `cref` gets: 0 public, 1 private,
      # 2 protected; and whether `module_function` requests a copy on
      # the singleton class.
      def self?.definition_vis: (untyped name, untyped cref) -> untyped

      def self?.module_function?: (untyped cref) -> untyped

      # What a bare `private`, `public`, `protected` or `module_function`
      # in a body writes: the body's own visibility, which lives in its
      # cref and not in any frame the walk has.
      def self?.set_vis: (untyped cref, untyped vis) -> untyped

      def self?.set_module_function: (untyped cref) -> untyped

      # While the walk runs, the caller of the runtime is the program,
      # not the interpreter's own file, which loaded hidden from the
      # program. So a constant that the string defines is the program's,
      # and so is a require that it makes.
      def self?.walk_enter: () -> untyped

      def self?.walk_leave: () -> untyped

      # `class << obj` and `obj.instance_eval`: the singleton class, or
      # the class itself where the object can hold no singleton.
      def self?.singleton_of: (untyped obj) -> untyped

      # The scopes of a Binding, innermost first, each an Array of the
      # names of its slots; and one slot of one scope.
      def self?.binding_scopes: (untyped b) -> untyped

      def self?.binding_get: (untyped b, untyped depth, untyped index) -> untyped

      def self?.binding_set: (untyped b, untyped depth, untyped index, untyped v) -> untyped

      def self?.binding_add: (untyped b, untyped name) -> untyped

      def self?.binding_receiver: (untyped b) -> untyped

      def self?.binding_cref: (untyped b) -> untyped

      def self?.binding_parameters: (untyped b) -> untyped

      # A bare constant under `cref`, and `scope::Name`.
      def self?.const_get: (untyped cref, untyped name) -> untyped

      def self?.const_defined?: (untyped cref, untyped name) -> untyped

      def self?.const_get_at: (untyped scope, untyped name) -> untyped

      def self?.const_defined_at?: (untyped scope, untyped name) -> untyped

      def self?.const_set: (untyped klass, untyped name, untyped value) -> untyped

      def self?.cvar_get: (untyped cref, untyped name) -> untyped

      def self?.cvar_defined?: (untyped cref, untyped name) -> untyped

      def self?.cvar_set: (untyped cref, untyped name, untyped value) -> untyped

      def self?.gvar_get: (untyped name) -> untyped

      def self?.gvar_defined?: (untyped name) -> untyped

      def self?.gvar_set: (untyped shown, untyped name, untyped value) -> untyped

      def self?.gvar_alias: (untyped new_name, untyped old_name) -> untyped

      # `alias :"#{a}" :"#{b}"` on a module.
      def self?.alias_method: (untyped klass, untyped new_name, untyped old_name) -> untyped
    end
  end
end
