module Zr
  module Obj
    class JIT
      # The system half of the loader, inside a program the runtime runs.
      # The same libSystem calls the Fiddle host makes.
      class Runtime
        def reserve: (untyped size) -> untyped

        def release: (untyped at, untyped size) -> untyped

        # A nonzero address is taken as it is: the caller reserved it.
        def map: (untyped size, exec: untyped, ?at: untyped?, ?near: ::Integer) -> untyped

        def symbol: (untyped name) -> untyped

        def write_data: (untyped at, untyped bytes) -> untyped

        def write_code: (untyped at, untyped bytes) -> untyped

        # A loaded function, called for the word that it returns.
        def call: (untyped at) -> untyped
      end
    end
  end
end
