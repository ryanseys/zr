module Zr
  module AST
    Node: untyped

    Location: untyped
  end
end

module Zr
  module AST
    # A span in the source. Lines count from 1; columns count bytes from 0.
    class Location
      @first_lineno: untyped

      @first_column: untyped

      @last_lineno: untyped

      @last_column: untyped

      attr_reader first_lineno: untyped

      attr_reader first_column: untyped

      attr_reader last_lineno: untyped

      attr_reader last_column: untyped

      def self.new: (*untyped) -> untyped

      def self.build: (untyped first_lineno, untyped first_column, untyped last_lineno, untyped last_column) -> untyped

      def inspect: () -> ::String

      private

      def setup: (untyped first_lineno, untyped first_column, untyped last_lineno, untyped last_column) -> untyped
    end

    # What every node of one parse shares: the script lines and the tokens.
    class Tree
      @script_lines: untyped

      @tokens: untyped

      attr_reader script_lines: untyped

      attr_reader tokens: untyped

      def initialize: (untyped script_lines, untyped tokens) -> void
    end

    # A node of RubyVM::AbstractSyntaxTree: its type, span, and children, as
    # CRuby's Node returns them.
    class Node
      @type: untyped

      @spans: untyped

      @first_lineno: untyped

      @first_column: untyped

      @last_lineno: untyped

      @last_column: untyped

      @children: untyped

      @node_id: untyped

      @tree: untyped

      # The keyword locations each node type reports after its own span.
      EXTRA_LOCATIONS: { ALIAS: 1, AND: 1, BLOCK_PASS: 1, BREAK: 1, CASE: 2, CASE2: 2, CASE3: 2, CLASS: 3, COLON2: 2, COLON3: 2, DEFINED: 1, DOT2: 1, DOT3: 1, EVSTR: 2, FLIP2: 1, FLIP3: 1, FOR: 4, LAMBDA: 3, IF: 3, IN: 3, MODULE: 2, NEXT: 1, OR: 1, OP_ASGN1: 4, OP_ASGN2: 3, POSTEXE: 3, REDO: 1, REGX: 3, RETURN: 1, SCLASS: 3, SPLAT: 1, SUPER: 3, UNDEF: 1, UNLESS: 3, VALIAS: 1, WHEN: 2, WHILE: 2, UNTIL: 2, YIELD: 3 }

      def self.new: (*untyped) -> untyped

      # Makes a node; `spans` contains the node's own span and then its keyword
      # spans, each [first_lineno, first_column, last_lineno, last_column] or nil.
      def self.build: (untyped type, untyped spans, untyped children, untyped node_id, untyped tree) -> untyped

      attr_reader type: untyped

      attr_reader first_lineno: untyped

      attr_reader first_column: untyped

      attr_reader last_lineno: untyped

      attr_reader last_column: untyped

      attr_reader node_id: untyped

      # A new array on each call, as CRuby's is.
      def children: () -> untyped

      def locations: () -> untyped

      def inspect: () -> ::String

      def script_lines: () -> untyped

      def source: () -> (nil | untyped)

      def all_tokens: () -> untyped

      def tokens: () -> (nil | untyped)

      private

      def setup: (untyped type, untyped spans, untyped children, untyped node_id, untyped tree) -> untyped
    end

    # One parse.y node while the translator builds it. It contains the fields a
    # NODE_* struct has (`head`, `next`, `body`, ...), which parse.y's helpers
    # rewrite in place; #children reads them the way ast.c's node_children does.
    class Draft
      @type: untyped

      @first_lineno: untyped

      @first_column: untyped

      @last_lineno: untyped

      @last_column: untyped

      @node_id: untyped

      NO_NAME_REST: :NODE_SPECIAL_NO_NAME_REST

      REQUIRED_KEYWORD: :NODE_SPECIAL_REQUIRED_KEYWORD

      NO_REST_KEYWORD: :NODE_SPECIAL_NO_REST_KEYWORD

      EXCESSIVE_COMMA: :NODE_SPECIAL_EXCESSIVE_COMMA

      def initialize: (untyped type, untyped first, untyped last, untyped node_id) -> void

      attr_reader type: untyped

      attr_reader node_id: untyped

      attr_accessor first_lineno: untyped

      attr_accessor first_column: untyped

      attr_accessor last_lineno: untyped

      attr_accessor last_column: untyped

      # parse.y's field names, shared across node types.
      attr_accessor head: untyped

      # parse.y's field names, shared across node types.
      attr_accessor body: untyped

      # parse.y's field names, shared across node types.
      attr_accessor next: untyped

      # parse.y's field names, shared across node types.
      attr_accessor end_node: untyped

      # parse.y's field names, shared across node types.
      attr_accessor cond: untyped

      # parse.y's field names, shared across node types.
      attr_accessor else_body: untyped

      # parse.y's field names, shared across node types.
      attr_accessor value: untyped

      # parse.y's field names, shared across node types.
      attr_accessor vid: untyped

      # parse.y's field names, shared across node types.
      attr_accessor mid: untyped

      # parse.y's field names, shared across node types.
      attr_accessor recv: untyped

      # parse.y's field names, shared across node types.
      attr_accessor args: untyped

      # parse.y's field names, shared across node types.
      attr_accessor iter: untyped

      # parse.y's field names, shared across node types.
      attr_accessor state: untyped

      # parse.y's field names, shared across node types.
      attr_accessor resq: untyped

      # parse.y's field names, shared across node types.
      attr_accessor exc_var: untyped

      # parse.y's field names, shared across node types.
      attr_accessor ensr: untyped

      # parse.y's field names, shared across node types.
      attr_accessor first: untyped

      # parse.y's field names, shared across node types.
      attr_accessor second: untyped

      # parse.y's field names, shared across node types.
      attr_accessor string: untyped

      # parse.y's field names, shared across node types.
      attr_accessor lit: untyped

      # parse.y's field names, shared across node types.
      attr_accessor cpath: untyped

      # parse.y's field names, shared across node types.
      attr_accessor super_class: untyped

      # parse.y's field names, shared across node types.
      attr_accessor tbl: untyped

      # parse.y's field names, shared across node types.
      attr_accessor ainfo: untyped

      # parse.y's field names, shared across node types.
      attr_accessor pconst: untyped

      # parse.y's field names, shared across node types.
      attr_accessor pre_args: untyped

      # parse.y's field names, shared across node types.
      attr_accessor rest_arg: untyped

      # parse.y's field names, shared across node types.
      attr_accessor post_args: untyped

      # parse.y's field names, shared across node types.
      attr_accessor pre_rest: untyped

      # parse.y's field names, shared across node types.
      attr_accessor post_rest: untyped

      # parse.y's field names, shared across node types.
      attr_accessor kw_rest: untyped

      # parse.y's field names, shared across node types.
      attr_accessor undefs: untyped

      # parse.y's field names, shared across node types.
      attr_accessor aid: untyped

      # parse.y's field names, shared across node types.
      attr_accessor index: untyped

      # parse.y's field names, shared across node types.
      attr_accessor op: untyped

      # parse.y's field names, shared across node types.
      attr_accessor beg_node: untyped

      # parse.y's field names, shared across node types.
      attr_accessor fin_node: untyped

      # parse.y's field names, shared across node types.
      attr_accessor orig: untyped

      # parse.y's field names, shared across node types.
      attr_accessor new_name: untyped

      # parse.y's field names, shared across node types.
      attr_accessor path: untyped

      # parse.y's field names, shared across node types.
      attr_accessor keyword_locations: untyped

      # parse.y's field names, shared across node types.
      attr_accessor tail_cell: untyped

      attr_writer type: untyped

      def first_pos: () -> ::Array[untyped]

      def last_pos: () -> ::Array[untyped]

      def first_pos=: (untyped pos) -> untyped

      def last_pos=: (untyped pos) -> untyped

      def children: () -> untyped

      private

      def block_children: () -> untyped

      def list_children: () -> untyped

      def logop_children: () -> untyped

      def args_children: () -> ::Array[untyped]
    end

    # The byte offsets of each `#$` and `#@` in text, where parse.y's lexer
    # ends a string content token.
    def self.variable_marks: (untyped text) -> untyped

    # Parses source the way RubyVM::AbstractSyntaxTree.parse does. A source
    # that prism refuses raises SyntaxError unless error_tolerant is set,
    # which returns a tree with ERROR nodes where the source is broken.
    def self.parse: (untyped source, ?keep_script_lines: bool, ?error_tolerant: bool, ?keep_tokens: bool) -> untyped

    # Parses the file at path the way RubyVM::AbstractSyntaxTree.parse_file
    # does. Like CRuby, `__FILE__` in the tree is an empty string.
    def self.parse_file: (untyped path, ?keep_script_lines: bool, ?error_tolerant: bool, ?keep_tokens: bool) -> untyped

    private

    def self.prism_parse: (untyped source) -> untyped

    # CRuby's message shape: the complaint, the source line, and a caret.
    def self.syntax_error_message: (untyped source, untyped result) -> ::String

    # The lines parse.y read: through an `__END__` line, and no further.
    def self.script_lines_of: (untyped source, untyped result) -> untyped

    public

    # The token list that keep_tokens: true returns: parse.y's tokens, rebuilt
    # from prism's lexer. Each token is
    # [id, type, text, [first_lineno, first_column, last_lineno, last_column]].
    # parse.y's lexer states decide some token types, so a few of them
    # (such as which `do` a block opens) come from the tree instead.
    class Tokens
      @source: untyped

      @result: untyped

      @do_blocks: untyped

      @lambda_dos: untyped

      @tokens: untyped

      @state: untyped

      @paren_args: untyped

      @interpolating: untyped

      TYPES: { IDENTIFIER: :tIDENTIFIER, CONSTANT: :tCONSTANT, METHOD_NAME: :tFID, LABEL: :tLABEL, INSTANCE_VARIABLE: :tIVAR, CLASS_VARIABLE: :tCVAR, GLOBAL_VARIABLE: :tGVAR, BACK_REFERENCE: :tBACK_REF, NUMBERED_REFERENCE: :tNTH_REF, INTEGER: :tINTEGER, FLOAT: :tFLOAT, INTEGER_RATIONAL: :tRATIONAL, FLOAT_RATIONAL: :tRATIONAL, INTEGER_IMAGINARY: :tIMAGINARY, FLOAT_IMAGINARY: :tIMAGINARY, INTEGER_RATIONAL_IMAGINARY: :tIMAGINARY, FLOAT_RATIONAL_IMAGINARY: :tIMAGINARY, CHARACTER_LITERAL: :tCHAR, STRING_BEGIN: :tSTRING_BEG, STRING_CONTENT: :tSTRING_CONTENT, STRING_END: :tSTRING_END, LABEL_END: :tLABEL_END, SYMBOL_BEGIN: :tSYMBEG, REGEXP_BEGIN: :tREGEXP_BEG, REGEXP_END: :tREGEXP_END, BACKTICK: :tXSTRING_BEG, PERCENT_LOWER_X: :tXSTRING_BEG, PERCENT_LOWER_W: :tQWORDS_BEG, PERCENT_UPPER_W: :tWORDS_BEG, PERCENT_LOWER_I: :tQSYMBOLS_BEG, PERCENT_UPPER_I: :tSYMBOLS_BEG, WORDS_SEP: :word_sep, HEREDOC_START: :tHEREDOC_BEG, HEREDOC_END: :tHEREDOC_END, EMBEXPR_BEGIN: :tSTRING_DBEG, EMBEXPR_END: :tSTRING_DEND, EMBVAR: :tSTRING_DVAR, COMMENT: :tCOMMENT, EMBDOC_BEGIN: :tEMBDOC_BEG, EMBDOC_LINE: :tEMBDOC, EMBDOC_END: :tEMBDOC_END, NEWLINE: :nl, IGNORED_NEWLINE: :tIGNORED_NL, COLON_COLON: :tCOLON2, UCOLON_COLON: :tCOLON3, AMPERSAND_DOT: :tANDDOT, EQUAL_GREATER: :tASSOC, MINUS_GREATER: :tLAMBDA, LAMBDA_BEGIN: :tLAMBEG, DOT_DOT: :tDOT2, DOT_DOT_DOT: :tDOT3, UDOT_DOT: :tBDOT2, UDOT_DOT_DOT: :tBDOT3, AMPERSAND_AMPERSAND: :tANDOP, PIPE_PIPE: :tOROP, EQUAL_EQUAL: :tEQ, EQUAL_EQUAL_EQUAL: :tEQQ, BANG_EQUAL: :tNEQ, EQUAL_TILDE: :tMATCH, BANG_TILDE: :tNMATCH, LESS_EQUAL_GREATER: :tCMP, GREATER_EQUAL: :tGEQ, LESS_EQUAL: :tLEQ, LESS_LESS: :tLSHFT, GREATER_GREATER: :tRSHFT, STAR_STAR: :tPOW, USTAR: :tSTAR, USTAR_STAR: :tDSTAR, UAMPERSAND: :tAMPER, UMINUS: :tUMINUS, UMINUS_NUM: :tUMINUS_NUM, UPLUS: :tUPLUS, BRACKET_LEFT_ARRAY: :tLBRACK, BRACKET_LEFT_RIGHT: :tAREF, BRACKET_LEFT_RIGHT_EQUAL: :tASET, BRACKET_LEFT: :"\"[\"", BRACKET_RIGHT: :"\"]\"", PARENTHESIS_RIGHT: :"\")\"", BRACE_RIGHT: :"\"}\"", KEYWORD_IF_MODIFIER: :modifier_if, KEYWORD_UNLESS_MODIFIER: :modifier_unless, KEYWORD_WHILE_MODIFIER: :modifier_while, KEYWORD_UNTIL_MODIFIER: :modifier_until, KEYWORD_RESCUE_MODIFIER: :modifier_rescue, KEYWORD_DO_LOOP: :keyword_do_cond, KEYWORD___FILE__: :keyword__FILE__, KEYWORD___LINE__: :keyword__LINE__, KEYWORD___ENCODING__: :keyword__ENCODING__, KEYWORD_BEGIN_UPCASE: :keyword_BEGIN, KEYWORD_END_UPCASE: :keyword_END, KEYWORD_DEFINED: :keyword_defined }

      EXPR_BEG_ANY: untyped

      EXPR_ARG_ANY: untyped

      EXPR_END_LABEL: untyped

      # The openings whose content interpolates, so `#$` and `#@` split it.
      OPENINGS: ::Array[:STRING_BEGIN | :HEREDOC_START | :SYMBOL_BEGIN | :REGEXP_BEGIN | :BACKTICK | :PERCENT_LOWER_X | :PERCENT_UPPER_W | :PERCENT_UPPER_I | :PERCENT_LOWER_W | :PERCENT_LOWER_I]

      def initialize: (untyped source, untyped result) -> void

      def to_a: () -> untyped

      private

      def add: (untyped token, untyped name, untyped state) -> untyped

      # parse.y's token type, which for a few tokens hangs on the lexer state.
      def name_of: (untyped token, untyped spaced) -> untyped

      def interpolating?: (untyped opening) -> untyped

      # parse.y splits a word separator at each newline.
      def separators: (untyped loc, untyped text) -> untyped

      # parse.y's lexer reads the comment lines right after a newline before
      # it returns the newline, so their tokens come first.
      def reorder_newlines: (untyped lexed) -> untyped

      # parse.y reports a token that ends its line on that line.
      def span: (untyped loc, untyped text) -> untyped

      # parse.y ends a content token before each `#$` and `#@`.
      def split_content: (untyped loc, untyped text) -> untyped

      # The emitted token that starts last before offset: the spaces after it
      # are the gap before the token at offset.
      def preceding: (untyped emitted, untyped offset) -> untyped

      def insert_emitted: (untyped emitted, untyped loc) -> untyped

      # The spaces between two tokens on one line are a tSP token; an escaped
      # newline is one of its own.
      def gap: (untyped previous, untyped loc) -> (nil | untyped)

      # The `do` of a command's block (keyword_do_block) and of a lambda.
      def do_keywords: () -> ::Array[untyped]
    end
  end
end

module Zr
  module AST
    # Rebuilds parse.y's tree from prism's. Each visit method returns the
    # Draft that parse.y's grammar action builds for the same source, with
    # the span that rule gives it; #scope turns the drafts into Nodes.
    #
    # Positions are [line, column] pairs. Most spans come from prism's
    # locations, but parse.y also puts nodes where no prism node is: an
    # empty statement list is a zero-width `BEGIN nil` at the end of the
    # grammar symbol before it, and a list of statements runs through its
    # terminators. The translator scans the source for those terminators
    # (`;` and the newlines that parse.y's lexer returns as tokens) itself.
    class Translator < Prism::BasicVisitor
      @result: untyped

      @src: untyped

      @size: untyped

      @bom: untyped

      @offsets: untyped

      @start_line: untyped

      @file: untyped

      @tree: untyped

      @next_id: untyped

      @scopes: untyped

      @begin_blocks: untyped

      @heredoc_bodies: untyped

      @semicolons: untyped

      @dedent_heredocs: untyped

      # A terminator token (`;` or a significant newline) and the offset after it.
      Term: untyped

      NL: 10

      SPACE_BYTES: ::Array[32 | 9 | 13 | 12 | 11]

      BINARY_OPERATORS: ::Array[:+ | :- | :* | :/ | :% | :** | :| | :^ | :& | :<=> | :> | :>= | :< | :<= | :== | :=== | :!= | :!~ | :<< | :>>]

      UNARY_OPERATORS: ::Array[:-@ | :+@ | :! | :~]

      # result: the Prism::ParseResult of the source. The source itself is
      # read back from the result; `file` is the value that `__FILE__` returns,
      # and `tree` contains what every node shares.
      def initialize: (untyped result, ?untyped? source, ?file: ::String, ?tree: untyped?) -> void

      # The SCOPE node for the whole program.
      def scope: () -> untyped

      # Turns the drafts into RubyVM::AbstractSyntaxTree nodes.
      def publish: (untyped value, untyped done) -> untyped

      def line_index: (untyped offset) -> untyped

      def pos: (untyped offset) -> ::Array[untyped]

      # parse.y's lexer skips a byte order mark, so the first line's columns
      # start after it.
      def line_start: (untyped index) -> untyped

      # The position of an end offset. An end just past a newline stays on
      # the newline's line, a column past its last character.
      def end_pos: (untyped offset) -> (untyped | ::Array[untyped])

      def loc_of: (untyped thing) -> untyped

      def first_of: (untyped thing) -> untyped

      def last_of: (untyped thing) -> untyped

      def start_offset: (untyped thing) -> untyped

      def end_offset: (untyped thing) -> untyped

      def byte: (untyped offset) -> untyped

      def mk: (untyped type, untyped first, untyped last, **untyped fields) -> untyped

      def span: (untyped type, untyped thing, **untyped fields) -> untyped

      # A keyword span for Node#locations, or nil when the source has none.
      def kw: (untyped thing) -> (nil | untyped)

      # `then`: a terminator, the `then` keyword, or both. Returns its span.
      def then_span: (untyped offset, untyped keyword, ?newline: bool) -> untyped

      # rparen and rbracket: `'\n'? ')'` starts where the token before it ends.
      def closing_span: (untyped before, untyped closing) -> (nil | untyped)

      def unknown: (untyped node) -> untyped

      def begin_nil: (untyped at) -> untyped

      def nil_at: (untyped at) -> untyped

      def new_list: (untyped item, ?untyped first, ?untyped last) -> untyped

      def new_block: (untyped item, ?untyped first, ?untyped last) -> untyped

      # The last cell of a list. The head caches it, as parse.y's nd_end
      # does, so long literals append in constant time.
      def list_last: (untyped list) -> untyped

      def list_append: (untyped list, untyped item) -> untyped

      def list_concat: (untyped head, untyped tail) -> untyped

      def block_append: (untyped head, untyped tail) -> untyped

      def remove_begin: (untyped node) -> untyped

      alias newline_node remove_begin

      def splat_array: (untyped node) -> untyped

      def arg_append: (untyped node1, untyped node2, untyped first, untyped last) -> untyped

      def arg_concat: (untyped node1, untyped node2, untyped first, untyped last) -> untyped

      def rest_arg_append: (untyped args, untyped rest, untyped first, untyped last) -> untyped

      def last_arg_append: (untyped args, untyped last_arg, untyped first, untyped last) -> untyped

      def arg_blk_pass: (untyped node1, untyped block_pass) -> untyped

      def logop: (untyped type, untyped left, untyped right, untyped first, untyped last, ?untyped? operator) -> untyped

      # parse.y's cond0: a condition turns a regexp literal into a match
      # against $_ and a range into a flip-flop. The nodes it adds span
      # `loc`, the span the calling rule passes.
      def cond0: (untyped node, untyped loc, ?bool top) -> (nil | untyped)

      def range_op: (untyped node, untyped loc) -> (nil | untyped)

      # parse.y's reduce_nodes, applied to a method body.
      def reduce_nodes: (untyped node) -> (nil | untyped)

      # Walks the value-producing tail of a body and drops a trailing nil or
      # a BEGIN wrapper, the way reduce_nodes does. The block stores the
      # replacement for the slot that contained the node.
      def reduce_tail: (untyped node) { (?) -> untyped } -> untyped

      # Scans the terminators after offset: `;` tokens and, while a newline
      # is a token there, the newline. Stops at anything else.
      def scan_terms: (untyped offset, untyped newline) -> untyped

      def skip_embedded_document: (untyped offset) -> untyped

      # The position of a newline term that follows a comment. parse.y's
      # lexer keeps reading comment-only lines; the token sits past the end
      # of the last one, or at that comment's start at the end of input.
      def comment_term: (untyped offset) -> (::Array[untyped] | untyped)

      # compstmt: `stmts terms?`. The statements come from prism's
      # StatementsNode (or an Array of nodes); `prev` and `offset` locate the
      # grammar symbol before them, `newline` says whether a newline is a
      # token right after it, and `absorb` says whether the rule before the
      # body takes one terminator itself (`then`, `do`, a def's arglist).
      # Returns [node, first, last, offset].
      def compstmt: (untyped statements, untyped prev, untyped offset, ?newline: bool, ?absorb: bool) -> ::Array[untyped]

      # Runs the block inside a local variable scope: :top, :def, :class, or
      # :block. Inside a block every local reads as DVAR and assigns as DASGN.
      def push_scope: (untyped kind) { () -> untyped } -> untyped

      def in_block?: () -> untyped

      # The local table parse.y builds: parameters in parse.y's order (with
      # internal ids as nil), then the variables the body assigns.
      def local_table: (untyped locals, untyped parameters) -> untyped

      def table_param: (untyped table, untyped destructured, untyped param) -> untyped

      def collect_targets: (untyped target, untyped names) -> untyped

      def visit_program_node: (untyped node) -> untyped

      def visit_statements_node: (untyped node) -> untyped

      def visit_integer_node: (untyped node) -> untyped

      def visit_float_node: (untyped node) -> untyped

      def visit_rational_node: (untyped node) -> untyped

      def visit_imaginary_node: (untyped node) -> untyped

      def visit_nil_node: (untyped node) -> untyped

      def visit_true_node: (untyped node) -> untyped

      def visit_false_node: (untyped node) -> untyped

      def visit_self_node: (untyped node) -> untyped

      def visit_source_line_node: (untyped node) -> untyped

      def visit_source_file_node: (untyped node) -> untyped

      def visit_source_encoding_node: (untyped node) -> untyped

      def visit_symbol_node: (untyped node) -> untyped

      def visit_regular_expression_node: (untyped node) -> untyped

      def visit_match_last_line_node: (untyped node) -> untyped

      # A regexp without interpolation, unless a `#$` or `#@` splits its content.
      def plain_regexp: (untyped node) -> untyped

      def regexp_of: (untyped node, untyped source) -> untyped

      # The literal's value, in the encoding its escapes force.
      def string_value: (untyped node) -> untyped

      def visit_string_node: (untyped node) -> untyped

      # Records where a heredoc's body lines sit, so terminator scans skip them.
      def heredoc_body: (untyped node) -> (nil | untyped)

      # `strings: string` over a literal or a run of adjacent literals.
      def visit_interpolated_string_node: (untyped node) -> untyped

      def literal_piece?: (untyped part) -> untyped

      # string1: `tSTRING_BEG string_contents tSTRING_END`, spanning the literal.
      def string1: (untyped node) -> untyped

      def visit_interpolated_symbol_node: (untyped node) -> untyped

      def visit_x_string_node: (untyped node) -> untyped

      # new_xstring
      def visit_interpolated_x_string_node: (untyped node) -> untyped

      def visit_interpolated_regular_expression_node: (untyped node) -> untyped

      def visit_interpolated_match_last_line_node: (untyped node) -> untyped

      # new_regexp over regexp_contents.
      def new_regexp: (untyped node, ?untyped parts) -> untyped

      def regexp_contents: (untyped parts, untyped literal) -> untyped

      def dsym_node: (untyped node, untyped first, untyped last) -> untyped

      # string_contents: literal_concat over the pieces of one literal.
      def string_contents: (untyped parts, untyped literal) -> untyped

      # A squiggly heredoc whose lines share some indentation. parse.y lexes
      # such a heredoc line by line and joins the pieces after dedenting;
      # with no common indentation it lexes it like any other heredoc.
      def dedent_heredoc?: (untyped literal) -> (false | untyped)

      def heredoc_indent: (untyped literal) -> (0 | untyped)

      # heredoc_dedent: joins each run of adjacent string pieces into its first.
      def heredoc_dedent: (untyped root) -> untyped

      # One piece of a literal. A content token's span follows parse.y's
      # lexer: in a squiggly heredoc each line is a token; elsewhere a token
      # that crosses lines starts at its last line, and the token that ends
      # a heredoc sits at the end of the heredoc's opening.
      def string_content: (untyped part, untyped literal, untyped parts, untyped index) -> untyped

      # A content token of a literal: a prism string piece, or the part of
      # one that parse.y's lexer reads as a token of its own.
      Piece: untyped

      # parse.y ends a content token before each `#$` and `#@`, even when no
      # variable follows, so those split prism's pieces.
      def pieces_of: (untyped parts) -> untyped

      def content_pieces: (untyped start, untyped finish, untyped value) -> (::Array[untyped] | untyped)

      def content_span: (untyped part, untyped literal, untyped parts, untyped index) -> ::Array[untyped]

      def str2dstr: (untyped node) -> untyped

      def evstr2dstr: (untyped node) -> untyped

      def new_dstr: (untyped node, untyped first, untyped last) -> untyped

      # The node whose string a following literal joins: the DSTR itself,
      # or its last piece when that is a STR.
      def string_literal_head: (untyped head) -> (nil | untyped)

      def append_literal: (untyped holder, untyped text) -> untyped

      def literal_concat: (untyped head, untyped tail, untyped first, untyped last, ?dedent: bool) -> untyped

      def dstr_append: (untyped head, untyped tail) -> (untyped | untyped | nil)

      def visit_embedded_statements_node: (untyped node) -> untyped

      def visit_embedded_variable_node: (untyped node) -> untyped

      def visit_local_variable_read_node: (untyped node) -> untyped

      def visit_it_local_variable_read_node: (untyped node) -> untyped

      def visit_instance_variable_read_node: (untyped node) -> untyped

      def visit_class_variable_read_node: (untyped node) -> untyped

      def visit_global_variable_read_node: (untyped node) -> untyped

      def visit_constant_read_node: (untyped node) -> untyped

      def visit_back_reference_read_node: (untyped node) -> untyped

      def visit_numbered_reference_read_node: (untyped node) -> untyped

      def assignable: (untyped name, untyped first, untyped last, ?untyped? value) -> untyped

      # The anonymous `*`, `**`, and `&` parameters are always read as LVAR.
      def lvar: (untyped name, untyped first, untyped last) -> untyped

      def gettable: (untyped name, untyped first, untyped last) -> untyped

      def visit_local_variable_write_node: (untyped node) -> untyped

      def visit_instance_variable_write_node: (untyped node) -> untyped

      def visit_class_variable_write_node: (untyped node) -> untyped

      def visit_global_variable_write_node: (untyped node) -> untyped

      def visit_constant_write_node: (untyped node) -> untyped

      def variable_write: (untyped node) -> untyped

      # The right side of an assignment: an array without brackets is mrhs.
      def rhs_value: (untyped value) -> untyped

      def visit_local_variable_target_node: (untyped node) -> untyped

      def visit_instance_variable_target_node: (untyped node) -> untyped

      def visit_class_variable_target_node: (untyped node) -> untyped

      def visit_global_variable_target_node: (untyped node) -> untyped

      def visit_constant_target_node: (untyped node) -> untyped

      def visit_constant_path_target_node: (untyped node) -> untyped

      def visit_call_target_node: (untyped node) -> untyped

      def visit_index_target_node: (untyped node) -> untyped

      # Operator assignment: `x += 1`, `x ||= 1`, `x &&= 1`.
      def visit_local_variable_operator_write_node: (untyped node) -> untyped

      def visit_instance_variable_operator_write_node: (untyped node) -> untyped

      def visit_class_variable_operator_write_node: (untyped node) -> untyped

      def visit_global_variable_operator_write_node: (untyped node) -> untyped

      def visit_constant_operator_write_node: (untyped node) -> untyped

      def visit_local_variable_or_write_node: (untyped node) -> untyped

      def visit_instance_variable_or_write_node: (untyped node) -> untyped

      def visit_class_variable_or_write_node: (untyped node) -> untyped

      def visit_global_variable_or_write_node: (untyped node) -> untyped

      def visit_constant_or_write_node: (untyped node) -> untyped

      def visit_local_variable_and_write_node: (untyped node) -> untyped

      def visit_instance_variable_and_write_node: (untyped node) -> untyped

      def visit_class_variable_and_write_node: (untyped node) -> untyped

      def visit_global_variable_and_write_node: (untyped node) -> untyped

      def visit_constant_and_write_node: (untyped node) -> untyped

      def operator_write: (untyped node, untyped op) -> untyped

      def visit_index_operator_write_node: (untyped node) -> untyped

      def visit_index_or_write_node: (untyped node) -> untyped

      def visit_index_and_write_node: (untyped node) -> untyped

      def index_operator_write: (untyped node, untyped op) -> untyped

      def visit_call_operator_write_node: (untyped node) -> untyped

      def visit_call_or_write_node: (untyped node) -> untyped

      def visit_call_and_write_node: (untyped node) -> untyped

      def call_operator_write: (untyped node, untyped op) -> untyped

      def visit_constant_path_operator_write_node: (untyped node) -> untyped

      def visit_constant_path_or_write_node: (untyped node) -> untyped

      def visit_constant_path_and_write_node: (untyped node) -> untyped

      def constant_path_operator_write: (untyped node, untyped op) -> untyped

      def visit_constant_path_node: (untyped node) -> untyped

      def constant_path: (untyped node) -> untyped

      def visit_constant_path_write_node: (untyped node) -> untyped

      def visit_multi_write_node: (untyped node) -> untyped

      def visit_multi_target_node: (untyped node) -> untyped

      # mlhs_basic: a MASGN over the targets before the splat, the splat, and
      # a POSTARG for the targets after it. The first cell of each list spans
      # its item's grammar symbol, parentheses included. In a parameter list
      # (`margs`) the splat target's span includes its `*`.
      def mlhs: (untyped node, ?margs: bool) -> untyped

      def mlhs_items: (untyped items, untyped margs) -> untyped

      def mlhs_span: (untyped node) -> ::Array[untyped]

      def mlhs_item: (untyped target, untyped margs) -> untyped

      def visit_array_node: (untyped node) -> untyped

      # words and symbols: `%w`, `%W`, `%i`, `%I` lists of lexed words.
      def word_list: (untyped node, untyped first, untyped last) -> untyped

      # args: a list that turns into ARGSCAT/ARGSPUSH around splats.
      def args_list: (untyped elements) -> untyped

      def splat_node: (untyped element) -> untyped

      def mrhs: (untyped elements) -> untyped

      # aref_args and call_args: plain arguments, then an optional brace-less hash.
      # `rule_last` ends the grammar rule: a trailing comma or a block
      # argument after the elements. In an array literal a lone hash's list
      # spans the rule; in call arguments it spans the hash.
      def aref_args: (untyped elements, ?untyped? rule_last, ?call: bool) -> untyped

      # The end of an element list, through a trailing comma.
      def list_rule_last: (untyped elements) -> (nil | untyped)

      def visit_hash_node: (untyped node) -> untyped

      def visit_keyword_hash_node: (untyped node) -> untyped

      def assocs: (untyped elements) -> untyped

      def assoc: (untyped element) -> untyped

      def implicit_value: (untyped value, untyped first, untyped last) -> untyped

      def visit_splat_node: (untyped node) -> untyped

      def visit_range_node: (untyped node) -> untyped

      def visit_flip_flop_node: (untyped node) -> untyped

      def visit_call_node: (untyped node) -> untyped

      def operator_call?: (untyped node) -> (true | untyped)

      def call_without_block: (untyped node) -> untyped

      def block_argument: (untyped block) -> (untyped | nil)

      # The call's own span, without a literal block.
      def call_last: (untyped node) -> untyped

      # `not(expr)` takes the expression itself; `not()` takes a nil at its `(`.
      def not_operand: (untyped node) -> (nil | untyped)

      def command_args?: (untyped node) -> untyped

      # block_call: a command with a do block, or a call chained onto one.
      def block_call?: (untyped node) -> (false | untyped)

      def operator_call: (untyped node, untyped first, untyped last) -> untyped

      def negative_power?: (untyped node) -> untyped

      def match_op: (untyped node1, untyped node2, untyped first, untyped last) -> untyped

      def visit_match_write_node: (untyped node) -> untyped

      def attribute_write: (untyped node, untyped first, untyped last) -> untyped

      # call_args and opt_call_args. The parentheses locate `(...)` forwarding.
      def call_arguments: (untyped arguments, untyped block_arg, ?untyped? opening, ?untyped? closing) -> untyped

      # new_args_forward_call: `(...)` passes the rest, keyword rest, and block.
      def forward_arguments: (untyped leading, untyped forwarding, untyped args_first, untyped args_last) -> untyped

      def visit_super_node: (untyped node) -> untyped

      def super_last: (untyped node) -> untyped

      def visit_forwarding_super_node: (untyped node) -> untyped

      def with_block: (untyped node, untyped call) -> untyped

      def visit_yield_node: (untyped node) -> untyped

      def visit_block_argument_node: (untyped node) -> untyped

      # brace_block / do_block: an ITER whose SCOPE spans the braces.
      def block_iter: (untyped block) -> untyped

      # The local table of a block or a lambda: its parameters, then its
      # block-local variables, then what its body assigns.
      def block_table: (untyped params, untyped locals) -> untyped

      # block_param_def: the ARGS node, and where the body's statements start
      # (a newline right after `|` or `{` is no token). Returns [args, prev, offset].
      def block_parameters: (untyped params, untyped block) -> (::Array[nil | untyped] | ::Array[untyped])

      def numbered_args: (untyped params, untyped block, untyped args) -> untyped

      def visit_lambda_node: (untyped node) -> untyped

      def new_args_node: (untyped first, untyped last) -> untyped

      # f_args: the ARGS node for a ParametersNode.
      def parameters_args: (untyped params) -> untyped

      # opt_arg_append: each earlier item's span grows to the new item's end.
      def opt_arg_append: (untyped chain, untyped item) -> untyped

      def destructure_chain: (untyped params) -> untyped

      # f_margs: a MASGN over destructured parameters, valued by an internal
      # variable at the list's start.
      def f_margs: (untyped node) -> untyped

      def visit_required_parameter_node: (untyped node) -> untyped

      # bodystmt: statements, then rescue clauses, else, and ensure.
      # Returns [node, first, last, offset].
      def bodystmt: (untyped node, untyped prev, untyped offset, ?newline: bool, ?absorb: bool) -> (untyped | ::Array[untyped])

      # opt_rescue: `k_rescue exc_list exc_var then compstmt opt_rescue`.
      def rescue_clause: (untyped node, untyped _offset) -> ::Array[untyped]

      def set_value: (untyped target, untyped value, untyped first, untyped last) -> untyped

      def visit_begin_node: (untyped node) -> untyped

      def visit_rescue_modifier_node: (untyped node) -> untyped

      def visit_def_node: (untyped node) -> untyped

      def visit_class_node: (untyped node) -> untyped

      def cpath: (untyped node) -> untyped

      def visit_module_node: (untyped node) -> untyped

      def visit_singleton_class_node: (untyped node) -> untyped

      def visit_alias_method_node: (untyped node) -> untyped

      def visit_alias_global_variable_node: (untyped node) -> untyped

      def visit_undef_node: (untyped node) -> untyped

      # `tLPAREN compstmt ')'` wraps the statements in a BLOCK; the lexer's
      # tLPAREN_ARG (a parenthesis after a method name and a space) does not.
      def visit_parentheses_node: (untyped node) -> untyped

      ARG_KEYWORDS: ::Array["yield" | "super" | "defined?" | "not"]

      KEYWORDS: ::Array["alias" | "and" | "begin" | "BEGIN" | "break" | "case" | "class" | "def" | "defined?" | "do" | "else" | "elsif" | "end" | "END" | "ensure" | "false" | "for" | "if" | "in" | "module" | "next" | "nil" | "not" | "or" | "redo" | "rescue" | "retry" | "return" | "self" | "super" | "then" | "true" | "undef" | "unless" | "until" | "when" | "while" | "yield" | "__FILE__" | "__LINE__" | "__ENCODING__"]

      def lparen_arg?: (untyped offset) -> (false | untyped | true)

      def identifier_byte?: (untyped c) -> untyped

      def visit_and_node: (untyped node) -> untyped

      def visit_or_node: (untyped node) -> untyped

      def visit_if_node: (untyped node) -> untyped

      def if_body: (untyped node, untyped cond, untyped type, ?nested: bool) -> untyped

      # prism gives an `elsif` without `then` the `then` of the branch before it.
      def then_keyword_of: (untyped node) -> untyped

      def elsif_node: (untyped node) -> untyped

      # An elsif's span runs to the end of its last clause's statements.
      def elsif_last: (untyped node) -> untyped

      # compstmt's span without building nodes.
      def compstmt_span: (untyped statements, untyped prev, untyped offset, ?bool newline, ?bool absorb) -> ::Array[nil | untyped]

      def visit_unless_node: (untyped node) -> untyped

      def visit_else_node: (untyped node) -> untyped

      def visit_while_node: (untyped node) -> untyped

      def visit_until_node: (untyped node) -> untyped

      def loop_node: (untyped node, untyped type) -> untyped

      def visit_for_node: (untyped node) -> untyped

      def visit_case_node: (untyped node) -> untyped

      # case_body: WHEN nodes chained through `next`, ending in the else body.
      def when_chain: (untyped conditions, untyped else_clause) -> untyped

      def when_clause: (untyped node) -> ::Array[untyped]

      def case_args: (untyped conditions) -> untyped

      def visit_break_node: (untyped node) -> untyped

      def visit_next_node: (untyped node) -> untyped

      def visit_return_node: (untyped node) -> untyped

      def jump: (untyped node, untyped type) -> untyped

      def visit_redo_node: (untyped node) -> untyped

      def visit_retry_node: (untyped node) -> untyped

      # new_defined: a `;` inside the expression keeps it whole in a BLOCK.
      def visit_defined_node: (untyped node) -> untyped

      def visit_pre_execution_node: (untyped node) -> untyped

      def visit_post_execution_node: (untyped node) -> untyped

      def visit_shareable_constant_node: (untyped node) -> untyped

      def visit_missing_node: (untyped node) -> untyped

      def visit_case_match_node: (untyped node) -> untyped

      def in_clause: (untyped node) -> ::Array[untyped]

      def top_pattern: (untyped node) -> untyped

      def pattern: (untyped node, ?top: bool) -> untyped

      # p_rest: `*name` assigns; a bare `*` is no node.
      def pattern_rest: (untyped node) -> (nil | untyped)

      # The LIST cells p_args builds, one per element, concatenated.
      def pattern_list: (untyped items) -> untyped

      def array_pattern: (untyped node, untyped top) -> untyped

      def list_concat_or_new: (untyped list, untyped tail) -> untyped

      def find_pattern: (untyped node) -> untyped

      def hash_pattern: (untyped node) -> untyped

      def trailing_comma?: (untyped offset) -> untyped

      def comma_offset: (untyped offset) -> untyped

      def visit_match_predicate_node: (untyped node) -> untyped

      def visit_match_required_node: (untyped node) -> untyped
    end
  end
end
