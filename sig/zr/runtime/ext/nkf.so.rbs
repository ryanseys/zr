    LONG_OPTIONS: untyped

    # One candidate of the input guesser: struct input_code.
    InputCode: untyped

    # A conversion of `src` under the options `opt`: rb_nkf_convert.
    def self.convert: (untyped opt, untyped src) -> untyped

