    def nfc_getc: () -> untyped

    def nfc_ungetc: (untyped c) -> untyped

    # Newline conversion (-Lu -Lw -Lm -c -d), and the newline kind the
    # guesser reports.
    def eol_conv: (untyped c2, untyped c1) -> untyped

    def newline_bytes: () -> untyped

    def put_newline: (untyped func) -> untyped

    def oconv_newline: (untyped func) -> untyped

    # -f and -F: line folding with nkf's simple kinsoku rules.
    def fold_conv: (untyped c2, untyped c1) -> untyped

    KINSOKU_ASCII: untyped

    KINSOKU_X0201: ::Array[untyped]

    KINSOKU_X0208: untyped

    # fold_conv for a character that takes room on the line.
    def fold_char: (untyped c2, untyped c1) -> (1 | untyped)

    # X0201 kana to X0208, by the byte after 0xA0 (two bytes per entry).
    CV: ::Array[33 | 35 | 86 | 87 | 34 | 38 | 37 | 114 | 39 | 41 | 99 | 101 | 103 | 67 | 60 | 36 | 40 | 42 | 43 | 45 | 47 | 49 | 51 | 53 | 55 | 57 | 59 | 61 | 63 | 65 | 68 | 70 | 72 | 74 | 75 | 76 | 77 | 78 | 79 | 82 | 85 | 88 | 91 | 94 | 95 | 96 | 97 | 98 | 100 | 102 | 104 | 105 | 106 | 107 | 108 | 109 | 111 | 115 | 44 | 0]

    # The voiced (dakuten) forms.
    DV: untyped

    # The semi-voiced (handakuten) forms.
    EV: untyped

    # The semi-voiced forms JIS X 0213 adds.
    EV_X0213: untyped

    # X0208 symbols to ASCII, from row 1 cell 0x20.
    FV: ::Array[0 | 44 | 46 | 58 | 59 | 63 | 33 | 39 | 96 | 94 | 95 | 45 | 47 | 92 | 124 | 34 | 40 | 41 | 91 | 93 | 123 | 125 | 60 | 62 | 43 | 61 | 36 | 37 | 35 | 38 | 42 | 64]

    # X0208 katakana (row 5, from cell 0x20) to X0201: the kana, and a
    # voiced or semi-voiced mark after it.
    FULLWIDTH_TO_HALFWIDTH: ::Array[0 | 9984 | 12544 | 10240 | 12800 | 10496 | 13056 | 10752 | 13312 | 11008 | 13568 | 13824 | 13918 | 14080 | 14174 | 14336 | 14430 | 14592 | 14686 | 14848 | 14942 | 15104 | 15198 | 15360 | 15454 | 15616 | 15710 | 15872 | 15966 | 16128 | 16222 | 16384 | 16478 | 16640 | 16734 | 12032 | 16896 | 16990 | 17152 | 17246 | 17408 | 17502 | 17664 | 17920 | 18176 | 18432 | 18688 | 18944 | 19038 | 19039 | 19200 | 19294 | 19295 | 19456 | 19550 | 19551 | 19712 | 19806 | 19807 | 19968 | 20062 | 20063 | 20224 | 20480 | 20736 | 20992 | 21248 | 11264 | 21504 | 11520 | 21760 | 11776 | 22016 | 22272 | 22528 | 22784 | 23040 | 23296 | 23552 | 9728 | 23808 | 13150 | 13919 | 14175 | 14431 | 14687 | 14943 | 15967 | 16991 | 17503]

    # X0208 symbols -Z4 writes as X0201.
    HALFWIDTH_SYMBOLS: { 35 => 161, 86 => 162, 87 => 163, 34 => 164, 38 => 165, 60 => 176, 43 => 222, 44 => 223 }

    HTML_ENTITIES: ::Hash[untyped, "&gt;" | "&lt;" | "&quot;" | "&amp;"]

    # A byte of a kana table entry, 0 where C would read past the table.
    def kana: (untyped table, untyped c, untyped offset) -> untyped

    # z_conv: X0201 katakana to X0208 (joining voiced marks), and the -Z
    # conversions.
    def z_conv: (untyped c2, untyped c1) -> (nil | untyped)

    def rot13: (untyped c) -> untyped

    def rot47: (untyped c) -> untyped

    # -r: ROT13 on ASCII, ROT47 on JIS.
    def rot_conv: (untyped c2, untyped c1) -> untyped

    # -h1 katakana to hiragana, -h2 hiragana to katakana.
    def hira_conv: (untyped c2, untyped c1) -> (nil | untyped)

    ISO2022JP_RANGES: ::Array[::Array[8751 | 8761] | ::Array[8770 | 8777] | ::Array[8785 | 8795] | ::Array[8811 | 8817] | ::Array[8826 | 8829] | ::Array[8993 | 9007] | ::Array[9018 | 9024] | ::Array[9051 | 9056] | ::Array[9083 | 9086] | ::Array[9332 | 9342] | ::Array[9591 | 9598] | ::Array[9785 | 9792] | ::Array[9817 | 9854] | ::Array[10050 | 10064] | ::Array[10098 | 10110] | ::Array[10305 | 10366] | ::Array[20308 | 20350] | ::Array[29733 | 29822]]

    # -I: characters outside ISO-2022-JP become a geta mark.
    def iso2022jp_check_conv: (untyped c2, untyped c1) -> untyped

    MIME_PATTERNS: untyped

    MIME_PRIORITY_FUNC: ::Array[:e_iconv | :s_iconv | nil | :w_iconv]

    MIME_ENCODE: ::Array[untyped | 0]

    MIME_ENCODE_METHOD: untyped

    MIME_B: untyped

    MIME_Q: untyped

    BASIS_64: untyped

    def mime_buf_get: (untyped index) -> untyped

    def mime_buf_set: (untyped index, untyped c) -> untyped

    def mime_ungetc: (untyped c) -> untyped

    def mime_ungetc_buf: (untyped c) -> untyped

    def mime_getc_buf: () -> untyped

    def switch_mime_getc: () -> (nil | untyped)

    def unswitch_mime_getc: () -> untyped

    # In buffered mode, the encoded word read ahead up to its "?=", so a
    # broken word passes through undecoded.
    def mime_integrity: (untyped pattern) -> 1

    # "=?" read: the charset and encoding matched against nkf's patterns.
    def mime_begin_strict: () -> untyped

    # -mN: only "=?" is checked, and a false start is read again from the
    # buffer.
    def mime_begin: () -> untyped

    def base64decode: (untyped c) -> untyped

    # The white space after an encoded word's "?=": dropped before the
    # next "=?", kept otherwise, with folded lines joined. `q_encoding`
    # picks the CR rule the Q decoder uses; the B decoder's differs.
    def mime_after_word: (untyped q_encoding) -> untyped

    def mime_getc: () -> untyped

    def mime_getc_q: (untyped exit_mode) -> untyped

    # One base64 character, skipping white space unless the decoding is
    # strict. Returns [c, nil] or [nil, value to return].
    def mime_b_char: () -> untyped

    def mime_getc_b: (untyped exit_mode) -> untyped

    def open_mime: (untyped mode) -> untyped

    def mime_prechar: (untyped c2, untyped c1) -> (untyped | nil | untyped | nil | nil)

    def close_mime: () -> untyped

    def eof_mime: () -> (nil | untyped)

    def mimeout_addchar: (untyped c) -> untyped

    def mimeout_push: (untyped c) -> untyped

    def mime_putc: (untyped c) -> (nil | untyped)

    def mime_putc_eof: () -> untyped

    BOUNDARY: untyped

    # mime_putc for a plain character outside an encoded word. True when
    # the character is dealt with.
    def mime_putc_plain: (untyped c) -> true

    # mime_putc for a plain character inside an encoded word. True when
    # the character is dealt with.
    def mime_putc_encoded: (untyped c, untyped lastchar) -> (true | false)

    def base64_conv: (untyped c2, untyped c1) -> untyped

    # module_connection: the filter chains that the options select.
    def module_connection: () -> untyped

    def set_input_mode: (untyped mode) -> untyped

    # kanji_convert: the main loop.
    def kanji_convert: () -> (nil | untyped)

    # A first byte: [:send, c2, c1] to convert what it makes, [:next, c2,
    # c1] to read on with c2 kept, or [:last] to stop.
    def first_byte: (untyped c1) -> (::Array[:next | untyped] | ::Array[:send | untyped] | ::Array[:next | untyped] | ::Array[:send | untyped] | ::Array[:send | untyped] | ::Array[:next | untyped] | ::Array[:send | untyped] | ::Array[:send | untyped] | ::Array[:next | 0 | untyped] | ::Array[:next | untyped] | untyped | ::Array[:send | 0 | untyped] | ::Array[:next | 0 | untyped] | ::Array[:next | 0 | untyped] | untyped | untyped | ::Array[:send | 0 | untyped])

    # "=" in ASCII: perhaps the start of a MIME encoded word.
    def mime_start: () -> untyped

    # An ISO-2022 escape sequence.
    def escape_sequence: () -> (::Array[:last] | ::Array[:send | untyped] | untyped)

    # ESC in Shift_JIS: the J-PHONE emoji escapes.
    JPHONE_EMOJI_FIRST_TABLE: ::Array[57824 | 57312 | 58080 | 58336 | 58592 | 57568]

    def jphone_escape: () -> (::Array[:last] | ::Array[:next | 0 | untyped] | ::Array[:send | 0 | untyped])

    # The character a first and second byte make, by the input mode.
    def send_char: (untyped c2, untyped c1) -> untyped

    def send_combining6: (untyped c2, untyped c1, untyped c3) -> (untyped | untyped | untyped | untyped | nil)

    def convert_utf32: () -> untyped

    def convert_utf16: () -> untyped
  end

  AUTO: nil

  NOCONV: nil

  UNKNOWN: nil

  BINARY: untyped

  ASCII: untyped

  JIS: untyped

  EUC: untyped

  SJIS: untyped

  UTF8: untyped

  UTF16: untyped

  UTF32: untyped

  # Full version string of nkf
  VERSION: untyped

  # Version of nkf
  NKF_VERSION: untyped

  # Release date of nkf
  NKF_RELEASE_DATE: untyped

  # Version of nkf library
  GEM_VERSION: untyped

  #  call-seq:
  #     NKF.nkf(opt, str)   => string
  #
  #  Convert _str_ and return converted result.
  #  Conversion details are specified by _opt_ as String.
  def self?.nkf: (untyped opt, untyped str) -> untyped

  #  call-seq:
  #     NKF.guess(str)  => encoding
  #
  #  Returns guessed encoding of _str_ by nkf routine.
  def self?.guess: (untyped str) -> untyped
end
