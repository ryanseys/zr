class Date
  FRAG_SETS: ::Array[::Array[:time | ::Array[:hour | :min | :sec]] | ::Array[nil | ::Array[:jd]] | ::Array[:ordinal | ::Array[:year | :yday | :hour | :min | :sec]] | ::Array[:civil | ::Array[:year | :mon | :mday | :hour | :min | :sec]] | ::Array[:commercial | ::Array[:cwyear | :cweek | :cwday | :hour | :min | :sec]] | ::Array[:wday | ::Array[:wday | :hour | :min | :sec]] | ::Array[:wnum0 | ::Array[:year | :wnum0 | :wday | :hour | :min | :sec]] | ::Array[:wnum1 | ::Array[:year | :wnum1 | :wday | :hour | :min | :sec]] | ::Array[nil | ::Array[:cwyear | :cweek | :wday | :hour | :min | :sec]] | ::Array[nil | ::Array[:year | :wnum0 | :cwday | :hour | :min | :sec]] | ::Array[nil | ::Array[:year | :wnum1 | :cwday | :hour | :min | :sec]]]

  def self.parse: (untyped text, ?bool comp, ?untyped start) -> untyped

  def self.iso8601: (?::String text, ?untyped start) -> untyped

  def self.rfc3339: (?::String text, ?untyped start) -> untyped

  def self.xmlschema: (?::String text, ?untyped start) -> untyped

  def self.rfc2822: (?::String text, ?untyped start) -> untyped

  alias self.rfc822 self.rfc2822

  def self.httpdate: (?::String text, ?untyped start) -> untyped

  def self.jisx0301: (?::String text, ?untyped start) -> untyped

  def self.strptime: (?::String text, ?::String format, ?untyped start) -> untyped

  private

  # The date the elements name, or nil, so every reader raises where
  # its own caller can see it.
  def self.frags_date: (untyped found, untyped start) -> (nil | untyped)

  # The day the elements name. A plain civil date needs no completion.
  def self.frags_jd: (untyped found, untyped start, untyped datetime) -> untyped

  # Seconds since the epoch represent a whole date and time.
  def self.rewrite_frags: (untyped found) -> (nil | untyped)

  def self.complete_frags: (untyped found, untyped datetime) -> untyped

  def self.widest_frag_set: (untyped found) -> untyped

  # What a set is missing comes from today, up to its first element
  # that the reader did find.
  def self.complete_kind: (untyped found, untyped kind, untyped names) -> (untyped | nil)

  # A leap second reads as the last second of the minute.
  def self.complete_time: (untyped found, untyped leap) -> untyped

  # The first shape the elements make a real day in.
  def self.valid_date_frags: (untyped found, untyped start) -> untyped

  def self.commercial_frags: (untyped found, untyped start) -> (nil | untyped)

  def self.weeknum_frags: (untyped found, untyped start, untyped first) -> (nil | untyped)

  # A week number counted from the first `first` day of the year.
  def self.weeknum_jd: (untyped year, untyped week, untyped wday, untyped first, untyped start) -> untyped

  def self.jd_weeknum: (untyped jd, untyped first, untyped start) -> ::Array[untyped]

  def self.valid_weeknum_jd: (untyped year, untyped week, untyped wday, untyped first, untyped start) -> untyped
end

class DateTime < Date
  def self.parse: (untyped text, ?bool comp, ?untyped start) -> untyped

  def self.iso8601: (?::String text, ?untyped start) -> untyped

  def self.rfc3339: (?::String text, ?untyped start) -> untyped

  def self.xmlschema: (?::String text, ?untyped start) -> untyped

  def self.rfc2822: (?::String text, ?untyped start) -> untyped

  alias self.rfc822 self.rfc2822

  def self.httpdate: (?::String text, ?untyped start) -> untyped

  def self.jisx0301: (?::String text, ?untyped start) -> untyped

  # datetime_s__strptime: Date's reader, with a time and a zone in the
  # format that it takes by default.
  def self._strptime: (untyped text, ?::String format) -> untyped

  def self.strptime: (?::String text, ?::String format, ?untyped start) -> untyped

  private

  def self.frags_date: (untyped found, untyped start) -> (nil | untyped)

  # An offset past a whole day is no offset at all.
  def self.offset_seconds: (untyped offset) -> (0 | untyped)
end
