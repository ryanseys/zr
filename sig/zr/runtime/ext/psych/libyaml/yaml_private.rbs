# The character tests of libyaml 0.2.5 (src/yaml_private.h). Each one
# looks at the UTF-8 bytes of `string` at byte offset `at`, the way the
# C macros look at `string.pointer[offset]`.
#
# libyaml's strings end with a NUL byte, so a test past the last byte
# sees 0. `getbyte` returns nil there, and the tests read nil as 0.
module Psych
  module LibYAML
    module Chars
      private

      # CHECK_AT
      def check_at?: (untyped string, untyped octet, untyped at) -> untyped

      # IS_ALPHA_AT: a digit, a letter, '_' or '-'.
      def alpha_at?: (untyped string, untyped at) -> untyped

      # IS_DIGIT_AT
      def digit_at?: (untyped string, untyped at) -> untyped

      # AS_DIGIT_AT
      def as_digit_at: (untyped string, untyped at) -> untyped

      # IS_HEX_AT
      def hex_at?: (untyped string, untyped at) -> untyped

      # AS_HEX_AT
      def as_hex_at: (untyped string, untyped at) -> untyped

      # IS_ASCII_AT
      def ascii_at?: (untyped string, untyped at) -> untyped

      # IS_PRINTABLE_AT: a character YAML can show without an escape.
      def printable_at?: (untyped string, untyped at) -> (true | untyped | false)

      # IS_Z_AT
      def z_at?: (untyped string, untyped at) -> untyped

      # IS_BOM_AT
      def bom_at?: (untyped string, untyped at) -> untyped

      # IS_SPACE_AT
      def space_at?: (untyped string, untyped at) -> untyped

      # IS_TAB_AT
      def tab_at?: (untyped string, untyped at) -> untyped

      # IS_BLANK_AT: a space or a tab.
      def blank_at?: (untyped string, untyped at) -> untyped

      # IS_BREAK_AT: CR, LF, NEL, LS or PS.
      def break_at?: (untyped string, untyped at) -> untyped

      # IS_CRLF_AT
      def crlf_at?: (untyped string, untyped at) -> untyped

      # IS_BREAKZ_AT: a line break or NUL.
      def breakz_at?: (untyped string, untyped at) -> untyped

      # IS_BLANKZ_AT: a space, a tab, a line break or NUL.
      def blankz_at?: (untyped string, untyped at) -> untyped

      # WIDTH_AT: the byte length of the UTF-8 character that starts here.
      def width_at: (untyped string, untyped at) -> untyped

      # A NUL-terminated view of a string: the bytes before the first NUL,
      # which is what strlen, strcmp and strdup see.
      def c_string: (untyped string) -> untyped

      # A new, empty, binary string buffer.
      def new_string: () -> untyped
    end
  end
end
