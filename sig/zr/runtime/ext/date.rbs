class Date
  include Comparable

  VERSION: "3.5.1"

  ITALY: 2299161

  ENGLAND: 2361222

  JULIAN: untyped

  GREGORIAN: untyped

  MONTHNAMES: untyped

  DAYNAMES: untyped

  ABBR_MONTHNAMES: untyped

  ABBR_DAYNAMES: untyped

  DAY: 86400

  NANOSECOND: 1000000000

  # The first and the last day a calendar reform can start on.
  REFORM_BEGIN_JD: 2298874

  REFORM_END_JD: 2426355

  class Error < ArgumentError
  end

  # A value larger, or smaller, than every date. Ranges of dates use it
  # for an open end.
  # The gem's lib/date.rb writes this in Ruby.
  class Infinity < Numeric
    @d: untyped

    def initialize: (?::Integer d) -> void

    def d: () -> untyped

    def zero?: () -> false

    def finite?: () -> false

    def infinite?: () -> untyped

    def nan?: () -> untyped

    def abs: () -> untyped

    def -@: () -> untyped

    def +@: () -> untyped

    def <=>: (untyped other) -> untyped

    def coerce: (untyped other) -> untyped

    def to_f: () -> (0 | untyped)
  end

  private

  # The Julian day number of a civil date, with no validity check.
  def self.civil_jd: (untyped year, untyped month, untyped day, untyped start) -> untyped

  # The year, month and day a Julian day number names.
  def self.jd_civil: (untyped jd, untyped start) -> untyped

  # The Julian day number of a valid civil date, or nil. A negative
  # month or day counts back from the end of the year or the month.
  def self.valid_civil_jd: (untyped year, untyped month, untyped day, untyped start) -> (nil | untyped)

  # The last day of a month, which the Gregorian reform can shorten.
  def self.last_day_jd: (untyped year, untyped month, untyped start) -> (untyped | nil)

  def self.first_day_jd: (untyped year, untyped start) -> (untyped | nil)

  def self.valid_ordinal_jd: (untyped year, untyped yday, untyped start) -> (nil | untyped)

  def self.commercial_jd: (untyped cwyear, untyped cweek, untyped cwday, untyped start) -> untyped

  def self.valid_commercial_jd: (untyped cwyear, untyped cweek, untyped cwday, untyped start) -> (nil | untyped)

  def self.jd_commercial: (untyped jd, untyped start) -> ::Array[untyped]

  def self.jd_wday: (untyped jd) -> untyped

  public

  # A date from its own parts, which no caller checks again. A simple
  # date has a day and no time of day, as date_core.c's
  # SimpleDateData does; Date's own constructors make one.
  def self.at: (untyped jd, untyped df, untyped sf, untyped of, untyped start, ?simple: bool) -> untyped

  def self.jd: (?::Integer jd, ?untyped start) -> untyped

  private

  # date_s_civil: a date from its civil parts. It never calls the
  # initialize that a subclass defines.
  def self.civil: (?::Integer year, ?::Integer month, ?::Integer day, ?untyped start) -> untyped

  public

  # date_initialize reads the parts last to first. A fraction of a day
  # is lost, because `new` returns the date it allocated and not the one
  # that the fraction moved.
  def self.civil_day: (untyped year, untyped month, untyped day, untyped start) -> ::Array[untyped]

  # Date.new: date_initialize, on the simple date that Date.allocate
  # makes. A DateTime's allocation is not simple.
  def initialize: (?::Integer year, ?::Integer month, ?::Integer day, ?untyped start) -> void

  # d_lite_initialize_copy: a copy takes the other date's parts. A
  # simple date cannot take the parts of one with a time of day.
  def initialize_copy: (untyped date) -> (self | untyped)

  def self.ordinal: (?::Integer year, ?::Integer yday, ?untyped start) -> untyped

  private

  def self.commercial: (?::Integer cwyear, ?::Integer cweek, ?::Integer cwday, ?untyped start) -> untyped

  public

  def self.today: (?untyped start) -> untyped

  def self.valid_jd?: (untyped jd, ?untyped start) -> (false | true)

  def self.valid_civil?: (untyped year, untyped month, untyped day, ?untyped start) -> (false | untyped)

  alias self.valid_date? self.valid_civil?

  def self.valid_ordinal?: (untyped year, untyped yday, ?untyped start) -> (false | untyped)

  def self.valid_commercial?: (untyped cwyear, untyped cweek, untyped cwday, ?untyped start) -> (false | untyped)

  def self.gregorian_leap?: (untyped year) -> untyped

  alias self.leap? self.gregorian_leap?

  def self.julian_leap?: (untyped year) -> untyped

  # check_numeric: each part of a date is a Numeric.
  def self.numeric: (untyped value, untyped name) -> untyped

  # A year as a whole number; a year past every whole number is no date.
  def self.integer: (untyped value) -> untyped

  # val2sg: the day the Gregorian calendar starts, as NUM2DBL reads it.
  # A day outside the years of the reform is ignored for ITALY.
  def self.valid_start: (untyped start) -> untyped

  private

  # date_core.c keeps a date in a C struct, so a program sees no
  # instance variable on one. Here its parts live in a hidden slot: the
  # UTC day number, the second of that day and its nanosecond, the
  # offset in seconds, the day the Gregorian calendar starts, and
  # whether the date is simple.
  def setup: (untyped jd, untyped df, untyped sf, untyped of, untyped start, untyped simple) -> self

  # An allocated date is day 0 of the Julian period, as
  # d_lite_s_alloc_simple and d_lite_s_alloc_complex leave one.
  def parts: () -> untyped

  def offset_seconds: () -> untyped

  def reform: () -> untyped

  # The local day and second, which the offset moves off the stored UTC.
  def local: () -> ::Array[untyped]

  public

  def jd: () -> untyped

  def mjd: () -> untyped

  def ld: () -> untyped

  def ajd: () -> untyped

  def amjd: () -> untyped

  # A date with no time of day has no fraction at all.
  def day_fraction: () -> (0 | untyped)

  def start: () -> untyped

  def julian?: () -> untyped

  def gregorian?: () -> untyped

  def new_start: (?untyped start) -> untyped

  def italy: () -> untyped

  def england: () -> untyped

  def julian: () -> untyped

  def gregorian: () -> untyped

  def civil: () -> untyped

  def year: () -> untyped

  def mon: () -> untyped

  alias month mon

  def mday: () -> untyped

  alias day mday

  def yday: () -> untyped

  def wday: () -> untyped

  def commercial: () -> untyped

  def cwyear: () -> untyped

  def cweek: () -> untyped

  def cwday: () -> untyped

  def leap?: () -> untyped

  def infinite?: () -> false

  private

  # The time of day in the date's own offset: the hour, the minute and
  # the second.
  def clock: () -> ::Array[untyped]

  # A Date has a clock only to return zero from, privately.
  def hour: () -> 0

  public

  alias min hour

  alias minute hour

  alias sec hour

  alias second hour

  def self.offset_string: (untyped of) -> untyped

  # An offset as a count of seconds: a number of days, or "+HH:MM".
  def self.seconds_of: (untyped offset) -> untyped

  def self.zone_seconds: (untyped text) -> (0 | nil | untyped)

  # Whole days move the day number; a fraction moves the nanosecond.
  def +: (untyped other) -> untyped

  private

  # Whole days keep a simple date simple.
  def days_later: (untyped count) -> untyped

  # A fraction of a day makes a date that has a time of day, unless
  # the time comes back to midnight in UTC.
  def add_nanoseconds: (untyped count) -> untyped

  public

  def -: (untyped other) -> untyped

  # A month later, kept inside the month it lands in.
  def >>: (untyped months) -> untyped

  def <<: (untyped months) -> untyped

  def next_day: (?::Integer count) -> untyped

  def prev_day: (?::Integer count) -> untyped

  def next_month: (?::Integer count) -> untyped

  def prev_month: (?::Integer count) -> untyped

  def next_year: (?::Integer count) -> untyped

  def prev_year: (?::Integer count) -> untyped

  def succ: () -> untyped

  alias next succ

  def <=>: (untyped other) -> untyped

  def ===: (untyped other) -> untyped

  def eql?: (untyped other) -> untyped

  def hash: () -> untyped

  # Every date from here to `limit`, `step` days apart.
  def step: (untyped limit, ?::Integer step) ?{ (untyped) -> untyped } -> (untyped | self)

  def upto: (untyped limit) ?{ (?) -> untyped } -> untyped

  def downto: (untyped limit) ?{ (?) -> untyped } -> untyped

  def to_date: () -> self

  # A simple date stays simple; another leaves its time of day behind.
  def to_datetime: () -> untyped

  def to_time: () -> untyped

  def deconstruct_keys: (untyped keys) -> untyped

  # d_lite_marshal_dump: the period count, the UTC day number, second
  # and nanosecond, the offset and the reform day as a Float.
  def marshal_dump: () -> ::Array[0 | untyped]

  # d_lite_marshal_load: this form, or the older one of an astronomical
  # day number, an offset in days and a reform day.
  def marshal_load: (untyped values) -> untyped

  def self._load: (untyped text) -> untyped
end

# DateTime: the same value, with the time of day and the offset shown.
class DateTime < Date
  def self.new: (?::Integer year, ?::Integer month, ?::Integer day, ?::Integer hour, ?::Integer minute, ?::Integer second, ?::Integer offset, ?untyped start) -> untyped

  alias self.civil self.new

  # The second of the day and its nanosecond, with a negative part
  # counting back from the end of the hour, minute or day.
  def self.time_of_day: (untyped hour, untyped minute, untyped second) -> ::Array[untyped]

  private

  # A day number and second put back in range after the offset moved it.
  def carry: () -> untyped

  public

  def self.now: (?untyped start) -> untyped

  def self.jd: (?::Integer jd, ?::Integer hour, ?::Integer minute, ?::Integer second, ?::Integer offset, ?untyped start) -> untyped

  def self.ordinal: (?::Integer year, ?::Integer yday, ?::Integer hour, ?::Integer minute, ?::Integer second, ?::Integer offset, ?untyped start) -> untyped

  def self.commercial: (?::Integer cwyear, ?::Integer cweek, ?::Integer cwday, ?::Integer hour, ?::Integer minute, ?::Integer second, ?::Integer offset, ?untyped start) -> untyped

  def hour: () -> untyped

  def min: () -> untyped

  alias minute min

  def sec: () -> untyped

  alias second sec

  def sec_fraction: () -> untyped

  alias second_fraction sec_fraction

  def offset: () -> untyped

  def zone: () -> untyped

  def new_offset: (?::Integer offset) -> untyped

  def to_date: () -> untyped

  def to_datetime: () -> self

  def to_time: () -> untyped

  def deconstruct_keys: (untyped keys) -> untyped
end

# date_core.c's time_to_*: the proleptic Gregorian day of the time,
# which then takes the default day of the calendar reform.
class Time
  def to_time: () -> self

  def to_date: () -> untyped

  # A leap second is the last second of its minute.
  def to_datetime: () -> untyped
end
