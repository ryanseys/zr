# digest.c, in ruby: Digest.hexencode, the Digest::Instance protocol,
# Digest::Class, and Digest::Base, which runs the algorithm that a
# subclass gives in its metadata. The extension's ruby part (digest.rb,
# vendored in vendor/ruby/lib/ruby/4.0.0) uses it as it uses the C.
module Digest
  # An algorithm, as rb_digest_metadata_t describes one: which compression
  # the kernel runs, the chaining words it starts from, the lengths, and
  # the byte order of its words and its length field.
  Metadata: untyped

  def self.metadata: (untyped algorithm, untyped start, untyped digest_length, untyped block_length, untyped little_endian) -> untyped

  def self?.hexencode: (untyped str) -> untyped

  module Instance
    def update: (untyped str) -> untyped

    alias << update

    def reset: () -> untyped

    def digest_length: () -> untyped

    def block_length: () -> untyped

    def ==: (untyped other) -> (false | untyped)

    def inspect: () -> ::String

    def new: () -> untyped

    def digest: (*untyped args) -> untyped

    def digest!: () -> untyped

    def hexdigest: (*untyped args) -> untyped

    def hexdigest!: () -> untyped

    def to_s: () -> untyped

    def length: () -> untyped

    alias size length

    private

    def finish: () -> untyped
  end

  class Class
    include Instance

    def initialize: () -> void

    def self.digest: (*untyped args) -> untyped

    def self.hexdigest: (*untyped args) -> untyped
  end

  class Base < Class
    # rb_digest_base_alloc refuses before anything is made.
    def self.allocate: () -> untyped

    def self.new: (*untyped args) { (?) -> untyped } -> untyped

    private

    # get_digest_base_metadata: the nearest class up the chain that
    # gives an algorithm.
    def self.metadata_of: (untyped klass) -> untyped

    public

    def initialize_copy: (untyped obj) -> self

    def reset: () -> self

    def update: (untyped str) -> self

    alias << update

    def digest_length: () -> untyped

    def block_length: () -> untyped

    private

    # rb_digest_base_finish: the padded message's last blocks, the words
    # as the digest, and the context started again.
    def finish: () -> untyped

    def metadata: () -> untyped

    def context: () -> untyped

    def start: () -> untyped

    def compress: () -> (nil | untyped)
  end
end
