# ossl_pkey.c: OpenSSL::PKey and PKey::PKey over EVP_PKEY: reading any
# key the library decodes, generating keys and parameters, and signing,
# verifying, deriving, encrypting and decrypting with them.
module OpenSSL
  module Lib
    EVP_PKEY_RSA: 6

    EVP_PKEY_DSA: 116

    EVP_PKEY_DH: 28

    EVP_PKEY_EC: 408

    EVP_PKEY_KEYMGMT: -1

    # evp.h's selections, over core_dispatch.h's OSSL_KEYMGMT_SELECT_*.
    EVP_PKEY_KEY_PARAMETERS: 132

    EVP_PKEY_PUBLIC_KEY: 134

    EVP_PKEY_KEYPAIR: 135

    BIO_CTRL_EOF: 2

    BIO_C_FILE_TELL: 133

    # BIO_eof (bio.h).
    def self.BIO_eof: (untyped bio) -> untyped

    # BIO_tell (bio.h).
    def self.BIO_tell: (untyped bio) -> untyped
  end

  module PKey
    class PKeyError < OpenSSLError
    end

    class PKey
    end
  end

  module Ossl
    PKEY: untyped

    # ossl_pkey_wrap: `pkey` in an instance of the class its type has,
    # which owns it from here.
    def self.pkey_wrap: (untyped pkey) -> untyped

    # OSSL_BIO_reset.
    def self.bio_reset: (untyped bio) -> untyped

    # ossl_pkey_read: one decoder pass over the BIO, for one input type
    # and selection; the EVP_PKEY, or nil.
    def self.pkey_read: (untyped bio, untyped input_type, untyped selection, untyped password) -> (nil | untyped)

    # ossl_pkey_read_generic: DER, then PEM, each as a key pair, as
    # parameters, then as a public key. `password` is the Integer
    # with_password gives, so PEM_PASSWORD_CB finds the password.
    def self.pkey_read_generic: (untyped bio, untyped password) -> (untyped | nil)

    # GetPKeyPtr.
    def self.pkey: (untyped object) -> untyped

    # GetPrivPKeyPtr.
    def self.private_pkey: (untyped object) -> untyped

    # DupPKeyPtr.
    def self.dup_pkey: (untyped object) -> untyped

    # ossl_pkey_check_public_key.
    def self.check_public_key: (untyped pkey) -> (untyped | nil)

    # pkey_ctx_apply_options: each pair of `options` through
    # EVP_PKEY_CTX_ctrl_str.
    def self.apply_pkey_options: (untyped ctx, untyped options) -> untyped

    # Runs `yield` on a new EVP_PKEY_CTX, which is freed afterwards.
    def self.with_pkey_ctx: (untyped ctx) { (untyped) -> untyped } -> untyped

    # The bytes that a function fills in two calls, the first for the
    # length and the second for the bytes. `yield` gets the buffer (nil
    # first) and the length buffer, and returns whether the call worked.
    # `too_large` is the message for a length past the maximum String size.
    def self.sized_output: (untyped error_class, untyped message, ?untyped? too_large) { (untyped, untyped) -> untyped } -> untyped

    # pkey_generate.
    def self.pkey_generate: (untyped alg, untyped options, untyped generate_parameters, untyped block) -> untyped

    # pkey_gen_cb: the block of the generate call, given the keygen
    # info; an exception it raises stops the generation, and is raised
    # again once the library returns.
    def self.keygen_progress: (untyped ctx) -> untyped

    # ossl_pkey_export_traditional.
    def self.pkey_export_traditional: (untyped object, untyped to_der, ?untyped? cipher, ?untyped? password) -> untyped

    # ossl_pkey_export_spki.
    def self.pkey_export_spki: (untyped object, untyped to_der) -> untyped

    # do_pkcs8_export.
    def self.pkcs8_export: (untyped object, untyped to_der, untyped args) -> untyped

    # EVP_PKEY_CTX_new over `pkey`, raising when the library cannot.
    def self.new_pkey_ctx: (untyped pkey) -> untyped

    # The EVP_MD a digest argument names, or nil for nil.
    def self.optional_md: (untyped digest) -> (::Array[nil] | untyped)

    KEYGEN_CB: untyped
  end

  module PKey
    def self?.read: (untyped data, ?untyped? pass) { (?) -> untyped } -> untyped

    def self?.generate_parameters: (untyped alg, ?untyped? options) { (?) -> untyped } -> untyped

    def self?.generate_key: (untyped alg, ?untyped? options) { (?) -> untyped } -> untyped

    def self?.new_raw_private_key: (untyped type, untyped key) -> untyped

    def self?.new_raw_public_key: (untyped type, untyped key) -> untyped

    class PKey
      def initialize: () -> void

      def initialize_copy: (untyped other) -> self

      def oid: () -> untyped

      def inspect: () -> untyped

      def to_text: () -> untyped

      def private_to_der: (*untyped args) -> untyped

      def private_to_pem: (*untyped args) -> untyped

      def public_to_der: () -> untyped

      def public_to_pem: () -> untyped

      def raw_private_key: () -> untyped

      def raw_public_key: () -> untyped

      def compare?: (untyped other) -> untyped

      def sign: (untyped digest, untyped data, ?untyped? options) -> untyped

      def verify: (untyped digest, untyped signature, untyped data, ?untyped? options) -> untyped

      def sign_raw: (untyped digest, untyped data, ?untyped? options) -> untyped

      def verify_raw: (untyped digest, untyped signature, untyped data, ?untyped? options) -> untyped

      def verify_recover: (untyped digest, untyped signature, ?untyped? options) -> untyped

      def derive: (untyped peer) -> untyped

      def encrypt: (untyped data, ?untyped? options) -> untyped

      def decrypt: (untyped data, ?untyped? options) -> untyped
    end
  end
end
