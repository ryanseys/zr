# ossl_x509req.c: OpenSSL::X509::Request over X509_REQ.
module OpenSSL
  module X509
    class RequestError < OpenSSLError
    end

    class Request
    end
  end

  module Ossl
    X509_REQ: untyped

    # GetX509ReqPtr.
    def self.x509req: (untyped object) -> untyped
  end

  module X509
    class Request
      def initialize: (*untyped args) -> void

      def initialize_copy: (untyped other) -> self

      def to_pem: () -> untyped

      alias to_s to_pem

      def to_der: () -> untyped

      def to_text: () -> untyped

      def version: () -> untyped

      def version=: (untyped version) -> untyped

      def subject: () -> untyped

      def subject=: (untyped subject) -> untyped

      def signature_algorithm: () -> untyped

      def public_key: () -> untyped

      def public_key=: (untyped key) -> untyped

      def sign: (untyped key, untyped digest) -> self

      def verify: (untyped key) -> untyped

      def attributes: () -> (::Array[untyped] | untyped)

      def attributes=: (untyped attributes) -> untyped

      def add_attribute: (untyped attribute) -> untyped
    end
  end
end
