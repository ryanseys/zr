# ossl_ssl_session.c: OpenSSL::SSL::Session over SSL_SESSION.
module OpenSSL
  module Lib
    # d2i_SSL_SESSION_bio (ssl.h).
    def self.d2i_SSL_SESSION_bio: (untyped bio, untyped out) -> untyped
  end

  module SSL
    class SSLError < OpenSSLError
    end

    class Session
      class SessionError < OpenSSLError
      end
    end

    class SSLSocket
    end
  end

  module Ossl
    SSL_SESSION: untyped

    # A Session holding a reference to `session`, as the session callbacks
    # hand one to Ruby.
    def self.ssl_session_new: (untyped session) -> untyped
  end

  module SSL
    class Session
      def initialize: (untyped arg) -> void

      def initialize_copy: (untyped other) -> self

      def ==: (untyped other) -> (false | untyped)

      def time: () -> untyped

      def time=: (untyped time) -> untyped

      def timeout: () -> untyped

      def timeout=: (untyped timeout) -> untyped

      def id: () -> untyped

      def to_der: () -> untyped

      def to_pem: () -> untyped

      def to_text: () -> untyped
    end
  end
end
