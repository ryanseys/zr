# ossl_ns_spki.c: OpenSSL::Netscape::SPKI over NETSCAPE_SPKI.
module OpenSSL
  module Netscape
    class SPKIError < OpenSSLError
    end

    class SPKI
    end
  end

  module Ossl
    SPKI: untyped

    # spki->spkac->challenge (x509.h: NETSCAPE_SPKI starts with its
    # NETSCAPE_SPKAC, whose second field is the challenge).
    def self.spki_challenge: (untyped spki) -> untyped
  end

  module Netscape
    class SPKI
      def initialize: (*untyped args) -> void

      def to_der: () -> untyped

      def to_pem: () -> untyped

      alias to_s to_pem

      def to_text: () -> untyped

      def public_key: () -> untyped

      def public_key=: (untyped key) -> untyped

      def sign: (untyped key, untyped digest) -> self

      def verify: (untyped key) -> untyped

      def challenge: () -> untyped

      def challenge=: (untyped challenge) -> untyped
    end
  end
end
