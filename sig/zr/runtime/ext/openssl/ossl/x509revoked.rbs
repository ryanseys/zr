# ossl_x509revoked.c: OpenSSL::X509::Revoked over X509_REVOKED.
module OpenSSL
  module X509
    class RevokedError < OpenSSLError
    end

    class Revoked
    end
  end

  module Ossl
    X509_REVOKED: untyped

    # ossl_x509revoked_new.
    def self.x509revoked_new: (untyped rev) -> untyped

    # DupX509RevokedPtr.
    def self.dup_x509revoked: (untyped object) -> untyped
  end

  module X509
    class Revoked
      def initialize: (*untyped) -> void

      def initialize_copy: (untyped other) -> self

      def serial: () -> untyped

      def serial=: (untyped num) -> untyped

      def time: () -> untyped

      def time=: (untyped time) -> untyped

      def extensions: () -> untyped

      def extensions=: (untyped extensions) -> untyped

      def add_extension: (untyped extension) -> untyped

      def to_der: () -> untyped
    end
  end
end
