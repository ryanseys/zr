# ossl_x509crl.c: OpenSSL::X509::CRL over X509_CRL.
module OpenSSL
  module X509
    class CRLError < OpenSSLError
    end

    class CRL
    end
  end

  module Ossl
    X509_CRL: untyped

    # GetX509CRLPtr.
    def self.x509crl: (untyped object) -> untyped

    # ossl_x509crl_new.
    def self.x509crl_new: (untyped crl) -> untyped

    # X509_CRL_add0_revoked over a copy of `revoked`'s struct, then
    # X509_CRL_sort.
    def self.x509crl_add_revoked: (untyped crl, untyped revoked) -> untyped
  end

  module X509
    class CRL
      def initialize: (*untyped args) -> void

      def initialize_copy: (untyped other) -> self

      def version: () -> untyped

      def version=: (untyped version) -> untyped

      def signature_algorithm: () -> untyped

      def issuer: () -> untyped

      def issuer=: (untyped issuer) -> untyped

      def last_update: () -> untyped

      def last_update=: (untyped time) -> untyped

      def next_update: () -> untyped

      def next_update=: (untyped time) -> untyped

      def revoked: () -> untyped

      def revoked=: (untyped revoked) -> untyped

      def add_revoked: (untyped revoked) -> untyped

      def sign: (untyped key, untyped digest) -> self

      def verify: (untyped key) -> untyped

      def to_der: () -> untyped

      def to_pem: () -> untyped

      alias to_s to_pem

      def to_text: () -> untyped

      def extensions: () -> untyped

      def extensions=: (untyped extensions) -> untyped

      def add_extension: (untyped extension) -> untyped
    end
  end
end
