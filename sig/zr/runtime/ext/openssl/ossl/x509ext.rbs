# ossl_x509ext.c: OpenSSL::X509::Extension over X509_EXTENSION, and
# ExtensionFactory over X509V3_CTX.
module OpenSSL
  module Lib
    # struct v3_ext_ctx (x509v3.h): int flags, then X509 *issuer_cert,
    # X509 *subject_cert, X509_REQ *subject_req, X509_CRL *crl,
    # X509V3_CONF_METHOD *db_meth, void *db, EVP_PKEY *issuer_pkey.
    X509V3_CTX_SIZE: 64

    X509V3_CTX_ISSUER_CERT: 8

    X509V3_CTX_SUBJECT_CERT: 16

    X509V3_CTX_SUBJECT_REQ: 24

    X509V3_CTX_CRL: 32

    X509V3_CTX_DB: 48

    # X509V3_set_ctx_nodb (x509v3.h): ctx->db = NULL.
    def self.X509V3_set_ctx_nodb: (untyped ctx) -> untyped
  end

  module X509
    class ExtensionError < OpenSSLError
    end

    class ExtensionFactory
    end

    class Extension
    end
  end

  module Ossl
    X509_EXT: untyped

    X509_EXT_FACTORY: untyped

    # ossl_x509ext_new.
    def self.x509ext_new: (untyped ext) -> untyped

    # The factory's context, and the certificate, request or CRL it
    # reads, which the factory keeps in an instance variable so the
    # struct stays alive while the context points at it.
    def self.x509ext_factory_set: (untyped factory, untyped ivar, untyped offset, untyped object, untyped pointer) -> untyped
  end

  module X509
    class ExtensionFactory
      @config: untyped

      def issuer_certificate: () -> untyped

      def subject_certificate: () -> untyped

      def subject_request: () -> untyped

      def crl: () -> untyped

      def config: () -> untyped

      def config=: (untyped config) -> untyped

      def initialize: (?untyped? issuer_cert, ?untyped? subject_cert, ?untyped? subject_req, ?untyped? crl) -> void

      def issuer_certificate=: (untyped cert) -> untyped

      def subject_certificate=: (untyped cert) -> untyped

      def subject_request=: (untyped req) -> untyped

      def crl=: (untyped crl) -> untyped

      def create_ext: (untyped oid, untyped value, ?untyped? critical) -> untyped
    end

    class Extension
      def initialize: (*untyped args) -> void

      def initialize_copy: (untyped other) -> self

      def oid=: (untyped oid) -> untyped

      def value=: (untyped data) -> untyped

      def critical=: (untyped flag) -> untyped

      def oid: () -> untyped

      def value: () -> untyped

      def value_der: () -> untyped

      def critical?: () -> untyped

      def to_der: () -> untyped
    end
  end
end
