# ossl_ts.c: OpenSSL::Timestamp, the Time-Stamp Protocol of RFC 3161.
module OpenSSL
  module Lib
    TS_VFY_SIGNATURE: 1

    PKCS7_SIGNED_SIGNER_INFO: 32

    # The failure-info bits (ts.h), in the order ruby tests them.
    TS_FAILURE_INFO: { BAD_ALG: 0, BAD_REQUEST: 2, BAD_DATA_FORMAT: 5, TIME_NOT_AVAILABLE: 14, UNACCEPTED_POLICY: 15, UNACCEPTED_EXTENSION: 16, ADD_INFO_NOT_AVAILABLE: 17, SYSTEM_FAILURE: 25 }
  end

  module Timestamp
    class TimestampError < OpenSSLError
    end

    class Response
    end

    class TokenInfo
    end

    class Request
    end

    class Factory
    end
  end

  module Ossl
    TS_REQUEST: untyped

    TS_RESPONSE: untyped

    TS_TOKEN_INFO: untyped

    # ossl_tsfac_serial_cb: gives the library the serial ASN1_INTEGER in
    # the data word, which the library frees after this.
    TS_SERIAL_CB: untyped

    # ossl_tsfac_time_cb: the seconds in the data word, no microseconds.
    TS_TIME_CB: untyped

    # asn1_to_der.
    def self.ts_to_der: (untyped function, untyped struct) -> untyped

    # The initialize of Request, Response and TokenInfo: a struct a
    # d2i_*_bio function decodes from `der`.
    def self.ts_decode: (untyped object, untyped der, untyped type, untyped function, untyped message) -> untyped

    # The OID of a TS_MSG_IMPRINT's algorithm.
    def self.ts_imprint_algorithm: (untyped imprint) -> untyped

    # to_text of each Timestamp class.
    def self.ts_text: (untyped function, untyped struct) -> untyped

    # ossl_pkcs7_new.
    def self.pkcs7_new: (untyped p7) -> untyped

    # The signed content of a TS token: the PKCS7_SIGNED in its union.
    def self.pkcs7_signed: (untyped p7) -> untyped
  end

  module Timestamp
    class Request
      def initialize: (?untyped arg) -> void

      def algorithm: () -> untyped

      def algorithm=: (untyped algo) -> untyped

      def message_imprint: () -> untyped

      def message_imprint=: (untyped hash) -> untyped

      def version: () -> untyped

      def version=: (untyped version) -> untyped

      def policy_id: () -> untyped

      def policy_id=: (untyped oid) -> untyped

      def nonce: () -> untyped

      def nonce=: (untyped num) -> untyped

      def cert_requested?: () -> untyped

      def cert_requested=: (untyped requested) -> untyped

      def to_der: () -> untyped

      def to_text: () -> untyped
    end

    class Response
      def initialize: (untyped der) -> void

      def status: () -> untyped

      def failure_info: () -> (nil | untyped)

      def status_text: () -> untyped

      def token: () -> untyped

      def token_info: () -> (nil | untyped)

      def tsa_certificate: () -> (nil | untyped)

      def to_der: () -> untyped

      def to_text: () -> untyped

      def verify: (untyped ts_req, untyped store, ?untyped? intermediates) -> self
    end

    class TokenInfo
      def initialize: (untyped der) -> void

      def version: () -> untyped

      def policy_id: () -> untyped

      def algorithm: () -> untyped

      def message_imprint: () -> untyped

      def serial_number: () -> untyped

      def gen_time: () -> untyped

      def ordering: () -> untyped

      def nonce: () -> untyped

      def to_der: () -> untyped

      def to_text: () -> untyped
    end

    class Factory
      def create_timestamp: (untyped key, untyped certificate, untyped request) -> (nil | untyped)
    end
  end
end
