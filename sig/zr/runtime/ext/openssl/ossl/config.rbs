# ossl_config.c: OpenSSL::Config, an OpenSSL configuration file.
module OpenSSL
  class Config
    include Enumerable
  end

  class ConfigError < OpenSSLError
  end

  module Ossl
    CONFIG: untyped

    # GetConfig.
    def self.config_of: (untyped object) -> untyped

    # config_load_bio, which consumes the BIO.
    def self.config_load: (untyped conf, untyped bio) -> untyped

    # The CONF_VALUEs of the CONF's hash, in the hash's order, as
    # [section, name, value] addresses; a section's own entry has no
    # name, and its value is the STACK of its entries.
    def self.config_values: (untyped conf) -> untyped

    def self.c_string: (untyped address) -> (nil | untyped)
  end

  class Config
    def self.parse: (untyped str) -> untyped

    def self.parse_config: (untyped io) -> untyped

    def initialize: (?untyped? filename) -> void

    def initialize_copy: (untyped other) -> untyped

    def get_value: (untyped section, untyped key) -> (nil | untyped)

    def []: (untyped section) -> untyped

    def sections: () -> untyped

    def to_s: () -> untyped

    def each: () ?{ (untyped) -> untyped } -> (untyped | self)

    def inspect: () -> ::String

    DEFAULT_CONFIG_FILE: untyped
  end
end
