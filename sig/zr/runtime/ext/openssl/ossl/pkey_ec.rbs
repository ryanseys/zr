# ossl_pkey_ec.c: OpenSSL::PKey::EC, and its Group and Point.
module OpenSSL
  module Lib
    OPENSSL_EC_NAMED_CURVE: 1

    POINT_CONVERSION_COMPRESSED: 2

    POINT_CONVERSION_UNCOMPRESSED: 4

    POINT_CONVERSION_HYBRID: 6

    # d2i_ECPKParameters_bio (ec.h).
    def self.d2i_ECPKParameters_bio: (untyped bio, untyped out) -> untyped

    # i2d_ECPKParameters_bio (ec.h).
    def self.i2d_ECPKParameters_bio: (untyped bio, untyped group) -> untyped
  end

  module PKey
    class EC < PKey
      class Group
        class Error < OpenSSLError
        end
      end

      class Point
        class Error < OpenSSLError
        end
      end
    end
  end

  module Ossl
    EC_GROUP: untyped

    EC_POINT: untyped

    POINT_CONVERSION_FORMS: { uncompressed: untyped, compressed: untyped, hybrid: untyped }

    def self.ec: (untyped object) -> untyped

    # EC keys name their own type in the Get macro's message.
    def self.ec_pkey: (untyped object) -> untyped

    # ec_key_new_from_group: an EC_KEY over a Group, or over the named
    # curve `arg` names.
    def self.ec_key_new_from_group: (untyped arg) -> untyped

    # ec_group_new: a Group holding a copy of `group`.
    def self.ec_group_new: (untyped group) -> untyped

    # ec_point_new: a Point holding a copy of `point`, on a copy of
    # `group`.
    def self.ec_point_new: (untyped point, untyped group) -> untyped

    # GetECPointGroup.
    def self.ec_point_group: (untyped point) -> untyped

    # parse_point_conversion_form_symbol.
    def self.point_conversion_form: (untyped symbol) -> untyped

    # ossl_ec_group_eql.
    def self.ec_group_eql: (untyped a, untyped b) -> untyped

    # ossl_ec_group_to_string.
    def self.ec_group_to_string: (untyped object, untyped der) -> untyped

    # A BN whose BIGNUM a group function fills.
    def self.ec_group_bn: (untyped object, untyped function, untyped name) -> untyped

    # A Point on `point`'s group, as ossl_ec_point_initialize makes one
    # from a group alone.
    def self.ec_point_on_group: (untyped group_object) -> untyped

    # ossl_ec_group_initialize with one argument: a copy of a Group, the
    # parameters in PEM or DER, or a named curve.
    def self.ec_group_from: (untyped arg) -> untyped

    # ossl_ec_group_initialize with four arguments: a curve over GF(p)
    # or GF(2^m).
    def self.ec_group_curve: (untyped field, untyped p, untyped a, untyped b) -> untyped

    # ossl_ec_point_initialize.
    def self.ec_point_initialize: (untyped object, untyped args) -> untyped

    # ossl_ec_point_initialize_copy.
    def self.ec_point_initialize_copy: (untyped object, untyped other) -> untyped
  end

  module PKey
    class EC
      def self.builtin_curves: () -> untyped

      def self.generate: (untyped arg) -> untyped

      def initialize: (*untyped args) { (?) -> untyped } -> void

      def group: () -> untyped

      def group=: (untyped _group) -> untyped

      def private_key: () -> untyped

      def private_key=: (untyped _private_key) -> untyped

      def public_key: () -> untyped

      def public_key=: (untyped _public_key) -> untyped

      def private?: () -> untyped

      alias private_key? private?

      def public?: () -> untyped

      alias public_key? public?

      def generate_key!: () -> untyped

      alias generate_key generate_key!

      def check_key: () -> true

      def export: (*untyped args) -> untyped

      alias to_pem export

      def to_der: () -> untyped

      class Group
        def initialize: (*untyped args) -> void

        def initialize_copy: (untyped other) -> self

        def eql?: (untyped other) -> untyped

        alias == eql?

        def generator: () -> untyped

        def set_generator: (untyped generator, untyped order, untyped cofactor) -> self

        def order: () -> untyped

        def cofactor: () -> untyped

        def curve_name: () -> untyped

        def asn1_flag: () -> untyped

        def asn1_flag=: (untyped flag) -> untyped

        def point_conversion_form: () -> untyped

        def point_conversion_form=: (untyped form) -> untyped

        def seed: () -> untyped

        def seed=: (untyped seed) -> untyped

        def degree: () -> untyped

        def to_pem: () -> untyped

        def to_der: () -> untyped

        def to_text: () -> untyped
      end

      class Point
        def group: () -> untyped

        def initialize: (*untyped args) -> void

        def initialize_copy: (untyped other) -> untyped

        def eql?: (untyped other) -> (false | untyped)

        alias == eql?

        def infinity?: () -> untyped

        def on_curve?: () -> untyped

        def make_affine!: () -> self

        def invert!: () -> self

        def set_to_infinity!: () -> self

        def to_octet_string: (untyped conversion_form) -> untyped

        def add: (untyped other) -> untyped

        def mul: (untyped bn1, *untyped rest) -> untyped
      end
    end
  end
end
