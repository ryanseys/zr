# The access to C that the port uses, over the kernel's calls
# (lib/zr/runtime/kernel/ffi.rb): dlopen and dlsym, a call through an address with
# up to eight integer or pointer arguments, or through libffi with more,
# raw memory by address, and the kernel's callback entries. This is the
# only file of the port that refers to Primitive.
module OpenSSL
  module Native
    # dlopen's mode: every symbol bound now, and none of them seen by a
    # later dlopen's lookups.
    RTLD_NOW: 2

    RTLD_LOCAL: untyped

    # sizeof(ffi_cif), and FFI_DEFAULT_ABI.
    CIF_SIZE: 40

    DEFAULT_ABI: 1

    # The handle of the image at `path`, or nil.
    def self.open: (untyped path) -> untyped

    # Why the last open failed.
    def self.error: () -> untyped

    # The address of `name` in the image of `handle`, or 0.
    def self.symbol: (untyped handle, untyped name) -> untyped

    # The function at `address` called with `words`, Integers in the
    # signed 64-bit range: x0 as a signed Integer.
    def self.call: (untyped address, untyped words) -> untyped

    # #call, returning [x0, errno].
    def self.call_errno: (untyped address, untyped words) -> untyped

    # #call for a function that also takes `float`, a double, as its
    # last argument.
    def self.call_double: (untyped address, untyped words, untyped float) -> untyped

    # #call for a function of more than eight arguments, whose last ones
    # go on the stack, where each takes its own width: libffi places
    # them. `widths` gives each argument's, 32 or 64 bits.
    def self.call_wide: (untyped address, untyped widths, untyped words) -> untyped

    # Where `string` keeps its bytes, which end in a NUL, for C to read
    # or write while the String stays as it is.
    def self.address: (untyped string) -> untyped

    # A String argument C reads up to its NUL.
    alias self.cstring self.address

    # `length` bytes at `address`, in binary.
    def self.read: (untyped address, untyped length) -> untyped

    # How many bytes at `address` come before a NUL.
    def self.strlen: (untyped address) -> untyped

    # `string`'s bytes written at `address`.
    def self.write: (untyped address, untyped string) -> untyped

    # The address of callback entry `index`, which runs the callable
    # #dispatch set with the entry's index and its arguments.
    def self.callback: (untyped index) -> untyped

    def self.dispatch: (untyped callable) -> untyped

    # State kept on `object` under `key` that no Ruby name reaches, as
    # CRuby's C keeps a TypedData pointer and its ivars without an @.
    def self.hidden_get: (untyped object, untyped key) -> untyped

    def self.hidden_set: (untyped object, untyped key, untyped value) -> untyped

    # An instance of `klass` as its allocator makes one, even where
    # #undef_allocator took `allocate` and `new` away from programs.
    def self.allocate: (untyped klass) -> untyped

    # Whether a frame at `path` is the port's own, which the C
    # extension has no frame for.
    def self.internal_path?: (untyped path) -> untyped

    # rb_undef_alloc_func.
    def self.undef_allocator: (untyped klass) -> untyped
  end
end
