# ossl_pkcs12.c: OpenSSL::PKCS12 over PKCS12.
module OpenSSL
  module Lib
    KEY_EX: 16

    KEY_SIG: 128
  end

  class PKCS12
    class PKCS12Error < OpenSSLError
    end
  end

  module Ossl
    PKCS12_STRUCT: untyped

    # A PBE algorithm's NID, 0 for nil.
    def self.pbe_nid: (untyped name) -> (0 | untyped)
  end

  class PKCS12
    @key: untyped

    @certificate: untyped

    @ca_certs: untyped

    def key: () -> untyped

    def certificate: () -> untyped

    def ca_certs: () -> untyped

    def self.create: (untyped pass, untyped name, untyped pkey, untyped cert, ?untyped? ca, ?untyped? key_nid, ?untyped? cert_nid, ?untyped? key_iter, ?untyped? mac_iter, ?untyped? keytype) -> untyped

    def initialize_copy: (untyped other) -> self

    def initialize: (*untyped args) -> void

    def to_der: () -> untyped

    def set_mac: (untyped pass, ?untyped? salt, ?untyped? iter, ?untyped? md_name) -> nil
  end
end
