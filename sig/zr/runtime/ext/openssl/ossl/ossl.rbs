# ossl.c: the OpenSSL module, its versions and errors, and the helpers
# every other file shares (the Ossl module: ossl_raise and its kin, the
# PEM password callback, to_der).
module OpenSSL
  module Lib
    ERR_SYSTEM_FLAG: 2147483648

    ERR_REASON_MASK: 8388607

    # ERR_GET_REASON (err.h).
    def self.ERR_GET_REASON: (untyped code) -> untyped

    OPENSSL_VERSION: 0

    ERR_TXT_STRING: 2

    PEM_BUFSIZE: 1024

    # OPENSSL_free (crypto.h).
    def self.OPENSSL_free: (untyped address) -> untyped
  end

  VERSION_TEXT: untyped

  # The library that the port runs on. The headers that the C extension
  # was built against, OPENSSL_VERSION and OPENSSL_VERSION_NUMBER, are
  # ruby's, and come with the generated constants.
  OPENSSL_LIBRARY_VERSION: untyped

  OPENSSL_FIPS: true

  def self.fixed_length_secure_compare: (untyped str1, untyped str2) -> untyped

  def self?.fips_mode: () -> untyped

  def self?.fips_mode=: (untyped enabled) -> untyped

  # Generic error class for OpenSSL. All error classes in this library
  # inherit from this class.
  class OpenSSLError < StandardError
    # The OpenSSL error queue's entries when the exception was raised,
    # oldest first.
    def errors: () -> untyped

    def detailed_message: (*untyped args) -> untyped
  end

  def self?.debug: () -> untyped

  def self?.debug=: (untyped value) -> untyped

  # The errors left in OpenSSL's queue, which it empties.
  def self?.errors: () -> untyped

  # The helpers of ossl.c that the other files share.
  module Ossl
    self.@debug: untyped

    self.@references: untyped

    self.@reference_id: untyped

    self.@passwords: untyped

    self.@password_id: untyped

    self.@collections: untyped

    self.@collection_id: untyped

    # dOSSL: whether the error queue's entries are written to stderr as
    # they are dropped.
    def self.debug: () -> untyped

    def self.debug=: (untyped value) -> untyped

    # ossl_make_error: an instance of `klass` whose message is `message`
    # followed by the reason of the newest error in OpenSSL's queue, and
    # whose #errors are the queue's entries, which it empties.
    def self.error: (untyped klass, ?untyped? message) -> untyped

    # ossl_clear_error: empties the queue, writing each entry to stderr
    # when OpenSSL.debug is on.
    def self.clear_error: () -> untyped

    # collect_errors_into.
    def self.collect_errors: (untyped into) -> (nil | untyped)

    # rb_check_frozen.
    def self.check_frozen: (untyped object) -> (untyped | nil)

    # rb_warn: `message` at the program's line that called into the
    # extension, the frames of the port itself skipped as the C
    # extension has none.
    def self.warn: (untyped message) -> untyped

    # OSSL_Check_Kind.
    def self.check_kind: (untyped object, untyped klass) -> (nil | untyped)

    # Check_Type(value, T_ARRAY).
    def self.check_array: (untyped value) -> (untyped | nil)

    # An Integer that a C struct's ex_data or callback argument contains
    # in place of a Ruby object. #dereference gives the object back while
    # something else keeps it alive; 0 represents nil.
    def self.reference: (untyped object) -> (0 | untyped)

    def self.dereference: (untyped id) -> (nil | untyped)

    # The DER an i2d function writes for `object`: its length first,
    # then its bytes, raising `klass` with `message` when either fails.
    def self.i2d: (untyped function, untyped object, untyped klass, ?untyped? message) -> untyped

    # The struct a d2i function decodes from `der`, or 0.
    def self.d2i: (untyped function, untyped der) -> untyped

    # What `yield` writes into a new memory BIO, raising `klass` with
    # `message` when it returns false or 0.
    def self.bio_output: (untyped klass, ?untyped? message) { (untyped) -> untyped } -> untyped

    # StringValue.
    def self.string_value: (untyped value) -> untyped

    # StringValueCStr.
    def self.cstring_value: (untyped value) -> untyped

    # NUM2LONG.
    def self.long: (untyped value) -> untyped

    # NUM2INT.
    def self.int: (untyped value) -> untyped

    # An optional int argument: 0 when nil.
    def self.optional_int: (untyped value) -> (0 | untyped)

    # NUM2UINT: an int's range, and an unsigned int's.
    def self.uint: (untyped value) -> untyped

    # NUM2ULONG, which NUM2UINT64T is on a 64-bit machine: from -2**63,
    # which C reads as unsigned, up to 2**64 - 1.
    def self.uint64: (untyped value) -> untyped

    alias self.ulong self.uint64

    # NUM2DBL.
    def self.double: (untyped value) -> untyped

    # rb_to_int: an Integer through to_int, or a TypeError.
    def self.integer: (untyped value) -> untyped

    # rb_get_kwargs with every keyword required: the values of `names`
    # in `options`, raising as ruby does for one missing or one unknown.
    def self.keywords: (untyped options, *untyped names) -> untyped

    # How ruby's conversion errors name a value's class.
    def self.type_name: (untyped value) -> untyped

    # ossl_to_der.
    def self.to_der: (untyped object) -> untyped

    # ossl_to_der_if_possible.
    def self.to_der_if_possible: (untyped object) -> untyped

    # ossl_pem_passwd_value.
    def self.pem_password_value: (untyped password) -> (nil | untyped)

    # Runs `yield` with `password` and `block` where PEM_PASSWORD_CB
    # finds them: the Integer to pass as the callback's data argument.
    def self.with_password: (untyped password, untyped block) { (untyped) -> untyped } -> untyped

    # ossl_pem_passwd_cb: the password in `with_password`, or its block's
    # return value, copied into OpenSSL's buffer; -1 when there is none.
    def self.pem_password: (untyped buffer, untyped max_length, untyped flag, untyped id) -> (-1 | untyped)

    PEM_PASSWORD_CB: untyped

    # A C object a Ruby object owns: freed by `free`, a Lib function's
    # name or a Proc, once the collector takes this handle. The handle is
    # a separate object so that a copy of the Ruby object, which shares
    # it until initialize_copy sets its own, never frees it twice.
    # (A reader method and not attr_reader, as throughout the port: in
    # zr an attr_* method of the runtime's own files reads a hidden field.)
    class Handle
      @address: untyped

      def address: () -> untyped

      def initialize: (untyped address, untyped free) -> void

      def self.release: (untyped free, untyped address) -> untyped

      # The address, which the handle does not free after this: the
      # library took the struct over, or freed it itself.
      def take: () -> untyped
    end

    # A C struct type that the port wraps, as an rb_data_type_t describes
    # one. `name` shows in a TypeError. `klass` is the class whose
    # instances contain one. `free` frees it. The Get macro raises an error
    # for an object that contains none. `alloc` is the allocator that makes
    # one with the object, where the C extension's allocation function
    # does; it gets the object when it takes an argument.
    class DataType
      @name: untyped

      @klass: untyped

      @free: untyped

      @missing: untyped

      @alloc: untyped

      def name: () -> untyped

      def initialize: (untyped name, untyped klass, untyped free, ?untyped? missing, ?alloc: untyped?) -> void

      # TypedData_Get_Struct: the address in `object`, or nil when
      # nothing set one yet; a TypeError for an object of another type.
      def get: (untyped object) -> (untyped | nil)

      # The Get macro: #get, raising when nothing is set.
      def fetch: (untyped object) -> untyped

      # RTYPEDDATA_DATA(object) = address: `object` owns the struct from
      # here, and frees it once it is collected.
      def set: (untyped object, untyped address) -> untyped

      # The address in `object`, which the object stops owning, for a
      # library call that frees or replaces the struct. The object
      # contains nothing until #set.
      def take: (untyped object) -> untyped

      # The object contains `address` but does not own it: a struct that
      # the library lends for the length of a callback.
      def borrow: (untyped object, untyped address) -> untyped

      # TypedData_Wrap_Struct: a new instance of `klass` owning `address`.
      def wrap: (untyped klass, untyped address) -> untyped

      # A copy begins as allocate leaves an object: the handle it took
      # from `original` stays the original's.
      def unshare: (untyped copy, untyped original) -> (untyped | nil)

      def check: (untyped object) -> (nil | untyped)
    end

    # What a C iteration hands its callback, in its order: `yield` runs
    # the iteration with COLLECT_CB and the data argument to give it.
    # OBJ_NAME_do_all_sorted, OSSL_PROVIDER_do_all and lh_doall_arg all
    # call back with the item first and the data argument second.
    def self.collect: () { (untyped, untyped) -> untyped } -> untyped

    def self.collected: (untyped item, untyped id) -> 1

    # The names OBJ_NAME_do_all_sorted lists for `type`, in its order.
    def self.names: (untyped type) -> untyped

    COLLECT_CB: untyped
  end
end
