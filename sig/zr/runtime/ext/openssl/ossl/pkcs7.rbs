# ossl_pkcs7.c: OpenSSL::PKCS7 over PKCS7, and its SignerInfo and
# RecipientInfo.
module OpenSSL
  module Lib
    NID_pkcs7_data: 21

    NID_pkcs7_signed: 22

    NID_pkcs7_enveloped: 23

    NID_pkcs7_signedAndEnveloped: 24

    NID_pkcs7_digest: 25

    NID_pkcs7_encrypted: 26

    NID_pkcs9_signingTime: 52

    PKCS7_OP_SET_DETACHED_SIGNATURE: 1

    PKCS7_OP_GET_DETACHED_SIGNATURE: 2

    BIO_CTRL_FLUSH: 11

    # struct pkcs7_st (pkcs7.h): unsigned char *asn1, long length,
    # int state, int detached, ASN1_OBJECT *type, then the union d.
    PKCS7_TYPE: 24

    PKCS7_D: 32

    # PKCS7_SIGNED and PKCS7_SIGN_ENVELOPE: version, md_algs, cert, crl,
    # signer_info; the latter then enc_data, recipientinfo.
    PKCS7_SIGNED_CERT: 16

    PKCS7_SIGNED_CRL: 24

    PKCS7_SIGN_ENVELOPE_RECIPIENTINFO: 48

    # PKCS7_ENVELOPE: version, recipientinfo, enc_data.
    PKCS7_ENVELOPE_RECIPIENTINFO: 8

    # PKCS7_SIGNER_INFO: version, issuer_and_serial, digest_alg, auth_attr,
    # digest_enc_alg, enc_digest, unauth_attr, pkey.
    PKCS7_SIGNER_INFO_ISSUER_AND_SERIAL: 8

    PKCS7_SIGNER_INFO_PKEY: 56

    # PKCS7_RECIP_INFO: version, issuer_and_serial, key_enc_algor,
    # enc_key, cert.
    PKCS7_RECIP_INFO_ISSUER_AND_SERIAL: 8

    PKCS7_RECIP_INFO_ENC_KEY: 24

    PKCS7_RECIP_INFO_CERT: 32

    # PKCS7_type_is_* (pkcs7.h).
    def self.PKCS7_type: (untyped p7) -> untyped

    # PKCS7_get_detached and PKCS7_set_detached (pkcs7.h).
    def self.PKCS7_get_detached: (untyped p7) -> untyped

    def self.PKCS7_set_detached: (untyped p7, untyped value) -> untyped

    # PKCS7_is_detached (pkcs7.h).
    def self.PKCS7_is_detached: (untyped p7) -> untyped

    # BIO_flush (bio.h).
    def self.BIO_flush: (untyped bio) -> untyped
  end

  class PKCS7
    class PKCS7Error < OpenSSLError
    end

    class SignerInfo
    end

    class RecipientInfo
    end

    Signer: untyped
  end

  module Ossl
    PKCS7_STRUCT: untyped

    PKCS7_SIGNER: untyped

    PKCS7_RECIPIENT: untyped

    PKCS7_TYPES: { "signed" => untyped, "data" => untyped, "signedAndEnveloped" => untyped, "enveloped" => untyped, "encrypted" => untyped, "digest" => untyped }

    def self.pkcs7: (untyped object) -> untyped

    # ossl_PKCS7_SIGNER_INFO_dup: a copy that shares the signing key.
    def self.pkcs7_signer_info_dup: (untyped si) -> untyped

    # ossl_PKCS7_RECIP_INFO_dup: a copy that shares the certificate.
    def self.pkcs7_recip_info_dup: (untyped ri) -> (0 | untyped)

    # pkcs7_get_certs and pkcs7_get_crls: the stack at `offset` of a
    # signed or signed-and-enveloped PKCS7, or 0.
    def self.pkcs7_stack: (untyped object, untyped offset) -> untyped

    # The issuer and serial of a signer or recipient.
    def self.issuer_and_serial: (untyped info, untyped offset) -> untyped

    # ossl_pkcs7_add_certificate.
    def self.pkcs7_add_certificate: (untyped object, untyped cert) -> untyped

    # ossl_pkcs7_add_crl.
    def self.pkcs7_add_crl: (untyped object, untyped crl) -> untyped

    # ossl_protect_x509_ary2sk, freeing `bio` when the array is not one of
    # certificates.
    def self.certificate_stack: (untyped certificates, untyped bio) -> untyped
  end

  class PKCS7
    @error_string: untyped

    @data: untyped

    def data: () -> untyped

    def error_string: () -> untyped

    def error_string=: (untyped error_string) -> untyped

    def self.read_smime: (untyped arg) -> untyped

    def self.write_smime: (untyped pkcs7, ?untyped? data, ?untyped? flags) -> untyped

    def self.sign: (untyped cert, untyped key, untyped data, ?untyped? certs, ?untyped? flags) -> untyped

    def self.encrypt: (untyped certs, untyped data, ?untyped? cipher, ?untyped? flags) -> untyped

    def initialize_copy: (untyped other) -> self

    def initialize: (*untyped args) -> void

    def type=: (untyped type) -> untyped

    def type: () -> untyped

    def detached=: (untyped flag) -> untyped

    def detached: () -> (false | untyped)

    def detached?: () -> untyped

    def cipher=: (untyped cipher) -> untyped

    def add_signer: (untyped signer) -> self

    def signers: () -> untyped

    def add_recipient: (untyped recipient) -> self

    def recipients: () -> untyped

    def add_certificate: (untyped cert) -> untyped

    def certificates=: (untyped certificates) -> untyped

    def certificates: () -> untyped

    def add_crl: (untyped crl) -> untyped

    def crls=: (untyped crls) -> untyped

    def crls: () -> untyped

    def add_data: (untyped data) -> untyped

    alias data= add_data

    def verify: (untyped certs, untyped store, ?untyped? indata, ?untyped? flags) -> (false | true)

    def decrypt: (untyped pkey, ?untyped? cert, ?untyped? flags) -> untyped

    def to_pem: () -> untyped

    alias to_s to_pem

    def to_der: () -> untyped

    def to_text: () -> untyped

    class SignerInfo
      def initialize: (untyped cert, untyped key, untyped digest) -> void

      def issuer: () -> untyped

      def serial: () -> untyped

      def signed_time: () -> (nil | untyped)
    end

    class RecipientInfo
      def initialize: (untyped cert) -> void

      def issuer: () -> untyped

      def serial: () -> untyped

      def enc_key: () -> untyped
    end
  end
end
