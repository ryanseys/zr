# ossl_x509store.c: OpenSSL::X509::Store and StoreContext, certificate
# verification with a Ruby verify callback.
module OpenSSL
  module Lib
    CRYPTO_EX_INDEX_X509_STORE: 4

    CRYPTO_EX_INDEX_X509_STORE_CTX: 5

    X509_FILETYPE_PEM: 1

    X509_L_FILE_LOAD: 1

    X509_L_ADD_DIR: 2

    X509_V_OK: 0

    X509_V_ERR_CERT_REJECTED: 28

    # X509_LOOKUP_load_file (x509_vfy.h).
    def self.X509_LOOKUP_load_file: (untyped lookup, untyped name, untyped type) -> untyped

    # X509_LOOKUP_add_dir (x509_vfy.h).
    def self.X509_LOOKUP_add_dir: (untyped lookup, untyped name, untyped type) -> untyped
  end

  module X509
    class StoreError < OpenSSLError
    end

    class Store
    end

    class StoreContext
    end
  end

  module Ossl
    X509_STORE: untyped

    X509_STORE_CTX: untyped

    STCTX_VERIFY_CB_INDEX: untyped

    STORE_VERIFY_CB_INDEX: untyped

    # GetX509StorePtr.
    def self.x509store: (untyped object) -> untyped

    # ossl_verify_cb_call: `proc`'s verdict on the chain the library
    # built so far, as a StoreContext over `ctx` for the length of the
    # call. An exception in the callback counts as a rejection.
    def self.verify_cb_call: (untyped proc, untyped ok, untyped ctx) -> untyped

    # x509store_verify_cb: the StoreContext's callback, else its
    # Store's.
    def self.x509store_verify: (untyped ok, untyped ctx) -> untyped

    X509STORE_VERIFY_CB: untyped
  end

  module X509
    class Store
      @error: untyped

      @error_string: untyped

      @chain: untyped

      @verify_callback: untyped

      def verify_callback: () -> untyped

      def error: () -> untyped

      def error_string: () -> untyped

      def chain: () -> untyped

      def initialize: (*untyped args) -> void

      def verify_callback=: (untyped callback) -> untyped

      def flags=: (untyped flags) -> untyped

      def purpose=: (untyped purpose) -> untyped

      def trust=: (untyped trust) -> untyped

      def time=: (untyped time) -> untyped

      def add_file: (untyped file) -> self

      def add_path: (untyped dir) -> self

      def set_default_paths: () -> nil

      def add_cert: (untyped cert) -> self

      def add_crl: (untyped crl) -> self

      def verify: (untyped cert, ?untyped? chain) ?{ (?) -> untyped } -> untyped
    end

    class StoreContext
      @verify_callback: untyped

      @cert: untyped

      def initialize: (untyped store, ?untyped? cert, ?untyped? chain) -> void

      def verify: () -> untyped

      def chain: () -> untyped

      def error: () -> untyped

      def error=: (untyped error) -> untyped

      def error_string: () -> untyped

      def error_depth: () -> untyped

      def current_cert: () -> untyped

      def current_crl: () -> untyped

      def flags=: (untyped flags) -> untyped

      def purpose=: (untyped purpose) -> untyped

      def trust=: (untyped trust) -> untyped

      def time=: (untyped time) -> untyped
    end
  end
end
