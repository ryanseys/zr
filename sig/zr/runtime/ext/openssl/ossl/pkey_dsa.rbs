# ossl_pkey_dsa.c: OpenSSL::PKey::DSA.
module OpenSSL
  module Lib
    PEM_STRING_DSA_PUBLIC: "DSA PUBLIC KEY"
  end

  module Ossl
    def self.dsa: (untyped object) -> untyped
  end

  module PKey
    class DSA < PKey
      def initialize: (*untyped args) { (?) -> untyped } -> void

      def public?: () -> untyped

      def private?: () -> untyped

      def export: (*untyped args) -> untyped

      alias to_pem export

      alias to_s export

      def to_der: () -> untyped

      def p: () -> untyped

      def q: () -> untyped

      def g: () -> untyped

      def pub_key: () -> untyped

      def priv_key: () -> untyped

      def set_pqg: (untyped _p, untyped _q, untyped _g) -> untyped

      def set_key: (untyped _pub_key, untyped _priv_key) -> untyped
    end
  end
end
