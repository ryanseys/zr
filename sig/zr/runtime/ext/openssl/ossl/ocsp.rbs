# ossl_ocsp.c: OpenSSL::OCSP, requests and responses of the Online
# Certificate Status Protocol.
module OpenSSL
  module Lib
    OCSP_NOCERTS: 1

    V_OCSP_CERTSTATUS_REVOKED: 1
  end

  module OCSP
    class OCSPError < OpenSSLError
    end

    class Request
    end

    class Response
    end

    class BasicResponse
    end

    class SingleResponse
    end

    class CertificateId
    end
  end

  module Ossl
    # The allocator each class shares: OCSP_*_new, or OCSPError.
    def self.ocsp_alloc: (untyped new_function) -> untyped

    OCSP_REQUEST: untyped

    OCSP_RESPONSE: untyped

    OCSP_BASICRESP: untyped

    OCSP_SINGLERESP: untyped

    OCSP_CERTID: untyped

    # ossl_ocspcid_new.
    def self.ocsp_certid_new: (untyped cid) -> untyped

    # ossl_ocspsres_new.
    def self.ocsp_singleresp_new: (untyped single) -> untyped

    # The initialize_copy of each OCSP class: an ASN1_item_dup of the
    # other's struct.
    def self.ocsp_copy: (untyped object, untyped other, untyped type, untyped item) -> untyped

    # The initialize of each OCSP class given DER.
    def self.ocsp_decode: (untyped object, untyped arg, untyped type, untyped d2i) -> untyped

    # add_nonce of a request or a basic response.
    def self.ocsp_add_nonce: (untyped object, untyped type, untyped function, untyped value) -> untyped

    # sign of a request or a basic response.
    def self.ocsp_sign: (untyped object, untyped type, untyped function, untyped signer_cert, untyped signer_key, untyped certs, untyped flags, untyped digest) -> untyped

    # verify of a request or a basic response.
    def self.ocsp_verify: (untyped object, untyped type, untyped function, untyped certs, untyped store, untyped flags) -> untyped

    # add_status_convert_time.
    def self.ocsp_time: (untyped value) -> untyped

    # OCSP_single_get0_status, raising on failure: [status, reason,
    # revtime, thisupd, nextupd].
    def self.ocsp_single_status: (untyped single) -> untyped

    def self.time_or_nil: (untyped time) -> (nil | untyped)

    # A hash's bytes in lower-case hex, as ossl_bin2hex writes them.
    def self.hex: (untyped asn1_string) -> untyped

    # OCSP_id_get0_info's one out-parameter at `index`.
    def self.ocsp_id_info: (untyped cid, untyped index) -> untyped
  end

  module OCSP
    class Request
      def initialize_copy: (untyped other) -> untyped

      def initialize: (?untyped? arg) -> void

      def add_nonce: (?untyped? value) -> untyped

      def check_nonce: (untyped basic_resp) -> untyped

      def add_certid: (untyped certid) -> self

      def certid: () -> (nil | untyped)

      def signed?: () -> untyped

      def sign: (untyped signer_cert, untyped signer_key, ?untyped? certs, ?untyped? flags, ?untyped? digest) -> untyped

      def verify: (untyped certs, untyped store, ?untyped? flags) -> untyped

      def to_der: () -> untyped
    end

    class Response
      def self.create: (untyped status, untyped basic_resp) -> untyped

      def initialize_copy: (untyped other) -> untyped

      def initialize: (?untyped? arg) -> void

      def status: () -> untyped

      def status_string: () -> untyped

      def basic: () -> untyped

      def to_der: () -> untyped
    end

    class BasicResponse
      def initialize_copy: (untyped other) -> untyped

      def initialize: (?untyped? arg) -> void

      def copy_nonce: (untyped request) -> untyped

      def add_nonce: (?untyped? value) -> untyped

      def add_status: (untyped certid, untyped status, untyped reason, untyped revocation_time, untyped this_update, untyped next_update, untyped extensions) -> self

      def status: () -> untyped

      def responses: () -> untyped

      def find_response: (untyped certid) -> untyped

      def sign: (untyped signer_cert, untyped signer_key, ?untyped? certs, ?untyped? flags, ?untyped? digest) -> untyped

      def verify: (untyped certs, untyped store, ?untyped? flags) -> untyped

      def to_der: () -> untyped
    end

    class SingleResponse
      def initialize: (untyped arg) -> void

      def initialize_copy: (untyped other) -> untyped

      def check_validity: (?untyped? nsec, ?untyped? maxsec) -> (true | false)

      def certid: () -> untyped

      def cert_status: () -> untyped

      def this_update: () -> untyped

      def next_update: () -> untyped

      def revocation_time: () -> untyped

      def revocation_reason: () -> untyped

      def extensions: () -> untyped

      def to_der: () -> untyped
    end

    class CertificateId
      def initialize_copy: (untyped other) -> self

      def initialize: (untyped subject, ?untyped issuer, ?untyped? digest) -> void

      def cmp: (untyped other) -> untyped

      def cmp_issuer: (untyped other) -> untyped

      def serial: () -> untyped

      def issuer_name_hash: () -> untyped

      def issuer_key_hash: () -> untyped

      def hash_algorithm: () -> untyped

      def to_der: () -> untyped
    end
  end
end
