# ossl_bio.c: a String as a memory BIO for the library to read, and a
# memory BIO's bytes as a String.
module OpenSSL
  module Lib
    BIO_CTRL_RESET: 1

    BIO_C_GET_BUF_MEM_PTR: 115

    # BIO_get_mem_ptr (bio.h): the BUF_MEM behind a memory BIO, into the
    # pointer buffer `out`.
    def self.BIO_get_mem_ptr: (untyped bio, untyped out) -> untyped

    # BIO_reset (bio.h).
    def self.BIO_reset: (untyped bio) -> untyped

    # The address of a function that the library frees with, to give it
    # back as a pointer: sk_X509_pop_free(sk, X509_free).
    def self.function_address: (untyped name) -> untyped
  end

  module Ossl
    # ossl_obj2bio: a read-only memory BIO over `object`'s bytes (a File
    # is read first), and the String that contains those bytes, which the
    # caller keeps while the BIO is in use.
    def self.obj2bio: (untyped object) -> ::Array[untyped]

    # ossl_membio2str: the bytes in a memory BIO, freeing the BIO.
    def self.membio2str: (untyped bio) -> untyped

    # A new memory BIO to write into, for membio2str to read.
    def self.mem_bio: () -> untyped

    # The items of an OpenSSL STACK, as addresses.
    def self.stack_items: (untyped stack) -> (::Array[untyped] | untyped)
  end
end
