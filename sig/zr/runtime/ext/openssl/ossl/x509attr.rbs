# ossl_x509attr.c: OpenSSL::X509::Attribute over X509_ATTRIBUTE.
module OpenSSL
  module X509
    class AttributeError < OpenSSLError
    end

    class Attribute
    end
  end

  module Ossl
    X509_ATTR: untyped

    # ossl_x509attr_new.
    def self.x509attr_new: (untyped attr) -> untyped

    # sk_ASN1_TYPE_pop_free(stack, ASN1_TYPE_free).
    def self.free_asn1_type_stack: (untyped stack) -> untyped
  end

  module X509
    class Attribute
      def initialize: (*untyped args) -> void

      def initialize_copy: (untyped other) -> self

      def oid=: (untyped oid) -> untyped

      def oid: () -> untyped

      def value=: (untyped value) -> untyped

      def value: () -> untyped

      def to_der: () -> untyped
    end
  end
end
