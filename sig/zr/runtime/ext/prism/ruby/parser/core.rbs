module Prism
  module Ruby
    class Parser
      @previous_start: untyped

      @previous_type: untyped

      # pm_binding_power_t
      BINDING_POWER_UNSET: 0

      BINDING_POWER_STATEMENT: 2

      BINDING_POWER_MODIFIER_RESCUE: 4

      BINDING_POWER_MODIFIER: 6

      BINDING_POWER_COMPOSITION: 8

      BINDING_POWER_NOT: 10

      BINDING_POWER_MATCH: 12

      BINDING_POWER_DEFINED: 14

      BINDING_POWER_MULTI_ASSIGNMENT: 16

      BINDING_POWER_ASSIGNMENT: 18

      BINDING_POWER_TERNARY: 20

      BINDING_POWER_RANGE: 22

      BINDING_POWER_LOGICAL_OR: 24

      BINDING_POWER_LOGICAL_AND: 26

      BINDING_POWER_EQUALITY: 28

      BINDING_POWER_COMPARISON: 30

      BINDING_POWER_BITWISE_OR: 32

      BINDING_POWER_BITWISE_AND: 34

      BINDING_POWER_SHIFT: 36

      BINDING_POWER_TERM: 38

      BINDING_POWER_FACTOR: 40

      BINDING_POWER_UMINUS: 42

      BINDING_POWER_EXPONENT: 44

      BINDING_POWER_UNARY: 46

      BINDING_POWER_INDEX: 48

      BINDING_POWER_CALL: 50

      BINDING_POWER_MAX: 52

      # pm_binding_powers_t: the powers a token binds with, whether it is a
      # binary operator, and whether it is non-associative.
      BindingPowers: untyped

      # pm_binding_powers, unset for any other token.
      BINDING_POWERS: untyped

      # context_terminators: the tokens that end each context.
      CONTEXT_TERMINATORS: { none: ::Array[untyped], begin: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], begin_ensure: ::Array[:KEYWORD_END], begin_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], begin_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], block_braces: ::Array[:BRACE_RIGHT], block_keywords: ::Array[:KEYWORD_END | :KEYWORD_RESCUE | :KEYWORD_ENSURE], block_ensure: ::Array[:KEYWORD_END], block_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], block_parameters: ::Array[:PIPE], block_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], case_when: ::Array[:KEYWORD_WHEN | :KEYWORD_END | :KEYWORD_ELSE], case_in: ::Array[:KEYWORD_IN | :KEYWORD_END | :KEYWORD_ELSE], class: ::Array[:KEYWORD_END | :KEYWORD_RESCUE | :KEYWORD_ENSURE], class_ensure: ::Array[:KEYWORD_END], class_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], class_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], def: ::Array[:KEYWORD_END | :KEYWORD_RESCUE | :KEYWORD_ENSURE], def_ensure: ::Array[:KEYWORD_END], def_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], def_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], def_params: ::Array[:EOF], defined: ::Array[:EOF], default_params: ::Array[:COMMA | :PARENTHESIS_RIGHT], else: ::Array[:KEYWORD_END], elsif: ::Array[:KEYWORD_ELSE | :KEYWORD_ELSIF | :KEYWORD_END], embexpr: ::Array[:EMBEXPR_END], for: ::Array[:KEYWORD_END], for_index: ::Array[:KEYWORD_IN], if: ::Array[:KEYWORD_ELSE | :KEYWORD_ELSIF | :KEYWORD_END], lambda_braces: ::Array[:BRACE_RIGHT], lambda_do_end: ::Array[:KEYWORD_END | :KEYWORD_RESCUE | :KEYWORD_ENSURE], lambda_ensure: ::Array[:KEYWORD_END], lambda_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], lambda_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], loop_predicate: ::Array[:KEYWORD_DO | :KEYWORD_THEN], main: ::Array[:EOF], module: ::Array[:KEYWORD_END | :KEYWORD_RESCUE | :KEYWORD_ENSURE], module_ensure: ::Array[:KEYWORD_END], module_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], module_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], multi_target: ::Array[:EOF], parens: ::Array[:PARENTHESIS_RIGHT], postexe: ::Array[:BRACE_RIGHT], predicate: ::Array[:KEYWORD_THEN | :NEWLINE | :SEMICOLON], preexe: ::Array[:BRACE_RIGHT], rescue_modifier: ::Array[:EOF], sclass: ::Array[:KEYWORD_END | :KEYWORD_RESCUE | :KEYWORD_ENSURE], sclass_ensure: ::Array[:KEYWORD_END], sclass_else: ::Array[:KEYWORD_ENSURE | :KEYWORD_END], sclass_rescue: ::Array[:KEYWORD_ENSURE | :KEYWORD_RESCUE | :KEYWORD_ELSE | :KEYWORD_END], ternary: ::Array[:EOF], unless: ::Array[:KEYWORD_ELSE | :KEYWORD_END], until: ::Array[:KEYWORD_END], while: ::Array[:KEYWORD_END] }

      # The contexts inside a method (true) or a class body that ends the
      # search (false), for context_def_p.
      CONTEXT_DEF: { def: true, def_params: true, def_ensure: true, def_rescue: true, def_else: true, class: false, class_ensure: false, class_rescue: false, class_else: false, module: false, module_ensure: false, module_rescue: false, module_else: false, sclass: false, sclass_ensure: false, sclass_rescue: false, sclass_else: false }

      # context_human
      CONTEXT_HUMAN: { begin: "begin statement", block_braces: "'{'..'}' block", block_keywords: "'do'..'end' block", block_parameters: "'|'..'|' block parameter", case_when: "'when' clause", case_in: "'in' clause", class: "class definition", def: "method definition", def_params: "method parameters", default_params: "parameter default value", defined: "'defined?' expression", else: "'else' clause", begin_else: "'else' clause", block_else: "'else' clause", class_else: "'else' clause", def_else: "'else' clause", lambda_else: "'else' clause", module_else: "'else' clause", sclass_else: "'else' clause", elsif: "'elsif' clause", embexpr: "embedded expression", begin_ensure: "'ensure' clause", block_ensure: "'ensure' clause", class_ensure: "'ensure' clause", def_ensure: "'ensure' clause", lambda_ensure: "'ensure' clause", module_ensure: "'ensure' clause", sclass_ensure: "'ensure' clause", for: "for loop", for_index: "for loop index", if: "if statement", lambda_braces: "'{'..'}' lambda block", lambda_do_end: "'do'..'end' lambda block", loop_predicate: "loop predicate", main: "top level context", module: "module definition", multi_target: "multiple targets", parens: "parentheses", postexe: "'END' block", predicate: "predicate", preexe: "'BEGIN' block", begin_rescue: "'rescue' clause", block_rescue: "'rescue' clause", class_rescue: "'rescue' clause", def_rescue: "'rescue' clause", lambda_rescue: "'rescue' clause", module_rescue: "'rescue' clause", rescue_modifier: "'rescue' clause", sclass_rescue: "'rescue' clause", sclass: "singleton class definition", ternary: "ternary expression", unless: "unless statement", until: "until statement", while: "while statement" }

      private

      # match1 through match8
      def match?: (*untyped types) -> untyped

      # accept1, accept2
      def accept: (*untyped types) -> (false | true)

      # expect1, expect2: a missing token is put in its place, empty at the
      # end of the previous one, with an error there.
      def expect: (*untyped types, untyped id) -> (nil | untyped)

      # expect1_heredoc_term
      def expect_heredoc_term: (untyped ident_start, untyped ident_length) -> untyped

      # expect1_opening: the error is at the token that opened the construct.
      def expect_opening: (untyped type, untyped id, untyped opening) -> (nil | untyped)

      # context_terminator
      def context_terminator?: (untyped context, untyped type) -> untyped

      # context_recoverable: the innermost context the token ends, or :none.
      def context_recoverable: (untyped type) -> (untyped | :none)

      # context_push
      def context_push: (untyped context) -> untyped

      # context_pop
      def context_pop: () -> untyped

      # context_p
      def context?: (untyped context) -> untyped

      # context_def_p
      def context_def?: () -> (untyped | false)

      # context_human
      def context_human: (untyped context) -> untyped

      # The current context, or :none.
      def current_context: () -> untyped

      # parse_value_expression
      def parse_value_expression: (untyped binding_power, untyped accepts_command_call, untyped accepts_label, untyped id, untyped depth) -> untyped

      # Tokens that never begin an expression, though they have no binding
      # power, and the unary tokens that do, though they have one.
      NO_EXPRESSION_TOKENS: untyped

      UNARY_EXPRESSION_TOKENS: untyped

      # token_begins_expression_p
      def token_begins_expression?: (untyped type) -> (false | true | untyped)

      # parse_starred_expression
      def parse_starred_expression: (untyped binding_power, untyped accepts_command_call, untyped id, untyped depth) -> untyped

      # pm_node_unreference: before the C frees a node, its jumps leave the
      # block exits and its implicit parameters leave the scope's list.
      def node_unreference: (untyped node) -> (nil | untyped)

      # parse_write_name: `foo` as the write name `foo=`.
      def parse_write_name: (untyped name) -> untyped

      UNWRITABLE_ERRORS: ::Hash[untyped, :expression_not_writable_encoding | :expression_not_writable_false | :expression_not_writable_file | :expression_not_writable_line | :expression_not_writable_nil | :expression_not_writable_self | :expression_not_writable_true]

      # parse_unwriteable_target: `nil`, `self` and the like become local
      # targets, with an error naming them.
      def parse_unwriteable_target: (untyped target) -> untyped

      # Whether a call can become a local variable or attribute write: a
      # message without `!` or `?`, and no parentheses, arguments or block.
      def call_writable_target?: (untyped call) -> (false | untyped)

      # parse_target: the node as the target of a write. `multiple` for one of
      # several targets, where `&.` is not allowed; `splat_parent` inside a
      # splat, where fewer targets are.
      def parse_target: (untyped target, untyped multiple, untyped splat_parent) -> untyped

      # parse_target_validate: a target must be followed by `=`, by `in` in a
      # for loop's index, or by `)` in parentheses.
      def parse_target_validate: (untyped target, untyped multiple) -> untyped

      # parse_shareable_constant_write
      def parse_shareable_constant_write: (untyped write) -> untyped

      # parse_write: `target operator value` as a write node.
      def parse_write: (untyped target, untyped operator, untyped value) -> untyped

      # parse_unwriteable_write: `nil = 1` and the like become local writes,
      # with an error at the `=`.
      def parse_unwriteable_write: (untyped target, untyped equals, untyped value) -> untyped

      # parse_targets: the targets of a multiple write or a for loop's index,
      # from the first one.
      def parse_targets: (untyped first_target, untyped binding_power, untyped depth) -> untyped

      # parse_targets_validate: the targets must be followed by `=` or `)`.
      def parse_targets_validate: (untyped first_target, untyped binding_power, untyped depth) -> untyped

      # parse_statements: statements separated by newlines or semicolons, up
      # to a token that ends `context`; nil when there are none.
      def parse_statements: (untyped context, untyped depth) -> (nil | untyped)

      # parse_assocs: the elements of a hash or keyword hash; true when one is
      # a `**` splat.
      def parse_assocs: (untyped literals, untyped node, untyped depth) -> untyped

      # The value of a label with none written: a constant, a local variable,
      # or a method call of that name.
      def parse_assoc_implicit_value: (untyped label) -> untyped

      # argument_allowed_for_bare_hash: whether the argument is the key of a
      # hash without braces, which a label is, or which `=>` follows.
      def argument_allowed_for_bare_hash?: (untyped argument) -> (true | false | untyped)

      # parse_arguments_append
      def parse_arguments_append: (untyped arguments, untyped argument) -> untyped

      # parse_arguments: a call's arguments up to `terminator`, into
      # `arguments`.
      def parse_arguments: (untyped arguments, untyped accepts_forwarding, untyped terminator, untyped depth) -> (nil | untyped)
    end
  end
end
