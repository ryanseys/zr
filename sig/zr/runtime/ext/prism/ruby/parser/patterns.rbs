module Prism
  module Ruby
    class Parser
      @pattern_matching_newlines: untyped

      # PM_PARSE_PATTERN_SINGLE, _TOP and _MULTI
      PARSE_PATTERN_SINGLE: 0

      PARSE_PATTERN_TOP: 1

      PARSE_PATTERN_MULTI: 2

      # The tokens a pattern primitive may start with.
      PATTERN_PRIMITIVE_STARTS: untyped

      private

      # parse_pattern_capture: a local a pattern binds, which may not repeat
      # unless it starts with `_`.
      def parse_pattern_capture: (untyped captures, untyped capture, untyped location) -> (nil | untyped)

      # A local variable a pattern binds, added to the scope when new: its
      # target node.
      def parse_pattern_local_target: (untyped captures, untyped token) -> untyped

      # parse_pattern_constant_path: `A::B`, and `A::B[...]` or `A::B(...)`
      # around an inner pattern.
      def parse_pattern_constant_path: (untyped captures, untyped node, untyped depth) -> untyped

      # parse_pattern_rest: `*` or `*name` after the star.
      def parse_pattern_rest: (untyped captures) -> untyped

      # parse_pattern_keyword_rest: `**nil`, `**` or `**name`.
      def parse_pattern_keyword_rest: (untyped captures) -> untyped

      # pm_slice_is_valid_local
      def slice_valid_local?: (untyped start, untyped finish) -> (false | untyped)

      # parse_pattern_hash_implicit_value: `{ name: }` binds `name`.
      def parse_pattern_hash_implicit_value: (untyped captures, untyped key) -> untyped

      # parse_pattern_hash_key: an error for a repeated key.
      def parse_pattern_hash_key: (untyped keys, untyped node) -> (untyped | nil)

      # The tokens after a hash pattern key that leave its value out.
      PATTERN_HASH_VALUE_ENDS: ::Array[:COMMA | :KEYWORD_THEN | :BRACE_RIGHT | :BRACKET_RIGHT | :PARENTHESIS_RIGHT | :NEWLINE | :SEMICOLON]

      # parse_pattern_hash: a hash pattern from its first key or rest.
      def parse_pattern_hash: (untyped captures, untyped first_node, untyped depth) -> untyped

      # An array or find pattern takes the brackets around it, unless it has
      # its own already.
      def parse_pattern_bracketed: (untyped inner, untyped opening, untyped closing) -> untyped

      # parse_pattern_primitive
      def parse_pattern_primitive: (untyped captures, untyped id, untyped depth) -> untyped

      # parse_pattern_alternation_error: a capture in an alternative is an
      # error.
      def parse_pattern_alternation_error: (untyped node) -> untyped

      # parse_pattern_primitives: primitives joined by `|`, then `=> name`
      # captures.
      def parse_pattern_primitives: (untyped captures, untyped first_node, untyped id, untyped depth) -> untyped

      # parse_pattern: a pattern, which with PARSE_PATTERN_TOP may be a hash
      # pattern without braces and with PARSE_PATTERN_MULTI an array or find
      # pattern without brackets.
      def parse_pattern: (untyped captures, untyped flags, untyped id, untyped depth) -> untyped

      # parse_negative_numeric: a `-` before a number joins it.
      def parse_negative_numeric: (untyped node) -> untyped
    end
  end
end
