module Prism
  module Ruby
    class Parser
      @previous_start: untyped

      @previous_type: untyped

      @lex_state: untyped

      @current_hash_keys: untyped

      @pattern_matching_newlines: untyped

      @command_start: untyped

      # Each element has its own encoding.
      @explicit_encoding: untyped

      @lambda_enclosure_nesting: untyped

      @recovering: untyped

      # size_t -1: a <<~ heredoc's common whitespace before any line sets it.
      COMMON_WHITESPACE_UNSET: untyped

      private

      # The node of a variable at the start of a statement, or the targets of
      # a multiple write when a comma follows.
      def parse_statement_targets: (untyped node, untyped binding_power, untyped depth) -> untyped

      # [ elements ]
      def parse_array_literal: (untyped depth) -> untyped

      # Semicolons and newlines inside parentheses; the flags gain
      # MULTIPLE_STATEMENTS for a semicolon.
      def parse_parentheses_terminators: (untyped flags) -> untyped

      # ( statements ), or parenthesized targets of a multiple write.
      def parse_parentheses: (untyped binding_power, untyped depth) -> untyped

      # { assocs }
      def parse_hash_literal: (untyped depth) -> untyped

      # ?a
      def parse_character_literal: (untyped depth) -> untyped

      # Whether arguments or a block follow a name, which make it a call.
      def call_arguments_follow?: (untyped accepts_command_call) -> untyped

      # Foo, or Foo(...) as a call.
      def parse_constant: (untyped binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # an identifier: a local variable or a method call.
      def parse_identifier: (untyped binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # <<HEREDOC
      def parse_heredoc: (untyped depth) -> untyped

      # alias new old
      def parse_alias: (untyped binding_power, untyped depth) -> untyped

      # case ... when / case ... in
      def parse_case: (untyped depth) -> untyped

      # begin ... end
      def parse_begin: (untyped depth) -> untyped

      # BEGIN { ... }
      def parse_pre_execution: (untyped binding_power, untyped depth) -> untyped

      # break, next, return
      def parse_jump: (untyped accepts_command_call, untyped depth) -> untyped

      # super, super(...)
      def parse_super: (untyped accepts_command_call, untyped depth) -> untyped

      # yield
      def parse_yield_expression: (untyped accepts_command_call, untyped depth) -> untyped

      # class Name < Super, class << self
      def parse_class: (untyped depth) -> untyped

      # The receiver node a `def` names with a keyword, constant or variable.
      DEF_RECEIVERS: { CONSTANT: :constant_read_node, INSTANCE_VARIABLE: :instance_variable_read_node, CLASS_VARIABLE: :class_variable_read_node, GLOBAL_VARIABLE: :global_variable_read_node, KEYWORD_NIL: :nil_node, KEYWORD_SELF: :self_node, KEYWORD_TRUE: :true_node, KEYWORD_FALSE: :false_node, KEYWORD___FILE__: :source_file_node, KEYWORD___LINE__: :source_line_node, KEYWORD___ENCODING__: :source_encoding_node }

      # def name(params) ... end, def name = value
      def parse_def: (untyped binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # defined?(expression)
      def parse_defined: (untyped depth) -> untyped

      # END { ... }
      def parse_post_execution: (untyped binding_power, untyped depth) -> untyped

      # for index in collection ... end
      def parse_for: (untyped depth) -> untyped

      # if ... end
      def parse_if: (untyped depth) -> untyped

      # undef names
      def parse_undef: (untyped binding_power, untyped depth) -> untyped

      # not expression, not(expression)
      def parse_not: (untyped accepts_command_call, untyped depth) -> untyped

      # module Name ... end
      def parse_module: (untyped depth) -> untyped

      # while and until loops.
      def parse_loop: (untyped type, untyped depth) -> untyped

      # The end of a %-list: its closing token, or a missing one at the end
      # of the source.
      def parse_list_close: (untyped array, untyped opening, untyped term_error) -> untyped

      # A symbol element of %i or %I that gains another string part: the
      # symbol becomes an interpolated symbol of its string and this one.
      def parse_list_symbol_split: (untyped current) -> untyped

      # %i[]
      def parse_percent_lower_i: () -> untyped

      # %I[] with interpolation.
      def parse_percent_upper_i: (untyped depth) -> untyped

      # %w[]
      def parse_percent_lower_w: () -> untyped

      # %W[] with interpolation.
      def parse_percent_upper_w: (untyped depth) -> untyped

      # /regexp/
      def parse_regexp_literal: (untyped depth) -> untyped

      # `xstring`, %x()
      def parse_xstring_literal: (untyped depth) -> untyped

      # *splat at the start of a multiple write.
      def parse_splat_target: (untyped binding_power, untyped diag_id, untyped depth) -> untyped

      # ! ~ -@ +@ as prefix operators.
      def parse_unary: (untyped binding_power, untyped name, untyped depth) -> untyped

      # -1, and -2 ** 2 as -(2 ** 2).
      def parse_negative_number: (untyped depth) -> untyped

      # -> (params) { body }
      def parse_lambda: (untyped depth) -> untyped

      # A token no expression starts with: an error, and a missing node. A
      # token that closes an enclosing context starts recovery.
      def parse_unexpected: (untyped diag_id) -> untyped

      # pm_parser_err_prefix: the errors whose messages name a token.
      def err_prefix: (untyped diag_id) -> untyped

      # parse_retry: a retry belongs in a rescue clause.
      RETRY_CONTEXTS: { begin_rescue: :valid, block_rescue: :valid, class_rescue: :valid, def_rescue: :valid, lambda_rescue: :valid, module_rescue: :valid, sclass_rescue: :valid, defined: :valid, rescue_modifier: :valid, class: :invalid, def: :invalid, def_params: :invalid, main: :invalid, module: :invalid, preexe: :invalid, sclass: :invalid, begin_else: :else, block_else: :else, class_else: :else, def_else: :else, lambda_else: :else, module_else: :else, sclass_else: :else, begin_ensure: :ensure, block_ensure: :ensure, class_ensure: :ensure, def_ensure: :ensure, lambda_ensure: :ensure, module_ensure: :ensure, sclass_ensure: :ensure }

      def parse_retry: (untyped node) -> (nil | untyped)

      # parse_yield: a yield belongs in a method.
      YIELD_CONTEXTS: { def: :valid, def_params: :valid, defined: :valid, def_ensure: :valid, def_rescue: :valid, def_else: :valid, class: :invalid, class_ensure: :invalid, class_rescue: :invalid, class_else: :invalid, main: :invalid, module: :invalid, module_ensure: :invalid, module_rescue: :invalid, module_else: :invalid, sclass: :invalid, sclass_rescue: :invalid, sclass_ensure: :invalid, sclass_else: :invalid }

      def parse_yield: (untyped node) -> untyped

      # parse_regular_expression_errors: the errors the regexp scanner finds
      # in a regexp literal, at the offending bytes when the source is a
      # slice of the file and at the whole literal otherwise.
      def parse_regular_expression_errors: (untyped node) -> untyped

      # parse_expression_prefix: an expression from its first token.
      def parse_expression_prefix: (untyped binding_power, untyped accepts_command_call, untyped accepts_label, untyped diag_id, untyped depth) -> untyped
    end
  end
end
