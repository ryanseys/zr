module Prism
  module Ruby
    class Parser
      @command_start: untyped

      @previous_start: untyped

      @previous_type: untyped

      @current_block_exits: untyped

      # pm_parameters_order_t: where a parameter list is, from NONE (nothing
      # yet) down to NOTHING_AFTER; a parameter may not move back up.
      PARAMETERS_NO_CHANGE: 0

      PARAMETERS_ORDER_NOTHING_AFTER: 1

      PARAMETERS_ORDER_KEYWORDS_REST: 2

      PARAMETERS_ORDER_KEYWORDS: 3

      PARAMETERS_ORDER_REST: 4

      PARAMETERS_ORDER_AFTER_OPTIONAL: 5

      PARAMETERS_ORDER_OPTIONAL: 6

      PARAMETERS_ORDER_NAMED: 7

      PARAMETERS_ORDER_NONE: 8

      # parameters_ordering
      PARAMETERS_ORDERING: untyped

      # The errors for a parameter named like a constant or a variable.
      FORMAL_ARGUMENT_ERRORS: { CONSTANT: :argument_formal_constant, INSTANCE_VARIABLE: :argument_formal_ivar, GLOBAL_VARIABLE: :argument_formal_global, CLASS_VARIABLE: :argument_formal_class }

      private

      # parse_required_destructured_parameter: `(a, *b, (c, d))` among
      # parameters.
      def parse_required_destructured_parameter: () -> untyped

      # update_parameter_state: the order after the parameter that starts with
      # `token`, or an error when it is out of order. Returns the new order
      # and whether the parameter was in order.
      def update_parameter_state: (untyped token, untyped current) -> (::Array[untyped | true] | ::Array[untyped | false])

      # parse_parameters: a method's, block's or lambda's parameters; nil
      # when there are none.
      def parse_parameters: (untyped binding_power, untyped uses_parentheses, untyped allows_trailing_comma, untyped allows_forwarding_parameters, untyped accepts_blocks_in_defaults, untyped in_block, untyped depth) -> (nil | untyped)

      # token_newline_index: the line index the current token is on.
      def token_newline_index: () -> untyped

      # token_column: the token's column, with tabs to the next multiple of
      # 8; with `break_on_non_space`, -1 when anything but spaces and tabs
      # comes before it on its line.
      def token_column: (untyped newline_index, untyped token, untyped break_on_non_space) -> (-1 | untyped)

      # parser_warn_indentation_mismatch: a warning when the current token
      # (an `end`, `else` and the like) is indented differently from the
      # token that opened it.
      def warn_indentation_mismatch: (untyped opening_newline_index, untyped opening_token, untyped if_after_else, untyped allow_indent) -> (nil | untyped)

      # The contexts each kind of rescue clause's statements are in:
      # [rescue, else, ensure].
      RESCUES_CONTEXTS: { begin: ::Array[:begin_rescue | :begin_else | :begin_ensure], block: ::Array[:block_rescue | :block_else | :block_ensure], class: ::Array[:class_rescue | :class_else | :class_ensure], def: ::Array[:def_rescue | :def_else | :def_ensure], lambda: ::Array[:lambda_rescue | :lambda_else | :lambda_ensure], module: ::Array[:module_rescue | :module_else | :module_ensure], sclass: ::Array[:sclass_rescue | :sclass_else | :sclass_ensure] }

      # parse_rescues: the rescue, else and ensure clauses and the end of
      # `parent_node`, a begin node. `opening` (or nil) is the token whose
      # indentation the clauses should match; `type` is the kind of body.
      def parse_rescues: (untyped opening_newline_index, untyped opening, untyped parent_node, untyped type, untyped depth) -> untyped

      # parse_rescues_implicit_begin: rescue clauses on a body without
      # `begin` (a def, class, block, ...), from `start`.
      def parse_rescues_implicit_begin: (untyped opening_newline_index, untyped opening, untyped start, untyped statements, untyped type, untyped depth) -> untyped

      # parse_block_parameters: a block's or lambda's parameters and its
      # block locals after `;`.
      def parse_block_parameters: (untyped allows_trailing_comma, untyped opening, untyped is_lambda_literal, untyped accepts_blocks_in_defaults, untyped depth) -> untyped

      # outer_scope_using_numbered_parameters_p
      def outer_scope_using_numbered_parameters?: () -> (true | false)

      # parse_blocklike_parameters: a block's or lambda's parameters node,
      # its numbered parameters, or `it`.
      def parse_blocklike_parameters: (untyped parameters, untyped opening, untyped closing) -> (untyped | nil)

      # parse_block: a `{ }` or `do end` block, after its opening token.
      def parse_block: (untyped depth) -> untyped

      # parse_arguments_list: a call's arguments, with or without
      # parentheses, and its block; whether any were found.
      def parse_arguments_list: (untyped arguments, untyped accepts_block, untyped accepts_command_call, untyped depth) -> untyped

      # The contexts a return sees through (:pass), may be in (:valid), may
      # not be in (:invalid), or that make it one in a singleton class body.
      RETURN_CONTEXTS: { begin_else: :pass, begin_ensure: :pass, begin_rescue: :pass, begin: :pass, case_in: :pass, case_when: :pass, default_params: :pass, defined: :pass, else: :pass, elsif: :pass, embexpr: :pass, for_index: :pass, for: :pass, if: :pass, loop_predicate: :pass, main: :pass, multi_target: :pass, parens: :pass, postexe: :pass, predicate: :pass, preexe: :pass, rescue_modifier: :pass, ternary: :pass, unless: :pass, until: :pass, while: :pass, sclass_else: :sclass, sclass_ensure: :sclass, sclass_rescue: :sclass, sclass: :sclass, class_else: :invalid, class_ensure: :invalid, class_rescue: :invalid, class: :invalid, module_else: :invalid, module_ensure: :invalid, module_rescue: :invalid, module: :invalid, block_braces: :valid, block_else: :valid, block_ensure: :valid, block_keywords: :valid, block_rescue: :valid, block_parameters: :valid, def_else: :valid, def_ensure: :valid, def_params: :valid, def_rescue: :valid, def: :valid, lambda_braces: :valid, lambda_do_end: :valid, lambda_else: :valid, lambda_ensure: :valid, lambda_rescue: :valid }

      # parse_return: an error for a return in a class or module body, or
      # from 3.4 in a singleton class body.
      def parse_return: (untyped node) -> (nil | untyped)

      # The contexts a block exit may be in (:valid), may not be in unless a
      # while or until modifier follows (:invalid), or sees through.
      BLOCK_EXIT_CONTEXTS: { block_braces: :valid, block_keywords: :valid, block_else: :valid, block_ensure: :valid, block_parameters: :valid, block_rescue: :valid, defined: :valid, for: :valid, lambda_braces: :valid, lambda_do_end: :valid, lambda_else: :valid, lambda_ensure: :valid, lambda_rescue: :valid, loop_predicate: :valid, postexe: :valid, until: :valid, while: :valid, def: :invalid, def_params: :invalid, def_else: :invalid, def_ensure: :invalid, def_rescue: :invalid, main: :invalid, preexe: :invalid, sclass: :invalid, sclass_else: :invalid, sclass_ensure: :invalid, sclass_rescue: :invalid }

      # parse_block_exit: a break, next or redo outside a block may still be
      # valid inside a while or until modifier, so it waits in the block
      # exits.
      def parse_block_exit: (untyped node) -> untyped

      # push_block_exits: a new list of block exits; returns the one before.
      def push_block_exits: (untyped current_block_exits) -> untyped

      # flush_block_exits: an error for each block exit left.
      def flush_block_exits: (untyped previous_block_exits) -> untyped

      # pop_block_exits: a while or until modifier makes the block exits
      # valid; otherwise they move to the list around, or are errors at the
      # top.
      def pop_block_exits: (untyped previous_block_exits) -> untyped

      # parse_predicate: an if's or unless's predicate and what closes it;
      # returns the predicate and the `then` keyword (or NOT_PROVIDED).
      def parse_predicate: (untyped binding_power, untyped context, untyped then_keyword, untyped depth) -> ::Array[untyped]

      # parse_conditional: an if (with its elsif and else clauses) or an
      # unless, after its keyword.
      def parse_conditional: (untyped context, untyped opening_newline_index, untyped if_after_else, untyped depth) -> untyped
    end
  end
end
