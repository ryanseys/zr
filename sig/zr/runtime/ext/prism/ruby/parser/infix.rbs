module Prism
  module Ruby
    class Parser
      @source: untyped

      @end: untyped

      @pattern_matching_newlines: untyped

      @command_start: untyped

      @lex_state: untyped

      # The node an operator write makes of each target, by operator:
      # [&&=, ||=, op=].
      OPERATOR_WRITES: { global: ::Array[:global_variable_and_write_node | :global_variable_or_write_node | :global_variable_operator_write_node], class_variable: ::Array[:class_variable_and_write_node | :class_variable_or_write_node | :class_variable_operator_write_node], constant_path: ::Array[:constant_path_and_write_node | :constant_path_or_write_node | :constant_path_operator_write_node], constant: ::Array[:constant_and_write_node | :constant_or_write_node | :constant_operator_write_node], instance_variable: ::Array[:instance_variable_and_write_node | :instance_variable_or_write_node | :instance_variable_operator_write_node], local_variable: ::Array[:local_variable_and_write_node | :local_variable_or_write_node | :local_variable_operator_write_node], index: ::Array[:index_and_write_node | :index_or_write_node | :index_operator_write_node], call: ::Array[:call_and_write_node | :call_or_write_node | :call_operator_write_node] }

      # The errors of each operator write: [value missing, multiple write].
      OPERATOR_WRITE_ERRORS: ::Array[::Array[:expect_expression_after_ampampeq | :ampampeq_multi_assign] | ::Array[:expect_expression_after_pipepipeeq | :pipepipeeq_multi_assign] | ::Array[:expect_expression_after_operator | :operator_multi_assign]]

      # The binary operators that may follow a rescue modifier's or `and`'s
      # match only on a new statement.
      BINARY_OPERATORS: ::Array[:UAMPERSAND | :USTAR | :USTAR_STAR | :BANG_EQUAL | :BANG_TILDE | :EQUAL_EQUAL | :EQUAL_EQUAL_EQUAL | :LESS_EQUAL_GREATER | :CARET | :PIPE | :AMPERSAND | :GREATER_GREATER | :LESS_LESS | :MINUS | :PLUS | :PERCENT | :SLASH | :STAR | :STAR_STAR]

      OPERATOR_ASSIGNMENTS: ::Array[:AMPERSAND_EQUAL | :CARET_EQUAL | :GREATER_GREATER_EQUAL | :LESS_LESS_EQUAL | :MINUS_EQUAL | :PERCENT_EQUAL | :PIPE_EQUAL | :PLUS_EQUAL | :SLASH_EQUAL | :STAR_EQUAL | :STAR_STAR_EQUAL]

      private

      # parse_assignment_value: the value of an operator write, which may
      # take a rescue modifier.
      def parse_assignment_value: (untyped previous_binding_power, untyped binding_power, untyped accepts_command_call, untyped diag_id, untyped depth) -> untyped

      # parse_assignment_value_local: a local written as the value of
      # another write counts as used.
      def parse_assignment_value_local: (untyped node) -> untyped

      # parse_assignment_values: the value after `=`, which at a statement
      # may be several (an array without brackets) and may take a rescue
      # modifier.
      def parse_assignment_values: (untyped previous_binding_power, untyped binding_power, untyped accepts_command_call, untyped diag_id, untyped depth) -> untyped

      # parse_call_operator_write: an operator write's call target has no
      # arguments or block.
      def parse_call_operator_write: (untyped call_node, untyped operator) -> (nil | untyped)

      # pm_named_capture_escape_hex
      def named_capture_escape_hex: (untyped unescaped, untyped bytes, untyped cursor) -> untyped

      # pm_named_capture_escape_octal
      def named_capture_escape_octal: (untyped unescaped, untyped bytes, untyped cursor) -> untyped

      # escape_unicode over `bytes`, with a surrogate's error at the regexp
      # (`error_location`) or at the digits when the bytes are the source.
      def named_capture_unicode_value: (untyped bytes, untyped from, untyped length, untyped error_location) -> (untyped | 65533)

      # The run of hexadecimal digits at `from` in `bytes`, at most `limit`.
      def hexadecimal_run: (untyped bytes, untyped from, untyped limit) -> untyped

      # pm_named_capture_escape_unicode
      def named_capture_escape_unicode: (untyped unescaped, untyped bytes, untyped cursor, untyped error_location) -> untyped

      # pm_memchr over `bytes`.
      def memchr: (untyped bytes, untyped value, untyped from) -> (untyped | nil)

      # pm_named_capture_escape: a capture group's name with its escapes
      # read, from the first backslash at `cursor`.
      def named_capture_escape: (untyped bytes, untyped cursor, untyped error_location) -> untyped

      # parse_regular_expression_named_captures: `/(?<name>..)/ =~ value`
      # writes the named groups to locals, through a match write node.
      def parse_regular_expression_named_captures: (untyped content, untyped shared, untyped call, untyped extended_mode) -> untyped

      # pm_slice_is_valid_local over bytes not in the source.
      def valid_local_bytes?: (untyped bytes) -> (false | untyped)

      # The block's return value, with `bytes` as the source that the
      # character functions read.
      def with_source: (untyped bytes) { () -> untyped } -> untyped

      # The kind of target an operator write writes to.
      def operator_write_kind: (untyped node) -> untyped

      # `target &&= value`, `target ||= value` and `target op= value`, where
      # `operator` is 0, 1 or 2.
      def parse_operator_write: (untyped node, untyped token, untyped operator, untyped previous_binding_power, untyped binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # Whether a match (`=>` or `in`) ends the right side of a rescue
      # modifier, `and` or `or`, which an operator may not follow.
      def match_after_operator?: (untyped node) -> untyped

      # `target = value`
      def parse_write_expression: (untyped node, untyped token, untyped previous_binding_power, untyped binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # `left =~ right`, which writes named captures of a regexp literal.
      def parse_match_expression: (untyped node, untyped token, untyped binding_power, untyped depth) -> untyped

      # `receiver.message(arguments)` and `receiver&.message`
      def parse_call_expression: (untyped node, untyped previous_binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # `receiver::Constant` and `receiver::method`
      def parse_colon_colon_expression: (untyped node, untyped previous_binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # `receiver[arguments]`
      def parse_index_expression: (untyped node, untyped previous_binding_power, untyped depth) -> untyped

      # `value ? a : b`
      def parse_ternary: (untyped node, untyped depth) -> untyped

      # `value in pattern` and `value => pattern`
      def parse_match_pattern: (untyped node, untyped required, untyped depth) -> untyped

      # parse_expression_infix: the infix operator at the current token
      # applied to `node`.
      def parse_expression_infix: (untyped node, untyped previous_binding_power, untyped binding_power, untyped accepts_command_call, untyped depth) -> untyped

      # pm_call_node_command_p: arguments or a block argument, without
      # parentheses.
      def call_node_command?: (untyped node) -> untyped

      # PRISM_DEPTH_MAXIMUM
      DEPTH_MAXIMUM: 10000

      # The statements that end an expression unless a modifier follows.
      STATEMENT_NODES: ::Array[untyped]

      # The writes that end an expression when their value is an array
      # without brackets.
      IMPLICIT_ARRAY_WRITES: ::Array[untyped]

      # parse_expression: an expression, and the infix operators that bind at
      # least as tightly as `binding_power`.
      def parse_expression: (untyped binding_power, untyped accepts_command_call, untyped accepts_label, untyped diag_id, untyped depth) -> untyped

      # wrap_statements: -p, -n, -a and -l as the loop and statements they
      # add.
      def wrap_statements: (untyped statements) -> untyped

      public

      # parse_program: the whole source as a program node.
      def parse_program: () -> untyped
    end
  end
end
