module Prism
  module Ruby
    # util/pm_char.c: which bytes are whitespace, digits and regexp option
    # letters, and how far a run of them goes. A run starts at `from` in the
    # binary source and stops before `limit` (C's `string + length`).
    module Characters
      WHITESPACE: 1

      INLINE_WHITESPACE: 2

      REGEXP_OPTION: 4

      BINARY_DIGIT: 1

      BINARY_NUMBER: 2

      OCTAL_DIGIT: 4

      OCTAL_NUMBER: 8

      DECIMAL_DIGIT: 16

      DECIMAL_NUMBER: 32

      HEXADECIMAL_DIGIT: 64

      HEXADECIMAL_NUMBER: 128

      # pm_byte_table
      BYTE_TABLE: untyped

      # pm_number_table
      NUMBER_TABLE: untyped

      private

      def whitespace?: (untyped byte) -> untyped

      def inline_whitespace?: (untyped byte) -> untyped

      def binary_digit?: (untyped byte) -> untyped

      def octal_digit?: (untyped byte) -> untyped

      def decimal_digit?: (untyped byte) -> untyped

      def hexadecimal_digit?: (untyped byte) -> untyped

      # pm_strspn_char_kind
      def strspn_char_kind: (untyped from, untyped limit, untyped kind) -> untyped

      def strspn_whitespace: (untyped from, untyped limit) -> untyped

      def strspn_inline_whitespace: (untyped from, untyped limit) -> untyped

      def strspn_regexp_option: (untyped from, untyped limit) -> untyped

      # pm_strspn_whitespace_newlines: the run, with each newline in it added
      # to the newline list.
      def strspn_whitespace_newlines: (untyped from, untyped limit) -> untyped

      # pm_strspn_number_kind
      def strspn_number_kind: (untyped from, untyped limit, untyped kind) -> untyped

      # pm_strspn_number_kind_underscores: the run, and the offset of an
      # underscore that follows another or ends the run (the last one found),
      # or nil.
      def strspn_number_kind_underscores: (untyped from, untyped limit, untyped kind) -> ::Array[untyped]

      def strspn_decimal_digit: (untyped from, untyped limit) -> untyped

      def strspn_hexadecimal_digit: (untyped from, untyped limit) -> untyped

      def strspn_binary_number: (untyped from, untyped limit) -> untyped

      def strspn_octal_number: (untyped from, untyped limit) -> untyped

      def strspn_decimal_number: (untyped from, untyped limit) -> untyped

      def strspn_hexadecimal_number: (untyped from, untyped limit) -> untyped
    end
  end
end
