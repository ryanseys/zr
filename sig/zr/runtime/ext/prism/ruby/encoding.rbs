module Prism
  module Ruby
    # encoding.c: the functions that the lexer calls on the encoding of a
    # source, for the 90 encodings that prism knows. Each takes the binary
    # source, a byte offset and the bytes left from there (C's `n`, which
    # can be 0 or less). It returns a width in bytes, 0 for no character,
    # or true or false for isupper_char.
    module Encodings
      ALPHABETIC: 1

      ALPHANUMERIC: 2

      UPPERCASE: 4

      # pm_unicode_codepoint_match: a binary search over inclusive ranges.
      def self.codepoint_in?: (untyped codepoint, untyped ranges) -> (true | false)

      # A pm_encoding_t: its name, whether it is multibyte, and the four
      # functions. The base implements them with the ASCII table, as the
      # ascii_*_char functions do.
      class Encoding
        @name: untyped

        @multibyte: untyped

        attr_reader name: untyped

        def initialize: (untyped name, untyped multibyte) -> void

        def multibyte?: () -> untyped

        # pm_encoding_single_char_width
        def char_width: (untyped _source, untyped _at, untyped _n) -> 1

        # pm_encoding_ascii_alpha_char, which returns the table bit itself.
        def alpha_char: (untyped source, untyped at, untyped n) -> (untyped | 0)

        # pm_encoding_ascii_alnum_char
        def alnum_char: (untyped source, untyped at, untyped n) -> (1 | 0)

        # pm_encoding_ascii_isupper_char
        def isupper_char: (untyped source, untyped at, untyped n) -> untyped

        def inspect: () -> ::String
      end

      # US-ASCII: pm_encoding_ascii_char_width, one byte below 0x80.
      class ASCII < Encoding
        def char_width: (untyped source, untyped at, untyped n) -> (1 | 0)
      end

      # A single-byte encoding with a byte table of its own
      # (PRISM_ENCODING_TABLE).
      class Table < Encoding
        @table: untyped

        def initialize: (untyped name, untyped table) -> void

        def alpha_char: (untyped source, untyped at, untyped n) -> (1 | 0)

        def alnum_char: (untyped source, untyped at, untyped n) -> (1 | 0)

        def isupper_char: (untyped source, untyped at, untyped n) -> untyped
      end

      # Unicode functions over a decoder: the byte table below 0x100, the
      # code point ranges above. C leaves the width of a decoded character
      # unset (pm_utf_8_codepoint never writes it). The compiled C returns
      # the character's own width, and so does this.
      class Unicode < Encoding
        def alpha_char: (untyped source, untyped at, untyped n) -> untyped

        def alnum_char: (untyped source, untyped at, untyped n) -> untyped

        def isupper_char: (untyped source, untyped at, untyped n) -> untyped

        private

        def unicode_char: (untyped source, untyped at, untyped n, untyped bit, untyped ranges) -> (0 | untyped)
      end

      # UTF-8 and its variants, over the pm_utf_8_dfa state machine.
      class UTF8 < Unicode
        # pm_encoding_utf_8_char_width
        def char_width: (untyped source, untyped at, untyped n) -> (untyped | 0)

        # pm_utf_8_codepoint
        def codepoint: (untyped source, untyped at, untyped n) -> (untyped | 0)
      end

      # CESU-8: surrogate pairs as two three-byte sequences.
      class CESU8 < Unicode
        # pm_encoding_cesu_8_char_width
        def char_width: (untyped source, untyped at, untyped n) -> (0 | untyped)

        # pm_cesu_8_codepoint
        def codepoint: (untyped source, untyped at, untyped n) -> untyped
      end

      # A multibyte encoding whose letters are ASCII's alone
      # (pm_encoding_ascii_*_char_7bit), and whose width is one of
      # encoding.c's width functions.
      class Multibyte < Encoding
        @width: untyped

        @isupper: untyped

        def initialize: (untyped name, untyped width, untyped isupper) -> void

        def char_width: (untyped source, untyped at, untyped n) -> untyped

        def alpha_char: (untyped source, untyped at, untyped n) -> (untyped | 0)

        def alnum_char: (untyped source, untyped at, untyped n) -> (untyped | 0)

        def isupper_char: (untyped source, untyped at, untyped n) -> untyped

        private

        # pm_encoding_euc_jp_char_width
        def euc_jp: (untyped source, untyped at, untyped n) -> (1 | 2 | 3 | 0)

        # pm_encoding_big5_char_width
        def big5: (untyped source, untyped at, untyped n) -> (1 | 0 | untyped)

        # pm_encoding_cp949_char_width
        def cp949: (untyped source, untyped at, untyped n) -> (1 | 0 | untyped)

        # pm_encoding_emacs_mule_char_width
        def emacs_mule: (untyped source, untyped at, untyped n) -> (1 | 2 | 3 | 4 | 0)

        # pm_encoding_euc_kr_char_width
        def euc_kr: (untyped source, untyped at, untyped n) -> (1 | untyped)

        # pm_encoding_euc_tw_char_width
        def euc_tw: (untyped source, untyped at, untyped n) -> (1 | 2 | 4 | 0)

        # pm_encoding_gb18030_char_width
        def gb18030: (untyped source, untyped at, untyped n) -> (1 | 2 | 4 | 0)

        # pm_encoding_gbk_char_width
        def gbk: (untyped source, untyped at, untyped n) -> (1 | 0 | untyped)
      end

      # Shift_JIS and its kin, whose single bytes above 0x80 count as letters.
      class ShiftJIS < Encoding
        def initialize: (untyped name) -> void

        # pm_encoding_shift_jis_char_width
        def char_width: (untyped source, untyped at, untyped n) -> (0 | 1 | 2)

        # pm_encoding_shift_jis_alnum_char and _alpha_char
        def alnum_char: (untyped source, untyped at, untyped n) -> untyped

        def alpha_char: (untyped source, untyped at, untyped n) -> untyped

        # pm_encoding_shift_jis_isupper_char, which returns the width (0)
        # for a byte that is not a character.
        def isupper_char: (untyped source, untyped at, untyped n) -> untyped

        private

        def letter: (untyped source, untyped at, untyped n) { () -> untyped } -> untyped
      end

      # pm_encodings, by pm_encoding_type_t name.
      ALL: untyped

      UTF_8: untyped

      US_ASCII: untyped

      ASCII_8BIT: untyped

      LOOKUP: untyped

      # pm_encoding_find: the encoding that a magic comment or an option
      # gives, or nil. Case does not matter, and UTF-8 can have a suffix.
      def self.find: (untyped bytes) -> untyped
    end
  end
end
