module Prism
  module Ruby
    # regexp.c: a scanner over a regexp's source that finds its named
    # capture groups and the errors the regexp engine would report at parse
    # time. Offsets are into the scanned bytes.
    class RegexpScanner
      @source: untyped

      @cursor: untyped

      @end: untyped

      @extended_mode: untyped

      @encoding_changed: untyped

      @encoding: untyped

      @on_name: untyped

      @on_error: untyped

      # PM_REGEXP_PARSE_DEPTH_MAX
      DEPTH_MAX: 4096

      # pm_regexp_option_state_t
      OPTION_INVALID: 0

      OPTION_TOGGLEABLE: 1

      OPTION_ADDABLE: 2

      OPTION_ADDED: 3

      OPTION_REMOVED: 4

      # The states the options of a group start in, by letter.
      OPTION_DEFAULTS: { 105 => untyped, 109 => untyped, 120 => untyped, 100 => untyped, 97 => untyped, 117 => untyped }

      # `encoding` is the parser's when `encoding_changed`, for multibyte
      # characters whose trailing bytes can look like ASCII. `on_name`
      # receives each capture group's name as [start, end]; `on_error`
      # receives [start, end, message].
      def initialize: (untyped bytes, untyped extended_mode, untyped encoding_changed, untyped encoding, untyped on_name, untyped on_error) -> void

      # pm_regexp_parse_pattern
      def parse: () -> (true | false | untyped)

      private

      def error: (untyped start, untyped finish, untyped message) -> untyped

      def byte: () -> untyped

      # pm_regexp_char_is_eof
      def eof?: () -> untyped

      # pm_regexp_char_accept, pm_regexp_char_expect
      def accept: (untyped value) -> (false | true)

      # pm_memchr: the offset of `value` from `from`, stepping over multibyte
      # characters when the encoding's trailing bytes can equal it.
      def memchr: (untyped value, untyped from) -> (untyped | nil)

      # pm_regexp_char_find: past the next `value`.
      def find: (untyped value) -> (false | true)

      def digit?: (untyped value) -> untyped

      # pm_regexp_parse_range_quantifier: {n}, {n,}, {n,m}, {,m}; anything
      # else is plain characters, and the cursor goes back.
      def parse_range_quantifier: () -> (true | untyped)

      # pm_regexp_parse_quantifier
      def parse_quantifier: () -> (false | true)

      # pm_regexp_parse_posix_class: [[:alpha:]]
      def parse_posix_class: () -> (false | untyped)

      # pm_regexp_parse_character_set
      def parse_character_set: (untyped depth) -> untyped

      # pm_regexp_parse_lbracket: a POSIX class or a character set.
      def parse_lbracket: (untyped depth) -> (false | true | untyped)

      # pm_regexp_options_add
      def options_add: (untyped options, untyped key) -> untyped

      # pm_regexp_options_remove
      def options_remove: (untyped options, untyped key) -> untyped

      # pm_regexp_parse_group: after `(`.
      def parse_group: (untyped depth) -> (false | true | untyped)

      # pm_regexp_parse_item
      def parse_item: (untyped depth) -> untyped

      # pm_regexp_parse_expression
      def parse_expression: (untyped depth) -> (false | true)
    end

    class Parser
      private

      # pm_regexp_parse over `bytes`: named captures go to `on_name` as
      # [start, end] into the bytes, errors to the block as [start, end,
      # message].
      def regexp_parse: (untyped bytes, untyped extended_mode, untyped on_name) { (?) -> untyped } -> untyped
    end
  end
end
