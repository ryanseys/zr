module Prism
  module Ruby
    # pm_arguments_t: a call's arguments with the parentheses or brackets
    # around them and its block, as parse_arguments_list fills them in.
    Arguments: untyped

    # prism.c's node functions: the checks on nodes, and one method per
    # pm_*_node_create and its setters. A node gets its id when it is made,
    # at the point the C's PM_NODE_INIT runs, so ids follow the C's order.
    class Parser
      # The id PM_NODE_INIT gives the next node.
      @node_id: untyped

      @current_string: untyped

      # Internal flags the C keeps on nodes beside the public ones.
      WRITE_NODE_FLAGS_IMPLICIT_ARRAY: untyped

      CALL_NODE_FLAGS_LAST: untyped

      CALL_NODE_FLAGS_IMPLICIT_ARRAY: untyped

      CALL_NODE_FLAGS_COMPARISON: untyped

      CALL_NODE_FLAGS_INDEX: untyped

      # PM_REGULAR_EXPRESSION_ENCODING_MASK
      REGULAR_EXPRESSION_ENCODING_MASK: untyped

      # The keywords pm_local_is_keyword knows.
      LOCAL_KEYWORDS: untyped

      private

      # The id PM_NODE_INIT gives the next node.
      def next_node_id: () -> untyped

      # A location packed as `(start << 32) | length`.
      def loc: (untyped start, untyped finish) -> untyped

      def loc_start: (untyped location) -> untyped

      def loc_end: (untyped location) -> untyped

      # PM_LOCATION_NULL_VALUE
      def null_location: () -> 0

      # The Symbol of the constant numbered `id`, as a node stores it. A name
      # that is not valid in the source's encoding keeps its bytes.
      def constant_symbol: (untyped id) -> untyped

      # The constant id of a name in a node.
      def constant_id_of: (untyped symbol) -> untyped

      # pm_parser_constant_id_token, as the node's Symbol.
      def token_name: (untyped token) -> untyped

      # pm_parser_optional_constant_id_token, as the node's Symbol or nil.
      def optional_token_name: (untyped token) -> (untyped | nil)

      # pm_parser_constant_id_location, as the node's Symbol.
      def location_name: (untyped start, untyped finish) -> untyped

      # pm_parser_constant_id_constant, as the node's Symbol.
      def constant_name: (untyped bytes) -> untyped

      # pm_parser_err_node, PM_PARSER_ERR_NODE_FORMAT
      def err_node: (untyped node, untyped id, *untyped arguments) -> untyped

      # pm_parser_err_token, PM_PARSER_ERR_TOKEN_FORMAT
      def err_token: (untyped token, untyped id, *untyped arguments) -> untyped

      # pm_parser_warn_node, PM_PARSER_WARN_NODE_FORMAT
      def warn_node: (untyped node, untyped id, *untyped arguments) -> untyped

      # pm_parser_warn_token, PM_PARSER_WARN_TOKEN_FORMAT
      def warn_token: (untyped token, untyped id, *untyped arguments) -> untyped

      # PM_PARSER_ERR_NODE_FORMAT_CONTENT
      def err_node_content: (untyped node, untyped id) -> untyped

      # PM_PARSER_ERR_TOKEN_FORMAT_CONTENT
      def err_token_content: (untyped token, untyped id) -> untyped

      # PM_PARSER_WARN_TOKEN_FORMAT_CONTENT
      def warn_token_content: (untyped token, untyped id) -> untyped

      def token_slice: (untyped token) -> untyped

      def node_slice: (untyped node) -> untyped

      def command_line_e?: () -> untyped

      # pm_check_value_expression: the node that makes `node` no value (a
      # return, break, next, redo, retry or `=>` match on every path), or
      # nil.
      def check_value_expression: (untyped node) -> (untyped | nil)

      # pm_assert_value_expression
      def assert_value_expression: (untyped node) -> untyped

      # The one- and two-byte operator names pm_void_statement_check warns
      # about.
      VOID_OPERATORS: untyped

      # pm_void_statement_check: a warning for a statement whose value is
      # thrown away.
      def void_statement_check: (untyped node) -> untyped

      # pm_void_statements_check
      def void_statements_check: (untyped node, untyped last_value) -> untyped

      # pm_parser_warn_conditional_predicate_literal
      def warn_conditional_predicate_literal: (untyped node, untyped type, untyped id, untyped prefix) -> untyped

      # pm_conditional_predicate_warn_write_literal_p
      def conditional_predicate_write_literal?: (untyped node) -> untyped

      # pm_conditional_predicate_warn_write_literal
      def conditional_predicate_warn_write_literal: (untyped node) -> (nil | untyped)

      # pm_conditional_predicate: in a predicate, a range is a flip-flop and
      # a regexp matches $_, and literals cause warnings. `type` is
      # :conditional, :flip_flop or :not. The C changes a node's type in
      # place; this returns the node to use in its place.
      def conditional_predicate: (untyped node, untyped type) -> untyped

      # A node as another type with the same fields, as the C changes a
      # node's type in place. It keeps the node's id.
      def retype: (untyped node, untyped type) -> untyped

      # pm_arguments_end
      def arguments_end: (untyped arguments) -> (untyped | nil)

      # pm_arguments_validate_block: a brace block cannot attach to a call
      # whose arguments have no parentheses.
      def arguments_validate_block: (untyped arguments, untyped block) -> (nil | untyped)

      # token_is_setter_name
      def token_setter_name?: (untyped token) -> untyped

      # pm_local_is_keyword
      def local_keyword?: (untyped bytes) -> untyped

      # pm_node_flag_set_repeated_parameter
      def flag_repeated_parameter: (untyped node) -> untyped

      # pm_regular_expression_flags_create: the flags a regexp's closing
      # token spells, with an error for letters that are no option.
      def regular_expression_flags: (untyped closing) -> untyped

      # pm_missing_node_create
      def missing_node: (untyped start, untyped finish) -> untyped

      # pm_alias_global_variable_node_create
      def alias_global_variable_node: (untyped keyword, untyped new_name, untyped old_name) -> untyped

      # pm_alias_method_node_create
      def alias_method_node: (untyped keyword, untyped new_name, untyped old_name) -> untyped

      # pm_alternation_pattern_node_create
      def alternation_pattern_node: (untyped left, untyped right, untyped operator) -> untyped

      # pm_and_node_create
      def and_node: (untyped left, untyped operator, untyped right) -> untyped

      # pm_arguments_node_create
      def arguments_node: () -> untyped

      # pm_arguments_node_arguments_append
      def arguments_node_arguments_append: (untyped node, untyped argument) -> (nil | untyped)

      # pm_array_node_create
      def array_node: (untyped opening) -> untyped

      # pm_array_node_elements_append
      def array_node_elements_append: (untyped node, untyped element) -> untyped

      # pm_array_node_close_set
      def array_node_close_set: (untyped node, untyped closing) -> untyped

      # pm_array_pattern_node_node_list_create: at least two nodes, split
      # around the first splat.
      def array_pattern_node_node_list: (untyped nodes) -> untyped

      # pm_array_pattern_node_rest_create
      def array_pattern_node_rest: (untyped rest) -> untyped

      # pm_array_pattern_node_constant_create
      def array_pattern_node_constant: (untyped constant, untyped opening, untyped closing) -> untyped

      # pm_array_pattern_node_empty_create
      def array_pattern_node_empty: (untyped opening, untyped closing) -> untyped

      # pm_assoc_node_create
      def assoc_node: (untyped key, untyped operator, untyped value) -> untyped

      # An array, hash or range, which is never a static literal inside
      # another literal.
      def container_node?: (untyped node) -> untyped

      # pm_assoc_splat_node_create
      def assoc_splat_node: (untyped value, untyped operator) -> untyped

      # pm_back_reference_read_node_create
      def back_reference_read_node: (untyped name) -> untyped

      # pm_begin_node_create
      def begin_node: (untyped begin_keyword, untyped statements) -> untyped

      # pm_begin_node_rescue_clause_set
      def begin_node_rescue_clause_set: (untyped node, untyped rescue_clause) -> untyped

      # pm_begin_node_else_clause_set
      def begin_node_else_clause_set: (untyped node, untyped else_clause) -> untyped

      # pm_begin_node_ensure_clause_set
      def begin_node_ensure_clause_set: (untyped node, untyped ensure_clause) -> untyped

      # pm_begin_node_end_keyword_set
      def begin_node_end_keyword_set: (untyped node, untyped end_keyword) -> untyped

      # pm_block_argument_node_create
      def block_argument_node: (untyped operator, untyped expression) -> untyped

      # pm_block_node_create
      def block_node: (untyped locals, untyped opening, untyped parameters, untyped body, untyped closing) -> untyped

      # pm_block_parameter_node_create
      def block_parameter_node: (untyped name, untyped operator) -> untyped

      # pm_block_parameters_node_create. With neither an opening nor
      # parameters the C leaves the location unset (NULL); its start and
      # end are then nil until a block local sets them.
      def block_parameters_node: (untyped parameters, untyped opening) -> untyped

      # pm_block_parameters_node_closing_set
      def block_parameters_node_closing_set: (untyped node, untyped closing) -> untyped

      # pm_block_local_variable_node_create
      def block_local_variable_node: (untyped name) -> untyped

      # pm_block_parameters_node_append_local
      def block_parameters_node_append_local: (untyped node, untyped local) -> untyped

      # pm_break_node_create
      def break_node: (untyped keyword, untyped arguments) -> untyped

      # pm_call_node_create: a call with nothing set, for the variants to
      # fill in.
      def call_node: (untyped flags) -> untyped

      # pm_call_node_ignore_visibility_flag
      def call_node_ignore_visibility_flag: (untyped receiver) -> (untyped | 0)

      # pm_call_node_aref_create: receiver[arguments]
      def call_node_aref: (untyped receiver, untyped arguments) -> untyped

      # pm_call_node_binary_create
      def call_node_binary: (untyped receiver, untyped operator, untyped argument, untyped flags) -> untyped

      # pm_call_node_call_create: receiver.message(arguments)
      def call_node_call: (untyped receiver, untyped operator, untyped message, untyped arguments) -> untyped

      # pm_call_node_call_synthesized_create
      def call_node_call_synthesized: (untyped receiver, untyped message, untyped arguments) -> untyped

      # pm_call_node_fcall_create: message(arguments), which cannot be a
      # local variable.
      def call_node_fcall: (untyped message, untyped arguments) -> untyped

      # pm_call_node_fcall_synthesized_create
      def call_node_fcall_synthesized: (untyped arguments, untyped name) -> untyped

      # pm_call_node_not_create
      def call_node_not: (untyped receiver, untyped message, untyped arguments) -> untyped

      # pm_call_node_shorthand_create: receiver.(arguments)
      def call_node_shorthand: (untyped receiver, untyped operator, untyped arguments) -> untyped

      # pm_call_node_unary_create
      def call_node_unary: (untyped operator, untyped receiver, untyped name) -> untyped

      # pm_call_node_variable_call_create: a name that could also have been
      # a local variable.
      def call_node_variable_call: (untyped message) -> untyped

      # pm_call_node_writable_p: whether `node` can be the target of an
      # operator write.
      def call_node_writable?: (untyped node) -> (false | untyped)

      # pm_call_write_read_name_init: the write name without its `=`.
      def call_write_read_name: (untyped write_name) -> untyped

      # pm_call_and_write_node_create
      def call_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_index_arguments_check: from 3.4, no keywords or block in an index.
      def index_arguments_check: (untyped arguments, untyped block) -> (nil | untyped)

      # pm_index_and_write_node_create
      def index_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_call_operator_write_node_create
      # The binary operator is interned before the read name, as the C's
      # initializer runs first.
      def call_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_index_operator_write_node_create
      def index_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_call_or_write_node_create
      def call_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_index_or_write_node_create
      def index_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_call_target_node_create. A call operator missing after an error
      # gets an empty location, as the location is required.
      def call_target_node: (untyped target) -> untyped

      # pm_index_target_node_create
      def index_target_node: (untyped target) -> untyped

      # pm_capture_pattern_node_create
      def capture_pattern_node: (untyped value, untyped target, untyped operator) -> untyped

      # pm_case_node_create
      def case_node: (untyped case_keyword, untyped predicate, untyped end_keyword) -> untyped

      # pm_case_node_condition_append, pm_case_match_node_condition_append
      def case_node_condition_append: (untyped node, untyped condition) -> untyped

      # pm_case_node_else_clause_set, pm_case_match_node_else_clause_set
      def case_node_else_clause_set: (untyped node, untyped else_clause) -> untyped

      # pm_case_node_end_keyword_loc_set, pm_case_match_node_end_keyword_loc_set
      def case_node_end_keyword_loc_set: (untyped node, untyped end_keyword) -> untyped

      # pm_case_match_node_create
      def case_match_node: (untyped case_keyword, untyped predicate, untyped end_keyword) -> untyped

      # pm_class_node_create
      def class_node: (untyped locals, untyped class_keyword, untyped constant_path, untyped name, untyped inheritance_operator, untyped superclass, untyped body, untyped end_keyword) -> untyped

      # pm_class_variable_and_write_node_create
      def class_variable_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_class_variable_operator_write_node_create
      def class_variable_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_class_variable_or_write_node_create
      def class_variable_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_class_variable_read_node_create
      def class_variable_read_node: (untyped token) -> untyped

      # pm_implicit_array_write_flags: `flags` when the value is an array
      # without brackets (`a = 1, 2` or `a = *b`).
      def implicit_array_write_flags: (untyped node, untyped flags) -> (untyped | 0)

      # pm_class_variable_write_node_create
      def class_variable_write_node: (untyped read_node, untyped operator, untyped value) -> untyped

      # pm_constant_path_and_write_node_create
      def constant_path_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_path_operator_write_node_create
      def constant_path_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_path_or_write_node_create
      def constant_path_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_path_node_create
      def constant_path_node: (untyped parent, untyped delimiter, untyped name_token) -> untyped

      # pm_constant_path_write_node_create
      def constant_path_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_and_write_node_create
      def constant_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_operator_write_node_create
      def constant_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_or_write_node_create
      def constant_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_constant_read_node_create
      def constant_read_node: (untyped name) -> untyped

      # pm_constant_write_node_create
      def constant_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_def_node_receiver_check: no singleton methods on literals.
      def def_node_receiver_check: (untyped node) -> untyped

      # pm_def_node_create
      def def_node: (untyped name, untyped name_loc, untyped receiver, untyped parameters, untyped body, untyped locals, untyped def_keyword, untyped operator, untyped lparen, untyped rparen, untyped equal, untyped end_keyword) -> untyped

      # pm_defined_node_create
      def defined_node: (untyped lparen, untyped value, untyped rparen, untyped keyword) -> untyped

      # pm_else_node_create
      def else_node: (untyped else_keyword, untyped statements, untyped end_keyword) -> untyped

      # pm_embedded_statements_node_create
      def embedded_statements_node: (untyped opening, untyped statements, untyped closing) -> untyped

      # pm_embedded_variable_node_create
      def embedded_variable_node: (untyped operator, untyped variable) -> untyped

      # pm_ensure_node_create
      def ensure_node: (untyped ensure_keyword, untyped statements, untyped end_keyword) -> untyped

      # pm_false_node_create
      def false_node: (untyped token) -> untyped

      # pm_find_pattern_node_create: the first node is a splat, and so is the
      # last when there are two or more.
      def find_pattern_node: (untyped nodes) -> untyped

      # pm_double_parse: the token's value, with a warning when it is out of
      # range.
      def double_parse: (untyped token) -> (::Float | untyped)

      # The block's return value, without ruby's own out-of-range warning,
      # which $VERBOSE prints.
      def quietly: () { () -> untyped } -> untyped

      # pm_float_node_create
      def float_node: (untyped token) -> untyped

      # pm_float_node_imaginary_create: the numeric is made after the
      # imaginary, as the C's initializer runs in order.
      def float_node_imaginary: (untyped token) -> untyped

      # pm_float_node_rational_create: the digits over a power of ten,
      # reduced when both fit in 32 bits.
      def float_node_rational: (untyped token) -> untyped

      # pm_float_node_rational_imaginary_create
      def float_node_rational_imaginary: (untyped token) -> untyped

      # pm_for_node_create
      def for_node: (untyped index, untyped collection, untyped statements, untyped for_keyword, untyped in_keyword, untyped do_keyword, untyped end_keyword) -> untyped

      # pm_forwarding_arguments_node_create
      def forwarding_arguments_node: (untyped token) -> untyped

      # pm_forwarding_parameter_node_create
      def forwarding_parameter_node: (untyped token) -> untyped

      # pm_forwarding_super_node_create
      def forwarding_super_node: (untyped token, untyped arguments) -> untyped

      # pm_hash_pattern_node_empty_create
      def hash_pattern_node_empty: (untyped opening, untyped closing) -> untyped

      # pm_hash_pattern_node_node_list_create
      def hash_pattern_node_node_list: (untyped elements, untyped rest) -> untyped

      # pm_global_variable_write_name
      def global_variable_write_name: (untyped target) -> untyped

      # pm_global_variable_and_write_node_create
      def global_variable_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_global_variable_operator_write_node_create
      def global_variable_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_global_variable_or_write_node_create
      def global_variable_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_global_variable_read_node_create
      def global_variable_read_node: (untyped name) -> untyped

      # pm_global_variable_read_node_synthesized_create
      def global_variable_read_node_synthesized: (untyped name) -> untyped

      # pm_global_variable_write_node_create
      def global_variable_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_global_variable_write_node_synthesized_create
      def global_variable_write_node_synthesized: (untyped name, untyped value) -> untyped

      # pm_hash_node_create
      def hash_node: (untyped opening) -> untyped

      # pm_hash_node_elements_append
      def hash_node_elements_append: (untyped hash, untyped element) -> untyped

      # pm_hash_node_closing_loc_set
      def hash_node_closing_loc_set: (untyped hash, untyped token) -> untyped

      # pm_if_node_create
      def if_node: (untyped if_keyword, untyped predicate, untyped then_keyword, untyped statements, untyped subsequent, untyped end_keyword) -> untyped

      # pm_if_node_modifier_create
      def if_node_modifier: (untyped statement, untyped if_keyword, untyped predicate) -> untyped

      # pm_if_node_ternary_create
      def if_node_ternary: (untyped predicate, untyped qmark, untyped true_expression, untyped colon, untyped false_expression) -> untyped

      # pm_if_node_end_keyword_loc_set, pm_else_node_end_keyword_loc_set,
      # pm_unless_node_end_keyword_loc_set
      def end_keyword_loc_set: (untyped node, untyped keyword) -> untyped

      # pm_implicit_node_create
      def implicit_node: (untyped value) -> untyped

      # pm_implicit_rest_node_create
      def implicit_rest_node: (untyped token) -> untyped

      # The pm_integer_base_t of a node's base flag.
      INTEGER_BASES: ::Hash[untyped, :binary | :octal | :decimal | :hexadecimal]

      # pm_integer_parse: the value of digits in `base` (:default, :binary,
      # :octal, :decimal, :hexadecimal or :unknown) from `start` to `finish`,
      # past the prefix and without underscores. The lexer has validated
      # them.
      def integer_parse: (untyped base, untyped start, untyped finish) -> (0 | untyped)

      # pm_integer_node_create
      def integer_node: (untyped base, untyped token) -> untyped

      # pm_integer_node_imaginary_create
      def integer_node_imaginary: (untyped base, untyped token) -> untyped

      # pm_integer_node_rational_create
      def integer_node_rational: (untyped base, untyped token) -> untyped

      # pm_integer_node_rational_imaginary_create
      def integer_node_rational_imaginary: (untyped base, untyped token) -> untyped

      # pm_in_node_create
      def in_node: (untyped pattern, untyped statements, untyped in_keyword, untyped then_keyword) -> untyped

      # pm_instance_variable_and_write_node_create
      def instance_variable_and_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_instance_variable_operator_write_node_create
      def instance_variable_operator_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_instance_variable_or_write_node_create
      def instance_variable_or_write_node: (untyped target, untyped operator, untyped value) -> untyped

      # pm_instance_variable_read_node_create
      def instance_variable_read_node: (untyped token) -> untyped

      # pm_instance_variable_write_node_create
      def instance_variable_write_node: (untyped read_node, untyped operator, untyped value) -> untyped

      # pm_interpolated_node_append: a part of a regexp, symbol or xstring,
      # and whether the whole stays a static literal.
      def interpolated_node_append: (untyped node, untyped parts, untyped part) -> untyped

      # pm_interpolated_regular_expression_node_create
      def interpolated_regular_expression_node: (untyped opening) -> untyped

      # pm_interpolated_regular_expression_node_append
      def interpolated_regular_expression_node_append: (untyped node, untyped part) -> untyped

      # pm_interpolated_regular_expression_node_closing_set
      def interpolated_regular_expression_node_closing_set: (untyped node, untyped closing) -> untyped

      INTERPOLATED_STRING_FLAGS: untyped

      # pm_interpolated_string_node_append: a part, and what it does to the
      # string's static literal, frozen and mutable flags.
