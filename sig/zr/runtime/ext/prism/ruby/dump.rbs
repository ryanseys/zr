module Prism
  module Ruby
    # serialize.c: a parse as the bytes prism's C library writes for it,
    # which `Prism.dump` answers and `Prism.load` reads back.
    #
    # A tree of nodes does not carry everything the bytes hold, so the
    # writer takes the rest beside the result:
    #
    # * `pool`, the constant pool as the parser built it. It answers `size`,
    #   and `each_bucket`, which yields `[id, bytes, source_offset]` for each
    #   constant in the order of its hash table's buckets (the order the C
    #   writes owned constants' bytes in); `source_offset` is nil for a
    #   constant the pool owns.
    # * `shared`, a Hash by identity from each String that is a slice of the
    #   source to its offset there. Every other String is written as bytes
    #   of its own.
    # * `negative_zeros`, the ids of the nodes whose integer is a negated
    #   zero (`-0`), which pm_integer_t keeps a sign for and Integer cannot.
    class Dump
      @pool: untyped

      @shared: untyped

      @negative_zeros: untyped

      @buffer: untyped

      @ids: untyped

      # PRISM_VERSION_MAJOR, _MINOR and _PATCH.
      VERSION: ::Array[1 | 9 | 0]

      # pm_diagnostic_id_t: errors first, then warnings. An error and a
      # warning may share a name (invalid_character), so each list has its
      # own numbers.
      ERROR_TYPES: untyped

      WARNING_TYPES: untyped

      # pm_error_level_t and pm_warning_level_t.
      ERROR_LEVELS: { syntax: 0, argument: 1, load: 2 }

      WARNING_LEVELS: { default: 0, verbose: 1 }

      # pm_serialize_parse: the header, the content, and a closing zero.
      def self.parse: (untyped result, encoding_name: untyped, pool: untyped, shared: untyped, ?negative_zeros: untyped) -> untyped

      def initialize: (untyped pool, untyped shared, untyped negative_zeros) -> void

      def parse: (untyped result, untyped encoding_name) -> untyped

      private

      # pm_serialize_header: the magic, the version, and 0 for a dump
      # that keeps every location.
      def header: () -> untyped

      # pm_serialize_content: the metadata, a slot for the constant pool's
      # offset, the pool's size, the tree, then the pool.
      def content: (untyped result, untyped encoding_name) -> untyped

      # The table of constants, eight bytes each in id order: a source
      # offset or, with the top bit set, the offset of bytes written after
      # the table, then the length.
      def constant_pool: () -> untyped

      # pm_serialize_metadata
      def metadata: (untyped result, untyped encoding_name) -> untyped

      # pm_serialize_comment_list
      def comments: (untyped comments) -> untyped

      # pm_serialize_magic_comment_list
      def magic_comments: (untyped magic_comments) -> untyped

      # pm_serialize_diagnostic_list
      def diagnostics: (untyped diagnostics, untyped types, untyped levels) -> untyped

      # pm_serialize_node
      def node: (untyped node) -> untyped

      # The number of each node type, in config.yml's order by name.
      NODE_TYPES: { alias_global_variable_node: 1, alias_method_node: 2, alternation_pattern_node: 3, and_node: 4, arguments_node: 5, array_node: 6, array_pattern_node: 7, assoc_node: 8, assoc_splat_node: 9, back_reference_read_node: 10, begin_node: 11, block_argument_node: 12, block_local_variable_node: 13, block_node: 14, block_parameter_node: 15, block_parameters_node: 16, break_node: 17, call_and_write_node: 18, call_node: 19, call_operator_write_node: 20, call_or_write_node: 21, call_target_node: 22, capture_pattern_node: 23, case_match_node: 24, case_node: 25, class_node: 26, class_variable_and_write_node: 27, class_variable_operator_write_node: 28, class_variable_or_write_node: 29, class_variable_read_node: 30, class_variable_target_node: 31, class_variable_write_node: 32, constant_and_write_node: 33, constant_operator_write_node: 34, constant_or_write_node: 35, constant_path_and_write_node: 36, constant_path_node: 37, constant_path_operator_write_node: 38, constant_path_or_write_node: 39, constant_path_target_node: 40, constant_path_write_node: 41, constant_read_node: 42, constant_target_node: 43, constant_write_node: 44, def_node: 45, defined_node: 46, else_node: 47, embedded_statements_node: 48, embedded_variable_node: 49, ensure_node: 50, false_node: 51, find_pattern_node: 52, flip_flop_node: 53, float_node: 54, for_node: 55, forwarding_arguments_node: 56, forwarding_parameter_node: 57, forwarding_super_node: 58, global_variable_and_write_node: 59, global_variable_operator_write_node: 60, global_variable_or_write_node: 61, global_variable_read_node: 62, global_variable_target_node: 63, global_variable_write_node: 64, hash_node: 65, hash_pattern_node: 66, if_node: 67, imaginary_node: 68, implicit_node: 69, implicit_rest_node: 70, in_node: 71, index_and_write_node: 72, index_operator_write_node: 73, index_or_write_node: 74, index_target_node: 75, instance_variable_and_write_node: 76, instance_variable_operator_write_node: 77, instance_variable_or_write_node: 78, instance_variable_read_node: 79, instance_variable_target_node: 80, instance_variable_write_node: 81, integer_node: 82, interpolated_match_last_line_node: 83, interpolated_regular_expression_node: 84, interpolated_string_node: 85, interpolated_symbol_node: 86, interpolated_x_string_node: 87, it_local_variable_read_node: 88, it_parameters_node: 89, keyword_hash_node: 90, keyword_rest_parameter_node: 91, lambda_node: 92, local_variable_and_write_node: 93, local_variable_operator_write_node: 94, local_variable_or_write_node: 95, local_variable_read_node: 96, local_variable_target_node: 97, local_variable_write_node: 98, match_last_line_node: 99, match_predicate_node: 100, match_required_node: 101, match_write_node: 102, missing_node: 103, module_node: 104, multi_target_node: 105, multi_write_node: 106, next_node: 107, nil_node: 108, no_keywords_parameter_node: 109, numbered_parameters_node: 110, numbered_reference_read_node: 111, optional_keyword_parameter_node: 112, optional_parameter_node: 113, or_node: 114, parameters_node: 115, parentheses_node: 116, pinned_expression_node: 117, pinned_variable_node: 118, post_execution_node: 119, pre_execution_node: 120, program_node: 121, range_node: 122, rational_node: 123, redo_node: 124, regular_expression_node: 125, required_keyword_parameter_node: 126, required_parameter_node: 127, rescue_modifier_node: 128, rescue_node: 129, rest_parameter_node: 130, retry_node: 131, return_node: 132, self_node: 133, shareable_constant_node: 134, singleton_class_node: 135, source_encoding_node: 136, source_file_node: 137, source_line_node: 138, splat_node: 139, statements_node: 140, string_node: 141, super_node: 142, symbol_node: 143, true_node: 144, undef_node: 145, unless_node: 146, until_node: 147, when_node: 148, while_node: 149, x_string_node: 150, yield_node: 151 }

      def optional_node: (untyped node) -> untyped

      def nodes: (untyped nodes) -> untyped

      # pm_serialize_string: a slice of the source by offset, or bytes.
      def string: (untyped string) -> untyped

      def constant: (untyped symbol) -> untyped

      def optional_constant: (untyped symbol) -> untyped

      def constants: (untyped symbols) -> untyped

      # pm_serialize_location
      def location: (untyped location) -> untyped

      def optional_location: (untyped location) -> untyped

      # pm_serialize_integer: the sign, then the magnitude in 32-bit words,
      # least significant first.
      def integer: (untyped value, untyped node_id) -> untyped

      def embedded: (untyped bytes) -> untyped

      def byte: (untyped value) -> untyped

      # pm_buffer_append_varuint: LEB128.
      def varuint: (untyped value) -> untyped

      # pm_buffer_append_varsint: the zigzag form of an int32_t.
      def varsint: (untyped value) -> untyped
    end
  end
end
