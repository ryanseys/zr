module Prism
  module Ruby
    # prism.c's escape sequences: escape_read reads one after a backslash
    # into a buffer of bytes, and for a regexp also into the source the
    # regexp engine sees; lex_question_mark reads a character literal.
    class Parser
      @explicit_encoding: untyped

      @current_end: untyped

      @lex_state: untyped

      @current_string: untyped

      ESCAPE_FLAG_NONE: 0

      ESCAPE_FLAG_CONTROL: 1

      ESCAPE_FLAG_META: 2

      ESCAPE_FLAG_SINGLE: 4

      ESCAPE_FLAG_REGEXP: 8

      # ascii_printable_chars
      ASCII_PRINTABLE: untyped

      # The bytes that the simple escapes represent.
      SIMPLE_ESCAPES: { 92 => 92, 39 => 39, 97 => 7, 98 => 8, 101 => 27, 102 => 12, 110 => 10, 114 => 13, 115 => 32, 116 => 9, 118 => 11 }

      private

      # char_is_ascii_printable
      def ascii_printable?: (untyped byte) -> untyped

      # escape_hexadecimal_digit
      def escape_hexadecimal_digit: (untyped byte) -> untyped

      # escape_unicode: the code point of `length` hexadecimal digits, or
      # U+FFFD with an error for a surrogate.
      def escape_unicode: (untyped from, untyped length, ?untyped? error_start, ?untyped? error_end) -> (65533 | untyped)

      # escape_byte
      def escape_byte: (untyped value, untyped flags) -> untyped

      # pm_buffer_append_unicode_codepoint: false past U+10FFFF.
      def append_codepoint: (untyped buffer, untyped value) -> (false | true)

      # escape_write_unicode: a \u escape past ASCII, or any in a character
      # literal, makes the string UTF-8.
      def escape_write_unicode: (untyped buffer, untyped flags, untyped start, untyped finish, untyped value) -> (nil | untyped)

      # escape_write_byte_encoded: a byte past ASCII fixes the encoding.
      def escape_write_byte_encoded: (untyped buffer, untyped byte) -> untyped

      # escape_write_byte: the byte, and for a regexp its \xNN spelling.
      def escape_write_byte: (untyped buffer, untyped regexp_buffer, untyped flags, untyped byte) -> untyped

      # escape_write_escape_encoded: the character after the backslash as it
      # is.
      def escape_write_escape_encoded: (untyped buffer, untyped regexp_buffer, untyped flags) -> untyped

      # escape_read_warn: a space or tab inside \c, \C- or \M-.
      def escape_read_warn: (untyped flags, untyped flag, untyped type) -> untyped

      # escape_read: the escape after a backslash at @current_end - 1.
      def escape_read: (untyped buffer, untyped regexp_buffer, untyped flags) -> untyped

      # \0 through \777
      def escape_read_octal: (untyped buffer, untyped regexp_buffer, untyped flags) -> untyped

      # \xN and \xNN
      def escape_read_hexadecimal: (untyped buffer, untyped regexp_buffer, untyped flags) -> untyped

      # \uNNNN and \u{N ...}
      def escape_read_unicode: (untyped buffer, untyped regexp_buffer, untyped flags) -> (untyped | nil)

      # \cx and \C-x
      def escape_read_control: (untyped buffer, untyped regexp_buffer, untyped flags, untyped dash) -> untyped

      # \M-x
      def escape_read_meta: (untyped buffer, untyped regexp_buffer, untyped flags) -> untyped

      # lex_question_mark: a character literal, or the ? of a ternary. The
      # literal's bytes go to @current_string, as a slice of the source or
      # as owned bytes.
      def lex_question_mark: () -> (:QUESTION_MARK | :CHARACTER_LITERAL)

      # pm_string_shared_init: a slice of the source, which remembers where
      # it starts for Prism.dump.
      def shared_string: (untyped start, untyped finish) -> untyped

      # pm_string_owned_init: bytes the parser made.
      def owned_string: (untyped bytes) -> untyped
    end
  end
end
