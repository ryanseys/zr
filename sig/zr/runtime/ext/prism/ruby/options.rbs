module Prism
  module Ruby
    # pm_options_t, read from the keywords of a Prism call as the C
    # extension reads them (extension.c build_options_i), with its errors.
    # The messages of those errors are binary, as rb_raise makes them.
    class Options
      @filepath: untyped

      @line: untyped

      @encoding: untyped

      @encoding_locked: untyped

      @frozen_string_literal: untyped

      @command_line: untyped

      @version: untyped

      @main_script: untyped

      @partial_script: untyped

      @freeze: untyped

      @scopes: untyped

      # pm_options_version_t
      VERSION_CRUBY_3_3: 1

      VERSION_CRUBY_3_4: 2

      VERSION_CRUBY_4_0: 3

      VERSION_CRUBY_4_1: 4

      VERSION_LATEST: untyped

      # PM_OPTIONS_FROZEN_STRING_LITERAL_*
      FROZEN_STRING_LITERAL_DISABLED: -1

      FROZEN_STRING_LITERAL_UNSET: 0

      FROZEN_STRING_LITERAL_ENABLED: 1

      # PM_OPTIONS_COMMAND_LINE_*
      COMMAND_LINE: { "a" => 1, "e" => 2, "l" => 4, "n" => 8, "p" => 16, "x" => 32 }

      # The range of a C int.
      INT: ::Range[untyped]

      # The range of a C long.
      LONG: ::Range[untyped]

      # PM_OPTIONS_SCOPE_FORWARDING_*
      FORWARDING: { :* => 1, :** => 2, :& => 4, :"..." => 8 }

      # A scope an eval parses inside: local names as Strings, and what the
      # scope forwards.
      EvalScope: untyped

      attr_reader filepath: untyped

      attr_reader line: untyped

      attr_reader encoding: untyped

      attr_reader frozen_string_literal: untyped

      attr_reader command_line: untyped

      attr_reader version: untyped

      attr_reader scopes: untyped

      def initialize: (?untyped? filepath, **untyped keywords) -> void

      def encoding_locked?: () -> untyped

      def main_script?: () -> untyped

      def partial_script?: () -> untyped

      def freeze?: () -> untyped

      # Check_Type: the value, or the TypeError of one not of the type.
      def self.check_type: (untyped value, untyped type, ?untyped expected) -> untyped

      # A String as C reads it through its pointer: up to the first NUL.
      def self.c_string: (untyped value) -> untyped

      private

      # build_options_i
      def read: (untyped key, untyped value) -> untyped

      # check_string
      def string: (untyped value) -> untyped

      def c_string: (untyped value) -> untyped

      # NUM2INT: the value as a long (rb_num2long), then in an int's range.
      def int: (untyped value) -> untyped

      def read_version: (untyped value) -> untyped

      # pm_options_version_set
      def version_number: (untyped text) -> untyped

      def read_command_line: (untyped text) -> untyped

      # build_options_scopes
      def read_scopes: (untyped value) -> untyped

      def scope_parts: (untyped scope) -> ::Array[untyped]

      def symbol: (untyped value) -> untyped
    end
  end
end
