module Prism
  module Ruby
    # static_literals.c: the literal hash keys and `when` values seen so far,
    # to warn about duplicates. Each kind of literal has its own table; the
    # tables keep the C's murmur hash, size and linear probing, because a
    # resize there places each node without probing and so can drop one,
    # which decides which duplicates are found.
    class StaticLiterals
      @integers: untyped

      @floats: untyped

      @numbers: untyped

      @strings: untyped

      @regexps: untyped

      @symbols: untyped

      @singletons: untyped

      # pm_node_hash_t
      class Table
        @hash: untyped

        @compare: untyped

        @nodes: untyped

        @size: untyped

        @capacity: untyped

        def initialize: (untyped hash, untyped compare) -> void

        # pm_node_hash_insert: the node already there that equals `node`, or
        # nil; with `replace` the new node takes its slot.
        def insert: (untyped node, untyped replace) -> untyped
      end

      # `parser` supplies the C's node_hash and comparisons.
      def initialize: (untyped parser) -> void

      # pm_static_literals_add: the earlier equal literal, or nil.
      def add: (untyped node, untyped replace) -> untyped
    end

    class Parser
      # pm_node_type_t numbers, which the hashes and comparisons mix in.
      NODE_TYPE_NUMBERS: untyped

      private

      # node_hash
      def static_literal_hash: (untyped node) -> untyped

      # pm_compare_integer_nodes
      def compare_integer_nodes: (untyped left, untyped right) -> untyped

      # pm_compare_float_nodes, where NaN compares equal.
      def compare_float_nodes: (untyped left, untyped right) -> untyped

      # pm_compare_number_nodes
      def compare_number_nodes: (untyped left, untyped right) -> untyped

      # pm_compare_string_nodes: by length, then bytes.
      def compare_string_nodes: (untyped left, untyped right) -> untyped

      # pm_compare_regular_expression_nodes
      def compare_regular_expression_nodes: (untyped left, untyped right) -> untyped

      # pm_string_value
      def static_literal_string: (untyped node) -> untyped

      # murmur_scramble
      def murmur_scramble: (untyped value) -> untyped

      # murmur_hash over the bytes of `key`.
      def murmur_hash: (untyped key) -> untyped

      # integer_hash over pm_integer_t's words: one 32-bit value, or the
      # magnitude's 32-bit words past that, least significant first.
      def integer_hash: (untyped value, untyped negative_zero) -> untyped

      # pm_integer_compare, with a negated zero below zero.
      def integer_compare: (untyped left, untyped left_negative_zero, untyped right, untyped right_negative_zero) -> untyped

      # pm_int64_value
      def int64_value: (untyped node) -> untyped

      # Whether an integer node contains a negated zero (`-0`).
      def negative_zero?: (untyped node) -> untyped

      # pm_hash_key_static_literals_add: a warning when a literal key repeats,
      # at the earlier key.
      def hash_key_static_literals_add: (untyped literals, untyped node) -> (nil | untyped)

      # pm_when_clause_static_literals_add
      def when_clause_static_literals_add: (untyped literals, untyped node) -> (nil | untyped)

      # pm_static_literal_inspect: the literal as Ruby would show it.
      def static_literal_inspect: (untyped node) -> untyped

      # pm_static_literal_positive_p
      def static_literal_positive?: (untyped node) -> untyped

      # The escapes pm_buffer_append_source writes with Ruby escaping.
      RUBY_ESCAPES: { 7 => "\\a", 8 => "\\b", 9 => "\\t", 10 => "\\n", 11 => "\\v", 12 => "\\f", 13 => "\\r", 34 => "\\\"", 92 => "\\\\" }

      # pm_buffer_append_source with PM_BUFFER_ESCAPING_RUBY
      def escape_ruby: (untyped bytes) -> untyped
    end
  end
end
