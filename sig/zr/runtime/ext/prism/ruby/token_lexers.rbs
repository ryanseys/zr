module Prism
  module Ruby
    # prism.c's "Specific token lexers": numbers, global, instance and class
    # variables, identifiers and keywords, character literals and embedded
    # documentation. Each advances @current_end and returns a token type.
    class Parser
      @current_end: untyped

      @integer_base: untyped

      @lex_state: untyped

      @command_start: untyped

      @current_type: untyped

      @current_start: untyped

      # The punctuation a global variable's name may be (the `PUNCT` hash).
      GLOBAL_NAME_PUNCTUATION: untyped

      # The keywords lex_identifier knows: text => [state, type, modifier
      # type or nil]. C tries them by length in turn; no two share a text, so
      # one lookup finds the one C finds.
      KEYWORDS: untyped

      # The lengths a keyword has.
      KEYWORD_WIDTHS: untyped

      private

      # char_is_identifier_start
      def identifier_start_width: (untyped at) -> (0 | untyped)

      # char_is_identifier_utf8
      def identifier_width_utf8: (untyped at) -> (0 | untyped)

      # char_is_identifier
      def identifier_width: (untyped at) -> (0 | untyped)

      # char_is_global_name_punctuation
      def global_name_punctuation?: (untyped byte) -> untyped

      # The width of the character at `at` in the source's encoding, as
      # parser_char_width calculates it: never 0.
      def parser_char_width: () -> untyped

      # current_token_starts_line
      def current_token_starts_line?: () -> untyped

      # pm_token_is_numbered_parameter: /\A_[1-9]\z/.
      def numbered_parameter?: (untyped start, untyped finish) -> untyped

      # pm_strspn_number_validate: an error for a misplaced underscore.
      def number_validate: (untyped from, untyped) -> untyped

      def binary_number_validate: (untyped from) -> untyped

      def octal_number_validate: (untyped from) -> untyped

      def decimal_number_validate: (untyped from) -> untyped

      def hexadecimal_number_validate: (untyped from) -> untyped

      # lex_optional_float_suffix: the type and whether an exponent was seen.
      def lex_optional_float_suffix: () -> ::Array[untyped]

      # lex_numeric_prefix
      def lex_numeric_prefix: () -> ::Array[untyped]

      # lex_numeric
      def lex_numeric: () -> untyped

      # The error lex_global_variable and lex_at_variable give for an invalid
      # name under 3.3 or later versions.
      def before_3_4?: () -> untyped

      # lex_global_variable
      def lex_global_variable: () -> (:GLOBAL_VARIABLE | untyped)

      # lex_at_variable
      def lex_at_variable: () -> untyped

      # lex_keyword, for a text known to be the keyword: the state it moves
      # to, and the type or the modifier type that it returns.
      def lex_keyword: (untyped state, untyped type, untyped modifier_type) -> untyped

      # lex_identifier
      def lex_identifier: (untyped previous_command_start) -> (:LABEL | untyped | :METHOD_NAME | :IDENTIFIER)

      # Where an identifier may take a trailing `:` as a label.
      def label_position?: (untyped previous_command_start) -> untyped

      # parser_lex_callback
      def lex_callback: () -> untyped

      # lex_embdoc: :EMBDOC_END, or :EOF when the document never ends. The
      # begin, line and end tokens go to the lex callback only.
      def lex_embdoc: () -> (:EMBDOC_END | :EOF)
    end
  end
end
