# Init_prism (extension.c) and Init_prism_pack (api_pack.c): the Prism
# constant and the singleton methods that prism's C extension defines,
# implemented by the Ruby port. A gem's own Ruby part then finds Prism as
# it would after the C extension loads.
module Prism
  VERSION: untyped

  def self.lex: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.lex_file: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_file: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.profile: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.profile_file: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_stream: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_comments: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_file_comments: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_lex: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_lex_file: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_success?: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_failure?: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_file_success?: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.parse_file_failure?: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.dump: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def self.dump_file: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  class StringQuery
    def self.local?: (untyped string) -> untyped

    def self.constant?: (untyped string) -> untyped

    def self.method_name?: (untyped string) -> untyped
  end

  module Pack
    class Directive
    end

    class Format
    end

    def self.parse: (untyped version, untyped variant, untyped source) -> untyped
  end
end
