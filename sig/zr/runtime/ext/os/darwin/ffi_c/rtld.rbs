# darwin's dlopen(3) flags, with FFI::DynamicLibrary's names for them.
module FFI
  class DynamicLibrary
    RTLD_LAZY: 1

    RTLD_NOW: 2

    RTLD_GLOBAL: 8

    RTLD_LOCAL: 4

    RTLD_NOLOAD: 16

    RTLD_NODELETE: 128

    RTLD_FIRST: 256

    RTLD_DEEPBIND: 0

    RTLD_MEMBER: 0

    RTLD_BINDING_MASK: 3

    RTLD_LOCATION_MASK: 12

    RTLD_ALL_MASK: 415
  end
end
