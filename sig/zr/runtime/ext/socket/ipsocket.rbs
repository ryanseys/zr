# ipsocket.c, tcpsocket.c, tcpserver.c and udpsocket.c: the sockets of
# the Internet families. A TCP client resolves its host and tries each
# address in the order that the resolver returns, as
# init_inetsock_internal tries them.
class IPSocket < BasicSocket
  def inspect: () -> untyped

  def addr: (*untyped args) -> untyped

  def peeraddr: (*untyped args) -> untyped

  def recvfrom: (untyped len, ?untyped? flags, ?untyped? str) -> untyped

  def self.getaddress: (untyped host) -> untyped

  private

  def ip_address: (untyped peer, untyped args) -> untyped

  # rsock_init_inetsock: this socket, connected to the remote host, or
  # for a server bound to it and listening.
  def init_inetsock: (untyped remote_host, untyped remote_serv, untyped local_host, untyped local_serv, untyped server, ?untyped? resolv_timeout, ?untyped? connect_timeout, ?untyped? open_timeout) -> untyped
end

class TCPSocket < IPSocket
  def initialize: (untyped remote_host, untyped remote_serv, ?untyped? local_host, ?untyped? local_serv, ?resolv_timeout: untyped?, ?connect_timeout: untyped?, ?open_timeout: untyped?, ?fast_fallback: untyped?, ?test_mode_settings: untyped?) -> void

  def self.gethostbyname: (untyped host) -> untyped
end

class TCPServer < TCPSocket
  def initialize: (?untyped? hostname, untyped port) -> void

  def accept: () -> untyped

  def sysaccept: () -> untyped

  def listen: (untyped backlog) -> untyped

  private

  def __accept_nonblock: (untyped exception) -> untyped
end

class UDPSocket < IPSocket
  def initialize: (?untyped? family) -> void

  def connect: (untyped host, untyped port) -> (0 | untyped)

  def bind: (untyped host, untyped port) -> (0 | untyped)

  def send: (*untyped args) -> untyped

  private

  def __recvfrom_nonblock: (untyped len, untyped flags, untyped str, untyped exception) -> untyped

  # rsock_fd_family: the family of the socket's own address, AF_UNSPEC
  # when it has none.
  def descriptor_family: () -> untyped
end
