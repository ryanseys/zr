# ancdata.c: the control messages that sendmsg and recvmsg send and
# receive, and the two calls themselves. A cmsghdr here is 12 bytes, and
# its data is padded to a multiple of 4.
class Socket < BasicSocket
  class AncillaryData
    @family: untyped

    @level: untyped

    @type: untyped

    @data: untyped

    @unix_rights: untyped

    def initialize: (untyped family, untyped level, untyped type, untyped data) -> void

    def family: () -> untyped

    def level: () -> untyped

    def type: () -> untyped

    def data: () -> untyped

    def cmsg_is?: (untyped level, untyped type) -> untyped

    def int: () -> untyped

    def unix_rights: () -> untyped

    def timestamp: () -> untyped

    def ip_pktinfo: () -> ::Array[untyped]

    def ipv6_pktinfo: () -> ::Array[untyped]

    def ipv6_pktinfo_addr: () -> untyped

    def ipv6_pktinfo_ifindex: () -> untyped

    def inspect: () -> untyped

    def self.int: (untyped family, untyped level, untyped type, untyped integer) -> untyped

    def self.unix_rights: (*untyped ios) -> untyped

    def self.ip_pktinfo: (untyped addr, untyped ifindex, ?untyped? spec_dst) -> untyped

    def self.ipv6_pktinfo: (untyped addr, untyped ifindex) -> untyped

    # An IPv4 address's four bytes in a sockaddr_in whose length byte
    # stays 0, as ancillary_ip_pktinfo builds it.
    def self.in_addrinfo: (untyped bytes) -> untyped

    # The message's value as ancillary_inspect writes the messages it
    # knows here, or nil for one it shows as bytes.
    def self.shown: (untyped family, untyped level, untyped type, untyped bytes) -> untyped

    # A message of a received control buffer: [level, type, data], and
    # where the next begins.
    def self.cmsgs: (untyped control) -> untyped

    private

    def self.build: (untyped family, untyped level, untyped type, untyped data) -> untyped

    def assign: (untyped family, untyped level, untyped type, untyped data) -> self

    def ipv6_pktinfo_bytes: () -> untyped

    # make_io_for_unix_rights: each descriptor in a message, as a
    # Socket when it is one and an IO otherwise.
    def take_rights: () -> (nil | untyped)
  end

  # discard_cmsg: closes the descriptors in an SCM_RIGHTS message,
  # because no caller asked for them.
  def self.discard_rights: (untyped control) -> untyped
end

class BasicSocket < IO
  private

  def __sendmsg: (untyped mesg, untyped flags, untyped dest_sockaddr, untyped controls) -> untyped

  def __sendmsg_nonblock: (untyped mesg, untyped flags, untyped dest_sockaddr, untyped controls, untyped exception) -> untyped

  def __recvmsg: (untyped dlen, untyped flags, untyped clen, untyped scm_rights) -> untyped

  def __recvmsg_nonblock: (untyped dlen, untyped flags, untyped clen, untyped scm_rights, untyped exception) -> untyped

  # bsock_sendmsg_internal.
  def send_message: (untyped mesg, untyped flags, untyped dest_sockaddr, untyped controls, untyped exception, untyped nonblock) -> (untyped | :wait_writable)

  # bsock_recvmsg_internal. Without both lengths given, the call peeks
  # with buffers that grow until the message fits, and then takes it.
  def receive_message: (untyped dlen, untyped flags, untyped clen, untyped scm_rights, untyped exception, untyped nonblock) -> (:wait_readable | nil | untyped)
end
