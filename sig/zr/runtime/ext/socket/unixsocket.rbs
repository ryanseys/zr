# unixsocket.c and unixserver.c: sockets named by a path, which can also
# hand a descriptor to the process at the other end.
class UNIXSocket < BasicSocket
  @path: untyped

  def initialize: (untyped path) -> void

  def path: () -> untyped

  def addr: () -> untyped

  def peeraddr: () -> untyped

  def recvfrom: (untyped len, ?untyped? flags, ?untyped? str) -> untyped

  # unix_send_io: one byte of data, and the descriptor in SCM_RIGHTS.
  def send_io: (untyped io) -> (nil | untyped)

  # unix_recv_io: the descriptor the other end sent, as `klass.for_fd`
  # makes it, or as a number when `klass` is nil.
  def recv_io: (*untyped args) -> untyped

  def self.socketpair: (*untyped args) { (?) -> untyped } -> untyped

  alias self.pair self.socketpair

  private

  def unix_address: (untyped peer, untyped call) -> untyped

  # rsock_init_unixsock: this socket, connected to the path, or for a
  # server bound to it and listening.
  def init_unixsock: (untyped path, untyped server) -> self
end

class UNIXServer < UNIXSocket
  def initialize: (untyped path) -> void

  def accept: () -> untyped

  def sysaccept: () -> untyped

  def listen: (untyped backlog) -> untyped

  private

  def __accept_nonblock: (untyped exception) -> untyped
end
