# option.c: one socket option's family, level, name and bytes, which
# read back as the number, the flag or the structure of the option.
class Socket < BasicSocket
  class Option
    @family: untyped

    @level: untyped

    @optname: untyped

    @data: untyped

    def initialize: (untyped family, untyped level, untyped optname, untyped data) -> void

    def family: () -> untyped

    def level: () -> untyped

    def optname: () -> untyped

    def data: () -> untyped

    alias to_s data

    def unpack: (untyped template) -> untyped

    def int: () -> untyped

    def byte: () -> untyped

    def bool: () -> untyped

    def linger: () -> ::Array[untyped]

    def ipv4_multicast_loop: () -> untyped

    def ipv4_multicast_ttl: () -> untyped

    def inspect: () -> untyped

    def self.int: (untyped family, untyped level, untyped optname, untyped value) -> untyped

    def self.byte: (untyped family, untyped level, untyped optname, untyped value) -> untyped

    def self.bool: (untyped family, untyped level, untyped optname, untyped value) -> untyped

    def self.linger: (untyped onoff, untyped secs) -> untyped

    def self.ipv4_multicast_loop: (untyped value) -> untyped

    def self.ipv4_multicast_ttl: (untyped value) -> untyped

    private

    # rsock_sockopt_new: an option with these numbers, as a socket
    # returns one.
    def self.build: (untyped family, untyped level, untyped optname, untyped data) -> untyped

    def self.packed: (untyped family, untyped level, untyped optname, untyped bytes) -> untyped

    # optname_to_sym: an IP level's option by name.
    def self.optname_name: (untyped level, untyped optname) -> untyped

    # The option's value as sockopt_inspect writes the options it knows
    # here, or nil for one it shows as bytes.
    def self.shown: (untyped family, untyped level, untyped optname, untyped bytes) -> untyped

    def self.shown_int: (untyped bytes) -> untyped

    def self.shown_linger: (untyped bytes) -> (nil | ::String)

    # struct xucred: its version, its user and its groups.
    def self.shown_xucred: (untyped bytes) -> (nil | ::String)

    def self.ipv4_text: (untyped bytes) -> untyped

    def self.ipv6_text: (untyped bytes) -> untyped

    # rb_if_indextoname: the interface an index names, after one prefix,
    # or the index after the other when it names none.
    def self.interface: (untyped named, untyped unnamed, untyped index) -> untyped

    def assign: (untyped family, untyped level, untyped optname, untyped data) -> self

    # check_size: the bytes, which must be `size` of them.
    def sized: (untyped size, untyped spelled) -> untyped

    def ipv4_int: (untyped name, untyped spelled) -> untyped
  end
end
