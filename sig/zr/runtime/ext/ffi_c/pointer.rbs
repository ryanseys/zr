# Pointer.c and MemoryPointer.c: memory at an address, and memory that
# ffi_c allocates. ffi_c frees it when nothing refers to the pointer,
# unless told to keep it.
module FFI
  class Pointer < AbstractMemory
    self.@kept: untyped

    @parent: untyped

    @flags: untyped

    @autorelease: untyped

    @storage: untyped

    @allocated: untyped

    MEM_RD: 1

    MEM_WR: 2

    MEM_SWAP: 8

    UNBOUNDED: untyped

    # rbffi_Pointer_NewInstance: NULL is the one NULL pointer.
    def self.new_instance: (untyped address) -> untyped

    # Allocated storage a pointer was told not to release, which lives
    # as long as the process.
    def self.kept: () -> untyped

    def initialize: (*untyped args) -> void

    def initialize_copy: (untyped other) -> self

    def inspect: () -> untyped

    alias to_s inspect

    def +: (untyped offset) -> untyped

    def slice: (untyped offset, untyped length) -> untyped

    def null?: () -> untyped

    def ==: (untyped other) -> untyped

    def address: () -> untyped

    alias to_i address

    def order: (*untyped args) -> (untyped | self)

    def autorelease=: (untyped autorelease) -> untyped

    def autorelease?: () -> untyped

    def type_size: () -> untyped

    def free: () -> self

    # memptr_malloc: `size` fresh bytes this pointer owns, in bytes whose
    # address is a multiple of eight.
    def ffi_allocate: (untyped size, untyped type_size) -> untyped

    def ffi_release: () -> untyped

    # slice: a Pointer over part of this, which keeps this alive.
    def ffi_slice: (untyped offset, untyped length) -> untyped

    private

    def ffi_parent=: (untyped parent) -> untyped
  end

  class Pointer
    NULL: untyped
  end

  class MemoryPointer < Pointer
    # rbffi_MemoryPointer_NewInstance.
    def self.new_instance: (untyped size, untyped count, untyped clear) -> untyped

    def initialize: (untyped size, *untyped rest) ?{ (untyped) -> untyped } -> void

    def self.from_string: (untyped text) -> untyped
  end
end
