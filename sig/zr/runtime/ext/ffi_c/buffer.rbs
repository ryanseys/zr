# Buffer.c: memory for a call's argument. Eight bytes or fewer are kept
# inside the buffer itself.
module FFI
  class Buffer < AbstractMemory
    @storage: untyped

    @parent: untyped

    MEM_RD: 1

    MEM_WR: 2

    MEM_SWAP: 8

    MEM_EMBED: 16

    EMBED_MAXLEN: 8

    # buffer_alloc_inout: a new buffer set up by Buffer's own initialize,
    # whatever a subclass makes of it.
    def self.alloc_inout: (*untyped args) { (?) -> untyped } -> untyped

    alias self.alloc_out self.alloc_inout

    alias self.alloc_in self.alloc_inout

    alias self.new_in self.alloc_in

    alias self.new_out self.alloc_out

    alias self.new_inout self.alloc_inout

    def initialize: (untyped size, *untyped rest) ?{ (untyped) -> untyped } -> void

    def initialize_copy: (untyped other) -> self

    def order: (*untyped args) -> (untyped | self)

    def inspect: () -> untyped

    alias length total

    def +: (untyped offset) -> untyped

    def slice: (untyped offset, untyped length) -> untyped

    # slice: a Buffer over part of this, which keeps this alive.
    def ffi_slice: (untyped offset, untyped length) -> untyped

    private

    def ffi_parent=: (untyped parent) -> untyped
  end
end
