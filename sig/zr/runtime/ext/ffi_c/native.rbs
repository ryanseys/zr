# What every file of the C part shares: ruby's C conversions (NUM2INT and
# the related macros) with the words their errors use, native memory that
# the collector frees with the object that owns it, and libffi's ffi_type.
module FFI
  self.@big_decimal: untyped

  # The typedefs that a program adds, kept separate from TypeDefs.
  @custom_typedefs: untyped

  # NUM2INT.
  def self.int_value: (untyped value) -> untyped

  # NUM2LONG.
  def self.long_value: (untyped value) -> untyped

  # NUM2ULONG: a value from -2**63 up to 2**64 - 1, which C reads as
  # unsigned.
  def self.ulong_value: (untyped value, ?::String type) -> untyped

  # NUM2UINT: as NUM2ULONG, then within the range of an unsigned int.
  def self.uint_value: (untyped value) -> untyped

  # NUM2LL.
  def self.ll_value: (untyped value) -> untyped

  # NUM2ULL.
  def self.ull_value: (untyped value) -> untyped

  # NUM2DBL.
  def self.dbl_value: (untyped value) -> untyped

  # rbffi_longdouble_new: a long double as a BigDecimal when bigdecimal
  # loads, and as a Float when it does not. Here a long double is a
  # double.
  def self.longdouble_new: (untyped value) -> untyped

  # rbffi_num2longdouble.
  def self.longdouble_value: (untyped value) -> untyped

  # StringValueCStr.
  def self.cstr_value: (untyped value) -> untyped

  # TypedData_Get_Struct and Check_Type: `value` itself, when it is
  # the type that the C part expects.
  def self.typed: (untyped value, untyped klass, ?untyped expected) -> untyped

  # Bytes that the collector frees when nothing refers to them: the
  # String keeps them, and its bytes never move while no write goes through it.
  def self.storage: (untyped size) -> untyped

  def self.address_of: (untyped storage) -> untyped

  # A native address as C's %p writes it inside ruby.
  def self.hex: (untyped address) -> untyped

  def self._async_cb_dispatcher_atfork_child: () -> nil

  # The typedefs that a program adds, kept separate from TypeDefs.
  def self?.custom_typedefs: () -> untyped

  # libffi's ffi_type: a size, an alignment, a kind and, for an aggregate,
  # its elements, laid out in native memory for libffi to read. A builtin
  # one is libffi's own; one ffi_c makes lives as long as this does.
  class FFIType
    self.@builtins: untyped

    @address: untyped

    @code: untyped

    @size: untyped

    @alignment: untyped

    @elements: untyped

    @header: untyped

    @list: untyped

    VOID: 0

    FLOAT: 2

    DOUBLE: 3

    STRUCT: 13

    attr_reader address: untyped

    attr_reader size: untyped

    attr_reader alignment: untyped

    attr_reader code: untyped

    attr_reader elements: untyped

    # One of libffi's scalars, by the name libffi gives it: one object a
    # name, as libffi has one ffi_type.
    def self.builtin: (untyped name, untyped code, untyped size) -> untyped

    # An aggregate over `elements`, which a nil ends early, as libffi's
    # element list ends at a NULL.
    def self.aggregate: (untyped size, untyped alignment, untyped elements) -> untyped

    def initialize: (untyped address, untyped code, untyped size, untyped alignment, untyped elements, untyped header) -> void

    # The fields libffi reads, written again over a new element list.
    def update: (untyped size, untyped alignment, untyped elements) -> self

    def float?: () -> untyped

    # find_homogeneous_leaf_type: the one scalar every leaf is, or nil,
    # and whether each leaf is a float.
    def homogeneous_leaf: () -> (::Array[self | untyped] | ::Array[untyped])
  end
end
