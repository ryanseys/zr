# StructLayout.c and Struct.c: the position of each field of a C struct
# and its type, a struct over memory, and the array that a struct
# contains inline.
module FFI
  class StructLayout < Type
    @alignment: untyped

    @size: untyped

    @fields: untyped

    @names: untyped

    @map: untyped

    @ffi: untyped

    class Field
      @offset: untyped

      @name: untyped

      @type: untyped

      @reference: untyped

      def initialize: (*untyped args) -> void

      def offset: () -> untyped

      def size: () -> untyped

      def alignment: () -> untyped

      def name: () -> untyped

      def type: () -> untyped

      def get: (untyped pointer) -> untyped

      def put: (untyped pointer, untyped value) -> self

      # Whether a memory op reads and writes this field without `get`.
      def ffi_op?: () -> untyped

      def ffi_reference?: () -> untyped
    end

    class Number < Field
    end

    class String < Field
    end

    class Pointer < Field
    end

    class Function < Field
      def get: (untyped pointer) -> untyped

      def put: (untyped pointer, untyped proc) -> self
    end

    class Array < Field
      def get: (untyped pointer) -> untyped

      def put: (untyped pointer, untyped value) -> untyped
    end

    def initialize: (untyped fields, untyped size, untyped alignment) -> void

    def []: (untyped name) -> untyped

    def fields: () -> untyped

    def members: () -> untyped

    def to_a: () -> untyped

    # struct_layout_union_bang: libffi has no unions, so a union passes as
    # repeats of the one type whose alignment is the union's.
    def __union!: () -> self

    def ffi_native: () -> untyped

    def ffi_type: () -> untyped

    def ffi_field: (untyped name) -> untyped
  end

  class Struct
    @layout: untyped

    @pointer: untyped

    @references: untyped

    @set_layout: untyped

    alias self.alloc_in self.new

    alias self.alloc_out self.new

    alias self.alloc_inout self.new

    alias self.new_in self.new

    alias self.new_out self.new

    alias self.new_inout self.new

    def initialize: (*untyped args) -> void

    def initialize_copy: (untyped other) -> self

    def order: (*untyped args) -> untyped

    def pointer: () -> untyped

    def layout: () -> untyped

    def []: (untyped name) -> untyped

    def []=: (untyped name, untyped value) -> untyped

    def null?: () -> untyped

    def self.class_layout: (untyped klass) -> untyped

    private

    def pointer=: (untyped pointer) -> self

    def layout=: (untyped layout) -> self

    # struct_layout and struct_validate: the layout, taken from the class
    # the first time, and the memory, allocated the first time.
    def ffi_layout: () -> untyped

    def ffi_pointer: () -> untyped

    def ffi_references: () -> untyped

    def ffi_allocate: () -> untyped

    # struct_field: the field `name` names, which must be one.
    def ffi_field: (untyped name) -> untyped

    class InlineArray
      @memory: untyped

      @field: untyped

      @array: untyped

      @component: untyped

      @kind: untyped

      include Enumerable

      def initialize: (untyped memory, untyped field) -> void

      def []: (untyped index) -> untyped

      def []=: (untyped index, untyped value) -> untyped

      def each: () { (untyped) -> untyped } -> self

      def size: () -> untyped

      def to_a: () -> untyped

      def to_ptr: () -> untyped

      private

      # inline_array_offset.
      def ffi_offset: (untyped index) -> untyped
    end
  end

  class StructLayout
    class CharArray < Struct::InlineArray
      def to_s: () -> untyped

      alias to_str to_s
    end
  end
end
