# LastError.c: the errno that each thread's last C call left, kept
# separate from errno itself, which ruby's own calls change.
module FFI
  module LastError
    def self?.error: () -> untyped

    def self?.error=: (untyped value) -> nil

    # rbffi_save_errno.
    def self?.save: (untyped errno) -> untyped
  end
end
