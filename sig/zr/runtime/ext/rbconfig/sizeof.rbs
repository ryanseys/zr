# `rbconfig/sizeof`, which ruby builds as a C extension from its own
# <limits.h>, <float.h> and <stdint.h>. zr compiles no C, so the facts
# come from the program's target instead: every target here is one C
# ABI, and `RUBY_PLATFORM` identifies which. A gem reads these to size a
# buffer or to bound an integer, and both results follow from the width
# of a pointer.
module RbConfig
  # In the order the C extension writes them, so a program that prints
  # the table prints ruby's.
  ORDER: ::Array["int" | "short" | "long" | "long long" | "__int128" | "off_t" | "void*" | "float" | "double" | "time_t" | "clock_t" | "size_t" | "ptrdiff_t" | "dev_t" | "int8_t" | "uint8_t" | "int16_t" | "uint16_t" | "int32_t" | "uint32_t" | "int64_t" | "uint64_t" | "int128_t" | "uint128_t" | "intptr_t" | "uintptr_t" | "ssize_t" | "int_least8_t" | "int_least16_t" | "int_least32_t" | "int_least64_t" | "int_fast8_t" | "int_fast16_t" | "int_fast32_t" | "int_fast64_t" | "intmax_t" | "sig_atomic_t" | "wchar_t" | "wint_t" | "wctrans_t" | "wctype_t" | "_Bool" | "long double" | "float _Complex" | "double _Complex" | "long double _Complex"]

  SIZEOF: untyped

  LIMITS: untyped
end
