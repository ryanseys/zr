# `require "pty"`: a pseudo-terminal pair. ruby opens the master through
# the Unix98 calls (posix_openpt, grantpt, unlockpt) and then opens the
# slave device by the name they give.
module PTY
  # A child that ended or stopped, which PTY.check reports. The status
  # it contains is the one that the wait returned.
  class ChildExited < RuntimeError
    attr_reader status: untyped
  end

  # The master and the slave of a new pair. The master is an IO whose
  # path refers to the pair, not to a file; the slave is a File on the
  # device itself. A block takes the pair and leaves both closed.
  def self.open: () ?{ (untyped) -> untyped } -> untyped

  private

  # pty_getpty: a child on the far end of a new pair, leading a session
  # with the slave for its terminal, and the master as a reading File and
  # a writing one, both named for the slave. With no command the child
  # is the user's shell. A block takes the three, and the child is
  # detached after it. pty.c gives the one function both names.
  def self.spawn: (*untyped command) { (?) -> untyped } -> untyped

  def self.getpty: (*untyped command) { (?) -> untyped } -> untyped

  public

  def self.pty_getpty: (untyped command) ?{ (untyped) -> untyped } -> (untyped | nil)

  # pty.c defines both with rb_define_module_function, so a class that
  # includes PTY has a private copy of each.
  def spawn: (*untyped) ?{ (?) -> untyped } -> untyped

  def getpty: (*untyped) ?{ (?) -> untyped } -> untyped

  # Whether a child changed state: nil while it runs, its status after
  # it ended or stopped, and a ChildExited raise when the caller
  # requests an exception.
  def self.check: (untyped pid, ?untyped? want_raise) -> (nil | untyped)

  # The word ruby puts in the message: a stopped child, one that changed
  # in some other way and is still there, or one that has gone.
  def self.state_of: (untyped pid, untyped status) -> ("stopped" | untyped)

  # establishShell's shell: $SHELL, else the user's login shell, else
  # /bin/sh.
  def self.login_shell: () -> untyped

  # A File on a descriptor, named `path`.
  def self.stream: (untyped fd, untyped mode, untyped path) -> untyped

  # pty_detach_process: a child already gone is reaped, else a thread
  # waits for it.
  def self.detach: (untyped pid) -> untyped
end
