module JSON
  module Ext
    module Generator
      # rb_convert_type: `val`, or the value of its `method`, as a `klass`.
      def self.convert_type: (untyped val, untyped klass, untyped method) -> untyped

      class State
        self.@default_sort_keys_proc: untyped

        # generator.c's JSON_Generator_State. A State keeps it out of the
        # program's sight, as the C struct is, so `to_h` lists only the
        # instance variables a program set.
        Fields: untyped

        # The C string escapes, and the bytes each class of escape reads.
        ESCAPES: { "\"" => "\\\"", "\\" => "\\\\", "/" => "\\/", "\b" => "\\b", "\f" => "\\f", "\n" => "\\n", "\r" => "\\r", "\t" => "\\t" }

        BASIC: ::Regexp

        SCRIPT_SAFE: ::Regexp

        ASCII_ONLY: ::Regexp

        ASCII_ONLY_SCRIPT_SAFE: ::Regexp

        FBUFFER_INITIAL_LENGTH_DEFAULT: 1024

        # cState_from_state_s
        def self.from_state: (untyped opts) -> untyped

        def self.default_sort_keys_proc=: (untyped proc) -> untyped

        def self.default_sort_keys_proc: () -> untyped

        # cState_m_generate: a document from `opts`, with no State made
        # for it.
        def self.generate: (untyped obj, untyped opts, untyped io) -> untyped

        def self._generate_no_fallback: (untyped obj, untyped opts, untyped io) -> untyped

        private

        def self.fresh_fields: () -> untyped

        def self.configured: (untyped opts) -> untyped

        # configure_state
        def self.configure_fields: (untyped fields, untyped config) -> (nil | untyped)

        def self.string_config: (untyped config) -> (false | untyped)

        def self.long_config: (untyped num) -> untyped

        def self.depth_config: (untyped num) -> (0 | untyped)

        def self.initial_length: (untyped fields, untyped length) -> untyped

        def self.sort_keys_config: (untyped value) -> (untyped | false)

        public

        def initialize: (*untyped) -> void

        alias initialize initialize

        def initialize_copy: (untyped orig) -> self

        def indent: () -> untyped

        def space: () -> untyped

        def space_before: () -> untyped

        def object_nl: () -> untyped

        def array_nl: () -> untyped

        def indent=: (untyped indent) -> nil

        def space=: (untyped space) -> nil

        def space_before=: (untyped space_before) -> nil

        def object_nl=: (untyped object_nl) -> nil

        def array_nl=: (untyped array_nl) -> nil

        def as_json: () -> untyped

        def as_json=: (untyped as_json) -> nil

        def max_nesting: () -> untyped

        def max_nesting=: (untyped depth) -> nil

        def script_safe: () -> untyped

        alias script_safe? script_safe

        def script_safe=: (untyped enable) -> nil

        def strict: () -> untyped

        alias strict? strict

        def strict=: (untyped enable) -> nil

        def check_circular?: () -> untyped

        def allow_nan?: () -> untyped

        def allow_nan=: (untyped enable) -> nil

        def ascii_only?: () -> untyped

        def ascii_only=: (untyped enable) -> nil

        def depth: () -> untyped

        def depth=: (untyped depth) -> nil

        def buffer_initial_length: () -> untyped

        def buffer_initial_length=: (untyped length) -> nil

        def generate: (*untyped args) -> untyped

        def _generate_no_fallback: (*untyped args) -> untyped

        def sort_keys: () -> untyped

        def sort_keys=: (untyped value) -> nil

        private

        def _configure: (untyped opts) -> self

        def allow_duplicate_key?: () -> untyped

        # The fields, made as cState_s_allocate makes them the first time
        # a State is read.
        def fields: () -> untyped

        def fields!: () -> untyped

        # generate_json_data and the generate_json_* walk over one buffer.
        class Writer
          @fields: untyped

          @io: untyped

          @fallback: untyped

          @depth: untyped

          @vstate: untyped

          @out: untyped

          def initialize: (untyped fields, untyped io, fallback: untyped) -> void

          # generate_json_try: the document, or the IO it went to.
          def run: (untyped obj) -> untyped

          private

          # generate_json_general: a native value written as itself, and
          # anything else through `general`.
          def value: (untyped obj, untyped fallback) -> untyped

          def fragment: (untyped obj) -> untyped

          def fallback: (untyped obj) -> untyped

          # json_call_to_json: the object's own to_json, given a State that
          # represents this walk at its depth.
          def call_to_json: (untyped obj) -> untyped

          def call_as_json: (untyped object, untyped is_key) -> untyped

          def raise_error: (untyped invalid, untyped message) -> untyped

          # valid_json_string_p
          def valid_string?: (untyped str) -> (true | untyped)

          # ensure_valid_encoding and convert_invalid_encoding
          def valid_encoding: (untyped str, untyped as_json_called, untyped is_key) -> untyped

          # raw_generate_json_string: the escapes that the state requests.
          def raw_string: (untyped str) -> untyped

          def escaped: (untyped char) -> untyped

          def increase_depth: () -> untyped

          def indent: (untyped depth) -> (untyped | nil)

          def object: (untyped obj) -> (nil | untyped)

          def key_type: (untyped key) -> untyped

          def key: (untyped key, untyped type) -> (nil | untyped)

          # convert_string_subclass
          def string_of: (untyped key) -> untyped

          def array: (untyped obj) -> (nil | untyped)

          def float: (untyped obj) -> (nil | untyped)
        end
      end
    end
  end
end
