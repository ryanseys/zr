module JSON
  module Ext
    class ParserConfig
      # parser.c's JSON_ParserConfig, out of the program's sight as the C
      # struct is.
      Fields: untyped

      def self.fields_for: (untyped opts) -> untyped

      # A decimal class converts a number's text through try_convert, new,
      # or the method that its own name spells.
      def self.decimal: (untyped fields, untyped val) -> untyped

      def parse: (untyped source) -> untyped

      private

      def initialize: (untyped opts) -> void

      def fields: () -> untyped
    end

    class Parser
      def self.parse: (untyped source, untyped opts) -> untyped
    end

    # cParser_parse and json_parse_any over one source: the C half's
    # work, with no method or backtrace row a program sees.
    class Walk
      @fields: untyped

      @resumable: untyped

      @src: untyped

      @size: untyped

      @cursor: untyped

      @values: untyped

      @types: untyped

      @phases: untyped

      @heads: untyped

      @starts: untyped

      @nesting: untyped

      ARRAY: 1

      OBJECT: 2

      # The phases a frame goes through. The first three equal the frame
      # types, as a completed value moves its frame to the phase its type
      # names.
      DONE: 0

      ARRAY_COMMA: 1

      OBJECT_COMMA: 2

      VALUE: 3

      OBJECT_KEY: 4

      OBJECT_COLON: 5

      STRING_STOP: ::Regexp

      ESCAPES: { 92 => "\\", 110 => "\n", 114 => "\r", 116 => "\t", 98 => "\b", 102 => "\f" }

      # A resumable walk starts with no source and takes it in pieces
      # (`feed`); where a piece ends inside a token, the walk stops before
      # that token and reads it again once more has come.
      def initialize: (untyped fields, untyped source, ?resumable: bool) -> void

      # convert_encoding: the source as UTF-8 bytes; binary is read as
      # UTF-8, and another encoding converted.
      def self.source_of: (untyped source) -> untyped

      def run: () -> untyped

      # More source, after what the walk has not read yet.
      def feed: (untyped text) -> untyped

      # One more document: true once one is done, false where the source
      # ends first. A document already done whose value was not taken
      # gives way to the next.
      def resume: () -> (untyped | false)

      def size_left: () -> untyped

      def rest: () -> untyped

      def cursor: () -> untyped

      def eos?: () -> untyped

      # What is left once a document is done: the whitespace after it goes,
      # and a source read to its end is let go.
      def settle: () -> (nil | untyped)

      def value?: () -> untyped

      def partial?: () -> untyped

      # The value that is done, taken: the root has room for the next.
      def take: () -> untyped

      # The document under construction at this point: each open container
      # closed on its contents, and an object's key without its value set
      # to nil.
      def partial: () -> (nil | untyped)

      private

      # The token at the cursor runs into the end of a resumable source: the
      # walk stops before it, to read it whole later.
      def suspend: () -> untyped

      def at_end?: () -> untyped

      def peek: () -> untyped

      # json_parse_any: the frames' state machine, until the root value is
      # done. False when the source ends first.
      def walk: () -> (false | true | untyped)

      def enter: (untyped type, untyped phase, untyped start) -> untyped

      def leave: () -> untyped

      # json_push_value: each value, a key among them, through on_load.
      def push: (untyped value) -> untyped

      def array: (untyped count) -> untyped

      def object: (untyped count) -> untyped

      # raise_duplicate_key_error: the error's path ends at the key that
      # the object has twice.
      def duplicate_key: (untyped pairs) -> (nil | untyped)

      def duplicated: (untyped pairs) -> (untyped | false)

      # json_eat_whitespace, and a comment where the walk takes one.
      def whitespace: (untyped comments) -> untyped

      def comment: () -> untyped

      def keyword: (untyped word) -> (true | untyped)

      # json_parse_number: Walk where the text is no number.
      def number: (untyped negative, untyped start) -> untyped

      def digits_run: () -> untyped

      # json_parse_string: the string, a key interned, or Walk where the
      # source ends inside it.
      def string: (untyped name) -> untyped

      def escaped_string: (untyped start, untyped name) -> untyped

      def built: (untyped bytes, untyped name) -> untyped

      # json_string_unescape over the bytes from `from` to `to`.
      def unescape: (untyped from, untyped to, untyped backslashes) -> untyped

      def unicode: (untyped at, untyped to) -> untyped

      def syntax_error: (untyped format) -> untyped

      def syntax_error_at: (untyped format, untyped at) -> untyped

      def unexpected_end: (untyped format) -> untyped

      def unexpected_end_at: (untyped format, untyped at) -> untyped

      # raise_parse_error: the message with up to 32 bytes of the text at
      # the cursor, and the cursor's line and column.
      def raise_error: (untyped format) -> untyped

      # parse_error_new: the error knows its line, its column, and the
      # path to the value that the walk was in.
      def parse_error: (untyped message, untyped line, untyped column, ?untyped duplicate) -> untyped

      # json_path_new: for each open container, outermost first, the index
      # or the key that the walk is at. The path stops at an object that
      # has no key yet.
      def json_path: (untyped duplicate) -> untyped

      def fragment: () -> ("EOF" | untyped | ::String)

      # cursor_position: the line counts every newline before the cursor,
      # and the column the bytes since the last one.
      def position: () -> (::Array[1 | untyped] | ::Array[untyped])
    end
  end

  # parser.c's ResumableParser: a walk that takes its source in pieces
  # and gives out each document when it is complete.
  class ResumableParser
    @fields: untyped

    @parsed_bytes: untyped

    @incomplete_bytes: untyped

    @in_use: untyped

    @complete: untyped

    @walk: untyped

    def initialize: (?untyped? opts) -> void

    def <<: (untyped text) -> self

    def parse: () -> untyped

    def value?: () -> untyped

    def value: () -> untyped

    def partial_value: () -> untyped

    def partial_value?: () -> untyped

    def rest: () -> untyped

    def eos?: () -> untyped

    def parsed_bytes: () -> untyped

    def clear: () -> self
  end
end
