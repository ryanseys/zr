# zlib.c, in ruby, over zr's port of zlib (lib/zr/runtime/kernel/zlib_*.rb, reached
# through lib/zr/runtime/kernel/zlib.rb). The extension's structs are classes here: Stream
# is `struct zstream`, the z_stream and the buffers around it, and
# GzFile is `struct gzfile`, a stream and the gzip container's fields. A Deflate, an Inflate or a GzipFile keeps its own
# in a hidden slot, as a TypedData object keeps its struct.
module Zlib
  VERSION: "3.2.3"

  ZLIB_VERSION: "1.3.1"

  class Error < StandardError
  end

  class StreamEnd < Error
  end

  class NeedDict < Error
  end

  class DataError < Error
  end

  class StreamError < Error
  end

  class MemError < Error
  end

  class BufError < Error
  end

  class VersionError < Error
  end

  class InProgressError < Error
  end

  BINARY: 0

  ASCII: 1

  TEXT: 1

  UNKNOWN: 2

  NO_COMPRESSION: 0

  BEST_SPEED: 1

  BEST_COMPRESSION: 9

  DEFAULT_COMPRESSION: -1

  FILTERED: 1

  HUFFMAN_ONLY: 2

  RLE: 3

  FIXED: 4

  DEFAULT_STRATEGY: 0

  MAX_WBITS: 15

  DEF_MEM_LEVEL: 8

  MAX_MEM_LEVEL: 9

  NO_FLUSH: 0

  SYNC_FLUSH: 2

  FULL_FLUSH: 3

  FINISH: 4

  OS_CODE: 3

  OS_MSDOS: 0

  OS_AMIGA: 1

  OS_VMS: 2

  OS_UNIX: 3

  OS_VMCMS: 4

  OS_ATARI: 5

  OS_OS2: 6

  OS_MACOS: 7

  OS_ZSYSTEM: 8

  OS_CPM: 9

  OS_TOPS20: 10

  OS_WIN32: 11

  OS_QDOS: 12

  OS_RISCOS: 13

  OS_UNKNOWN: 255

  # zlib's return codes.
  Z_OK: 0

  Z_STREAM_END: 1

  Z_NEED_DICT: 2

  Z_ERRNO: -1

  Z_STREAM_ERROR: -2

  Z_DATA_ERROR: -3

  Z_MEM_ERROR: -4

  Z_BUF_ERROR: -5

  Z_VERSION_ERROR: -6

  ERRORS: ::Hash[untyped, untyped]

  CRC: 0

  ADLER: 1

  def self.deflate: (*untyped args) { (?) -> untyped } -> untyped

  def self.inflate: (untyped src) { (?) -> untyped } -> untyped

  # zlib_s_gzip: one gzip member of `src`, header and footer included.
  def self.gzip: (*untyped args) { (?) -> untyped } -> untyped

  # zlib_gunzip: the one member in `src`, with its footer checked.
  def self.gunzip: (untyped src) -> untyped

  private

  # raise_zlib_error: the error class a return code names, with zlib's
  # message or the code's own words.
  def self.raise_error: (untyped err, untyped message) -> untyped

  # do_checksum: `str`, or an IO read to its end, onto `sum`.
  def self.checksum: (untyped args, untyped kind) -> untyped

  def self.checksum_of: (untyped kind, untyped sum, untyped str) -> untyped

  # NUM2ULONG: an Integer, or its to_int, as an unsigned long.
  def self.unsigned: (untyped v) -> untyped

  # NUM2INT, which a FIXNUMARG reads as.
  def self.int: (untyped v) -> untyped

  def self.level_arg: (untyped v) -> untyped

  def self.wbits_arg: (untyped v) -> untyped

  def self.memlevel_arg: (untyped v) -> untyped

  def self.strategy_arg: (untyped v) -> untyped

  def self.flush_arg: (untyped v, ?untyped default) -> untyped

  # rb_get_kwargs over an options hash that may name only `names`.
  def self.keywords: (untyped opts, *untyped names) -> (::Array[untyped] | untyped)

  # rb_str_cat: `bytes` onto the end of `str`, whatever either's
  # encoding, which `str` keeps.
  def self.cat: (untyped str, untyped bytes) -> untyped

  # rb_str_resize and a copy: `str` contains `bytes` and keeps its encoding.
  def self.fill_in: (untyped str, untyped bytes) -> untyped

  public

  def self?.zlib_version: () -> untyped

  def self?.adler32: (*untyped args) -> untyped

  def self?.adler32_combine: (untyped adler1, untyped adler2, untyped len2) -> untyped

  def self?.crc32: (*untyped args) -> untyped

  def self?.crc32_combine: (untyped crc1, untyped crc2, untyped len2) -> untyped

  def self?.crc_table: () -> untyped

  # struct zstream.
  class Stream
    @kind: untyped

    @opaque: untyped

    @flags: untyped

    @buf: untyped

    @capa: untyped

    @shared: untyped

    @input: untyped

    @input_hidden: untyped

    @avail_out: untyped

    @mutex: untyped

    @stream: untyped

    READY: untyped

    IN_STREAM: untyped

    FINISHED: untyped

    CLOSING: untyped

    GZFILE: untyped

    REUSE_BUFFER: untyped

    IN_PROGRESS: untyped

    UNUSED: untyped

    INITIAL_BUFSIZE: 1024

    # The maximum number of bytes that a String keeps inside its own slot.
    EMBED_MAX: 615

    AVAIL_OUT_STEP_MAX: 16384

    AVAIL_OUT_STEP_MIN: 2048

    # What lib/zr/runtime/kernel/zlib.rb runs.
    DEFLATE: 0

    INFLATE: 1

    DEFLATE_END: 2

    INFLATE_END: 3

    DEFLATE_RESET: 4

    INFLATE_RESET: 5

    INFLATE_SYNC: 6

    INFLATE_SYNC_POINT: 7

    attr_accessor flags: untyped

    attr_accessor avail_out: untyped

    attr_accessor capa: untyped

    attr_reader buf: untyped

    attr_reader input: untyped

    attr_reader kind: untyped

    attr_reader mutex: untyped

    # A stream `holder` owns frees its z_stream once the holder is
    # gone, as the extension's free function does; `opaque` is the
    # object zlib.c's z_stream names, which keeps the dictionaries.
    def initialize: (untyped kind, ?holder: untyped?, ?opaque: untyped?) -> void

    def self.release: (untyped stream, untyped kind) -> untyped

    def release: () -> untyped

    def init: (untyped level, untyped wbits, untyped memlevel, untyped strategy) -> untyped

    def ready: () -> untyped

    def ready?: () -> untyped

    def finished?: () -> untyped

    def closing?: () -> untyped

    def gzfile?: () -> untyped

    def reuse_buffer?: () -> untyped

    def deflate?: () -> untyped

    def buf_filled: () -> (0 | untyped)

    # [avail_in, total_in, avail_out, total_out, data_type, adler, msg]
    def fields: () -> untyped

    def avail_in: () -> untyped

    def total_in: () -> untyped

    def total_out: () -> untyped

    def data_type: () -> untyped

    def adler: () -> untyped

    def message: () -> untyped

    def count_in: (untyped n) -> untyped

    def copy_from: (untyped other) -> untyped

    # The buffer a stream reads out of and writes into by itself; a
    # user's String for Inflate#inflate's `buffer:`.
    def buf=: (untyped str) -> untyped

    def call: (untyped op, ?::Integer flush) -> untyped

    def expand_buffer: (untyped block) -> untyped

    def expand_buffer_into: (untyped size) -> (untyped | untyped | nil)

    def expand_buffer_non_stream: () -> untyped

    # rb_str_modify_expand: room for `n` more bytes past the end.
    def expand: (untyped n) -> untyped

    # rb_str_set_len, which a shared buffer refuses.
    def settable: () -> (untyped | nil)

    def append_buffer: (untyped bytes) -> (nil | untyped)

    def detach_buffer: (untyped block) -> (nil | untyped)

    def shift_buffer: (untyped len, untyped dst, ?untyped? block) -> untyped

    def buffer_ungets: (untyped bytes) -> untyped

    def append_input: (untyped bytes) -> (nil | untyped)

    # gunzip reads the caller's own String, which it never changes.
    def lend_input: (untyped str) -> untyped

    def discard_input: (untyped len) -> (nil | untyped)

    def reset_input: () -> untyped

    def passthrough_input: () -> (nil | untyped)

    def detach_input: () -> untyped

    def reset: () -> untyped

    def end_stream: () -> nil

    def dictionary: (untyped dic) -> untyped

    # deflateParams, flushing what the old parameters left pending.
    def params: (untyped level, untyped strategy) -> untyped

    def sync_point?: () -> (true | false)

    # zstream_run: `src` and the input kept from before through zlib with
    # `flush`, the output into the buffer. A block given to the method
    # that runs takes the output as it fills, a buffer at a time.
    def run: (untyped src, untyped flush, untyped block) -> untyped

    def sync: (untyped src) -> (true | false)

    attr_reader stream: untyped

    private

    def run_try: (untyped src, untyped flush, untyped block) -> untyped

    # What follows one pass of zlib: the input it left is kept for the
    # next run, and an error is raised. Returns true when a dictionary
    # that the stream requested was set and the pass runs again.
    def settle: (untyped source, untyped err, untyped flush) -> (true | false)

    def run_func: (untyped source, untyped flush, untyped block) -> untyped

    def warning: (untyped message) -> (untyped | nil)
  end

  class ZStream
    def avail_out: () -> untyped

    def avail_out=: (untyped size) -> untyped

    def avail_in: () -> untyped

    def total_in: () -> untyped

    def total_out: () -> untyped

    def data_type: () -> untyped

    def adler: () -> untyped

    def finished?: () -> untyped

    def stream_end?: () -> untyped

    def closed?: () -> untyped

    def ended?: () -> untyped

    def close: () -> nil

    def end: () -> nil

    def reset: () -> nil

    def finish: () { (?) -> untyped } -> untyped

    def flush_next_in: () -> untyped

    def flush_next_out: () { (?) -> untyped } -> untyped

    private

    # A copy starts with a stream of its own, which no call has made
    # ready, as the one its allocator made.
    def initialize_copy: (untyped orig) -> untyped

    def zstream: () -> untyped

    # get_zstream: the stream, once initialize made it ready.
    def ready_zstream: () -> untyped

    # rb_mutex_synchronize over the stream's own lock.
    def exclusively: (untyped z) { () -> untyped } -> untyped
  end

  class Deflate < ZStream
    def self.deflate: (*untyped args) { (?) -> untyped } -> untyped

    def self.deflated: (untyped src, ?untyped? level) { (?) -> untyped } -> untyped

    def initialize: (?untyped? level, ?untyped? wbits, ?untyped? memlevel, ?untyped? strategy) -> void

    def initialize_copy: (untyped orig) -> self

    def deflate: (untyped src, ?untyped? flush) { (?) -> untyped } -> untyped

    def <<: (untyped src) -> self

    def flush: (?untyped? flush) { (?) -> untyped } -> untyped

    def params: (untyped level, untyped strategy) -> nil

    def set_dictionary: (untyped dic) -> untyped

    private

    def stream_kind: () -> untyped

    # do_deflate: nil finishes the stream; an empty String with no flush
    # runs nothing, because zlib would return Z_BUF_ERROR.
    def run_deflate: (untyped z, untyped src, untyped flush, untyped block) -> untyped
  end

  class Inflate < ZStream
    # rb_inflate_s_allocate: a stream, and the dictionaries it can request.
    def self.allocate: () -> untyped

    def self.new: (*untyped args) { (?) -> untyped } -> untyped

    def self.inflate: (untyped src) { (?) -> untyped } -> untyped

    private

    def self.inflated: (untyped src) { (?) -> untyped } -> untyped

    public

    def initialize: (?untyped? wbits) -> void

    def add_dictionary: (untyped dictionary) -> self

    def inflate: (*untyped args) { (?) -> untyped } -> untyped

    def <<: (untyped src) -> self

    def sync: (untyped src) -> untyped

    def sync_point?: () -> untyped

    def set_dictionary: (untyped dic) -> untyped

    private

    def stream_kind: () -> untyped

    # do_inflate: nil finishes the stream; nothing to read runs nothing.
    def run_inflate: (untyped z, untyped src, untyped block) -> untyped
  end

  class GzipFile
    # gzfile_raise sets `@input` where a program sees it.
    class Error < Zlib::Error
      def input: () -> untyped

      def inspect: () -> (untyped | ::String)
    end

    class NoFooter < Error
    end

    class CRCError < Error
    end

    class LengthError < Error
    end
  end

  # struct gzfile.
  class GzFile
    @z: untyped

    @ending: untyped

    @io: untyped

    @level: untyped

    @mtime: untyped

    @os_code: untyped

    @orig_name: untyped

    @comment: untyped

    @crc: untyped

    @lineno: untyped

    @ungetc: untyped

    @enc: untyped

    @enc2: untyped

    @ecopts: untyped

    @path: untyped

    MAGIC1: 31

    MAGIC2: 139

    METHOD_DEFLATE: 8

    FLAG_MULTIPART: 2

    FLAG_EXTRA: 4

    FLAG_ORIG_NAME: 8

    FLAG_COMMENT: 16

    FLAG_ENCRYPT: 32

    FLAG_UNKNOWN_MASK: 192

    EXTRAFLAG_FAST: 4

    EXTRAFLAG_SLOW: 2

    FLAG_SYNC: untyped

    FLAG_HEADER_FINISHED: untyped

    FLAG_FOOTER_FINISHED: untyped

    FLAG_MTIME_IS_SET: untyped

    READ_SIZE: 2048

    # The io of Zlib.gunzip, which reads a String that it already has.
    STRING: untyped

    # The most bytes one character takes, which a read that must not
    # split one looks ahead by.
    MBMAXLEN: { "UTF-8" => 4, "EUC-JP" => 3, "Shift_JIS" => 2, "Windows-31J" => 2, "GBK" => 2, "GB18030" => 4, "Big5" => 2, "EUC-KR" => 2, "UTF-16LE" => 4, "UTF-16BE" => 4, "UTF-32LE" => 4, "UTF-32BE" => 4 }

    attr_accessor io: untyped

    attr_accessor level: untyped

    attr_accessor os_code: untyped

    attr_accessor mtime: untyped

    attr_accessor orig_name: untyped

    attr_accessor comment: untyped

    attr_accessor crc: untyped

    attr_accessor lineno: untyped

    attr_accessor ungetc: untyped

    attr_accessor path: untyped

    attr_accessor enc: untyped

    attr_accessor enc2: untyped

    attr_reader z: untyped

    def initialize: (untyped ending, ?holder: untyped?) -> void

    def flag?: (untyped flag) -> untyped

    def flag: (untyped flag) -> untyped

    def finished?: () -> untyped

    def reset: () -> untyped

    def close: (untyped close_io) -> untyped

    # gz->end: each kind of file ends its stream its own way.
    def finish: () -> untyped

    def write_raw: () -> (nil | untyped)

    # gzfile_read_raw: a readpartial of the io, or its read where it has
    # none; nil at the end.
    def read_raw: (untyped outbuf) -> untyped

    def read_raw_ensure: (untyped size, untyped outbuf) -> (false | true)

    def read_raw_until_zero: (untyped offset) -> untyped

    # gzfile_raise: the error, and the input not yet read where there is
    # some.
    def raise_input: (untyped klass, untyped message) -> untyped

    def make_header: () -> untyped

    def make_footer: () -> untyped

    def read_header: (untyped outbuf) -> untyped

    def check_footer: (untyped outbuf) -> untyped

    def write: (untyped str) -> untyped

    def read_more: (untyped outbuf) -> untyped

    def calc_crc: (untyped str) -> untyped

    # gzfile_newstr: decoded bytes in the file's encoding, converted from
    # the external one where two were given.
    def newstr: (untyped str) -> untyped

    def fill: (untyped len, untyped outbuf) -> (0 | -1 | untyped)

    def read: (untyped len, untyped outbuf) -> (nil | untyped)

    def readpartial: (untyped len, untyped outbuf) -> untyped

    def read_all: (untyped dst) -> untyped

    def getc: () -> (nil | untyped)

    def ungets: (untyped bytes) -> untyped

    def rewind: () -> untyped

    def unused: () -> (nil | untyped)

    # rb_gzfile_ecopts: the encodings the options name, the external one
    # converted to the internal one where they differ.
    def encodings: (untyped opts) -> (nil | untyped)

    def mbmaxlen: () -> untyped

    # rb_enc_left_char_head and rb_enc_precise_mbclen at `at` in `bytes`:
    # where the character holding that byte starts, and whether it is
    # whole there (:found, its length), cut short by the end
    # (:needmore, the bytes it lacks) or no character at all.
    def char_head: (untyped bytes, untyped at) -> untyped

    def char_at: (untyped bytes, untyped at) -> (::Array[:found | 1] | ::Array[untyped] | ::Array[:invalid | 1] | ::Array[:needmore | untyped] | ::Array[:found | untyped])

    # gzreader_charboundary: a limit that falls inside a character moved
    # to its end.
    def charboundary: (untyped n) -> untyped

    def skip_linebreaks: () -> (nil | untyped)

    # gzreader_gets.
    def gets: (untyped args) -> (untyped | nil)

    private

    def read_zero_terminated: (untyped outbuf) -> untyped

    def string_of: (untyped str) -> untyped

    def writer_end: () -> (nil | untyped)

    def reader_end: () -> (nil | untyped)
  end

  class GzipFile
    def self.wrap: (*untyped args, **untyped opts) { (?) -> untyped } -> untyped

    private

    # gzfile_s_open: the file at the path, opened in `mode`, as the io.
    def self.opened: (untyped args, untyped opts, untyped mode) { (?) -> untyped } -> untyped

    # gzfile_wrap: a new file over the io, closed when the block is done.
    def self.wrapped: (untyped args, untyped opts, untyped close_io_on_error) ?{ (untyped) -> untyped } -> untyped

    public

    def to_io: () -> untyped

    def crc: () -> untyped

    def mtime: () -> untyped

    def level: () -> untyped

    def os_code: () -> untyped

    def orig_name: () -> untyped

    def comment: () -> untyped

    def close: () -> (nil | untyped)

    def finish: () -> untyped

    def closed?: () -> untyped

    def sync: () -> untyped

    def sync=: (untyped mode) -> untyped

    private

    def initialize_copy: (untyped orig) -> untyped

    def gzfile: () -> untyped

    # get_gzfile: the file, while it is open.
    def ready_gzfile: () -> untyped

    def ensure_closed: () -> untyped

    # The io's path, which this file returns as its own after it has one.
    def take_path: (untyped gz) -> (nil | untyped)
  end

  class GzipWriter < GzipFile
    def self.open: (*untyped args, **untyped opts) { (?) -> untyped } -> untyped

    def initialize: (*untyped args) -> void

    def mtime=: (untyped mtime) -> untyped

    def orig_name=: (untyped str) -> untyped

    def comment=: (untyped str) -> untyped

    def pos: () -> untyped

    def tell: () -> untyped

    def flush: (?untyped? flush) -> self

    def write: (*untyped strs) -> untyped

    def putc: (untyped ch) -> untyped

    def <<: (untyped str) -> self

    def printf: (*untyped args) -> nil

    def print: (*untyped objects) -> untyped

    def puts: (*untyped objects) -> nil

    private

    def file_ending: () -> :writer

    def header_string: (untyped str) -> untyped
  end

  class GzipReader < GzipFile
    include Enumerable

    def self.open: (*untyped args, **untyped opts) { (?) -> untyped } -> untyped

    def self.zcat: (*untyped args) ?{ (untyped) -> untyped } -> untyped

    def initialize: (untyped io, **untyped opt) -> void

    def lineno: () -> untyped

    def lineno=: (untyped lineno) -> untyped

    def eof: () -> untyped

    def eof?: () -> untyped

    def pos: () -> untyped

    def tell: () -> untyped

    def rewind: () -> 0

    def unused: () -> untyped

    def read: (?untyped? len, ?untyped? outbuf) -> untyped

    def readpartial: (untyped len, ?untyped? outbuf) -> untyped

    def getc: () -> untyped

    def readchar: () -> untyped

    def getbyte: () -> untyped

    def readbyte: () -> untyped

    def each_char: () ?{ (untyped) -> untyped } -> (untyped | nil)

    def each_byte: () ?{ (untyped) -> untyped } -> (untyped | nil)

    def ungetc: (untyped s) -> (untyped | nil)

    def ungetbyte: (untyped ch) -> nil

    def gets: (*untyped args) -> untyped

    def readline: (*untyped args) -> untyped

    def each: (*untyped args) ?{ (untyped) -> untyped } -> (untyped | self)

    def each_line: (*untyped args) ?{ (untyped) -> untyped } -> (untyped | self)

    def readlines: (*untyped args) -> untyped

    def external_encoding: () -> untyped

    private

    def file_ending: () -> :reader
  end
end
