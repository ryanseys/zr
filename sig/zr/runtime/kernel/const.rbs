  def zr_cref_push_eval: (untyped klass, untyped outer) -> untyped

  def zr_same_p: (untyped a, untyped b) -> untyped

  def zr_cref_set_vis: (untyped cref, untyped vis) -> untyped

  def zr_cref_set_modfn: (untyped cref) -> untyped

  def zr_cref_lexical: (untyped cref) -> untyped

  def zr_cref_lexical_class: (untyped cref) -> untyped

  # A constant table of this length or more has a hash index of its ids.
  # The first lookup that needs the index builds it. Object's table has
  # hundreds of entries, and every bare constant read ends there. A lookup
  # scans a shorter table.
  CONST_INDEX_MIN: 16

