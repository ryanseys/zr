  def zr_autoload_provided: (untyped feature, untyped path) -> untyped

  def zr_autoload_names: (untyped kept, untyped asked) -> (false | untyped)

  def zr_autoload_row: (untyped mod, untyped id) -> untyped

  def zr_autoload_feature: (untyped mod, untyped id) -> untyped

