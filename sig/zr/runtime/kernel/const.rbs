  def zr_class_define: (untyped scope, untyped id, untyped sup, untyped scoped) -> untyped

  def zr_module_define: (untyped scope, untyped id, untyped scoped) -> untyped

  def zr_module_define_m: (untyped scope, untyped name) -> untyped

  def zr_const_name_id: (untyped recv, untyped name, untyped out) -> untyped

  def zr_const_name_p: (untyped p, untyped n) -> (false | true)

  def zr_const_row_segment: (untyped recv, untyped id, untyped inherit, untyped later) -> untyped

  def zr_mod_const_get_m: (untyped recv, untyped name, untyped inherit, untyped later) -> untyped

  def zr_mod_const_source_location_m: (untyped recv, untyped name, untyped inherit, untyped later) -> untyped

  def zr_mod_const_defined_m: (untyped recv, untyped name, untyped inherit, untyped later) -> untyped

  def zr_const_row_segment_defined: (untyped recv, untyped id, untyped inherit, untyped later) -> untyped

  def zr_const_row_defined_for: (untyped mod, untyped id) -> untyped

  def zr_mod_remove_const: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_const_row_for: (untyped mod, untyped id, untyped inherit) -> untyped

  def zr_mod_const_set: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_const_names_at: (untyped klass, untyped out) -> untyped

  def zr_const_names_of: (untyped mod, untyped out, untyped inherit) -> untyped

  def zr_mod_s_constants: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_mod_constants: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_const_remove: (untyped klass, untyped id) -> (nil | untyped)

  G_AUTOLOADS: 38

  # Autoload: a constant entry whose value is undef until its file runs.
  # Each record of G_AUTOLOADS has AUTOLOAD_ROW words: the module, the
  # name, the feature as the program wrote it, the function of the unit as
  # a fixnum, the require kind (zr_require's: 0, or 3 for eval support's
  # own files), and the resolved path of the feature. A require of the same
  # file records that path. A feature that the program computed has no
  # unit. Its kind is AUTOLOAD_REQUIRE, and the first read of the constant
  # calls `require` on main with it, as ruby's autoload does.
  # `Kernel#autoload` and `Kernel.autoload` register on the class of the
  # caller, as CRuby's rb_f_autoload does.
  AUTOLOAD_ROW: 6

  AUTOLOAD_REQUIRE: 4

  # The kind of a record whose feature a require would not read, because
  # the program contains it or a require already read it. The record stays, as ruby keeps its
  # own, but it stops counting: `autoload?` returns nil and
  # `const_defined?` returns false. The name is still declared, so the
  # constant is undefined here and hides a constant of the same name
  # farther out. A record gets this kind where it is registered, or where
  # `zr_autoload_provided` finds the require that provided its feature.
  AUTOLOAD_DECLARED: 5

  def zr_autoload: (untyped mod, untyped id, untyped feature, untyped fn, untyped cref, untyped kind, untyped path) -> untyped

  def zr_autoload_computed: (untyped mod, untyped name, untyped feature, untyped cref, untyped loaded, untyped file) -> untyped

