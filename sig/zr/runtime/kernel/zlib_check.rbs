module Zr::Kern
  # zlib's checksums: adler32.c and crc32.c, as in zlib 1.3.1. A sum is a
  # 32-bit value in a Word. The C unsigned long is 64 bits on each host
  # that zr builds for, so no calculation here overflows where the C does
  # not. Derived from zlib; the license is in lib/zr/runtime/kernel/zlib.rb.
  ADLER_BASE: 65521

  ADLER_NMAX: 5552

  CRC_POLY: 3988292384

  ZLIB_MASK32: 4294967295

  def zr_adler32: (untyped adler, untyped buf, untyped len) -> (untyped | 1)

  def zr_adler32_combine: (untyped adler1, untyped adler2, untyped len2) -> untyped

  def zr_crc32: (untyped crc, untyped buf, untyped len) -> (0 | untyped)

  def zr_crc_multmodp: (untyped a, untyped b) -> untyped

  def zr_crc_x2nmodp: (untyped n, untyped k) -> untyped

  def zr_crc32_combine: (untyped crc1, untyped crc2, untyped len2) -> untyped
end
