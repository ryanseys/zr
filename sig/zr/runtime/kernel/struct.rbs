module Zr::Kern
  # Struct accessors (lib/zr/runtime/core/struct.rb, and Data's readers). Each
  # member reader and writer is a method entry of its own, as for
  # attr_accessor. `fn` contains the member's index, and `ivar` contains the
  # inline cache hint for the values Array. The values are in the hidden
  # instance variable `__values__`, an Array that the constructor makes. A
  # struct from `allocate` has no values until a write, and its reads
  # return nil. An accessor has no frame, so its arity error comes from the
  # caller, and a trace sees a C call.
  KIND_STRUCT_AREF: 10

  KIND_STRUCT_ASET: 11

  def zr_struct_readers: (untyped klass, untyped members) -> untyped

  def zr_struct_writers: (untyped klass, untyped members) -> untyped

  def zr_struct_aref_fn: (untyped recv, untyped argc, untyped argv, untyped e, untyped blk, untyped found) -> untyped

  def zr_struct_aset_fn: (untyped recv, untyped argc, untyped argv, untyped e, untyped blk, untyped found) -> untyped

  def zr_struct_values_guessed: (untyped recv, untyped e, untyped t) -> untyped

  def zr_struct_get: (untyped recv, untyped e) -> untyped

  def zr_struct_set: (untyped recv, untyped e, untyped v) -> untyped

  def zr_struct_values_new: (untyped recv) -> untyped

  def zr_struct_values: (untyped recv) -> untyped

  def zr_struct_members: (untyped klass) -> untyped

  def zr_struct_row: (untyped klass) -> untyped

  def zr_struct_values_of: (untyped n, untyped argc, untyped argv) -> untyped

  def zr_struct_values_named: (untyped members, untyped h) -> untyped

  def zr_struct_initialize: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_struct_keyword_init: (untyped klass) -> untyped

  def zr_struct_to_a: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_struct_initialize_copy: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_struct_builtins: (untyped klass) -> untyped

  def zr_word_entry_p: (untyped kind) -> untyped
end
