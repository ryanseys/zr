module Zr::Kern
  # Objects: a class and an ivar table of (id, value) ivar entries. A
  # class or module keeps the same table in its extension. An object's
  # first ivar entries are in its cell after the table. Entries past them
  # are malloc'd, and a release or a copy frees only those. A site reads
  # and writes the ivar entry at its cached index inline (the lowering's
  # `guessed_ivar_row`), and calls here for all other cases. This file
  # also contains reflection, identity, inspect and p.
  # `names` has bit `id & 63` set for each name that an ivar entry got. A
  # clear bit shows, with no scan, that no entry contains the name. A
  # removed entry keeps its bit.
  IvTab: untyped

  IvEntry: untyped

  RObject: untyped

  def zr_ivtab_init: (untyped t) -> untyped

  def zr_ivtab_name_bit: (untyped id) -> untyped

  def zr_ivtab: (untyped v) -> (0 | untyped)

  def zr_ivtab_for_write: (untyped v) -> (untyped | 0)

  def zr_mark_ivtab: (untyped t) -> untyped

  def zr_release_ivtab: (untyped t) -> (untyped | nil)

  def zr_ivtab_embedded_p: (untyped t) -> untyped

  def zr_ivtab_owner: (untyped obj) -> untyped

  def zr_obj_alloc: (untyped klass) -> untyped

  def zr_obj_ivars_seen: (untyped o, untyped n) -> untyped

  def zr_obj_ivtab_init: (untyped o) -> untyped

  def zr_ivtab_row: (untyped t, untyped id) -> (0 | untyped)

  def zr_ivtab_get: (untyped t, untyped id) -> untyped

  def zr_ractor_guard: (untyped obj) -> untyped

  def zr_ivar_defined: (untyped obj, untyped id) -> untyped

  def zr_method_defined: (untyped recv, untyped id, untyped explicit) -> untyped

  def zr_ivar_get: (untyped obj, untyped id) -> untyped

  def zr_hidden_get: (untyped obj, untyped name) -> untyped

  def zr_hidden_set: (untyped obj, untyped name, untyped v) -> untyped

  def zr_state_set: (untyped obj, untyped name, untyped v) -> untyped

  def zr_moved_m: (untyped obj, untyped klass) -> untyped

  def zr_obj_object_id: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ivar_id_visible_p: (untyped id) -> untyped

  def zr_ivar_set: (untyped obj, untyped id, untyped v) -> untyped

  def zr_ivtab_set: (untyped t, untyped id, untyped v) -> untyped

  def zr_ivtab_set_in: (untyped t, untyped id, untyped v, untyped owner) -> untyped

  def zr_ivtab_append: (untyped t, untyped id, untyped v, untyped owner) -> untyped

  # A Range is a plain frozen object of class Range with three ivars. Its
  # methods are in the core library.
  G_RANGE: 12

  G_RANGE_LITERALS: 51

  def zr_site_literal: (untyped g, untyped index) -> untyped

  def zr_site_literal_set: (untyped g, untyped index, untyped v) -> untyped

  def zr_range_literal: (untyped index, untyped low, untyped high, untyped excl) -> untyped

  def zr_range_fix_bounds: (untyped range, untyped out) -> (false | true)

  def zr_range_new: (untyped low, untyped high, untyped excl) -> untyped

  def zr_class_allocate: (untyped recv) -> untyped

  def zr_class_build: (untyped recv) -> untyped

  def zr_alloc_class: (untyped recv) -> untyped

  def zr_alloc_shape: (untyped recv, untyped kind) -> untyped

  # The type of object that a class allocates: the type that the class or
  # its nearest superclass records, as CRuby's rb_get_alloc_func walks the
  # superclasses. The builtin roots record theirs at boot
  # (zr_alloc_table). Core records the types of its own classes when it
  # defines them (zr_undef_alloc, zr_define_alloc). A class with no record
  # keeps its superclass's type after the first lookup, because a class's
  # superclass never changes.
  ALLOC_OBJECT: 1

  ALLOC_CLASS: 2

  ALLOC_MODULE: 3

  ALLOC_EXCEPTION: 4

  ALLOC_ARRAY: 5

  ALLOC_HASH: 6

  ALLOC_STRING: 7

  ALLOC_UNDEF: 8

  ALLOC_REGEXP: 9

  ALLOC_NONE: 10

  ALLOC_FIBER: 11

