module Zr::Kern
  # A method whose body is a block. The method entry's `cref` slot
  # contains the Proc, and a call runs it as a lambda with the receiver as
  # self. The call allocates nothing: the body's image goes on the stack
  # with the receiver as self (`zr_bmethod_call`). It uses a cref that the
  # entry makes one time and keeps (`zr_bmethod_cref`).
  KIND_BMETHOD: 8

  def zr_proc_under: (untyped p, untyped self_, untyped cref) -> untyped

  def zr_yield_under: (untyped blk, untyped self_, untyped klass, untyped argc, untyped argv) -> untyped

  def zr_block_needed: () -> untyped

  def zr_class_initialize: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_module_initialize: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_mod_class_eval: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_mod_class_exec: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_eval_definee: (untyped obj) -> untyped

  def zr_eval_class_of: (untyped obj) -> untyped

  def zr_obj_instance_eval: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_obj_instance_exec: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_mod_define_method: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_meta_owned_by: (untyped meta, untyped owner) -> (0 | untyped)

  def zr_cref_in_context: (untyped frame, untyped mod) -> untyped

  def zr_obj_define_singleton_method: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_bmethod_call: (untyped e, untyped recv, untyped argc, untyped argv, untyped blk) -> untyped

  def zr_bmethod_fn: (untyped recv, untyped argc, untyped argv, untyped e, untyped blk, untyped found) -> untyped

  def zr_bmethod_cref: (untyped e) -> untyped

  def zr_bmethod_cref_kept: (untyped e) -> untyped

  def zr_refine_body: (untyped blk, untyped holder) -> untyped
end
