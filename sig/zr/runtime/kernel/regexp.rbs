module Zr::Kern
  # `program` is the pattern compiled for the encoding of the source, as
  # the program String of lib/zr/runtime/core/regexp/onig/program.rb. `alt` is
  # nil or the Hash of programs that Regexp#program_for compiled again for
  # subjects in other encodings. `names` contains
  # [[name, [group numbers]], ...]. `limit` is the timeout of the pattern
  # in nanoseconds, or 0 for none.
  RRegexp: untyped

  T_REGEXP: 31

  G_REGEXP: 42

  G_REGEXP_LITERALS: 43

  def zr_regexp_alloc: (untyped klass) -> untyped

  def zr_regexp_copy_from: (untyped re, untyped other) -> untyped

  def zr_regexp_host_compile: (untyped source, untyped bits) -> untyped

  def zr_regexp_seat: (untyped re, untyped program, untyped shown, untyped options, untyped names) -> untyped

  def zr_regexp_alt: (untyped re) -> untyped

  def zr_regexp_alt_set: (untyped re, untyped programs) -> untyped

  def zr_regexp_captures: (untyped re) -> untyped

  def zr_regexp_names: (untyped re) -> untyped

  def zr_regexp_region_new: (untyped prog) -> untyped

  def zr_regexp_region_free: (untyped region) -> untyped

  def zr_regexp_search: (untyped re, untyped program, untyped str, untyped start, untyped backward) -> untyped

  def zr_regexp_failed: (untyped r) -> untyped

  def zr_regexp_match_at: (untyped re, untyped program, untyped str, untyped start) -> untyped

  def zr_region_offsets: (untyped region, untyped num_mem, untyped position) -> untyped

  def zr_region_offsets_after: (untyped region, untyped num_mem, untyped position, untyped base) -> untyped

  def zr_regexp_scan_in: (untyped re, untyped program, untyped str, untyped base, untyped start, untyped search) -> untyped

  def zr_regexp_limit_for: (untyped re) -> untyped

  def zr_mark_regexp: (untyped re) -> untyped

  def zr_release_regexp: (untyped re) -> nil

  def zr_regexp_source: (untyped re) -> untyped

  def zr_regexp_options: (untyped re) -> untyped

  def zr_regexp_once: (untyped index) -> untyped

  def zr_regexp_once_set: (untyped index, untyped re) -> untyped

  def zr_regexp_literal: (untyped index, untyped bytes, untyped len, untyped options, untyped pinned) -> untyped

  def zr_regexp_limit_set: (untyped re, untyped nanoseconds) -> untyped

  def zr_regexp_limit: (untyped re) -> untyped

  def zr_backref_home: () -> (untyped | 0)

  def zr_svars: (untyped home) -> untyped

  def zr_svar_get: (untyped home, untyped i) -> untyped

  def zr_backref_set: (untyped v) -> untyped

  def zr_backref_assign: (untyped v) -> untyped

  def zr_backref_get: () -> untyped

  def zr_match_field: (untyped m, untyped id, untyped row) -> untyped

  def zr_match_string: (untyped m) -> untyped

  def zr_match_offsets: (untyped m) -> untyped

  def zr_match_nth: (untyped m, untyped n) -> untyped

  def zr_match_last: (untyped m) -> untyped

  def zr_match_pre: (untyped m) -> untyped

  def zr_match_post: (untyped m) -> untyped

  def zr_lastline_set: (untyped v) -> untyped

  def zr_lastline_get: () -> untyped
end
