module Zr::Kern
  RFloat: untyped

  T_FLOAT: 4

  G_FLOAT: 40

  # The flonum +0.0, 0x8000000000000002, as a signed Word.
  FLONUM_ZERO: -9223372036854775806

  INF_BITS: 9218868437227405312

  # The gates of the Float operators that compiled code inlines for
  # flonums (`float_path` in the lowering). The Integer gates are in
  # lib/zr/runtime/kernel/integer.rb.
  GATE_FLO_PLUS: 4194304

  GATE_FLO_MINUS: 8388608

  GATE_FLO_MUL: 16777216

  GATE_FLO_DIV: 33554432

  GATE_FLO_LT: 67108864

  GATE_FLO_LE: 134217728

  GATE_FLO_GT: 268435456

  GATE_FLO_GE: 536870912

  GATE_FLO_EQ: 1073741824

  def zr_flonum_p: (untyped v) -> untyped

  def zr_float_p: (untyped v) -> untyped

  def zr_float_p_m: (untyped v) -> untyped

  def zr_integer_p_m: (untyped v) -> untyped

  def zr_float_new: (untyped d) -> untyped

  def zr_float_value: (untyped v) -> untyped

  def zr_float_operand: (untyped recv, untyped v, untyped out, untyped mid, untyped kind) -> untyped

  def zr_nan_p: (untyped d) -> untyped

  def zr_inf_p: (untyped d) -> untyped

  def zr_flo_plus: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_minus: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_mul: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_div: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_mod: (untyped x, untyped y) -> untyped

  def zr_flo_mod: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_quotient: (untyped x, untyped y) -> untyped

  def zr_complex_polar_pi: (untyped abs, untyped ang) -> untyped

  def zr_flo_pow: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_uminus: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_cmp: (untyped a, untyped b) -> (untyped | 1 | 0 | 2)

  def zr_flo_eq: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_cmp: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_cmp_value: (untyped recv, untyped other) -> (untyped | 2)

  def zr_flo_relate: (untyped recv, untyped other, untyped want) -> untyped

  def zr_flo_lt: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_le: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_gt: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_ge: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_to_int: (untyped d) -> untyped

  def zr_flo_to_i: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_floor: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_floor_m: (untyped recv, untyped digits) -> untyped

  def zr_flo_ceil_m: (untyped recv, untyped digits) -> untyped

  def zr_flo_round_m: (untyped recv, untyped digits) -> untyped

  def zr_flo_ceil: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_round_half_up: (untyped x, untyped s) -> untyped

  def zr_float_round_digits: (untyped d, untyped digits, untyped how) -> untyped

  def zr_float_binexp: (untyped d) -> untyped

  def zr_float_round_overflow: (untyped d, untyped digits) -> untyped

  def zr_float_round_underflow: (untyped d, untyped digits) -> untyped

  def zr_flo_round: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_nan_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_infinite_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_finite_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_abs: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_hash: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_eql_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_to_f: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_from_bits: (untyped bits) -> untyped

  def zr_umulh: (untyped a, untyped b) -> untyped

  def zr_ryu_mul_shift: (untyped m, untyped row, untyped j) -> untyped

  def zr_pow5_bits: (untyped e) -> untyped

  def zr_multiple_of_pow5: (untyped v, untyped p) -> untyped

  def zr_multiple_of_pow2: (untyped v, untyped p) -> untyped

  def zr_ryu: (untyped d, untyped out) -> untyped

  def zr_buf_float: (untyped b, untyped d) -> (nil | untyped)

  def zr_digits_of: (untyped n, untyped buf) -> (1 | untyped)

  def zr_flo_to_s: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  # cos(pi * x) and sin(pi * x), as complex.c computes them when libm has
  # no __cospi and __sinpi: it multiplies x by pi first.
  PI_BITS: 4614256656552045848

  def zr_cos_of_pi_times: (untyped x) -> untyped

  def zr_sin_of_pi_times: (untyped x) -> untyped

  def zr_digit_at: (untyped p, untyped i) -> untyped

  def zr_float_scan: (untyped s, untyped b) -> untyped

  def zr_buf_strtod: (untyped b) -> untyped

  def zr_str_to_f: (untyped s) -> untyped

  def zr_str_to_f_strict: (untyped s) -> untyped

  def zr_hex_to_f: (untyped s) -> untyped

  def zr_buf_last_is_zero: (untyped b) -> untyped

  def zr_float_quotient_value: (untyped a, untyped b) -> untyped

  def zr_math_sqrt: (untyped x) -> untyped

  # Math's singleton class, which holds `Math.sqrt` and the others that a
  # site calls directly while GATE_MATH is clear (zr_gates_snapshot).
  G_MATH_META: 63

  def zr_math_inline_p: (untyped mid) -> untyped

  def zr_math_sqrt_fast: (untyped x) -> untyped

  def zr_math_call_fast: (untyped which, untyped x) -> untyped

  def zr_math_call: (untyped which, untyped x, untyped y) -> untyped

  def zr_math_frexp: (untyped x) -> untyped

  def zr_math_fma: (untyped x, untyped y, untyped z) -> untyped

  def zr_math_lgamma: (untyped x) -> untyped

  def zr_float_adjacent: (untyped recv, untyped up) -> untyped

  def zr_flo_next_float: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_flo_prev_float: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_float_shortest: (untyped v) -> untyped

  def zr_float_halves: (untyped v) -> untyped

  def zr_float_of_halves: (untyped low, untyped high) -> untyped

  def zr_float_decode: (untyped v) -> untyped
end
