module Zr::Kern
  # Weak tables: Hashes whose entries the collector does not keep alive.
  # `FL_WEAK` makes keys and values weak (ObjectSpace::WeakMap).
  # `FL_WEAKKEY` makes only keys weak (ObjectSpace::WeakKeyMap, and the
  # finalizer table). A static list refers to the tables but does not
  # mark them. After marking, each live table removes the entries whose
  # weak key or value is dead. A dead key of the finalizer table queues
  # its procs.
  FL_WEAK: untyped

  FL_WEAKKEY: untyped

  WEAK_BOTH: 1

  WEAK_KEY: 2

  G_FINALIZERS: 45

  WeakList: untyped

  def zr_weak_list: () -> untyped

  def zr_finalizer_queue: () -> untyped

  def zr_weak_list_push: (untyped l, untyped v) -> untyped

  def zr_weak_table_new: (untyped kind, untyped identity) -> untyped

  def zr_weak_table_new_m: (untyped kind, untyped identity) -> untyped

  def zr_dead_p: (untyped v) -> untyped

  def zr_weak_prune: () -> untyped

  def zr_weak_prune_table: (untyped h, untyped finalizer) -> untyped

  def zr_mark_finalizer_queue: () -> untyped

  def zr_finalizers: () -> untyped

  def zr_finalizers_m: () -> untyped

  def zr_finalizers_run: () -> untyped

  def zr_finalizer_row_run: (untyped row) -> untyped

  def zr_finalizers_at_exit: () -> (nil | untyped)
end
