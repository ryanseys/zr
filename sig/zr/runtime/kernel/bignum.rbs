module Zr::Kern
  # The loops of bignum arithmetic (lib/zr/runtime/core/bignum.rb). A
  # magnitude is an Array of base-2^30 limbs, the lowest first, each a
  # fixnum.
  #
  # A def makes its result Array first, then reads its operands' limbs
  # where they are and writes each result limb, as a fixnum, past the
  # result's length. The collector does not move objects, and nothing
  # allocates in the loop, so the pointers hold. `zr_big_done` then sets
  # the length. Work that needs room for raw words (a product's sums, the
  # division's normalized operands) has a block of words that it frees.
  BIG_BITS: 30

  BIG_MASK: 1073741823

  def zr_big_add_mag: (untyped a, untyped b) -> untyped

  def zr_big_sub_mag: (untyped a, untyped b) -> untyped

  def zr_big_mul_mag: (untyped a, untyped b) -> untyped

  def zr_big_divmod_small_mag: (untyped a, untyped m) -> untyped

  def zr_big_divmod_mag: (untyped a, untyped b) -> untyped

  def zr_big_cmp_mag: (untyped a, untyped b) -> untyped

  def zr_big_at: (untyped p, untyped i) -> untyped

  def zr_big_put: (untyped p, untyped i, untyped w) -> untyped

  def zr_big_done: (untyped out, untyped n) -> untyped

  def zr_big_fill: (untyped out, untyped words, untyped n) -> untyped

  def zr_big_shifted_words: (untyped a, untyped s) -> untyped

  def zr_big_zeros: (untyped n) -> untyped

  def zr_big_word_bits: (untyped w) -> untyped
end
