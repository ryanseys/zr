module Zr::Kern
  # deflate.c: the compressor. The state is the C deflate_state, with its
  # trees, counts, heap and depths in one block after it. The four buffers
  # that the C code allocates separately are also separate here. Nothing
  # calls deflateSetHeader, so no gzip header struct is set, and a gzip
  # stream gets the plain ten-byte header.
  # Derived from zlib; the license is in lib/zr/runtime/kernel/zlib.rb.
  DeflateState: untyped

  # The stream's status.
  DEF_INIT_STATE: 42

  DEF_GZIP_STATE: 57

  DEF_EXTRA_STATE: 69

  DEF_NAME_STATE: 73

  DEF_COMMENT_STATE: 91

  DEF_HCRC_STATE: 103

  DEF_BUSY_STATE: 113

  DEF_FINISH_STATE: 666

  # The values that a block function returns.
  DEF_NEED_MORE: 0

  DEF_BLOCK_DONE: 1

  DEF_FINISH_STARTED: 2

  DEF_FINISH_DONE: 3

  # The kinds of block function in the configuration table.
  DEF_KIND_STORED: 0

  DEF_KIND_FAST: 1

  DEF_KIND_SLOW: 2

  DEF_TOO_FAR: 4096

  DEF_MIN_LOOKAHEAD: 262

  DEF_WIN_INIT: 258

  DEF_MAX_STORED: 65535

  DEF_MAX_MEM_LEVEL: 9

  DEF_PRESET_DICT: 32

  DEF_NIL: 0

  Z_DEFAULT_COMPRESSION: untyped

  Z_FILTERED: 1

  Z_HUFFMAN_ONLY: 2

  Z_RLE: 3

  Z_FIXED: 4

  # The block after the struct that contains the trees, counts, heap and
  # depths.
  DEF_LTREE_BYTES: 4584

  DEF_DTREE_BYTES: 488

  DEF_BLTREE_BYTES: 312

  DEF_BL_COUNT_BYTES: 64

  DEF_HEAP_BYTES: 2292

  DEF_DEPTH_BYTES: 576

  DEF_TAIL_BYTES: 8316

  def zr_deflate_config: (untyped level, untyped col) -> untyped

  def zr_deflate_kind: (untyped level) -> untyped

  def zr_deflate_max_dist: (untyped s) -> untyped

  def zr_deflate_rank: (untyped f) -> untyped

  def zr_deflate_hash: (untyped s, untyped h, untyped c) -> untyped

  def zr_deflate_window_byte: (untyped s, untyped i) -> untyped

  def zr_deflate_insert_string: (untyped s, untyped str) -> untyped

  def zr_deflate_clear_hash: (untyped s) -> untyped

  def zr_deflate_slide_hash: (untyped s) -> untyped

  def zr_deflate_read_buf: (untyped strm, untyped s, untyped buf, untyped size) -> (0 | untyped)

  def zr_deflate_fill_window: (untyped s) -> untyped

  def zr_deflate_state_check: (untyped strm) -> (1 | 0)

  def zr_deflate_point_tail: (untyped s) -> untyped

  def zr_deflate_end: (untyped strm) -> untyped

  def zr_deflate_init2: (untyped strm, untyped level, untyped method, untyped window_bits, untyped mem_level, untyped strategy) -> untyped

  def zr_deflate_set_dictionary: (untyped strm, untyped dictionary, untyped dict_length) -> untyped

  def zr_deflate_reset_keep: (untyped strm) -> untyped

  def zr_deflate_lm_init: (untyped s) -> untyped

  def zr_deflate_reset: (untyped strm) -> untyped

  def zr_deflate_params: (untyped strm, untyped level, untyped strategy) -> untyped

  def zr_deflate_put_short_msb: (untyped s, untyped b) -> untyped

  def zr_deflate_flush_pending: (untyped strm) -> (nil | untyped)

  def zr_deflate_err: (untyped strm, untyped err) -> untyped

  def zr_deflate: (untyped strm, untyped flush) -> untyped

  def zr_deflate_copy: (untyped dest, untyped source) -> untyped

  def zr_deflate_longest_match: (untyped s, untyped cur_match) -> untyped

  def zr_deflate_flush_block_only: (untyped s, untyped last) -> untyped

  def zr_deflate_stored: (untyped s, untyped flush) -> untyped

  def zr_deflate_flush_block: (untyped s, untyped last) -> untyped

  def zr_deflate_block_end: (untyped s, untyped flush) -> untyped

  def zr_deflate_fast: (untyped s, untyped flush) -> untyped

  def zr_deflate_slow: (untyped s, untyped flush) -> untyped

  def zr_deflate_rle: (untyped s, untyped flush) -> untyped

  def zr_deflate_huff: (untyped s, untyped flush) -> untyped
end
