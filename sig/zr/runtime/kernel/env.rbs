  def zr_signal_of: (untyped exc) -> (0 | untyped)

  def zr_die_by_signal: (untyped signo) -> untyped

  def zr_exit_status: (untyped exc) -> untyped

  def zr_system_exit_p: (untyped exc) -> untyped

  def zr_program_start: (untyped file, untyped len) -> untyped

  def zr_program_name: () -> untyped

  def zr_environment_get: (untyped name) -> untyped

  def zr_environment_set: (untyped name, untyped value) -> untyped

  def zr_environment_list: () -> untyped

  def zr_getcwd: () -> untyped

