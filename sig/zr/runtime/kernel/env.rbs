  def zr_process_id: () -> untyped

  def zr_process_ids: (untyped which) -> untyped

  def zr_random_seed: () -> untyped

  Top: untyped

  # The files that the runtime loaded hidden from the program. They are not
  # in $LOADED_FEATURES. Each file has a record of three slots: its path,
  # the hidden file that was loading when it started (nil for a root that
  # eval support loads), and an Array (or nil) of what it defined: the id
  # of each of Object's constants that it defined or reopened, and a pair
  # of the class and the id for each method that it defined on a class of
  # the program. When the program requires one
  # of these files, the file becomes visible, with all that it loaded and
  # defined.
  G_HIDDEN_FEATURES: 50

  HIDDEN_ROW: 3

  def zr_hidden_features: () -> untyped

  # The real paths of the files that the program required, as in CRuby's
  # loaded_features_realpaths. A file found again through a symlink or a
  # different spelling of its directory does not run a second time.
  G_REAL_FEATURES: 60

  def zr_real_features: () -> untyped

  def zr_global_list: (untyped g) -> untyped

  def zr_loading: () -> untyped

  def zr_hidden_loader: () -> untyped

  def zr_loading_hidden: () -> untyped

  def zr_walking: () -> untyped

  def zr_walking_now: () -> untyped

  def zr_walk_enter: () -> untyped

  def zr_walk_leave: () -> untyped

  def zr_hidden_loading_path: () -> untyped

  def zr_hidden_now: () -> (true | false | untyped)

  def zr_asking_frame: () -> (untyped | 0)

  def zr_loading_internal: () -> (false | untyped)

  def zr_hidden_row: (untyped path) -> (untyped | -1)

  def zr_hidden_p: (untyped path) -> untyped

  def zr_hidden_add: (untyped path) -> untyped

  def zr_hidden_forget: (untyped path) -> untyped

  def zr_hidden_defined: (untyped id) -> (nil | untyped)

  def zr_hidden_defined_method: (untyped klass, untyped mid) -> (nil | untyped)

  def zr_hidden_defined_const: (untyped klass, untyped id) -> (nil | untyped)

  def zr_feature_reveal: (untyped path) -> untyped

  def zr_feature_real_path: (untyped path) -> untyped

  def zr_require: (untyped path, untyped fn, untyped kind) -> untyped

  def zr_require_computed: (untyped path, untyped fn, untyped kind) -> untyped

  def zr_require_run: (untyped path, untyped fn, untyped kind, untyped framed) -> untyped

  def zr_run_top: (untyped fn, untyped mid) -> untyped

  # The table that the compiler writes for a require with a computed name
  # (lib/zr/runtime.rb, `load_tables`): the count of compiled-in files,
  # their entries, and ten (bytes, length) texts.
  LoadTable: untyped

  def zr_load_table: () -> untyped

  def zr_unit_for: (untyped path) -> untyped

  def zr_load_names: (untyped which) -> untyped

  def zr_string_of: (untyped e, untyped s) -> untyped

  def zr_string_of_bytes: (untyped e, untyped bytes, untyped len) -> (false | untyped)

  def zr_ary_rindex_string: (untyped a, untyped s) -> untyped

  def zr_ary_rindex_bytes: (untyped a, untyped bytes, untyped len) -> (untyped | -1)

  def zr_ary_has_string: (untyped a, untyped s) -> untyped

  def zr_ary_has_bytes: (untyped a, untyped bytes, untyped len) -> untyped

  def zr_ary_delete_string: (untyped a, untyped s) -> untyped

  def zr_load_error: (untyped path, untyped len) -> untyped

  def zr_load_error_in: (untyped mid, untyped path, untyped len) -> untyped

  def zr_path_kind: (untyped path) -> untyped

  # st_mode's file type bits, which POSIX defines with the same values on
  # all hosts.
  S_IFMT: 61440

  S_IFDIR: 16384

  S_IFREG: 32768

  def zr_clock_ns: (untyped id) -> untyped

