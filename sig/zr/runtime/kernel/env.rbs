module Zr::Kern
  G_ARGV: 36

  G_AT_EXIT: 37

  G_ARGV0: 53

  def zr_args_init: (untyped argc, untyped argv) -> untyped

  def zr_cstr_len: (untyped p) -> untyped

  def zr_program_args: () -> untyped

  def zr_at_exit_add: (untyped blk) -> untyped

  def zr_program_end: (untyped exc) -> untyped

