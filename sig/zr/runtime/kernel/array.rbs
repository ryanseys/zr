module Zr::Kern
  # Arrays: a length, a capacity and a buffer of Values outside the arena.
  # `base` is the block from malloc. `ptr` is the first element, after the
  # gap that a shift from the front leaves. `capa` counts from `ptr`.
  RArray: untyped

  G_ARRAY: 25

  G_INDEX_ERROR: 26

  # CRuby's ARY_MAX_SIZE: the maximum number of elements in an Array,
  # LONG_MAX divided by the size of a Value.
  ARY_MAX_SIZE: 1152921504606846975

  def zr_ary_max_size: () -> untyped

  def zr_ary_embedded_p: (untyped a) -> untyped

  def zr_ary_embed_capa: (untyped a) -> untyped

  def zr_ary_cell_bytes: (untyped capa) -> untyped

  def zr_ary_buf_new: (untyped a, untyped capa) -> untyped

  def zr_ary_buf_free: (untyped a) -> (untyped | nil)

  def zr_ary_buf_bytes: (untyped a) -> untyped

  def zr_ary_new: (untyped capa) -> untyped

  def zr_ary_len_m: (untyped a) -> untyped

  def zr_ary_at_m: (untyped a, untyped i) -> untyped

  def zr_mark_ary: (untyped a) -> untyped

  def zr_ary_at: (untyped a, untyped i) -> untyped

  def zr_ary_reserve: (untyped a, untyped n) -> (untyped | nil)

  def zr_ary_grow: (untyped a, untyped n) -> (nil | untyped)

  def zr_ary_push: (untyped a, untyped v) -> untyped

  def zr_ary_unshift: (untyped a, untyped v) -> untyped

  def zr_ary_store: (untyped a, untyped i, untyped v) -> untyped

  def zr_ary_of: (untyped argc, untyped argv) -> untyped

  def zr_fixnum_range_ary: (untyped low, untyped high, untyped excl) -> untyped

  def zr_splat_to_a: (untyped v) -> untyped

  def zr_ary_splat: (untyped a, untyped v) -> untyped

  def zr_ary_initialize: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_index_of: (untyped a, untyped v) -> untyped

  def zr_big_to_long: (untyped v, untyped out) -> (false | true)

  def zr_index_operand: (untyped v, untyped out) -> untyped

  def zr_ary_subseq: (untyped a, untyped beg, untyped len) -> untyped

  def zr_range_beg_len: (untyped range, untyped n, untyped out) -> untyped

  def zr_ary_aref: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_aref1_m: (untyped a, untyped x) -> untyped

  def zr_ary_aref2_m: (untyped a, untyped beg, untyped len) -> untyped

  def zr_ary_aset_at: (untyped recv, untyped index, untyped v) -> untyped

  def zr_ary_push_m: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_pop: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_shift: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_reverse_bang: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_reversed: (untyped a) -> untyped

  def zr_ary_drop_front: (untyped a, untyped k) -> untyped

  def zr_ary_unshift_m: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_count: (untyped argc, untyped argv, untyped n, untyped out) -> untyped

  def zr_ary_length: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_empty_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_first: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_last: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_inspect: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_eq_by_conversion: (untyped recv, untyped other, untyped conv) -> untyped

  def zr_ary_eq: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_opt_aref: (untyped recv, untyped mid, untyped argc, untyped argv, untyped mode) -> untyped

  def zr_opt_push: (untyped recv, untyped mid, untyped argc, untyped argv, untyped mode) -> untyped

  def zr_opt_pop: (untyped recv, untyped mid, untyped argc, untyped argv, untyped mode) -> untyped

  def zr_opt_shift: (untyped recv, untyped mid, untyped argc, untyped argv, untyped mode) -> untyped

  def zr_opt_empty_p: (untyped recv, untyped mid, untyped argc, untyped argv, untyped mode) -> untyped

  def zr_opt_aset: (untyped recv, untyped mid, untyped argc, untyped argv, untyped mode) -> untyped

  def zr_masgn_ary: (untyped v) -> untyped

  def zr_masgn_rest: (untyped ary, untyped nlefts, untyped nrights) -> untyped

  def zr_masgn_right: (untyped ary, untyped nlefts, untyped nrights, untyped i) -> untyped

  def zr_ary_splice: (untyped a, untyped beg_v, untyped len_v, untyped vals) -> untyped

  def zr_memmove: (untyped to, untyped from, untyped n) -> untyped

  def zr_ary_clear: (untyped a, untyped unused) -> untyped

  def zr_index_operand_m: (untyped v) -> untyped
end
