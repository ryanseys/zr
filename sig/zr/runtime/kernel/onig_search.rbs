module Zr::Kern
  # onig_search_gpos and onig_match (regexec.c:4238-5281): the search
  # drivers that call match_at. They include the anchor pre-checks, the
  # optimizer's exact-string and map searches, and forward_search_range /
  # backward_search_range. Derived from Onigmo; the license is in
  # lib/zr/runtime/kernel/regexp.rb.
  ONIG_OPTIMIZE_NONE: 0

  ONIG_OPTIMIZE_EXACT: 1

  ONIG_OPTIMIZE_EXACT_BM: 2

  ONIG_OPTIMIZE_EXACT_BM_NOT_REV: 3

  ONIG_OPTIMIZE_EXACT_IC: 4

  ONIG_OPTIMIZE_MAP: 5

  ONIG_OPTIMIZE_EXACT_BM_IC: 6

  ONIG_OPTIMIZE_EXACT_BM_NOT_REV_IC: 7

  ONIG_ANCHOR_BEGIN_BUF: 1

  ONIG_ANCHOR_BEGIN_LINE: 2

  ONIG_ANCHOR_BEGIN_POSITION: 4

  ONIG_ANCHOR_END_BUF: 8

  ONIG_ANCHOR_SEMI_END_BUF: 16

  ONIG_ANCHOR_END_LINE: 32

  ONIG_ANCHOR_PREC_READ_NOT: 2048

  ONIG_ANCHOR_LOOK_BEHIND: 4096

  ONIG_ANCHOR_ANYCHAR_STAR: 16384

  ONIG_ANCHOR_ANYCHAR_STAR_ML: 32768

  ONIG_MAX_PTR_NUM: 100

  # The two buffers that a search needs: its region and the match state's
  # arena. They stay between searches, because a malloc and a free for
  # each match is slow: `String#scan` on a long text can make tens of
  # thousands of matches. Each buffer is one record of `ptr, capacity,
  # busy`, which grows to the largest request. If a record is busy (a
  # search inside a search), the call gets a new malloc, and the free
  # after it tells the two apart by the address.
  SCRATCH_ROW: 24

  def zr_onig_scratch: (untyped row, untyped bytes) -> untyped

  def zr_onig_scratch_free: (untyped row, untyped p) -> untyped

  def zr_onig_msa_init: (untyped m, untyped prog, untyped str, untyped text_end, untyped region, untyped limit) -> untyped

  def zr_onig_msa_free: (untyped m) -> untyped

  def zr_onig_region_clear: (untyped region, untyped num_mem) -> untyped

  def zr_onig_exact: (untyped prog) -> untyped

  def zr_onig_exact_end: (untyped prog) -> untyped

  def zr_onig_map_at: (untyped prog, untyped c) -> untyped

  def zr_onig_slow_search: (untyped enc, untyped target, untyped target_end, untyped text, untyped text_end, untyped text_range) -> untyped

  def zr_onig_slow_search_ic: (untyped enc, untyped flag, untyped target, untyped target_end, untyped text, untyped text_end, untyped text_range) -> untyped

  def zr_onig_slow_search_backward: (untyped enc, untyped target, untyped target_end, untyped text, untyped adjust_text, untyped text_end, untyped text_start) -> untyped

  def zr_onig_slow_search_backward_ic: (untyped enc, untyped flag, untyped target, untyped target_end, untyped text, untyped adjust_text, untyped text_end, untyped text_start) -> untyped

  def zr_onig_bm_search_notrev: (untyped prog, untyped target, untyped target_end, untyped text, untyped text_end, untyped text_range) -> untyped

  def zr_onig_bm_search: (untyped prog, untyped target, untyped target_end, untyped text, untyped text_end, untyped text_range) -> untyped

  def zr_onig_bm_search_notrev_ic: (untyped prog, untyped target, untyped target_end, untyped text, untyped text_end, untyped text_range) -> untyped

  def zr_onig_bm_search_ic: (untyped prog, untyped target, untyped target_end, untyped text, untyped text_end, untyped text_range) -> untyped

  def zr_onig_map_search: (untyped prog, untyped text, untyped text_range, untyped text_end) -> untyped

  def zr_onig_map_search_backward: (untyped prog, untyped text, untyped adjust_text, untyped text_start, untyped text_end) -> untyped

  def zr_onig_forward_find: (untyped prog, untyped p, untyped text_end, untyped range) -> untyped

  def zr_onig_forward_search_range: (untyped prog, untyped str, untyped text_end, untyped s, untyped range, untyped low, untyped high, untyped low_prev) -> (false | true)

  def zr_onig_backward_find: (untyped prog, untyped p, untyped range, untyped adjrange, untyped text_end) -> untyped

  def zr_onig_backward_search_range: (untyped prog, untyped str, untyped text_end, untyped s, untyped range, untyped adjrange, untyped low, untyped high) -> (false | true)

  def zr_onig_try_at: (untyped m, untyped s, untyped prev) -> untyped

  def zr_onig_search_gpos: (untyped m, untyped global_pos, untyped start, untyped range) -> untyped

  def zr_onig_search_forward: (untyped m, untyped start, untyped range) -> untyped

  def zr_onig_search_backward: (untyped m, untyped start, untyped range) -> untyped

  def zr_onig_search: (untyped prog, untyped str, untyped text_end, untyped start, untyped range, untyped region, untyped limit) -> untyped

  def zr_onig_match: (untyped prog, untyped str, untyped text_end, untyped at, untyped region, untyped limit) -> untyped
end
