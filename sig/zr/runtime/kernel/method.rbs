module Zr::Kern
  # Method and UnboundMethod contain a copy of the method entry, the
  # module where the lookup found it (`owner`), the class of the lookup
  # (`klass`), and the receiver. An UnboundMethod has no receiver.
  RMethod: untyped

  T_METHOD: 29

  G_METHOD: 33

  G_UNBOUND_METHOD: 34

  PARAM_REQ: 0

  PARAM_OPT: 1

  PARAM_REST: 2

  PARAM_KEYREQ: 3

  PARAM_KEY: 4

  PARAM_KEYREST: 5

  PARAM_BLOCK: 6

  PARAM_NOKEY: 7

  def zr_mark_method: (untyped m) -> untyped

  def zr_method_owner: (untyped klass, untyped mid) -> untyped

  def zr_undefined_method: (untyped klass, untyped mid, untyped vis) -> untyped

  def zr_method_new: (untyped recv, untyped klass, untyped mid) -> untyped

  def zr_method_missing_new: (untyped recv, untyped klass, untyped mid) -> untyped

  def zr_obj_method: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_mod_instance_method: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_public_method_new: (untyped recv, untyped klass, untyped mid) -> untyped

  def zr_obj_public_method: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_mod_public_instance_method: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_call: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_block: (untyped p, untyped argc, untyped argv, untyped blk) -> untyped

  def zr_method_invoke: (untyped m, untyped argc, untyped argv, untyped blk) -> untyped

  def zr_method_to_proc: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_meta: (untyped e) -> (untyped | 0)

  def zr_method_arity_of: (untyped m) -> untyped

  def zr_method_arity: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_param_rows: (untyped table, untyped lenient) -> untyped

  def zr_arity_rows: (untyped arity) -> untyped

  def zr_method_rows: (untyped m) -> untyped

  def zr_method_parameters: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_params_min: (untyped table) -> untyped

  def zr_params_positional: (untyped table) -> untyped

  def zr_params_rest_p: (untyped table) -> (true | false)

  def zr_proc_arity: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_proc_param_rows: (untyped recv, untyped lenient) -> untyped

  def zr_param_kind_name: (untyped kind) -> untyped

  def zr_method_owner_m: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_receiver: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_name: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_original_id: (untyped e) -> untyped

  def zr_method_defined_in: (untyped m) -> untyped

  def zr_method_original_name: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_unbind: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_bind_to: (untyped m, untyped obj) -> untyped

  def zr_method_bind: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_bind_call: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_location: (untyped e) -> (0 | untyped)

  def zr_method_box_m: (untyped m) -> untyped

  def zr_method_source_location: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_eq: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_method_hash: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_buf_param: (untyped b, untyped kind, untyped id, untyped i, untyped forwarding) -> untyped

  def zr_params_forwarding_p: (untyped table) -> untyped

  def zr_buf_method_params: (untyped b, untyped m) -> (nil | untyped)

  def zr_method_inspect: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped
end
