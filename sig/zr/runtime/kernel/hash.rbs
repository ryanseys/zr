module Zr::Kern
  # Hashes. The entries are in insertion order, outside the arena. Each
  # entry has a key, a value, its hash code, and a live flag (a deleted
  # entry stays until the table grows). An open-addressing index of bins
  # maps a hash code to an entry. A String key is kept as a frozen copy, as
  # in CRuby. `gen` counts the rebuilds of the entries or the bins. Thus a
  # probe that ran a key's own `eql?` can see that the table changed
  # (CRuby's st "rebuilt" check).
  RHash: untyped

  HEntry: untyped

  T_HASH: 8

  G_HASH: 30

  G_KEY_ERROR: 31

  # The result of a probe when a key's own `hash` or `eql?` raised. The
  # exception is pending in the task, and the probe returns this in place
  # of an entry.
  HASH_RAISED: 1

  # The return values of zr_key_eql.
  KEY_DIFFERENT: 0

  KEY_SAME: 1

  KEY_RAISED: 2

  def zr_hash_new: () -> untyped

  def zr_mark_hash: (untyped h) -> (nil | untyped)

  def zr_key_eql: (untyped a, untyped b) -> untyped

  def zr_key_eql_elements: (untyped a, untyped b) -> untyped

  def zr_hash_mix: (untyped x) -> untyped

  def zr_key_hash: (untyped h, untyped key, untyped out) -> (true | false)

  def zr_key_builtin_p: (untyped key, untyped mid, untyped builtin) -> untyped

  def zr_key_code: (untyped h, untyped key) -> untyped

  def zr_value_code: (untyped key) -> untyped

  def zr_ary_leaf_hash: (untyped a, untyped seed) -> untyped

  def zr_rb_hash: (untyped v) -> untyped

  def zr_str_bytes_hash: (untyped s) -> untyped

  def zr_hash_seed: () -> untyped

  def zr_hash_seed_init: () -> untyped

  def zr_bytes_hash: (untyped p, untyped n) -> untyped

  def zr_hash_entry: (untyped h, untyped key) -> (0 | untyped)

  def zr_hash_find: (untyped h, untyped key, untyped code) -> (untyped | 0)

  def zr_hash_scan: (untyped h, untyped key, untyped code, untyped identity, untyped gen) -> (untyped | 0)

  def zr_hash_lookup: (untyped h, untyped key) -> untyped

  def zr_hash_bin: (untyped h, untyped n) -> (nil | untyped)

  # Rebuilds the bins from the live entries, with two times the entry
  # capacity, so the probes stay short. A table of HASH_SMALL entries or
  # fewer has no bins, because a scan of that many codes costs less than
  # the bins.
  HASH_SMALL: 8

  def zr_hash_rebins: (untyped h) -> (nil | untyped)

  def zr_hash_reserve: (untyped h) -> (nil | untyped)

  def zr_hash_recode: (untyped h) -> (false | true)

  def zr_hash_store: (untyped h, untyped key, untyped value) -> untyped

  def zr_hash_append: (untyped h, untyped key, untyped code, untyped value) -> untyped

  def zr_hash_default: (untyped h, untyped key) -> untyped

  def zr_hash_aref: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_missing: (untyped h, untyped key) -> untyped

  def zr_hash_aset: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_fetch: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_key_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_delete: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_size: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_len_m: (untyped h) -> untyped

  def zr_hash_empty_p: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_keys: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_values: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_assoc: (untyped e) -> untyped

  def zr_block_takes_pair: (untyped blk) -> untyped

  def zr_hash_each: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_foreach: (untyped h, untyped blk) -> untyped

  def zr_hash_to_a: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_symbol_key_simple_p: (untyped key) -> (false | true)

  def zr_hash_inspect: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_eq: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_eq_entries: (untyped recv, untyped other) -> untyped

  def zr_hash_init: (untyped recv, untyped capacity, untyped unset, untyped ifnone, untyped blk) -> untyped

  def zr_hash_default_m: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_hash_of: (untyped n, untyped argv) -> untyped

  def zr_kw_get: (untyped hash, untyped id) -> untyped

  def zr_kw_declared: (untyped ids, untyped n, untyped id) -> (true | false)

  def zr_kw_missing: (untyped hash, untyped ids, untyped n) -> untyped

  def zr_kw_none: (untyped hash) -> untyped

  def zr_kw_unknown: (untyped hash, untyped ids, untyped n) -> untyped

  def zr_kw_tab_index: (untyped tab, untyped id) -> untyped

  def zr_kw_shape: (untyped shape, untyped tab, untyped ids, untyped m, untyped required, untyped nreq, untyped mode) -> untyped

  def zr_kw_missing_tab: (untyped tab, untyped ids, untyped n) -> untyped

  def zr_kw_unknown_tab: (untyped tab, untyped ids, untyped m) -> untyped

  def zr_kw_rest_tab: (untyped tab, untyped vals, untyped ids, untyped m) -> untyped

  def zr_kw_rest: (untyped hash, untyped ids, untyped n) -> untyped

  def zr_hash_update: (untyped h, untyped other) -> untyped

  def zr_ary_kw_element: (untyped h) -> untyped

  def zr_hash_default_proc: (untyped h) -> untyped

  def zr_hash_set_default: (untyped h, untyped v) -> untyped

  def zr_hash_set_default_proc: (untyped h, untyped p) -> untyped

  def zr_hash_clear: (untyped h) -> untyped

  def zr_hash_compare_by_identity: (untyped h) -> untyped

  def zr_hash_iterating_p: (untyped h) -> untyped

  def zr_hash_rehash: (untyped h) -> untyped

  def zr_hash_identity_p: (untyped h) -> untyped

  def zr_hash_default_value: (untyped h) -> untyped

  def zr_hash_aref_m: (untyped h, untyped key) -> untyped

  def zr_hash_aset_m: (untyped h, untyped key, untyped value) -> untyped

  def zr_hash_key_p_m: (untyped h, untyped key) -> untyped

  def zr_hash_fetch_m: (untyped h, untyped key, untyped blk) -> untyped

  def zr_hash_replace_m: (untyped h, untyped other) -> untyped

  def zr_hash_delete_m: (untyped h, untyped key) -> untyped
end
