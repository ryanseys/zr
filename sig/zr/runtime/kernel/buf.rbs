module Zr::Kern
  # A growable byte buffer to build strings and messages. It starts in the
  # 64 bytes of its own tail, on the stack with the rest of the buffer. It
  # moves to malloc'd memory only when it grows past those bytes. Thus a
  # message that raises before a String takes it leaves nothing to free.
  BufTail: untyped

  Buf: untyped

  def zr_buf_init: (untyped b) -> untyped

  def zr_buf_inline_p: (untyped b) -> untyped

  def zr_buf_free: (untyped b) -> untyped

  def zr_buf_reserve: (untyped b, untyped n) -> untyped

  def zr_buf_push: (untyped b, untyped bytes, untyped n) -> untyped

  def zr_buf_byte: (untyped b, untyped c) -> untyped

  def zr_buf_long: (untyped b, untyped n) -> untyped

  def zr_buf_sym: (untyped b, untyped id) -> untyped

  def zr_buf_str: (untyped b, untyped s) -> untyped

  def zr_buf_take: (untyped b) -> untyped

  def zr_buf_take_at: (untyped b, untyped index) -> untyped
end
