module Zr::Kern
  # The encodings that the Onigmo matcher reads in zr, and the helpers of
  # regenc.c and enc/unicode.c that the matcher calls. `enc` is the
  # address of the encoding descriptor inside the program
  # (Regexp::Onig::Enc::Base#descriptor). Its kind selects the primitives
  # of its enc/*.c source file, and its tables contain the data that those
  # primitives read. Derived from Onigmo. The license is in
  # lib/zr/runtime/kernel/regexp.rb.
  ONIG_ENC_KIND_SINGLE_BYTE: 0

  ONIG_ENC_KIND_UTF8: 1

  ONIG_ENC_KIND_EUC_JP: 2

  ONIG_ENC_KIND_SHIFT_JIS: 3

  ONIG_ENC_KIND_TRAIL: 4

  ONIG_ENC_KIND_EUC_KR: 5

  ONIG_ENC_KIND_EUC_TW: 6

  ONIG_ENC_KIND_GB18030: 7

  ONIG_ENC_KIND_EMACS_MULE: 8

  ONIG_ENC_KIND_CESU8: 9

  ONIG_ENC_KIND_UTF16LE: 10

  ONIG_ENC_KIND_UTF16BE: 11

  ONIG_ENC_KIND_UTF32LE: 12

  ONIG_ENC_KIND_UTF32BE: 13

  ONIG_ENC_FLAG_SHARP_S: 1

  ONIG_CTYPE_WORD_BIT: 4096

  ONIG_MBC_CASE_FOLD_MAXLEN: 18

  ONIG_CASE_FOLD_MULTI_CHAR: untyped

  # The header of the descriptor. Each table offset counts from the start
  # of the descriptor.
  OnigEnc: untyped

  def zr_onig_enc_kind: (untyped enc) -> untyped

  def zr_onig_enc_single_byte_p: (untyped enc) -> untyped

  def zr_onig_enc_byte: (untyped enc, untyped field, untyped i) -> untyped

  def zr_onig_enc_trans: (untyped enc, untyped state, untyped c) -> untyped

  def zr_onig_utf8_trans: (untyped state, untyped c) -> (untyped | 1 | 2 | 4 | 3 | 5 | 6 | 7)

  def zr_onig_utf8_precise_len: (untyped p, untyped e) -> (untyped | 1)

  def zr_onig_mb_need: (untyped enc, untyped k, untyped first, untyped state) -> (untyped | 4)

  def zr_onig_mb_precise_len: (untyped enc, untyped p, untyped e) -> untyped

  def zr_onig_valid_codepoint_p: (untyped c) -> (false | untyped)

  def zr_onig_wide_precise_len: (untyped enc, untyped p, untyped e) -> (untyped | 2 | 4)

  def zr_onig_precise_len: (untyped enc, untyped p, untyped e) -> (untyped | 1)

  def zr_onig_mbclen: (untyped enc, untyped p, untyped e) -> (1 | untyped)

  def zr_onig_enclen: (untyped enc, untyped p, untyped e) -> (1 | untyped)

  def zr_onig_enclen_approx: (untyped enc, untyped p, untyped e) -> (untyped | 1)

  def zr_onig_mbc_head_p: (untyped enc, untyped p, untyped e) -> untyped

  def zr_onig_mbn_to_code: (untyped p, untyped e, untyped len) -> untyped

  def zr_onig_utf8_to_code: (untyped p, untyped e) -> untyped

  def zr_onig_cesu8_to_code: (untyped enc, untyped p, untyped e) -> untyped

  def zr_onig_decode3: (untyped p) -> untyped

  def zr_onig_mbc_to_code: (untyped enc, untyped p, untyped e) -> untyped

  def zr_onig_code_to_mbc: (untyped enc, untyped code, untyped buf) -> (4 | 2 | 1 | 6 | 3)

  def zr_onig_store16: (untyped buf, untyped v, untyped big) -> untyped

  def zr_onig_store_utf8_3: (untyped buf, untyped code) -> untyped

  def zr_onig_adjust_tail: (untyped s, untyped q, untyped len) -> untyped

  def zr_onig_euc_left_adjust: (untyped enc, untyped start, untyped s, untyped e) -> untyped

  def zr_onig_trail_left_adjust: (untyped enc, untyped start, untyped s, untyped e) -> untyped

  def zr_onig_gb18030_left_adjust: (untyped enc, untyped start, untyped s, untyped e) -> untyped

  def zr_onig_gb18030_moves: () -> untyped

  def zr_onig_left_adjust: (untyped enc, untyped start, untyped s, untyped e) -> untyped

  def zr_onig_right_adjust: (untyped enc, untyped start, untyped s, untyped e) -> untyped

  def zr_onig_prev_char_head: (untyped enc, untyped start, untyped s, untyped e) -> untyped

  def zr_onig_step_back: (untyped enc, untyped start, untyped s, untyped e, untyped n) -> untyped

  def zr_onig_newline_p: (untyped enc, untyped p, untyped e) -> (untyped | false)

  def zr_onig_in_code_range_p: (untyped ranges, untyped code) -> untyped

  def zr_onig_ascii_word_p: (untyped code) -> (false | untyped)

  def zr_onig_wide_code_p: (untyped enc, untyped code) -> (untyped | false | true)

  def zr_onig_code_word_p: (untyped enc, untyped code) -> (false | untyped)

  def zr_onig_mbc_word_p: (untyped enc, untyped s, untyped e) -> untyped

  def zr_onig_mbc_ascii_word_p: (untyped enc, untyped s, untyped e) -> untyped

  def zr_onig_ascii_lower: (untyped c) -> untyped

  def zr_onig_fold_lookup: (untyped code) -> untyped

  def zr_onig_unicode_case_fold: (untyped enc, untyped p, untyped e, untyped fold) -> untyped

  def zr_onig_jis_lower: (untyped kind, untyped code) -> untyped

  def zr_onig_jis_case_fold: (untyped enc, untyped p, untyped e, untyped fold) -> (1 | untyped)

  def zr_onig_mbc_case_fold: (untyped enc, untyped flag, untyped pp, untyped e, untyped fold) -> (2 | 1 | untyped)

  def zr_onig_string_cmp_ic: (untyped enc, untyped flag, untyped s1, untyped s2, untyped mblen, untyped text_end) -> untyped

  def zr_onig_str_lower_case_match: (untyped enc, untyped flag, untyped t, untyped tend, untyped p, untyped e) -> (false | true)
end
