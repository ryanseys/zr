module Zr::Kern
  # TracePoint events. When a program refers to TracePoint, the compiler
  # adds a check of `trace_events` at each point where ruby fires an
  # event. `trace_events` contains the events that the enabled
  # TracePoints need. A set bit sends the program here, and
  # TracePoint.fire runs the handlers with an event record (an Array)
  # that describes the frame of the event.
  TRACE_LINE: 1

  TRACE_CALL: 8

  TRACE_RETURN: 16

  TRACE_C_CALL: 32

  TRACE_C_RETURN: 64

  TRACE_C: 96

  # The events that a send fires around the method that it calls: a
  # method that CRuby writes in C, and a method that CRuby writes in Ruby.
  TRACE_SENDS: 120

  TRACE_RAISE: 128

  TRACE_RESCUE: 16384

  # Events that the machine fires, not a frame. The two thread events
  # fire from lib/zr/runtime/core/thread.rb, where the thread body starts and
  # ends. The fiber event fires here, at each of the four places where
  # control arrives after a switch.
  TRACE_FIBER_SWITCH: 4096

  # Fires when a string of Ruby, or a file that a require loads, is
  # compiled and is about to run.
  TRACE_SCRIPT_COMPILED: 8192

  def zr_trace_events_set: (untyped mask) -> untyped

  def zr_trace_events_arm: () -> untyped

  def zr_trace_c_p: () -> untyped

  def zr_trace_sends_p: () -> untyped

  # Marks a method that CRuby writes in Ruby. TracePoint sets this bit
  # (the second bit of MEntry.core) by name. A :call and a :return fire
  # around such a method, as around a method of the program.
  MENTRY_CRUBY_RUBY: 2

  def zr_trace_armed_m: () -> untyped

  def zr_trace_ruby_entry_p: (untyped e) -> untyped

  def zr_trace_mark_ruby: (untyped klass, untyped name) -> untyped

  def zr_trace_c_entry_p: (untyped e) -> (false | true | untyped)

  def zr_trace_c_caller_p: () -> (true | untyped)

  def zr_trace_send_invoke: (untyped e, untyped recv, untyped mid, untyped argc, untyped argv, untyped blk, untyped kw, untyped before) -> untyped

  def zr_trace_c_send: (untyped event, untyped e, untyped owner, untyped recv, untyped value) -> untyped

  def zr_trace_fire: (untyped event, untyped value) -> untyped

  def zr_trace_raise: (untyped exc, untyped top) -> untyped

  def zr_trace_rescue: (untyped line) -> untyped

  def zr_trace_send: (untyped rec, untyped event, untyped value) -> untyped

  def zr_trace_send_at: (untyped rec, untyped event, untyped value, untyped line) -> untyped

  def zr_trace_row: (untyped event, untyped value, untyped meta, untyped line) -> untyped

  def zr_trace_fiber_switch: (untyped recv, untyped mid) -> untyped

  def zr_trace_fiber_switched: (untyped v, untyped recv, untyped mid) -> untyped

  def zr_trace_compiled_value: (untyped script, untyped path, untyped label, untyped label_len, untyped line) -> untyped

  def zr_trace_compiled: (untyped rec, untyped value, untyped this, untyped mid, untyped owner) -> untyped

  def zr_trace_script_compiled: (untyped script, untyped path, untyped line) -> untyped

  def zr_trace_required: (untyped path, untyped kind) -> untyped

  def zr_trace_run: (untyped row) -> untyped

  def zr_trace_bmethod: (untyped event, untyped e, untyped recv, untyped value) -> untyped

  def zr_trace_binding: (untyped serial) -> untyped

  def zr_trace_parameters: (untyped meta_word, untyped entry_word) -> untyped

  def zr_trace_within: (untyped meta_word, untyped target) -> untyped
end
