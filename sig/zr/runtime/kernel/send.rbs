module Zr::Kern
  def zr_no_method_from: (untyped recv, untyped mid, untyped vcall, untyped from_super, untyped argc, untyped argv) -> untyped

  def zr_wrong_arity_kw: (untyped given, untyped min, untyped max, untyped ids, untyped nkw) -> untyped

  def zr_wrong_arity: (untyped given, untyped expected) -> untyped

  def zr_wrong_arity_range: (untyped given, untyped min, untyped max) -> untyped

  def zr_wrong_arity_min: (untyped given, untyped min) -> untyped

  def zr_kw_pass: () -> untyped

  def zr_kw_tab_in: (untyped tab, untyped argc, untyped argv) -> untyped

  def zr_kw_argc: (untyped argc, untyped argv) -> untyped

  def zr_kw_hashed: (untyped tab) -> (0 | 1)

  def zr_kw_argc_yield: (untyped argc, untyped argv) -> untyped

  def zr_ruby2_fns: () -> untyped

  def zr_ruby2_mark_m: (untyped klass, untyped name) -> untyped

  def zr_ruby2_mark_proc: (untyped pr) -> untyped

  def zr_kw_undeclared: (untyped kw, untyped argc, untyped argv, untyped fn) -> untyped

  def zr_kw_ruby2_out: (untyped argc, untyped argv) -> untyped

  def zr_kw_take: () -> untyped

  # Why a call went to `method_missing`. The base `method_missing` uses it
  # for the message. Either no method has the name (called with an
  # implicit receiver, as a bare identifier, or with an explicit
  # receiver), or the method is private or protected.
  MISS_IMPLICIT: 1

  MISS_VCALL: 2

  MISS_EXPLICIT: 3

  MISS_PRIVATE: 4

  MISS_PROTECTED: 5

  MISS_SUPER: 6

  def zr_method_missing: (untyped recv, untyped mid, untyped argc, untyped argv, untyped blk, untyped kw, untyped reason) -> untyped

  def zr_miss_error: (untyped recv, untyped mid, untyped reason, untyped argc, untyped argv) -> untyped

  def zr_obj_method_missing: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_no_method: (untyped recv, untyped mid, untyped vcall, untyped argc, untyped argv) -> untyped

  def zr_hidden_method: (untyped recv, untyped mid, untyped vis, untyped argc, untyped argv) -> untyped

  def zr_buf_receiver: (untyped b, untyped recv) -> untyped

  def zr_visibility_refused: (untyped e, untyped mode) -> (0 | untyped)

  # A send from the core library, to a name outside the protocol that
  # CRuby's C code sends by name. It finds the core library's own method on
  # a class that the runtime made, also when the program redefines the
  # method (zr_find_core_method).
  SEND_CORE: 8

  SEND_MODE: 7

  # A send written under `using`. The site sets its own active
  # refinements on the task before each send (the lowering's `activate`,
  # inline), and clears them after. Thus at that site the lookup result
  # depends only on the class and the stamp, and its cache entries can
  # keep it. The site checks its cache entry and takes an operator's fast
  # path, as any site does. A refinement's definition increments the
  # stamp, as any definition does, and closes the gate of the name that it
  # refines (zr_method_add_row). A `using` also increments the stamp.
  SEND_USING: 16

  def zr_dispatch: (untyped cc, untyped recv, untyped mid, untyped argc, untyped argv, untyped mode, untyped blk) -> untyped

  def zr_super: (untyped cc, untyped rec, untyped argc, untyped argv, untyped blk) -> untyped

  def zr_frame_defined: (untyped rec) -> untyped

  def zr_bmethod_entry: (untyped rec) -> (0 | untyped)

  def zr_method_meta_of: (untyped rec) -> (0 | untyped)

  def zr_super_defined: (untyped rec) -> untyped

  def zr_super_from: (untyped rec, untyped recv, untyped owner) -> untyped

  def zr_zsuper_in_block: (untyped rec) -> untyped

  def zr_zsuper_outside: (untyped rec) -> untyped

  def zr_invoke: (untyped e, untyped recv, untyped argc, untyped argv, untyped blk, untyped kw) -> untyped

  def zr_wrong_arity_in: (untyped given, untyped expected, untyped e, untyped recv) -> untyped

  def zr_entry_found: (untyped e) -> untyped

  def zr_send: (untyped recv, untyped mid, untyped argc, untyped argv) -> untyped

  def zr_send_blk: (untyped recv, untyped mid, untyped argc, untyped argv, untyped blk) -> untyped

  def zr_ruby2_hash_new: (untyped h) -> untyped

  def zr_ruby2_hash_p: (untyped h) -> untyped

  # Preemption. A green thread that only computes makes no blocking call,
  # so no other thread can run. Every safe point reads the poll word
  # (`zr_poll_slot`, next to the task word): a compiled loop's back edge,
  # a compiled method's entry, and the kernel's loops through
  # `zr_preempt`. The kernel acts at a safe point only when the word is
  # set. The timer thread sets it every 100 ms after a second thread starts
  # (`zr_os_poll_start`). A caught POSIX signal and a collection that
  # queued a finalizer also set it. Under wasm there is no timer thread,
  # so a count is the clock: compiled back edges decrement it, and the
  # kernel's loops decrement it here. Thread sets the receiver and message
  # when a second thread starts, so a one-thread program never yields to
  # the scheduler.
  PREEMPT_TICKS: 20000

  def zr_preempt_arm: (untyped receiver, untyped message) -> untyped

  def zr_poll_set: () -> untyped

  def zr_threaded: () -> untyped

  def zr_preempt: () -> untyped

  def zr_preempt_expired: () -> untyped

  def zr_preempt_send: (untyped mid) -> untyped

  def zr_check_funcall: (untyped v, untyped mid) -> untyped

  def zr_check_call: (untyped v, untyped name) -> untyped
end
