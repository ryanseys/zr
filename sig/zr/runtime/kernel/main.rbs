module Zr::Kern
  def zr_boot_class: (untyped g, untyped name, untyped sup) -> untyped

  def zr_boot_name: (untyped g, untyped name) -> untyped

  def zr_boot_method_class: (untyped klass) -> untyped

  # The machine stack ends at this margin for Ruby frames. The margin above
  # the thread's guard page keeps space for the kernel's own frames and
  # the error report. A limit of zero, as under wasm, never fails.
  STACK_MARGIN: 262144

  def zr_main_stack_limit: () -> untyped

  def zr_boot: () -> untyped

  def main: (untyped argc, untyped argv) -> untyped

  def zr_main: (untyped argc, untyped argv) -> untyped
end
