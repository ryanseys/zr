module Zr::Kern
  # Sorting. ruby's `Array#sort` uses the C library's `qsort_r`, so the
  # order of equal elements comes from that routine. `zr_os_sort` refers to
  # the OS's routine. For macOS, this file has the Bentley-McIlroy
  # algorithm, on records of `stride` bytes whose first word is the Value
  # to compare. It uses indexes in place of pointers. musl's smoothsort is
  # in lib/zr/runtime/kernel/os/linux/smoothsort.rb.
  #
  # The comparator runs Ruby. After a comparison raises, every later
  # comparison returns 0 and runs no Ruby. The sort finishes on its copy,
  # and the pending unwind continues after the sort.
  # `plain` means that Integer and String had the core's own `<=>` when the
  # sort started. Then two fixnums or two Strings compare with no send
  # (zr_sort_plain).
  Sort: untyped

  def zr_cmpint: (untyped r, untyped x, untyped y) -> untyped

  def zr_cmperr: (untyped x, untyped y) -> untyped

  def zr_sort_at: (untyped st, untyped i) -> untyped

  def zr_sort_swap: (untyped st, untyped i, untyped j) -> untyped

  def zr_sort_vecswap: (untyped st, untyped i, untyped j, untyped n) -> untyped

  def zr_core_cmp_p: (untyped klass) -> untyped

  def zr_cmp_plain: (untyped a, untyped b) -> untyped

  def zr_sort_plain: () -> (1 | 0)

  def zr_sort_cmp: (untyped st, untyped i, untyped j) -> untyped

  def zr_sort_cmp_values: (untyped st, untyped x, untyped y) -> (0 | untyped)

  def zr_sort_med3: (untyped st, untyped a, untyped b, untyped c) -> untyped

  def zr_sort_insertion: (untyped st, untyped a, untyped n) -> untyped

  def zr_sort_range: (untyped st, untyped a, untyped n) -> (nil | untyped)

  def zr_sort_partition: (untyped st, untyped a, untyped n, untyped parts) -> (false | true)

  def zr_sort_apple_all: (untyped st, untyped n) -> untyped

  def zr_sort_apple: (untyped st, untyped a, untyped n, untyped depth) -> untyped

  def zr_sort_isort: (untyped st, untyped a, untyped n, untyped limit) -> (false | true)

  def zr_sort_heap_at: (untyped st, untyped a, untyped i) -> untyped

  def zr_sort_heap: (untyped st, untyped a, untyped n) -> (nil | untyped)

  def zr_ary_sort_copy: (untyped ary, untyped blk) -> untyped

  def zr_ary_sort: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_ary_sort_bang: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  # The records of `sort_by`: a key and its element, in an Array of
  # pairs. When every key is a fixnum or a Float, CRuby sorts with its own
  # introsort in place of `qsort_r`, and the order of equal keys comes from
  # that routine.
  Pair: untyped

  def zr_uniform_failed: () -> untyped

  def zr_uniform_float_cmp: (untyped x, untyped y) -> (0 | untyped)

  def zr_uniform_key_less: (untyped a, untyped b) -> untyped

  def zr_uniform_float_less: (untyped a, untyped b) -> untyped

  def zr_uniform_key_larger: (untyped a, untyped b) -> untyped

  def zr_uniform_less: (untyped base, untyped i, untyped j) -> untyped

  def zr_uniform_swap: (untyped base, untyped i, untyped j) -> untyped

  def zr_uniform_move: (untyped base, untyped i, untyped pos) -> untyped

  def zr_uniform_insertion: (untyped base, untyped a, untyped stop) -> untyped

  def zr_uniform_heap_down: (untyped base, untyped a, untyped offset, untyped len) -> untyped

  def zr_uniform_heapsort: (untyped base, untyped a, untyped stop) -> (nil | untyped)

  def zr_uniform_med3: (untyped base, untyped a, untyped b, untyped c) -> untyped

  def zr_uniform_quicksort: (untyped base, untyped a, untyped stop, untyped d) -> (nil | untyped)

  def zr_uniform_sort: (untyped base, untyped n) -> (nil | untyped)

  def zr_sort_by: (untyped pairs) -> untyped
end
