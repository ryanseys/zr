module Zr::Kern
  # Integer builtins for fixnums. A bignum goes to the core library.
  # Compiled code inlines the fixnum fast path of each operator below while
  # its gate bit is clear. A redefinition sets the bit (see
  # zr_define_method), and then every site makes the call. The gate word is
  # in its own register. `Machine.gates` reads it, `Machine.gates_set`
  # writes it and its static, and `Machine.gates_enter` loads it from the
  # static where foreign code enters.
  GATE_PLUS: 1

  GATE_MINUS: 2

  GATE_MUL: 4

  GATE_DIV: 8

  GATE_MOD: 16

  GATE_LT: 32

  GATE_LE: 64

  GATE_GT: 128

  GATE_GE: 256

  GATE_EQ: 512

  GATE_NE: 1024

  GATE_NOT: 2048

  GATE_AREF: 4096

  GATE_ASET: 8192

  GATE_AND: 65536

  GATE_OR: 131072

  GATE_XOR: 262144

  GATE_SHR: 524288

  GATE_HASH_AREF: 1048576

  GATE_HASH_ASET: 2097152

  # The named calls that have their own fast path (zr_opt_getbyte and the
  # others). Their bits are above the operator bits, in the same word.
  GATE_GETBYTE: untyped

  GATE_SETBYTE: untyped

  GATE_SUCC: untyped

  GATE_PUSH: untyped

  GATE_POP: untyped

  GATE_SHIFT: untyped

  GATE_EMPTY_P: untyped

  # Proc#call on a `&b` parameter that is bound to the block that the
  # caller gave (zr_opt_block_call).
  GATE_PROC_CALL: untyped

  # `is_a?`, `kind_of?` and `instance_of?` from Kernel, for every object.
  # These two gates close when any class defines a method of that name,
  # because a site gets the result from the receiver's class only.
  GATE_IS_A: untyped

  GATE_INSTANCE_OF: untyped

  # Symbol#===: a `case` whose `when` values are all symbol literals
  # compares the subject with each symbol by identity
  # (Function::Control#symbol_case). A `case` arm on a class does not use
  # a gate for Module#===. Its cache entry records whether `===` is
  # Module's. A gate cannot see SystemCallError's own `===`, because the
  # core defines it before the program starts.
  GATE_SYM_EQQ: untyped

  # `nil?` from Kernel and NilClass. The gate closes when any class
  # defines a method of that name, because a site gets the result from
  # the receiver only.
  GATE_NIL_P: untyped

  # Array#each, Integer#times and Range#each. A site with a block literal
  # runs the loop inline while each method is the original of its class
  # (Function::Iterators).
  GATE_EACH: untyped

  GATE_TIMES: untyped

  GATE_RANGE_EACH: untyped

  # Integer#-@ and Float#-@: a site negates a fixnum or a flonum inline.
  GATE_UMINUS: untyped

  GATE_FLO_UMINUS: untyped

  # Integer#<=>: the core library compares two fixnums natively while it
  # is ruby's own, as CRuby's OPTIMIZED_CMP does.
  GATE_CMP: untyped

  # Array#map and Array#select: a site with a block literal runs the
  # loop inline, and pushes to the new Array there (Function::Iterators).
  GATE_MAP: untyped

  GATE_SELECT: untyped

  # Integer#upto from one fixnum to another: Ruby's C counts in a loop
  # with no send, so the site does too.
  GATE_UPTO: untyped

  # Math.sqrt, cbrt, sin, cos, tan, atan and exp: a site `Math.f(x)` calls
  # the kernel's fast path for a Float or an Integer directly, with no
  # send, while Math's singleton methods are the core's (G_MATH_META).
  GATE_MATH: untyped

  # Closes when the first ractor task starts (zr_ractor_enter_m). Until
  # then, an inline instance variable read or write needs no test of the
  # task: no task can be a ractor's. After, every one goes to the kernel,
  # which applies the ractor rule for the task that runs.
  GATE_RACTOR: untyped

  def zr_long_digits: (untyped n, untyped buf) -> untyped

  def zr_int_to_s: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_big_p: (untyped v) -> untyped

  def zr_big_alloc: () -> untyped

  def zr_fixnum_p_m: (untyped v) -> untyped

  # An integer literal outside the fixnum range. The first time its site
  # runs, the core parses its decimal digits. A table keeps the Integer at
  # the site's index, and later runs return the same Integer.
  G_BIG_LITERALS: 54

  def zr_big_literal: (untyped index, untyped bytes, untyped n) -> untyped

  def zr_big_route_blk: (untyped recv, untyped mid, untyped argc, untyped argv, untyped blk) -> untyped

  def zr_big_route: (untyped recv, untyped mid, untyped argc, untyped argv) -> untyped

  def zr_int_from_word: (untyped n) -> untyped

  def zr_shift_operand: (untyped recv, untyped argv, untyped out, untyped mid) -> untyped

  def zr_int_operand: (untyped recv, untyped argv, untyped out, untyped mid, untyped kind) -> untyped

  def zr_num_coerce: (untyped recv, untyped other, untyped mid, untyped kind) -> untyped

  def zr_num_coerce_m: (untyped recv, untyped other, untyped mid, untyped kind) -> untyped

  def zr_int_result: (untyped n) -> untyped

  def zr_int_plus: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_minus: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_mul: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_floor_div: (untyped a, untyped b) -> untyped

  def zr_floor_mod: (untyped a, untyped b) -> untyped

  def zr_int_div: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_mod: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_and: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_or: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_xor: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_not: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_lshift: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_fix_bit_length: (untyped v) -> untyped

  def zr_int_rshift: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_bool: (untyped b) -> untyped

  def zr_int_lt: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_le: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_gt: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_ge: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_eq: (untyped recv, untyped argc, untyped argv, untyped cref, untyped blk) -> untyped

  def zr_int_float_cmp: (untyped n, untyped d) -> (2 | untyped | 1 | 0)

  def zr_int_float_relate: (untyped n, untyped d, untyped want) -> untyped

  def zr_int_float_spaceship: (untyped recv, untyped other) -> untyped
end
