  def zr_io_pipe: () -> untyped

  def zr_proc_rusage: (untyped who) -> untyped

  def zr_proc_ppid: () -> untyped

  def zr_proc_getpriority: (untyped which, untyped who) -> untyped

  def zr_proc_setpriority: (untyped which, untyped who, untyped priority) -> untyped

