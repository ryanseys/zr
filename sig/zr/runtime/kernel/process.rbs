  def zr_proc_kill: (untyped pid, untyped signal) -> untyped

  def zr_proc_kill_all: (untyped pids, untyped signal) -> untyped

  def zr_proc_getrlimit: (untyped resource) -> untyped

  def zr_proc_setrlimit: (untyped resource, untyped cur, untyped max) -> untyped

  def zr_proc_setreid: (untyped group, untyped real, untyped effective) -> untyped

  def zr_proc_setgroups: (untyped ids) -> untyped

  def zr_proc_initgroups: (untyped user, untyped gid) -> untyped

