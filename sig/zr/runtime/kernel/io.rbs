module Zr::Kern
  def zr_errno: () -> untyped

  def zr_clear_errno: () -> untyped

  def zr_io_failed: (untyped r) -> untyped

  def zr_io_status: (untyped r) -> untyped

  # F_GETFL: the status flags of the descriptor, which show the mode it
  # was opened with. Each fcntl goes through `zr_os_fcntl`, which passes
  # the variadic argument of fcntl as each OS needs it.
  F_GETFL: 3

  def zr_io_flags: (untyped fd) -> untyped

  # Makes a descriptor return EAGAIN instead of waiting.
  F_SETFL: 4

  def zr_io_set_nonblock: (untyped fd, untyped on) -> untyped

  # F_SETFD and its one flag.
  F_SETFD: 2

  FD_CLOEXEC: 1

  def zr_io_cloexec: (untyped fd) -> untyped

  def zr_io_ioctl: (untyped fd, untyped command, untyped argument) -> untyped

  def zr_io_ioctl_buf: (untyped fd, untyped command, untyped bytes) -> untyped

  def zr_io_fcntl: (untyped fd, untyped command, untyped argument) -> untyped

  def zr_io_fcntl_bytes: (untyped fd, untyped command, untyped bytes) -> untyped

  def zr_io_open_flags: (untyped path, untyped flags, untyped perm) -> untyped

  def zr_io_read: (untyped fd, untyped count) -> untyped

  def zr_io_pread: (untyped fd, untyped count, untyped at) -> untyped

  def zr_io_pwrite: (untyped fd, untyped s, untyped at) -> untyped

  def zr_io_write: (untyped fd, untyped s) -> untyped

  def zr_io_write_some: (untyped fd, untyped s, untyped from, untyped count) -> untyped

  def zr_io_close: (untyped fd) -> untyped

  def zr_io_dup: (untyped fd) -> untyped

  def zr_io_dup2: (untyped from, untyped to) -> untyped

  def zr_io_fsync: (untyped fd) -> untyped

  def zr_io_seek: (untyped fd, untyped offset, untyped whence) -> untyped

  def zr_io_tty_p: (untyped fd) -> untyped

  # struct winsize: four unsigned shorts. The rows and the columns are
  # first.
  WINSIZE_LEN: 8

  def zr_io_winsize: (untyped fd) -> untyped

  def zr_io_set_winsize: (untyped fd, untyped bytes) -> untyped

  def zr_io_termios: (untyped fd) -> untyped

  def zr_io_set_termios: (untyped fd, untyped action, untyped bytes) -> untyped

  def zr_io_tcflush: (untyped fd, untyped queue) -> untyped

  def zr_pty_open: () -> untyped

  def zr_io_ttyname: (untyped fd) -> untyped

  def zr_io_unlink: (untyped path) -> untyped

  def zr_io_rename: (untyped from, untyped to) -> untyped

  def zr_io_mkdir: (untyped path, untyped mode) -> untyped

  def zr_io_rmdir: (untyped path) -> untyped

  def zr_io_chdir: (untyped path) -> untyped

  def zr_io_dir_names: (untyped path) -> untyped

  def zr_io_dir_kinds: (untyped path) -> untyped

  def zr_io_pathconf: (untyped path, untyped name) -> untyped

  def zr_io_fpathconf: (untyped fd, untyped name) -> untyped

  def zr_io_dir_names_fd: (untyped fd) -> untyped

  def zr_io_fchdir: (untyped fd) -> untyped

  def zr_io_chroot: (untyped path) -> untyped

  def zr_io_strerror: (untyped n) -> untyped

  def zr_io_file_size: (untyped path) -> untyped

  def zr_fs_call: (untyped which, untyped path, untyped a, untyped b) -> untyped

  def zr_utimens_m: (untyped path, untyped times, untyped link) -> untyped

  def zr_umask_m: (untyped mask) -> untyped

  def zr_readlink_m: (untyped path) -> untyped

  def zr_stat_m: (untyped path, untyped follow) -> untyped

  def zr_fstat_m: (untyped fd) -> untyped

  def zr_realpath_m: (untyped path) -> untyped

  def zr_chmod_m: (untyped path, untyped mode) -> untyped

  def zr_path_access: (untyped path, untyped mode) -> untyped

  # The bits in `events`: IO::READABLE, IO::PRIORITY, IO::WRITABLE.
  WAIT_READABLE: 1

  WAIT_PRIORITY: 2

  WAIT_WRITABLE: 4

  def zr_io_wait_fds: (untyped fds, untyped events, untyped milliseconds) -> untyped

  def zr_io_wait: (untyped fd, untyped events, untyped milliseconds) -> untyped
end
