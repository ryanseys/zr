module Zr::Kern
  # Ryu's tables, generated by a Ruby script from exact powers of five:
  # DOUBLE_POW5_INV_SPLIT (342 rows) and DOUBLE_POW5_SPLIT (326 rows),
  # each row a 128-bit value as two little-endian words.
  RYU_POW5_INV_ROWS: 342

  RYU_POW5_ROWS: 326

  def zr_ryu_pow5_inv: () -> untyped

  def zr_ryu_pow5: () -> untyped
end
