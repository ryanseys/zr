module Zr::Kern
  FfiPrepCif: untyped

  FfiPrepCifVar: untyped

  FfiCall: untyped

  FfiClosureAlloc: untyped

  FfiPrepClosureLoc: untyped

  FfiClosureFree: untyped

  CWords: untyped

  CWordsF64: untyped

  RTLD_LAZY: 1

  # The callable that a closure runs, and the pending unwind that a
  # callback left. The pending unwind waits until the C call that ran the
  # callback returns.
  G_FFI_CALLBACK: 58

  G_FFI_UNWIND: 59

  # The callable that the callback entries below run.
  G_C_CALLBACK: 62

  # sizeof(ffi_closure) on arm64.
  FFI_CLOSURE_SIZE: 40

  def zr_ffi_ptr: (untyped addr) -> untyped

  def zr_ffi_addr: (untyped p) -> untyped

  def zr_ffi_image: () -> untyped

  def zr_ffi_fn: (untyped cell, untyped name) -> untyped

