  def zr_ffi_call: (untyped cif, untyped fn, untyped rvalue, untyped avalues) -> untyped

  def zr_ffi_resume: (untyped outer) -> (false | true)

  def zr_ffi_park: () -> untyped

  def zr_ffi_set_errno: (untyped n) -> untyped

  def zr_ffi_callback_set: (untyped callable) -> untyped

  def zr_ffi_closure: (untyped cif, untyped id) -> untyped

  def zr_ffi_closure_free: (untyped closure) -> untyped

  def zr_ffi_closure_run: (untyped cif, untyped ret, untyped args, untyped user) -> untyped

  def zr_c_call: (untyped fn, untyped args) -> untyped

