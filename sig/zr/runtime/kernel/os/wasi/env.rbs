module Zr::Kern
  def zr_os_ruby_platform: () -> untyped

  def zr_wasi_table: (untyped raw, untyped count, untyped extra) -> untyped

  def zr_os_argv: (untyped argc, untyped argv) -> untyped

  def zr_os_environ: () -> untyped

  def zr_wasi_env_row: (untyped name) -> untyped

  def getenv: (untyped name) -> untyped

  def setenv: (untyped name, untyped value, untyped overwrite) -> untyped

  def unsetenv: (untyped name) -> untyped

  def zr_os_random: () -> untyped

  def zr_os_passwd_row: (untyped pw) -> untyped

  def zr_os_passwd_dir: (untyped pw) -> untyped

  # musl's sysconf name for the processor count.
  SC_NPROCESSORS_ONLN: 84

  # `_SC_PAGESIZE` and `_SC_PHYS_PAGES`. wasi has neither. The names are
  # here only so that `Etc.sysconf` has a name to use.
  SC_PAGESIZE: 30

  SC_PHYS_PAGES: 85

  def zr_os_machine_bytes: () -> 0

  # musl's utsname: six fields of 65 bytes: sysname, nodename, release,
  # version, machine and domainname.
  UTSNAME_LEN: 390

  UTSNAME_FIELD: 65

  # A module starts no process and changes no id. zr_posix_spawn, which a
  # module never calls, uses these sizes for its structures.
  SPAWN_ACTIONS_LEN: 16

  SPAWN_ATTR_LEN: 16

  def zr_os_spawn: (untyped words, untyped dups, untyped closes, untyped env, untyped chdir) -> untyped

  def zr_os_setid: (untyped call, untyped id) -> untyped

  def zr_os_issetugid: () -> untyped

  def getpid: () -> untyped

  def getppid: () -> untyped

  def getuid: () -> untyped

  def geteuid: () -> untyped

  def getgid: () -> untyped

  def getegid: () -> untyped

  def exit: (untyped code) -> untyped

  def _exit: (untyped code) -> untyped

  def zr_wasi_timespec: (untyped ts, untyped ns) -> untyped

  # WASI's clock ids: 0 real time, 1 monotonic, 2 the process's CPU time,
  # 3 the thread's CPU time. Process's CLOCK_IDS gives their ruby names.
  CLOCK_MONOTONIC: 1

  def clock_gettime: (untyped id, untyped ts) -> untyped

  def clock_getres: (untyped id, untyped ts) -> untyped

  def nanosleep: (untyped req, untyped rem) -> untyped

  def tzset: () -> nil

  def localtime_r: (untyped t, untyped tm) -> untyped

  def zr_wasi_year_day: (untyped year, untyped month, untyped mday) -> untyped
end
