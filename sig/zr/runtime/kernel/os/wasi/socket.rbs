module Zr::Kern
  # The WASI part of the socket calls. WASI preview 1 has no sockets. The
  # constants are wasi-libc's values. The calls that read a resolver
  # result or a peer address find nothing.
  EPROTOTYPE: 67

  EAI_SYSTEM: untyped

  # wasi-libc's struct msghdr. No call in this file fills it.
  MSGHDR_LEN: 28

  MSGHDR_FLAGS: 24

  def zr_os_sockaddr_len: (untyped addr) -> (16 | 28 | untyped)

  def zr_os_addrinfo_row: (untyped node) -> untyped

  def zr_os_addrinfo_next: (untyped node) -> untyped

  def zr_os_h_errno: () -> 0

  def zr_os_peereid: (untyped fd) -> untyped
end
