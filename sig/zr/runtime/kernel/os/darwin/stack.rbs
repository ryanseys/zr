module Zr::Kern
  def zr_os_main: (untyped argc, untyped argv) -> untyped

  def zr_os_stack_low: () -> (0 | untyped)

  def zr_os_stack_high: () -> untyped

  # PROT_READ | PROT_WRITE, and MAP_PRIVATE | MAP_ANON.
  STACK_PROT: 3

  STACK_MAP_FLAGS: 4098

  # The guard at the bottom of each fiber stack, which faults on access:
  # one page on arm64 macOS.
  STACK_GUARD_BYTES: 16384

  def zr_os_stack_map: (untyped bytes) -> untyped

  def zr_poll_timer: (untyped arg) -> untyped

  def zr_os_poll_start: () -> (nil | untyped)
end
