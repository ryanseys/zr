module Zr::Kern
  def zr_os_errno: () -> untyped

  def zr_os_set_errno: (untyped n) -> untyped

  EINTR: 4

  EBADF: 9

  # The *at calls' directory for the working directory, and their flag
  # for a link itself.
  AT_FDCWD: untyped

  AT_SYMLINK_NOFOLLOW: 32

  def zr_os_fcntl: (untyped fd, untyped command, untyped argument) -> untyped

  def zr_os_ioctl: (untyped fd, untyped request, untyped argument) -> untyped

  def zr_os_open: (untyped path, untyped flags, untyped mode) -> untyped

  def zr_os_realpath: (untyped path) -> untyped

  O_NONBLOCK: 4

  # All flags except O_NONBLOCK. A mask with it clears the flag.
  O_NONBLOCK_OFF: 4294967291

  # Each descriptor that ruby opens is close-on-exec. rb_sysopen sets
  # O_CLOEXEC in the open call itself.
  O_CLOEXEC: 16777216

  # O_RDWR | O_NOCTTY | O_CLOEXEC: the pty pair does not become this
  # process's controlling terminal.
  PTY_OPEN_FLAGS: 16908290

  TIOCGWINSZ: 1074295912

  # TIOCSCTTY: makes the descriptor the session's controlling terminal.
  TIOCSCTTY: 536900705

  TIOCSWINSZ: 2148037735

  # struct termios: four flag words, twenty control characters, and the
  # two speeds. ruby gets the bytes without change, because ruby selects
  # the flags that a mode changes.
  TERMIOS_LEN: 72

  def zr_os_dirent_name: (untyped entry) -> untyped

  def zr_os_dirent_kind: (untyped entry) -> (0 | 1 | 2 | 3)

  # darwin's 64-bit-inode struct stat.
  STAT_LEN: 160

  def zr_os_stat_rows: (untyped buf) -> untyped

  def zr_os_stat_size: (untyped buf) -> untyped

  def zr_os_stat_mode: (untyped buf) -> untyped

  # Darwin's select(2) with no FD_SETSIZE limit, which CRuby calls (it
  # builds with _DARWIN_UNLIMITED_SELECT). Plain `select` refuses more
  # than 1024 descriptors, and poll(2) on darwin reports a pipe with data
  # as priority-readable. Thus neither one gives CRuby's result.
  SelectCall: untyped

  def zr_select_fn: () -> untyped

  def zr_os_wait_fds: (untyped fds, untyped events, untyped milliseconds) -> untyped

  def zr_os_wait_fd: (untyped fd, untyped events, untyped milliseconds) -> untyped
end
