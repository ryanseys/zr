module Zr::Kern
  def zr_os_argv: (untyped argc, untyped argv) -> untyped

  def zr_os_ruby_platform: () -> untyped

  def zr_os_environ: () -> untyped

  def zr_os_random: () -> untyped

  def zr_os_passwd_row: (untyped pw) -> untyped

  def zr_os_passwd_dir: (untyped pw) -> untyped

  # `_SC_NPROCESSORS_ONLN`.
  SC_NPROCESSORS_ONLN: 84

  # `_SC_PAGESIZE` and `_SC_PHYS_PAGES`, which give the machine's memory.
  SC_PAGESIZE: 30

  SC_PHYS_PAGES: 85

  def zr_os_machine_bytes: () -> untyped

  # The monotonic clock, with its clock_gettime(2) number.
  CLOCK_MONOTONIC: 1

  # Linux's utsname: six fields of 65 bytes each: sysname, nodename,
  # release, version, machine and domainname.
  UTSNAME_LEN: 390

  UTSNAME_FIELD: 65

  # musl's posix_spawn_file_actions_t and posix_spawnattr_t are structures
  # in the caller's memory. A spawned child keeps only the descriptors that
  # are not close-on-exec. ruby opens each descriptor close-on-exec, so no
  # more flags are necessary.
  SPAWN_ACTIONS_LEN: 80

  SPAWN_ATTR_LEN: 336

  def zr_os_spawn: (untyped words, untyped dups, untyped closes, untyped env, untyped chdir) -> untyped

  def zr_os_setid: (untyped call, untyped id) -> untyped

  def zr_os_issetugid: () -> untyped
end
