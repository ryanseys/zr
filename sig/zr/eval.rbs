# The types of lib/zr/eval.rb that inline RBS cannot give. Its methods
# are inline.
module Zr
  class Eval
    self.@current: Eval?
    self.@backend: singleton(Eval)?
    self.@walk_metas: Hash[Array[untyped], Integer?]?
    self.@walk_trees: Hash[Array[untyped], Hir::Program]?
  end

  module Machine
    class Description
      # The kernel rows, which the generated file "zr_description" defines
      # in a program that evals (lib/zr/machine/description.rb).
      KERNEL: String
    end
  end
end
