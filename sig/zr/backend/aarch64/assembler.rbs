# The records of lib/zr/backend/aarch64/assembler.rb. Their methods are
# inline.
module Zr
  module Backend
    module Aarch64
      class Assembler
        # A memory operand: a base register and a byte offset, or the base
        # alone for the post-indexed form.
        type address = [Registers::Register, Integer] | [Registers::Register]

        # A register operand, or an immediate.
        type operand = Registers::Register | Integer

        # A branch target: a label, or a distance in instructions.
        type target = Label | Integer

        # An encoded word, or a record that encodes after layout.
        type word = Integer | Branch | Adr | TableWord

        class Branch < Data
          attr_reader base: Integer
          attr_reader label: Label
          attr_reader shift: Integer
          attr_reader bits: Integer

          def self.new: (Integer base, Label label, Integer shift, Integer bits) -> instance
                      | (base: Integer, label: Label, shift: Integer, bits: Integer) -> instance
        end

        class Adr < Data
          attr_reader d: Registers::Register
          attr_reader label: Label

          def self.new: (Registers::Register d, Label label) -> instance
                      | (d: Registers::Register, label: Label) -> instance
        end

        class TableWord < Data
          attr_reader label: Label
          attr_reader base: Label

          def self.new: (Label label, Label base) -> instance
                      | (label: Label, base: Label) -> instance
        end
      end
    end
  end
end
