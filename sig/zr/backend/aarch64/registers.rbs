# The registers that lib/zr/backend/aarch64/registers.rb makes with
# `const_set`, which inline RBS cannot see. SP, WSP, XZR and WZR are
# plain constants there, and inline.
module Zr
  module Backend
    module Aarch64
      module Registers
        X0: Register
        X1: Register
        X2: Register
        X3: Register
        X4: Register
        X5: Register
        X6: Register
        X7: Register
        X8: Register
        X9: Register
        X10: Register
        X11: Register
        X12: Register
        X13: Register
        X14: Register
        X15: Register
        X16: Register
        X17: Register
        X18: Register
        X19: Register
        X20: Register
        X21: Register
        X22: Register
        X23: Register
        X24: Register
        X25: Register
        X26: Register
        X27: Register
        X28: Register
        X29: Register
        X30: Register

        W0: Register
        W1: Register
        W2: Register
        W3: Register
        W4: Register
        W5: Register
        W6: Register
        W7: Register
        W8: Register
        W9: Register
        W10: Register
        W11: Register
        W12: Register
        W13: Register
        W14: Register
        W15: Register
        W16: Register
