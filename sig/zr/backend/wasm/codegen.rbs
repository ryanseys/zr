# The records of lib/zr/backend/wasm/codegen.rb. Their methods are
# inline.
module Zr
  module Backend
    module Wasm
      class Codegen
        class Import < Data
          attr_reader from: String
          attr_reader name: String
          attr_reader params: Array[Integer]
          attr_reader results: Array[Integer]

          def self.new: (String from, String name, Array[Integer] params, Array[Integer] results) -> instance
                      | (from: String, name: String, params: Array[Integer], results: Array[Integer]) -> instance
        end

        class Prelude < Data
          attr_reader imports: Array[Import]
          attr_reader shims: untyped
          attr_reader sigs: Hash[String, untyped]
          attr_reader bodies: untyped
          attr_reader types: untyped
          attr_reader data_at: untyped
          attr_reader data_end: Integer
          attr_reader segments: untyped
          attr_reader table: untyped
          attr_reader pending: untyped

          def self.new: (*untyped) -> instance
                      | (**untyped) -> instance
        end
      end
    end
  end
end
