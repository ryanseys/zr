  module Cache
    class Lowering
      class Piece < Struct[untyped]
        attr_accessor path: String?
        attr_accessor entry: String
        attr_accessor key: String?
        attr_accessor weight: Integer
        # `Lower#run`'s type: with no block, the functions are all IR.
        attr_accessor make: ^() -> [Array[IR::Function | Obj::Code], Array[Obj::Datum]]

        def self.new: (String? path, String entry, String? key, Integer weight, ^() -> [Array[IR::Function | Obj::Code], Array[Obj::Datum]] make) -> instance
