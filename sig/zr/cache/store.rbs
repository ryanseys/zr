# The records of lib/zr/cache/store.rb.
module Zr
  module Cache
    module Store
      class Kind < Data
        attr_reader name: Symbol
        attr_reader codec: Symbol
        attr_reader ext: String
        attr_reader quota_gb: Integer?

        def self.new: (Symbol name, Symbol codec, String ext, Integer? quota_gb) -> instance
                    | (name: Symbol, codec: Symbol, ext: String, quota_gb: Integer?) -> instance
      end

      class Entry < Data
        attr_reader kind: Kind
        attr_reader key: String
        attr_reader path: String
        attr_reader bytes: Integer
        attr_reader mtime: untyped

        def self.new: (Kind kind, String key, String path, Integer bytes, untyped mtime) -> instance
                    | (kind: Kind, key: String, path: String, bytes: Integer, mtime: untyped) -> instance
      end
    end
  end
end
