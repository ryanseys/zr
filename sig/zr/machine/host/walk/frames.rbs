# The records of lib/zr/machine/host/walk/frames.rb. Their methods are
# inline.
module Zr
  module Machine
    class Host
      class Walk
        class Scope < Data
          attr_reader node: untyped
          attr_reader unit: Unit
          attr_reader def_node: Hir::Def?
          attr_reader kind: Symbol
          attr_reader scopes: Array[Array[Symbol]]
          attr_reader homes: Array[untyped]
          attr_reader meta: Integer
          attr_reader params: Hir::Params?
          attr_reader in_env: bool
          attr_reader line: Integer
          attr_reader values: Integer
          attr_reader blank: Array[Integer]
          attr_reader names: Integer
          attr_reader loops: Array[untyped]
          attr_reader rescues: Array[Integer]

          def self.new: (*untyped) -> instance
                      | (**untyped) -> instance
        end

        # `env` is nil when the locals are in the record, and `block_proc` is
        # nil but in a block's run.
        class Frame < Struct[untyped]
          attr_accessor rec: Integer
          attr_accessor env: Integer?
          attr_accessor self_: Integer
          attr_accessor cref: Integer
          attr_accessor blk: Integer
          attr_accessor block_proc: Integer?
          attr_accessor outer: Integer
          attr_accessor stack: Stack
          attr_accessor opened: Symbol?
          attr_accessor ret_line: Integer?

          def self.new: (*untyped) -> instance
        end
      end
    end
  end
end
