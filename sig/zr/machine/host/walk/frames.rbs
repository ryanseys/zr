# The records of lib/zr/machine/host/walk/frames.rb. Their methods are
# inline.
module Zr
  module Machine
    class Host
      class Walk
        class Scope < Data
          attr_reader node: untyped
          attr_reader unit: Unit
          attr_reader def_node: untyped
          attr_reader kind: untyped
          attr_reader scopes: untyped
          attr_reader homes: untyped
          attr_reader meta: untyped
          attr_reader params: untyped
          attr_reader open: untyped
          attr_reader line: untyped
          attr_reader values: untyped
          attr_reader blank: untyped
          attr_reader names: untyped
          attr_reader loops: Array[untyped]

          def self.new: (*untyped) -> instance
                      | (**untyped) -> instance
        end

        class Frame < Struct[untyped]
          attr_accessor rec: untyped
          attr_accessor env: untyped
          attr_accessor self_: untyped
          attr_accessor cref: untyped
          attr_accessor blk: untyped
          attr_accessor proc: untyped
          attr_accessor outer: untyped
          attr_accessor stack: untyped
          attr_accessor opened: untyped
          attr_accessor ret_line: untyped

          def self.new: (*untyped) -> instance
        end
      end
    end
  end
end
