# The records of lib/zr/machine/description.rb. A kernel type is its
# name: "Word", "Value", "Ptr", "I32", "I8", "Bool", "F64" or "Void".
module Zr
  module Machine
    class Import < Data
      attr_reader name: String
      attr_reader params: Array[String]
      attr_reader ret: String
      attr_reader from: String?

      def self.new: (String name, Array[String] params, String ret, String? from) -> instance
                  | (name: String, params: Array[String], ret: String, from: String?) -> instance
    end

    class Def < Struct[untyped]
      attr_accessor name: String
      attr_accessor params: Array[[untyped, String]]
      attr_accessor ret: String
      attr_accessor node: untyped
      attr_accessor file: String
      attr_accessor effects: Integer?

      def self.new: (String name, Array[[untyped, String]] params, String ret, untyped node, String file, ?Integer? effects) -> instance
    end

    class Raw < Data
      attr_reader name: String
      attr_reader params: Array[String]
      attr_reader ret: String

      def self.new: (String name, Array[String] params, String ret) -> instance
                  | (name: String, params: Array[String], ret: String) -> instance
    end

    class Signature < Data
      attr_reader name: untyped
      attr_reader params: Array[String]
      attr_reader ret: String

      def self.new: (untyped name, Array[String] params, String ret) -> instance
                  | (name: untyped, params: Array[String], ret: String) -> instance
    end

    class Layout < Data
      attr_reader name: untyped
      attr_reader fields: Hash[untyped, [Integer, String]]
      attr_reader size: Integer
      attr_reader align: Integer

      def self.new: (untyped name, Hash[untyped, [Integer, String]] fields, Integer size, Integer align) -> instance
                  | (name: untyped, fields: Hash[untyped, [Integer, String]], size: Integer, align: Integer) -> instance
    end
  end
end
