# The records of lib/zr/machine/function.rb. IR names are Strings.
module Zr
  module Machine
    class Function
      # `enter_roots` sets `count` and `fill_at` just after it makes the
      # record.
      class Roots < Struct[untyped]
        attr_accessor slot: String
        attr_accessor addr: String
        attr_accessor n: Integer
        attr_accessor zero: String
        attr_accessor count: IR::Inst
        attr_accessor fill_at: Integer

        def self.new: (slot: String, addr: String, n: Integer, zero: String, ?count: IR::Inst, ?fill_at: Integer) -> instance
      end

      class Exit < Struct[untyped]
        attr_accessor type: String
        attr_accessor block: String?
        attr_accessor value: String?

        def self.new: (type: String, ?block: String?, ?value: String?) -> instance
      end
    end
  end
end
