# The records of lib/zr/machine/host.rb. Their methods are inline.
module Zr
  module Machine
    class Host
      class Type < Data
        attr_reader name: String
        attr_reader size: Integer
        attr_reader fiddle: Integer
        attr_reader packing: String?
        attr_reader loads: Symbol?
        attr_reader stores: Symbol?

        def self.new: (String name, Integer size, Integer fiddle, String? packing, Symbol? loads, Symbol? stores) -> instance
                    | (name: String, size: Integer, fiddle: Integer, packing: String?, loads: Symbol?, stores: Symbol?) -> instance
      end

      class Stack < Struct[untyped]
        attr_accessor top: Integer
        attr_accessor low: Integer
        attr_accessor pins: untyped
        attr_accessor depth: Integer
        attr_accessor roots: Integer
        attr_accessor rooted: untyped
        attr_accessor frames: untyped

        def self.new: (*untyped) -> instance
      end

      class Framing < Data
        attr_reader restores: untyped
        attr_reader drops: untyped
        attr_reader value: untyped
        attr_reader roots: untyped
        attr_reader params: untyped

        def self.new: (*untyped) -> instance
                    | (**untyped) -> instance
      end
    end
  end
end
