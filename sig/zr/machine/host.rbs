# The records of lib/zr/machine/host.rb. Their methods are inline.
module Zr
  module Machine
    class Host
      class Type < Data
        attr_reader name: String
        attr_reader size: Integer
        attr_reader fiddle: Integer
        attr_reader packing: String?
        attr_reader loads: Symbol?
        attr_reader stores: Symbol?

        def self.new: (String name, Integer size, Integer fiddle, String? packing, Symbol? loads, Symbol? stores) -> instance
                    | (name: String, size: Integer, fiddle: Integer, packing: String?, loads: Symbol?, stores: Symbol?) -> instance
      end

      class Stack < Struct[untyped]
        attr_accessor top: Integer
        attr_accessor low: Integer
        attr_accessor pins: Array[Integer]
        attr_accessor depth: Integer
        attr_accessor roots: Integer
        attr_accessor rooted: bool
        attr_accessor frames: Array[[Binding, Array[Symbol]]]

        def self.new: (Integer top, Integer low, Array[Integer] pins, Integer depth, Integer roots, bool rooted,
                       Array[[Binding, Array[Symbol]]] frames) -> instance
      end

      class Framing < Data
        attr_reader restores: bool
        attr_reader drops: bool
        attr_reader value: bool
        attr_reader roots: bool
        attr_reader params: Array[Integer]

        def self.new: (bool restores, bool drops, bool value, bool roots, Array[Integer] params) -> instance
                    | (restores: bool, drops: bool, value: bool, roots: bool, params: Array[Integer]) -> instance
      end
    end
  end
end
