# The records of lib/zr/ir/function.rb. They are assigned to constants,
# which inline RBS cannot type. Block and Function are inline.
module Zr
  module IR
    class Slot < Struct[untyped]
      attr_accessor bytes: Integer
      attr_accessor align: Integer

      def self.new: (Integer bytes, Integer align) -> instance
    end

    class Global < Data
      attr_reader gv: String
      attr_reader symbol: String
      attr_reader colocated: bool

      def self.new: (String gv, String symbol, bool colocated) -> instance
    end

    class Sig < Data
      attr_reader sig: String
      attr_reader params: Array[String]
      attr_reader ret: String

      def self.new: (String sig, Array[String] params, String ret) -> instance
    end

    class Callee < Struct[untyped]
      attr_accessor fn: String
      attr_accessor symbol: String
      attr_accessor sig: String
      attr_accessor colocated: bool
      attr_accessor from: String?
      attr_accessor effects: Integer

      def self.new: (String fn, String symbol, String sig, bool colocated, String? from, Integer effects) -> instance
    end
  end
end
