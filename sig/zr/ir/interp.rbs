module Zr
  module IR
    # An interpreter for `IR::Function`. It gives a second result for each
    # program in the machine dialect, and does not use the aarch64 backend.
    # If it and the compiled binary give different results, the cause is a
    # miscompile. If both give the same wrong result, the cause is a
    # lowering bug.
    #
    # It models the machine that `Backend::Aarch64::Codegen` targets. Each
    # value is in a 64-bit slot, and each use reads the width of its own
    # type. So a narrowing that the backend does at the next load also
    # occurs at the next load here. Arithmetic on a type narrower than
    # `i64` is 32 bits wide, as in the w-registers. If the two differ, the
    # backend is correct and this file has the bug.
    class Interp
      @functions: untyped

      @raw: untyped

      @memory: untyped

      @types: untyped

      @data_at: untyped

      @code_at: untyped

      @symbol_at: untyped

      @depth: untyped

      @floor: untyped

      @sp: untyped

      @host: untyped

      MASK: { 8 => 255, 32 => 4294967295, 64 => untyped }

      BITS: { "i8" => 8, "i32" => 32, "i64" => 64, "f64" => 64 }

      # The Ruby operator of each float binary opcode.
      FLOAT_BINOPS: { fadd: :+, fsub: :-, fmul: :*, fdiv: :/ }

      # The stack for each program, and the deepest call chain that the Ruby
      # stack can hold.
      STACK: untyped

      DEPTH: 4096

      # The interpreter does not model this program.
      class Refused < StandardError
        include Zr::Refusal
      end

      # The program did an operation that no machine can do.
      class Trapped < StandardError
      end

      # The program called `abort`.
      class Aborted < Trapped
      end

      # The program called `exit`.
      class Exited < StandardError
        @status: untyped

        attr_reader status: untyped

        def initialize: (untyped status) -> void
      end

      # A flat byte-addressed store. Addresses are offsets into one string.
      # The first page is never allocated, so a null dereference traps as on
      # the machine.
      class Memory
        @bytes: untyped

        GUARD: 4096

        def initialize: () -> void

        # The next address at `align`, with `size` bytes of room after it.
        def reserve: (untyped size, ?::Integer align) -> untyped

        # Puts `string` in memory, at its own address.
        def place: (untyped string, ?::Integer align) -> untyped

        def read: (untyped addr, untyped width) -> untyped

        def write: (untyped addr, untyped width, untyped value) -> untyped

        # The `len` bytes at `addr`, for a host call that takes a buffer.
        def slice: (untyped addr, untyped len) -> untyped

        PACK: { 1 => "C", 4 => "L<", 8 => "Q<" }

        private

        def grow: (untyped size) -> (untyped | nil)

        def reach: (untyped addr, untyped width) -> (nil | untyped)
      end

      # The libSystem calls that a machine-dialect program makes. All calls
      # that it can reach are here. Any other call is refused, with a message
      # that gives the name.
      class Host
        @memory: untyped

        @io: untyped

        def initialize: (untyped memory, ?out: untyped, ?err: untyped) -> void

        def knows?: (untyped name) -> untyped

        def call: (untyped name, untyped args) -> untyped

        def sys_write: (untyped fd, untyped buf, untyped len) -> untyped

        def sys_exit: (untyped status) -> untyped

        def sys_abort: () -> untyped

        # Anonymous pages only, which is all that the collector needs.
        def sys_mmap: (untyped _addr, untyped len, untyped _prot, untyped _flags, untyped _fd, untyped _offset) -> untyped

        CALLS: { "write" => :sys_write, "exit" => :sys_exit, "_exit" => :sys_exit, "abort" => :sys_abort, "mmap" => :sys_mmap }
      end

      # The state of one call: the values it defined, and the addresses of
      # its stack slots.
      Frame: untyped

      attr_reader memory: untyped

      # `functions` are `IR::Function`s and `data` is `Obj::Datum`. `raw`
      # names the raw functions. A raw function is machine code, not IR, so
      # a call to it is refused, with a message that gives the name.
      def initialize: (untyped functions, ?data: untyped, ?raw: untyped, ?out: untyped, ?err: untyped) -> void

      # Runs `main(argc, argv)` and returns the exit status as a shell sees
      # it: the argument of `exit`, or the return value of `main`.
      def run: (?untyped argv) -> untyped

      # The raw value that `name` returns for `args`. The numbers in and out
      # are the 64-bit words that the machine passes.
      def answer: (untyped name, ?untyped args) -> untyped

      private

      def place_data: (untyped data) -> untyped

      def relocate: (untyped data) -> untyped

      def patch: (untyped at, untyped reloc) -> untyped

      # Each function gets its own address, imports too, so `func_addr` and
      # an indirect call can refer to it.
      def place_code: (untyped names) -> untyped

      def address_of: (untyped symbol) -> untyped

      # `argv` as a NUL-terminated vector of NUL-terminated strings.
      def place_argv: (untyped argv) -> ::Array[untyped]

      def invoke: (untyped f, untyped args) -> untyped

      def types_of: (untyped f) -> untyped

      # Makes the frame: puts its stack slots in memory and binds its
      # parameters to the arguments, each narrowed to the parameter type.
      def enter: (untyped f, untyped t, untyped args) -> untyped

      def walk: (untyped f, untyped frame, untyped t) -> untyped

      # Runs a block. Returns its successor, or the return value of the function.
      def run_block: (untyped block, untyped frame, untyped t) -> (::Array[nil | untyped | true] | ::Array[untyped | nil | false] | untyped)

      # Copies the block arguments to its parameters. It reads all sources
      # before it writes a parameter: a parallel copy, as in the backend.
      def jump: (untyped frame, untyped t, untyped target) -> untyped

      # Reads a value from its 64-bit slot, as its own type.
      def read: (untyped frame, untyped v) -> untyped

      def assign: (untyped frame, untyped v, untyped raw) -> untyped

      def narrow: (untyped raw, untyped type) -> untyped

      # The signed value of `raw`, which contains `bits` of a value.
      def signed: (untyped raw, untyped bits) -> untyped

      def round_up: (untyped n, untyped a) -> untyped

      # An operation on a type narrower than `i64` runs in a w-register. So
      # it is 32 bits wide, and the high bits of its result are zero.
      def width_of: (untyped frame, untyped v) -> (64 | 32)

      def to_f64: (untyped raw) -> untyped

      def to_bits: (untyped float) -> untyped

      def step: (untyped frame, untyped t, untyped i) -> untyped

      GATES: "zr_static_gates"

      def slot_index: (untyped name) -> untyped

      def step_load: (untyped frame, untyped i) -> untyped

      def step_store: (untyped frame, untyped i) -> untyped

      def compare: (untyped frame, untyped i) -> untyped

      # The two-operand integer instructions. Division by zero gives zero,
      # as `udiv` and `sdiv` do. A shift uses its amount modulo the width, as
      # the register forms do.
      def binop: (untyped frame, untyped i) -> untyped

      # Division that truncates toward zero, as on arm64. The Ruby `/`
      # operator rounds down, which is different.
      def quotient: (untyped a, untyped b) -> untyped

      def step_overflow: (untyped frame, untyped i) -> untyped

      # The bit operations, as wide as the operand. The count of zeros in
      # zero is the width.
      def bitop: (untyped frame, untyped i) -> untyped

      # `fcvt_to_sint_sat` saturates and gives zero for NaN, as `fcvtzs`
      # does. All other float instructions use Ruby on the same bits.
      def float_op: (untyped frame, untyped i) -> untyped

      def saturate: (untyped a) -> (0 | untyped)

      # All conditions except `ne` give false for an unordered pair. Ruby
      # comparisons also give false for NaN.
      def float_compare: (untyped frame, untyped i) -> untyped

      def step_call: (untyped frame, untyped t, untyped i) -> untyped

      def step_call_indirect: (untyped frame, untyped t, untyped i) -> untyped

      def apply: (untyped frame, untyped i, untyped symbol, untyped sig, ?untyped args) -> (nil | untyped)

      def dispatch: (untyped symbol, untyped args) -> untyped
    end
  end
end
