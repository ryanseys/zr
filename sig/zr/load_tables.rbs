# lib/zr/load_tables.rb. A Data record assigned to a constant, which
# inline RBS cannot type.
module Zr
  class LoadTables < Data
    attr_reader evals: bool
    attr_reader spots: Hash[String, String]
    attr_reader coverable: Hash[String, [Integer, Array[Integer]]]
    attr_reader branches: Hash[String, Array[Array[untyped]]]
    attr_reader defs: Hash[String, Array[Array[untyped]]]
    attr_reader sources: Hash[String, String]
    attr_reader target: Target
    attr_reader gem_roots: Array[String]
    attr_reader manifest: String?

    def self.new: (?evals: bool, ?spots: Hash[String, String], ?coverable: Hash[String, [Integer, Array[Integer]]],
                   ?branches: Hash[String, Array[Array[untyped]]], ?defs: Hash[String, Array[Array[untyped]]],
                   ?sources: Hash[String, String], ?target: Target, ?gem_roots: Array[String], ?manifest: String?) -> instance

    def initialize: (?evals: bool, ?spots: Hash[String, String], ?coverable: Hash[String, [Integer, Array[Integer]]],
                     ?branches: Hash[String, Array[Array[untyped]]], ?defs: Hash[String, Array[Array[untyped]]],
                     ?sources: Hash[String, String], ?target: Target, ?gem_roots: Array[String], ?manifest: String?) -> void

    def data: (?Array[[String, String]] units) -> Array[Obj::Datum]
    def texts: () -> Array[Array[String]]
  end
end
