# The record of lib/zr/load_tables.rb. A Data record assigned to a
# constant, which inline RBS cannot type; its methods are inline.
module Zr
  class LoadTables < Data
    attr_reader computed: bool
    attr_reader gems: bool
    attr_reader spots: Hash[String, String]
    attr_reader coverable: Hash[String, [Integer, Array[Integer]]]
    attr_reader branches: Hash[String, Array[Array[untyped]]]
    attr_reader defs: Hash[String, Array[Array[untyped]]]
    attr_reader sources: Hash[String, String]
    attr_reader target: Target
    attr_reader gem_roots: Array[String]
    attr_reader manifest: String?
    attr_reader redirects: Hash[String, String]

    def self.new: (?computed: bool, ?spots: Hash[String, String], ?coverable: Hash[String, [Integer, Array[Integer]]],
                   ?branches: Hash[String, Array[Array[untyped]]], ?defs: Hash[String, Array[Array[untyped]]],
                   ?sources: Hash[String, String], ?target: Target, ?gem_roots: Array[String], ?manifest: String?,
                   ?redirects: Hash[String, String], ?gems: bool) -> instance
  end
end
