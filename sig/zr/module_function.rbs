# The modules of lib/ that call `module_function`. Inline RBS sees their
# defs as instance methods only, so `Bytes.align` would have no type.
# Each module extends itself here, which gives its module functions the
# inline types of its instance methods. test/unit/steepfile_test.rb
# checks that this list names every such module.
module Zr::Backend::Aarch64
  extend Zr::Backend::Aarch64
end

module Zr::Backend::Aarch64::Registers
  extend Zr::Backend::Aarch64::Registers
end

module Zr::Backend::Aarch64::Stub
  extend Zr::Backend::Aarch64::Stub
end

