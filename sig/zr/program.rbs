# The fields of the record in lib/zr/program.rb. Its methods are inline.
module Zr
  class Program < Data
    attr_reader runtime: untyped
    attr_reader functions: Array[Obj::Code]
    attr_reader data: Array[Obj::Datum]
    attr_reader evals: untyped
    attr_reader sources: Hash[String, String]
    attr_reader gems: Array[untyped]

    def self.new: (runtime: untyped, functions: Array[Obj::Code], data: Array[Obj::Datum], evals: untyped,
                   ?sources: Hash[String, String], ?gems: Array[untyped]) -> instance
  end
end
