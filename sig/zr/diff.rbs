# The record of lib/zr/diff.rb. Its methods are inline.
module Zr
  module Diff
    class Answer < Struct[untyped]
      attr_accessor stdout: String
      attr_accessor stderr: String
      attr_accessor status: untyped
      attr_accessor signal: untyped
      attr_accessor timeout: bool?

      def self.new: (String stdout, String stderr, untyped status, untyped signal, ?bool? timeout) -> instance
    end
  end
end
