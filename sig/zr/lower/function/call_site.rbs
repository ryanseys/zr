# lib/zr/lower/function/call_site.rb. A Data record assigned to a
# constant, which inline RBS cannot type.
module Zr
  class Lower
    class Function
      class CallSite < Data
        attr_reader node: untyped
        attr_reader cc: String?
        attr_reader recv: String
        attr_reader entry: String?
        attr_reader argv: Array[String]?
        attr_reader merge: String

        def self.new: (node: untyped, recv: String, argv: Array[String]?, merge: String, ?cc: String?, ?entry: String?) -> instance
        def initialize: (node: untyped, recv: String, argv: Array[String]?, merge: String, ?cc: String?, ?entry: String?) -> void
      end
    end
  end
end
