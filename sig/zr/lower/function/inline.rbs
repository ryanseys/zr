# The record of lib/zr/lower/function/inline.rb: the value of each
# parameter by name, and the return and bail blocks.
module Zr
  class Lower
    class Function
      module Inline
        class Site < Data
          attr_reader locals: Hash[Symbol, String]
          attr_reader done: String
          attr_reader bail: String

          def self.new: (Hash[Symbol, String] locals, String done, String bail) -> instance
                      | (locals: Hash[Symbol, String], done: String, bail: String) -> instance
        end
      end
    end
  end
end
