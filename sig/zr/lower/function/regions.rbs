# The fields of the record in lib/zr/lower/function/regions.rb. An
# ensure body is a node or a lowering Proc. `outer` is the inline scope
# and line record of an inline loop. An inline loop's region has no
# `slot` (nil), and nothing reads it there, so the reader types it as
# an Integer.
module Zr
  class Lower
    class Function
      module Regions
        type ensure_body = Hir::node | ^() -> String

        class Region < Data
          attr_reader landing: String
          attr_reader ensure_body: ensure_body?
          attr_reader slot: Integer
          attr_reader outer: [Iterators::InlineScope?, String?]?

          def self.new: (String landing, ensure_body? ensure_body, Integer? slot, ?[Iterators::InlineScope?, String?]? outer) -> instance
                      | (landing: String, ensure_body: ensure_body?, slot: Integer?, ?outer: [Iterators::InlineScope?, String?]?) -> instance
        end
      end
    end
  end
end
