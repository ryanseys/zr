# The records of lib/zr/obj/macho/object_file.rb. Their methods are
# inline.
module Zr
  module Obj
    module MachO
      module ObjectFile
        class Placed < Data
          attr_reader item: Code | Datum
          attr_reader section: Integer
          attr_reader addr: Integer

          def self.new: (Code | Datum item, Integer section, Integer addr) -> instance
                      | (item: Code | Datum, section: Integer, addr: Integer) -> instance
        end

        # `symbols` holds two words for each symbol (`nlist_64`).
        class Read < Struct[untyped]
          attr_accessor sections: Array[Section]
          attr_accessor symbols: Array[Integer]
          attr_accessor strings: String

          def self.new: (sections: Array[Section], symbols: Array[Integer], strings: String) -> instance
        end

        class Section < Struct[untyped]
          attr_accessor name: String
          attr_accessor segment: String
          attr_accessor addr: Integer
          attr_accessor size: Integer
          attr_accessor align: Integer
          attr_accessor flags: Integer
          attr_accessor bytes: String?
          attr_accessor relocs: Array[Integer]

          def self.new: (name: String, segment: String, addr: Integer, size: Integer, align: Integer, flags: Integer, bytes: String?,
                         relocs: Array[Integer]) -> instance
        end

        class Laid < Data
          attr_reader sections: Array[SectionBuild]
          attr_reader symbols: Array[Sym]
          attr_reader strtab: String
          attr_reader vmsize: Integer
          attr_reader data_start: Integer
          attr_reader data_end: Integer
          attr_reader symoff: Integer
          attr_reader stroff: Integer
          attr_reader sizeofcmds: Integer
          attr_reader segment_cmd: Integer

          def self.new: (sections: Array[SectionBuild], symbols: Array[Sym], strtab: String, vmsize: Integer, data_start: Integer,
                         data_end: Integer, symoff: Integer, stroff: Integer, sizeofcmds: Integer, segment_cmd: Integer) -> instance
        end

        class SectionBuild < Struct[untyped]
          attr_accessor name: String
          attr_accessor seg: String
          attr_accessor flags: Integer
          attr_accessor bytes: String
          attr_accessor size: Integer
          attr_accessor align: Integer
          attr_accessor items: Array[[Code | Datum, Integer]]
          # `[address, words]` groups while `laid_out` collects them, then
          # the words.
          attr_accessor relocs: Array[untyped]
          attr_accessor addr: Integer
          attr_accessor offset: Integer
          attr_accessor reloff: Integer

          def self.new: (name: String, seg: String, flags: Integer, bytes: String, size: Integer, align: Integer,
                         items: Array[[Code | Datum, Integer]], relocs: Array[untyped], addr: Integer, offset: Integer,
                         reloff: Integer) -> instance
        end

        # `strx` is nil until `laid_out` sets it, before any reader.
        class Sym < Struct[untyped]
          attr_accessor name: String
          attr_accessor bare: String
          attr_accessor linkage: Symbol
          attr_accessor sect: Integer
          attr_accessor value: Integer
          attr_accessor type: Integer
          attr_accessor strx: Integer

          def self.new: (name: String, bare: String, linkage: Symbol, sect: Integer, value: Integer, type: Integer) -> instance
        end
      end
    end
  end
end
