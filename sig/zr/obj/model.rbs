# lib/zr/obj/model.rb. Its Struct records are assigned to constants,
# which inline RBS cannot type.
module Zr
  module Obj
    # A relocation kind (`Reloc#kind`). The comment on `Reloc` tells what
    # each does.
    type reloc_kind = :branch26 | :page21 | :pageoff12 | :got_page21 | :got_pageoff12 | :abs64
                    | :symid | :symval | :symbit | :site
    # The section of a datum (`Datum#section`).
    type section = :text_const | :data_const | :data | :bss
    # The linkage of a function or a datum.
    type linkage = :export | :local

    class Reloc < Struct[untyped]
      attr_accessor offset: Integer
      attr_accessor kind: reloc_kind
      attr_accessor symbol: String
      attr_accessor addend: Integer

      def self.new: (Integer offset, reloc_kind kind, String symbol, ?Integer addend) -> instance
      def initialize: (Integer offset, reloc_kind kind, String symbol, ?Integer addend) -> void
    end

    class Code < Struct[untyped]
      attr_accessor name: String
      attr_accessor bytes: String
      attr_accessor relocs: Array[Reloc]
      attr_accessor align: Integer
      attr_accessor linkage: linkage

      def self.new: (String name, String bytes, ?relocs: Array[Reloc], ?align: Integer, ?linkage: linkage) -> instance
      def initialize: (String name, String bytes, ?relocs: Array[Reloc], ?align: Integer, ?linkage: linkage) -> void
      def size: () -> Integer
    end

    # `bytes` is a String, or the size (an Integer) in a :bss section. The
    # code tells them apart by `section`, which a type cannot follow, so
    # `bytes` is untyped.
    class Datum < Struct[untyped]
      attr_accessor name: String
      attr_accessor section: section
      attr_accessor bytes: untyped
      attr_accessor relocs: Array[Reloc]
      attr_accessor align: Integer
      attr_accessor linkage: linkage

      def self.new: (String name, section section, untyped bytes, ?relocs: Array[Reloc], ?align: Integer, ?linkage: linkage) -> instance
      def initialize: (String name, section section, untyped bytes, ?relocs: Array[Reloc], ?align: Integer, ?linkage: linkage) -> void
      def size: () -> Integer
    end

    # An item that `JIT#layout` places: a Code or a Datum.
    interface _Placeable
      def align: () -> Integer
      def size: () -> Integer
    end

    # The system calls of `JIT` (lib/zr/obj/jit.rb): `JIT::Fiddle` or
    # `JIT::Runtime`.
    interface _JITHost
      def reserve: (Integer size) -> Integer?
      def release: (Integer at, Integer size) -> untyped
      def map: (Integer size, exec: bool, ?at: Integer?, ?near: Integer) -> Integer?
      def symbol: (String name) -> Integer
      def write_data: (Integer at, String bytes) -> untyped
      def write_code: (Integer at, String bytes) -> untyped
      def call: (Integer at) -> Integer
    end

    class Unit
      attr_reader functions: Array[Code]
      attr_reader data: Array[Datum]

      def initialize: () -> void
      def function: (String name, String bytes, ?relocs: Array[Reloc], ?align: Integer, ?linkage: linkage) -> self
      def datum: (String name, section section, untyped bytes, ?relocs: Array[Reloc], ?align: Integer, ?linkage: linkage) -> self
      def items: () -> Array[[Symbol, Code | Datum]]
      def imports: () -> Array[String]
    end
  end
end

# The `initialize` that `Struct.new` and `Data.define` give a record. A
# record's own `initialize` calls it with `super`. The core signatures do
# not declare it.
class Struct[E]
  def initialize: (*untyped, **untyped) -> void
end

class Data
  def initialize: (*untyped, **untyped) -> void
end
