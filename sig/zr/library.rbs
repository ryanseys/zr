module Zr
  # The library that a program's `require` reads, and where each part of it
  # is. Each file below lib/zr/library/ requires what it uses, so nothing
  # loads this file; it names the parts:
  #
  # - Layout (layout.rb): where vendor/ruby, the gem home and zr's own
  #   runtime/ext and runtime/lib are;
  # - Roots (roots.rb): the directories that a `require` searches, in
  #   order, and the names that the loader treats as the runtime's own;
  # - Ports (ports.rb): the gems with a C part that zr implements in Ruby;
  # - Vendor (vendor.rb): what vendor/ holds, the input of `zr-dev vendor`;
  # - Stdlib (stdlib.rb): the version of each gem in vendor/ruby, which
  #   `zr-dev vendor` writes.
  module Library
  end
end
