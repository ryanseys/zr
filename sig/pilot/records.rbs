# The types of the Data records that lib/ assigns to constants
# (`Name = Data.define(...)`). The inline form has no way to give their
# fields a type, so they are here, and their files are not inline.
module Zr
  class Lower
    class Function
      # IR names are Strings: a block is "block0", a value "v3".
      class Loop < Data
        attr_reader head: String
        attr_reader body: String
        attr_reader done: String
        attr_reader depth: Integer
        attr_reader step: String?

        def self.new: (head: String, body: String, done: String, depth: Integer, ?step: String?) -> instance
        def initialize: (head: String, body: String, done: String, depth: Integer, ?step: String?) -> void
      end

      class CallSite < Data
        attr_reader node: untyped
        attr_reader cc: String?
        attr_reader recv: String
        attr_reader entry: String?
        attr_reader argv: Array[String]?
        attr_reader merge: String

        def self.new: (node: untyped, recv: String, argv: Array[String]?, merge: String, ?cc: String?, ?entry: String?) -> instance
        def initialize: (node: untyped, recv: String, argv: Array[String]?, merge: String, ?cc: String?, ?entry: String?) -> void
      end
    end
  end

  class LoadTables < Data
    attr_reader evals: bool
    attr_reader spots: Hash[String, String]
    attr_reader coverable: Hash[String, [Integer, Array[Integer]]]
    attr_reader branches: Hash[String, Array[Array[untyped]]]
    attr_reader defs: Hash[String, Array[Array[untyped]]]
    attr_reader sources: Hash[String, String]
    attr_reader target: Target
    attr_reader gem_roots: Array[String]
    attr_reader manifest: String?

    def self.new: (?evals: bool, ?spots: Hash[String, String], ?coverable: Hash[String, [Integer, Array[Integer]]],
                   ?branches: Hash[String, Array[Array[untyped]]], ?defs: Hash[String, Array[Array[untyped]]],
                   ?sources: Hash[String, String], ?target: Target, ?gem_roots: Array[String], ?manifest: String?) -> instance

    def initialize: (?evals: bool, ?spots: Hash[String, String], ?coverable: Hash[String, [Integer, Array[Integer]]],
                     ?branches: Hash[String, Array[Array[untyped]]], ?defs: Hash[String, Array[Array[untyped]]],
                     ?sources: Hash[String, String], ?target: Target, ?gem_roots: Array[String], ?manifest: String?) -> void

    def data: (?Array[[String, String]] units) -> Array[Obj::Datum]
    def texts: () -> Array[Array[String]]
  end
end

# The `initialize` that `Struct.new` and `Data.define` give a record. A
# record's own `initialize` calls it with `super`. The core signatures do
# not declare it.
class Struct[E]
  def initialize: (*untyped, **untyped) -> void
end

class Data
  def initialize: (*untyped, **untyped) -> void
end
