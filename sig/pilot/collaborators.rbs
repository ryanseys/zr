# The classes that the checked files use and that no checked file
# defines. Each has only the members that a checked file uses.
module Zr
  module Refusal
  end

  class Config
    def self.current: () -> Config
    def linker: () -> String?
  end

  module Paths
    def self.shown: (String path) -> String
  end

  module Hir
    class Build
      PRELOADED: Array[String]
      UNSUPPORTED_LIBRARIES: Hash[String, Array[String]]

      def self.missing_features: (Target target) -> Array[String]
    end
  end

  module Library
    module Layout
      EXT: String
    end

    module Roots
      def self.pure: () -> String
      def self.stdlib: (Target target) -> Array[String]
    end
  end

  module Native
    # Loaded by the caller of a `UnitProgram`. Each method returns nil, or
    # the message of the step that refused.
    module Build
      def self.object: (Array[untyped] functions, Array[Obj::Datum] data, String out, raw: Array[String], export: bool, target: Target) -> String?
      def self.wasm: (Array[untyped] functions, Array[Obj::Datum] data, String out, raw: Array[String]) -> String?
      def self.binary: (Array[untyped] functions, Array[Obj::Datum] data, String out, work: String, raw: Array[String], target: Target, link: untyped) -> String?
    end
  end

  # lib/zr/ir/function.rb.
  module IR
    class Sig < Data
      attr_reader sig: String
      attr_reader params: Array[String]
      attr_reader ret: String
    end

    class Global < Data
      attr_reader gv: String
      attr_reader symbol: String
      attr_reader colocated: bool
    end

    class Callee < Struct[untyped]
      attr_accessor fn: String
      attr_accessor symbol: String
      attr_accessor sig: String
      attr_accessor colocated: bool
      attr_accessor from: String?
      attr_accessor effects: Integer
    end

    class Block
      attr_reader name: String
      attr_reader params: Array[[String, String]]
      attr_reader insts: Array[Inst]
    end

    class Function
      attr_reader name: String
      attr_reader sigs: Array[Sig]
      attr_reader globals: Array[Global]
      attr_reader callees: Array[Callee]
      attr_reader blocks: Array[Block]
    end
  end
end
