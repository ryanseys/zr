# The members of Bundler that lib/ uses (`GemSet#locked`). RBS's stdlib
# has no signatures for Bundler.
module Bundler
  def self.ui=: (untyped ui) -> untyped
  def self.default_lockfile: () -> Pathname
  def self.definition: () -> Definition

  class Definition
    def specs: () -> Enumerable[Gem::Specification]
  end

  class BundlerError < StandardError
  end

  class GemNotFound < BundlerError
  end

  module UI
    class Silent
    end
  end
end

# The members of Gem::Specification that lib/zr/gem_set/resolve.rb uses.
# RBS's core signature of the class is empty.
class Gem::Specification
  def self.load: (String file) -> Gem::Specification?
  def self.find_all_by_name: (String name, *String requirements) -> Array[Gem::Specification]

  def name: () -> String
  def version: () -> Gem::Version
  def extensions: () -> Array[String]
  def require_paths: () -> Array[String]
  def raw_require_paths: () -> Array[String]
  def full_gem_path: () -> String
  def default_gem?: () -> bool
end
