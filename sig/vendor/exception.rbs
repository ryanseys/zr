# `caller_locations(1)` is nil only when the stack is shorter than 1,
# which it never is in a method (lib/zr/eval.rb). Ruby's `set_backtrace`
# takes nil too.
class Exception
  def set_backtrace: (Array[Thread::Backtrace::Location]?) -> Array[Thread::Backtrace::Location]?
                   | ...
end
