# Open3.capture2e with the `chdir:` of Process.spawn, which RBS's stdlib
# leaves out (`Ext::Builder#run`).
module Open3
  def self.capture2e: (Hash[String, String?] env, *String command, chdir: String) -> [String, Process::Status]
                    | ...
end

# The form of `Open3.popen3` that `Zr::Diff.run` calls: an environment
# first, and a block. RBS's open3 has neither.
module Open3
  def self?.popen3: [T] (Hash[String, String?] env, *String cmd, ?chdir: String, ?pgroup: true) { (IO, IO, IO, Process::Waiter) -> T } -> T
                  | ...
end
