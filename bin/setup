#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up a checkout: installs the gems, then builds the zr runtime for
# this host. The first build takes a few minutes. After that, bin/test
# runs the tests.

require "rbconfig"

root = File.expand_path("..", __dir__)
Dir.chdir(root)

# zr builds only on the ruby that .ruby-version pins. Say so before the
# long steps, not after them.
pinned = File.read(".ruby-version").strip
unless RUBY_VERSION == pinned
  abort "bin/setup: this is ruby #{RUBY_VERSION}; zr needs ruby #{pinned} " \
        "(for example `mise install ruby@#{pinned}` or `rbenv install #{pinned}`)"
end

system("bundle", "install", exception: true)

# The ruby that the tests compare with: ruby 4.0.7's bundled gems, and
# zr's versions of the gems whose C it ports, in tmp/reference.
system(RbConfig.ruby, "tool/zr-dev.rb", "reference", exception: true)

wasmtime = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? { |dir| File.executable?(File.join(dir, "wasmtime")) }
warn "note: wasmtime is not installed; the tests that run WebAssembly modules will skip (https://wasmtime.dev)" unless wasmtime

system("bundle", "exec", "rake", "build", exception: true)

puts
puts "Ready. Run the tests near your change with bin/test <path>, or bin/test --changed."
