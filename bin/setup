#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up a checkout: installs the gems, then builds the zr runtime for
# this host. The first build takes a few minutes. After that, bin/minitest
# runs the tests.

require_relative "../lib/zr/version"

root = File.expand_path("..", __dir__)
Dir.chdir(root)

# A checkout tests zr against the ruby that .ruby-version pins, and that
# ruby writes the expected outputs. Say so before the long steps, not
# after them.
unless Zr.pinned_ruby?
  abort "bin/setup: this is #{RUBY_DESCRIPTION}; zr needs ruby #{Zr::RUBY_PIN} " \
        "(for example `mise install ruby@#{Zr::RUBY_PIN}` or `rbenv install #{Zr::RUBY_PIN}`)"
end

system("bundle", "install", exception: true)

wasmtime = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? { |dir| File.executable?(File.join(dir, "wasmtime")) }
warn "note: wasmtime is not installed; the tests that run WebAssembly modules will skip (https://wasmtime.dev)" unless wasmtime

system("bundle", "exec", "rake", "build", exception: true)

puts
puts "Ready. Run the tests near your change with bin/minitest <path>, or bin/zr-dev test --changed."
