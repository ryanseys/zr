#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs zr's tests.
#
#   bin/test                            test/unit, then test/programs
#   bin/test test/unit                  one directory
#   bin/test test/unit/cli_test.rb      one file; a bare cli_test.rb also works
#   bin/test test/unit -n /blocks/      minitest options follow the paths
#   bin/test test/programs/core         program tests (plain .rb files and
#                                       ruby's output beside them)
#   bin/test --corpus DIR               the program tests of another project,
#                                       such as spinel's test/
#   bin/test --changed [--base REV]     the tests that the change against REV
#                                       (default: main) can reach
#
# The tests need the runtime for this host. If it is not built, this
# script builds it first (see `rake build`).
#
# Environment:
#   TARGET=<triple>   build and run the programs for that target
#   GC=stress         collect at every allocation (ZR_GC_STRESS=1)
#   SLOW=1            report the 25 slowest files
#   N=, X=, A=        the same as minitest's -n, -e, and extra options
#   MT_CPU=<n>        the number of worker processes

require "rbconfig"

# The time of each step of this run, printed to stderr when it ends. It
# is the whole command, as the shell sees it, and not only minitest's
# "Finished in" line. A run of several tiers prints the line of each
# tier and then the total. This `at_exit` is the first one registered,
# so it runs after minitest's, which runs the tests.
started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
steps = []
step = lambda do |name|
  steps << [name, Process.clock_gettime(Process::CLOCK_MONOTONIC) - started - steps.sum(&:last)]
end
parent = Process.pid
at_exit do
  next unless Process.pid == parent

  $stdout.flush

  total = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  steps << ["tests", total - steps.sum(&:last)] unless steps.empty?
  parts = steps.map { |name, seconds| format("%s %.2f s", name, seconds) }
  $stderr.puts(format("bin/test: %.2f s", total) + (parts.empty? ? "" : " (#{parts.join(", ")})"))
end

root =File.expand_path("..", __dir__)
test_dir = File.join(root, "test")

# `--changed` asks tool/affected.rb for the paths. A change that reaches
# everything runs nothing: the full run is a separate decision.
if (at = ARGV.index("--changed"))
  ARGV.delete_at(at)
  base = "main"
  if (at = ARGV.index("--base"))
    base = ARGV.delete_at(at + 1) or abort("bin/test: --base takes a revision")
    ARGV.delete_at(at)
  end
  $LOAD_PATH.unshift(File.join(root, "lib"))
  require File.join(root, "tool/affected")
  files, plan = Zr::Dev::Affected.test_paths(base)
  if plan == :all
    puts "bin/test: the #{files.size} changed file(s) against #{base} reach every test; " \
         "run bin/test, or name the paths"
    exit
  elsif plan.empty?
    puts "bin/test: no test reaches the #{files.size} changed file(s) against #{base}"
    exit
  end
  puts "bin/test: #{files.size} file(s) changed against #{base}; running #{plan.size} test path(s)"
  ARGV.unshift(*plan.map { |path| path.delete_prefix("#{root}/") })
end

# `--corpus DIR` runs the program tests below DIR, which is also the
# directory that their programs run in (test/support/programs.rb). ARGV
# keeps it: `CLI.tune!` can start this script again with ARGV.
args = ARGV.dup
corpus = nil
# `--host` runs the program tests on CRuby over zr's kernel, with no build
# (lib/zr/machine/host/walk.rb). The walker nests Ruby frames, so ruby
# starts again with the stacks that `zr-dev host` uses.
if args.delete("--host")
  require File.join(root, "tool/lib/zr/dev")
  require File.join(root, "tool/hosted")
  stacks = Zr::Dev::Hosted::STACK
  exec(stacks.merge("ZR_TEST_HOST" => "1"), RbConfig.ruby, __FILE__, *args) unless stacks.all? { |name, value| ENV[name] == value }
end
host = ENV["ZR_TEST_HOST"] == "1"
if (at = args.index("--corpus"))
  corpus = args.delete_at(at + 1) or abort("bin/test: --corpus takes a directory")
  args.delete_at(at)
  corpus = File.expand_path(corpus)
  abort "bin/test: no directory at #{corpus}" unless File.directory?(corpus)
end

# The words up to the first option are paths. The rest go to minitest.
split = args.index { |word| word.start_with?("-") } || args.size
words = args.take(split)
options = args.drop(split).reject { |word| word == "--" }

# A word is a path from here or from the root, or a file name under test/.
# `test` itself, or no word, means every tier. With `--corpus`, a word is a
# path below the corpus, and no word means all of it.
corpus_paths = words.map { |word| File.expand_path(word) } if corpus
outside = corpus_paths&.find { |path| !path.start_with?(corpus) }
abort "bin/test: #{outside} is not below #{corpus}" if outside
words = [] if corpus
paths = words.flat_map do |word|
  path = [File.expand_path(word), File.expand_path(word, root)].find { |p| File.exist?(p) }
  path ||= Dir[File.join(test_dir, "**", word)].min
  next [] if path == test_dir
  abort "bin/test: no test at #{word}" unless path&.start_with?(File.join(test_dir, ""))
  [path]
end
paths = %w[unit programs].map { |tier| File.join(test_dir, tier) } if paths.empty? && !corpus

ENV["ZR_TARGET"] = ENV["TARGET"] if ENV["TARGET"]
ENV["ZR_GC_STRESS"] = "1" if ENV["GC"] == "stress"

# The tier of a path is test/programs, or test/unit for the rest. Each
# tier runs in its own process: the unit tier loads minitest, and the
# program tests use no framework.
tiers = paths.group_by do |path|
  below = path.delete_prefix(File.join(test_dir, "")).split("/").first
  below == "programs" ? below : "unit"
end
tiers = { "programs" => [corpus] } if corpus
if tiers.size > 1
  tiers.each_value do |group|
    system(RbConfig.ruby, __FILE__, *group, *options) || exit($?.exitstatus || 1)
  end
  exit
end

$LOAD_PATH.unshift(File.join(root, "lib"), test_dir)
require "zr/cli"
Zr::CLI.tune!(__FILE__) # the tests use the GC limits and YJIT of a compile

# The program tests run without a test framework: zr builds each program
# and compares its output with ruby's.
if tiers.key?("programs")
  require "support/programs"
  require "support/built"
  programs_root = corpus || File.join(test_dir, "programs")
  paths = corpus_paths.empty? ? [corpus] : corpus_paths if corpus
  tests = paths.flat_map { |path| Zr::Test::Case.under(path, programs_root) }.uniq
  step.call("load")
  if host
    require "support/host_program"
    Zr::Test::HostProgram.walk
    step.call("host boot")
  else
    Zr::Test::Built.ready_for_programs!(tests)
    step.call("prebuild")
  end
  exit Zr::Test::Programs.run(paths, root: programs_root, host: host)
end

# Load this before the helper forks its workers, so that all workers
# share one loaded copy.
files = paths.flat_map { |path| File.directory?(path) ? Dir[File.join(path, "**/*_test.rb")].sort : [path] }
require "support/built"
step.call("load")
Zr::Test::Built.ready!(files: files)
step.call("prebuild")

ARGV.replace(options)
ARGV.push("-n", ENV["N"]) if ENV["N"]
ARGV.push("-e", ENV["X"]) if ENV["X"]
ARGV.concat(ENV["A"].split) if ENV["A"]

require "test_helper"
files.each { |file| require file }
step.call("require")
