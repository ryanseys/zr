#!/usr/bin/env ruby
# frozen_string_literal: true

#
# This file was generated by Bundler.
#
# The application 'minitest' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

# Ruby reads the collector's malloc limits only at its start, and the
# runtime build that a run forks (test/support/built.rb) needs zr's: with
# ruby's 32 MiB, a worker that lowered the gem prelude spent its minutes
# marking its heap. So the run starts again with them.
# A test file that does not exist would give minitest no file, and it
# would run every test (minutes) in place of the one asked for.
missing = ARGV.grep(/\A[^-].*\.rb(?::\d+)?\z/).map { |arg| arg.sub(/:\d+\z/, "") }.reject { |path| File.exist?(path) }
abort "bin/minitest: no such test file: #{missing.join(", ")}" unless missing.empty?

require_relative "../lib/zr/gc_tuning"
Zr::GcTuning.now(__FILE__)

require "rubygems"
require "bundler/setup"
# Before minitest requires prism: zr's prism, when the bundle's is not it.
require_relative "../test/support/prism_first"
Zr::Test::PrismFirst.ensure!

load Gem.bin_path("minitest", "minitest")
