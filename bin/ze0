#!/usr/bin/env ruby
# frozen_string_literal: true

# ze0: a Ruby compiler written in Ruby.
#
#   ze0 test <filter>... | --all        does ze0 answer what ruby answered?
#                [--gc plain|stress] [--show N]
#   ze0 check [<file>...]               the repo's own checks, a process a file
#   ze0 stage1                          ze0 compiles itself, twice, to the same bytes
#   ze0 stage2                          the compiler compiled by itself is a fixed point
#   ze0 deps build                      build the vendored C dependencies (oniguruma)
#   ze0 zr run <file.rb> [args]         compile a Ruby program with the zr runtime, and run it
#   ze0 zr build <file.rb> -o <bin>     compile a Ruby program with the zr runtime
#   ze0 zr machine <file.rb> -o <bin>   compile a kernel-dialect file alone
#                [--emit obj|wasm]
#
# ZE0_LINK picks the linker: `ruby` for Obj::Exe alone, which names what
# it cannot link; `cc` for the system linker; unset to take Obj::Exe
# where it reaches and cc for a program that needs the vendored archives.
#
# ruby is the oracle: every corpus program carries ruby 4.0.6's recorded
# answer under `__END__`, and ze0 is held to it or refuses by name.

ROOT = File.expand_path("..", __dir__)

# The compiler runs under YJIT unless ZE0_YJIT=0: a cold runtime build
# is mostly the compiler's own Ruby, which YJIT runs well. A child this
# script starts runs this script again, so it gets YJIT too.
RubyVM::YJIT.enable if defined?(RubyVM::YJIT.enable) && ENV["ZE0_YJIT"] != "0"

def usage
  warn File.read(__FILE__).lines.grep(/\A#   /).map { |l| l.delete_prefix("#   ") }.join
  exit 2
end

case ARGV.first
when "test"
  require_relative "../lib/ze0/harness/sweep"
  require "etc"
  args = ARGV.drop(1)
  usage if args.include?("-h") || args.include?("--help")
  all = args.delete("--all")
  show = 10
  if (i = args.index("--show"))
    show = Integer(args[i + 1]) rescue usage
    args.slice!(i, 2)
  end
  gc = "plain"
  if (i = args.index("--gc"))
    gc = args[i + 1] or usage
    args.slice!(i, 2)
  end
  usage if args.any? { |a| a.start_with?("--") } || (args.empty? && !all)
  usage unless %w[plain stress].include?(gc)
  sweep = Ze0::Harness::Sweep.new(ROOT, show: show, gc: gc)
  cases = sweep.matching(args, all: all)
  abort "ze0 test: no program matches #{args.inspect}" if cases.empty?
  warn "ze0 test: #{cases.size} program(s)"
  exit(sweep.report(sweep.run(cases)) ? 0 : 1)
when "zr"
  require "tmpdir"
  require_relative "../lib/ze0/zr"
  require_relative "../lib/ze0/native/build"
  args = ARGV.drop(1)
  verb = args.shift
  usage unless %w[run build machine].include?(verb)
  input = output = nil
  emit = nil
  rest = []
  until args.empty?
    case (a = args.shift)
    when "-o" then output = args.shift or usage
    when "--emit" then emit = args.shift or usage
    when /\A-/ then usage
    else
      if input then rest << a else input = a end
    end
  end
  usage unless input && (verb == "run" ? output.nil? : output)
  usage if verb != "run" && !rest.empty?
  begin
    source = File.read(input)
    program = verb == "machine" ? Ze0::Machine.compile(source, input) : Ze0::Zr.program(source, input)
  rescue Ze0::Machine::Refused, Ze0::Hir::Refused, Ze0::Zr::Lower::Refused => e
    # Status 3 is a refusal by name; the sweep tells it from a defect.
    warn "ze0: #{e.message}"
    exit 3
  rescue SyntaxError => e
    # ruby reports a program that does not parse and exits 1, and so does
    # the binary, with ruby's own report. A required file that does not
    # parse raises as the require runs, which ze0 does not do yet.
    report = begin
      RubyVM::InstructionSequence.compile_file(input)
      nil
    rescue SyntaxError => own
      "#{input}: #{own.detailed_message(highlight: false)}\n"
    end
    unless report
      warn "ze0: a required file does not parse: #{e.message.lines.first.chomp}"
      exit 3
    end
    program = Ze0::Zr.program("$stderr.write(#{report.inspect})\nexit 1\n", input)
  end
  Dir.mktmpdir("ze0-zr-") do |work|
    out = verb == "run" ? File.join(work, "program") : File.expand_path(output)
    if emit == "obj"
      why = if program.is_a?(Ze0::Zr::Program)
              # The runtime's object lands in the cache beside it, so the
              # object road is the whole of what ze0 wrote.
              Ze0::Native::Build.runtime_object(program.runtime)
              Ze0::Native::Build.object(program.functions, program.data, out, export: true)
            else
              functions, data, raw = program
              Ze0::Native::Build.object(functions, data, out, raw: raw, export: true)
            end
      abort "ze0: #{why}" if why
      exit 0
    end
    if emit == "wasm"
      why = if program.is_a?(Ze0::Zr::Program)
              Ze0::Native::Build.wasm_program(program, out)
            else
              functions, data, raw = program
              Ze0::Native::Build.wasm(functions, data, out, raw: raw)
            end
      abort "ze0: #{why}" if why
      exec("wasmtime", out, *rest) if verb == "run"
      exit 0
    end
    why = if program.is_a?(Ze0::Zr::Program)
            Ze0::Native::Build.program(program, out, work: work, root: ROOT)
          else
            functions, data, raw = program
            Ze0::Native::Build.binary(functions, data, out, work: work, raw: raw, root: ROOT)
          end
    abort "ze0: #{why}" if why
    if verb == "run"
      system(out, *rest)
      abort "ze0: the program died with signal #{$?.termsig}" if $?.signaled?
      exit($?.exitstatus)
    end
  end
when "deps"
  require "fileutils"
  require_relative "../lib/ze0/deps"
  usage unless ARGV[1] == "build"
  puts Ze0::Deps.build(ROOT)
when "stage1"
  # ze0 under ruby compiles the compiler twice, in two processes with a
  # cache of its own each, and the bytes must agree: the self-compile
  # stays deterministic and refusal-free with no binary in the loop.
  # Both objects are compared, the compiler's and the runtime's. The
  # stage-2 fixed point needs a stage-1 binary that runs.
  require "tmpdir"
  require "fileutils"
  source = File.join(ROOT, "tools/stage.rb")
  Dir.mktmpdir("ze0-stage1-") do |work|
    outs = %w[a b].map do |n|
      cache = File.join(work, "#{n}-cache")
      FileUtils.mkdir_p(cache)
      out = File.join(work, "#{n}.o")
      system({ "ZE0_CACHE" => cache, "RUBYOPT" => nil, "RUBYLIB" => nil },
             RbConfig.ruby, __FILE__, "zr", "build", source, "-o", out, "--emit", "obj", chdir: ROOT) or
        abort("ze0 stage1: the self-compile failed")
      runtime = Dir[File.join(cache, "rt-*.o")]
      abort("ze0 stage1: the runtime object was not cached") unless runtime.size == 1
      [File.binread(out), File.binread(runtime.first)]
    end
    a, b = outs
    %w[compiler runtime].each_with_index do |what, i|
      next if a[i] == b[i]

      at = a[i].bytes.zip(b[i].bytes).index { |x, y| x != y } || [a[i].bytesize, b[i].bytesize].min
      abort("ze0 stage1: the two #{what} objects differ: #{a[i].bytesize} and #{b[i].bytesize} bytes, first at #{at}")
    end
    puts "stage 1 holds: #{a[0].bytesize} bytes of compiler and #{a[1].bytesize} of runtime, the same twice"
  end
when "stage2"
  # The stage ladder. Stage 1 is the compiler compiled by ze0 under ruby;
  # stage 2 is the same source compiled by stage 1. The two binaries must
  # agree byte for byte, which is what says the compiler is a fixed point.
  # Both are written under the same base name, since the ad-hoc signature
  # carries the output's base name.
  #
  # The compiler reaches oniguruma, so `cc` links it and `ld` stamps a
  # fresh UUID into every link; the signature then hashes the page that
  # UUID sits in. `Obj::Stamps` blanks those two ranges so that what is
  # compared is what the compiler decided. A binary `Obj::Exe` writes
  # needs none of this -- its UUID is the image's own hash -- but this
  # one is not such a binary.
  require "fileutils"
  require_relative "../lib/ze0/obj/stamps"
  usage unless ARGV.drop(1).empty?

  source = File.join(ROOT, "tools/stage.rb")
  stages = (1..2).map do |n|
    dir = File.join(ROOT, "tmp/stage#{n}")
    FileUtils.rm_rf(dir)
    FileUtils.mkdir_p(File.join(dir, "cache"))
    File.join(dir, "ze0")
  end
  caches = stages.map { |path| { "ZE0_CACHE" => File.join(File.dirname(path), "cache") } }

  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  system(caches[0], RbConfig.ruby, __FILE__, "zr", "build", source, "-o", stages[0]) or
    abort("ze0 stage2: stage 1 did not build")
  warn("stage 1: #{File.size(stages[0])} bytes")
  system(caches[1], stages[0], source, "-o", stages[1]) or
    abort("ze0 stage2: stage 1 did not compile the compiler")

  a, b = stages.map { |path| File.binread(path) }
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  stamps = Ze0::Obj::Stamps.of(a)
  x, y = [a, b].map { |bytes| Ze0::Obj::Stamps.blank(bytes) }
  if x == y
    puts format("stage 2 holds: %d bytes, the same from stage 1 and from ruby, in %.1f s", a.bytesize, elapsed)
    puts "the linker's own stamps are not compared: #{stamps.map { |r| "#{r.first}..#{r.last}" }.join(", ")}"
  else
    at = x.bytesize.times.find { |i| x.getbyte(i) != y.getbyte(i) } || [x.bytesize, y.bytesize].min
    abort("ze0 stage2: #{a.bytesize} and #{b.bytesize} bytes, first differing at #{at}")
  end
when "check"
  # Every check file in a process of its own, and a file that says
  # `# shards: N` in N of them, each taking every Nth case.
  #
  # One ruby loading them all holds every program `programs_test`
  # compiles, every runtime `rt_test` links and every module `wasm_test`
  # builds in a single heap. Separate processes bound that, say which
  # file failed rather than which assertion, and let the machine run
  # several at once.
  require "etc"
  filters = ARGV.drop(1)
  files = Dir[File.join(ROOT, "test/checks/*_test.rb")].sort
  files = files.select { |f| filters.any? { |a| File.basename(f).include?(a) } } unless filters.empty?
  abort("ze0 check: nothing matches #{filters.join(" ")}") if files.empty?

  queue = Queue.new
  files.each do |file|
    shards = File.foreach(file).first(40).join[/^# shards: (\d+)$/, 1].to_i
    shards < 2 ? queue << [file, nil] : shards.times { |i| queue << [file, "#{i + 1}/#{shards}"] }
  end

  # Memory is what bounds this, not cores: a check process compiling
  # programs wants a gigabyte or more, and a machine short of it stops
  # the run rather than swapping. `ZE0_JOBS` says otherwise.
  jobs = [Integer(ENV.fetch("ZE0_JOBS") { [Etc.nprocessors, 4].min }), queue.size].min
  done = Queue.new
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  Array.new(jobs) do
    Thread.new do
      until queue.empty?
        file, shard = (queue.pop(true) rescue break)
        out = IO.popen(shard ? { "ZE0_SHARD" => shard } : {},
                       [RbConfig.ruby, "-I#{File.join(ROOT, "lib")}", file], err: %i[child out], &:read)
        done << [file, shard, $?.success?, out]
      end
    end
  end.each(&:join)

  rows = []
  rows << done.pop until done.empty?
  rows.sort_by! { |file, shard, _, _| [file, shard.to_s] }
  rows.each do |file, shard, ok, out|
    name = File.basename(file, "_test.rb") + (shard ? " #{shard}" : "")
    puts format("%-18s %s%s", name, out[/^\d+ runs.*$/] || "did not report a tally", ok ? "" : "  <-")
  end
  failed = rows.reject { |_, _, ok, _| ok }
  failed.each { |file, _, _, out| warn("\n--- #{File.basename(file)}\n#{out}") }
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  puts format("%d files, %d processes, %.1f s, %d at a time", files.size, rows.size, elapsed, jobs)
  exit(failed.empty? ? 0 : 1)
else
  usage
end
