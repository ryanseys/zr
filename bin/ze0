#!/usr/bin/env ruby
# frozen_string_literal: true

# ze0: a Ruby compiler written in Ruby.
#
#   ze0 <file.rb> -o <out.clif>         compile one program to CLIF text
#   ze0 test <filter>... | --all        does ze0 answer what ruby answered?
#   ze0 scan <glob> [limit]             which programs ze0 compiles, and what it refuses
#   ze0 check                           the repo's own checks
#   ze0 stage1                          ze0 compiles itself, twice, to the same bytes
#   ze0 native build                    build the clif2obj crate (the Cranelift road)
#   ze0 zr build <file.rb> -o <bin>     compile a kernel-dialect file to a binary
#                [--native ruby|cranelift]
#
# ruby is the oracle: every corpus program carries ruby 4.0.6's recorded
# answer under `__END__`, and ze0 is held to it or refuses by name.

ROOT = File.expand_path("..", __dir__)

def usage
  warn File.read(__FILE__).lines.grep(/\A#   /).map { |l| l.delete_prefix("#   ") }.join
  exit 2
end

case ARGV.first
when "test"
  require_relative "../lib/ze0/harness/sweep"
  require "etc"
  args = ARGV.drop(1)
  usage if args.include?("-h") || args.include?("--help")
  all = args.delete("--all")
  show = 10
  if (i = args.index("--show"))
    show = Integer(args[i + 1]) rescue usage
    args.slice!(i, 2)
  end
  usage if args.any? { |a| a.start_with?("--") } || (args.empty? && !all)
  sweep = Ze0::Harness::Sweep.new(ROOT, native: nil, show: show)
  cases = sweep.select(args, all: all)
  abort "ze0 test: no program matches #{args.inspect}" if cases.empty?
  warn "ze0 test: #{cases.size} program(s)"
  exit(sweep.report(sweep.run(cases)) ? 0 : 1)
when "zr"
  require "tmpdir"
  require_relative "../lib/ze0/machine/lower"
  require_relative "../lib/ze0/native/build"
  args = ARGV.drop(1)
  usage unless args.shift == "build"
  input = output = nil
  native = "ruby"
  until args.empty?
    case (a = args.shift)
    when "-o" then output = args.shift or usage
    when "--native" then native = args.shift or usage
    when /\A-/ then usage
    else usage if input; input = a
    end
  end
  usage unless input && output
  begin
    functions, data, raw = Ze0::Machine.compile(File.read(input), input)
  rescue Ze0::Machine::Refused => e
    abort "ze0: #{input}: #{e.message}"
  end
  road = Ze0::Native::Build.road(native, ROOT)
  abort "ze0: the #{native} road is not built (ze0 native build)" unless road.available?
  Dir.mktmpdir("ze0-zr-") do |work|
    why = Ze0::Native::Build.binary(functions, data, File.expand_path(output), road: road, work: work, raw: raw)
    abort "ze0: #{why}" if why
  end
when "native"
  require_relative "../lib/ze0/native/cranelift"
  usage unless ARGV[1] == "build"
  puts Ze0::Native::Cranelift.new(ROOT).build!
when "scan"
  exec(RbConfig.ruby, File.join(ROOT, "scan.rb"), *ARGV.drop(1))
when "stage1"
  # ze0 under ruby compiles ze0.rb twice and the bytes must agree: the
  # self-compile stays deterministic and refusal-free with no binary in the
  # loop. The stage-2 fixed point needs a runtime to link against.
  require "tmpdir"
  prism = File.join(ROOT, "vendor/ext/prism/lib")
  Dir.mktmpdir("ze0-stage1-") do |work|
    outs = %w[a b].map do |n|
      out = File.join(work, "#{n}.clif")
      system({ "RUBYOPT" => nil, "RUBYLIB" => nil }, RbConfig.ruby, File.join(ROOT, "ze0.rb"), "-I", prism,
             "ze0.rb", "-o", out, chdir: ROOT) or abort("ze0 stage1: the self-compile failed")
      [File.binread(out), File.binread(File.join(work, "#{n}.zeodata"))]
    end
    a, b = outs
    %w[clif zeodata].each_with_index do |ext, i|
      next if a[i] == b[i]

      at = a[i].bytes.zip(b[i].bytes).index { |x, y| x != y } || [a[i].bytesize, b[i].bytesize].min
      abort("ze0 stage1: the two .#{ext} differ: #{a[i].bytesize} and #{b[i].bytesize} bytes, first at #{at}")
    end
    puts "stage 1 holds: #{a[0].bytesize} bytes of CLIF, and the sidecar, the same twice"
  end
when "check"
  files = Dir[File.join(ROOT, "test/checks/*_test.rb")].sort
  exec(RbConfig.ruby, "-I#{File.join(ROOT, "lib")}", "-e", files.map { |f| "require #{f.inspect}" }.join(";"))
when nil, "-h", "--help"
  usage
else
  exec(RbConfig.ruby, File.join(ROOT, "ze0.rb"), *ARGV)
end
