# frozen_string_literal: true

# The generated files that come straight off ruby: what `require`
# answers, what encodings ruby knows, how a byte reads in each
# single-byte one, the emoji the carriers exchange, where CRuby's own
# Ruby methods stand, and the Unicode case mappings.
#
#   rake gen:features gen:encodings gen:transcode
#   rake gen:emoji gen:builtin_lines gen:unicode
#
# Each writes a file from an oracle: ruby, or a CRuby source read at the
# revision named below. The output carries a header saying so, and is
# never edited by hand.
#
# The bigger tables have a file of their own: `rakelib/cjk.rake`,
# `nkf.rake`, `onig.rake`, `zlib.rake` and `prism.rake`.

module Gen
  # The CRuby revision the sources are read at. ruby 4.0.6.
  REVISION = "03b6d3f8898a28604fe6cb00eae3226b821168f4"
  CHECKOUT = File.expand_path("~/dev/github.com/ruby/ruby")

  # A task that reads its table off the ruby running it stops on any ruby
  # but the one `.ruby-version` pins: another's table is not zr's.
  def self.pinned!(task)
    require_relative "../lib/zr/version"
    abort("rake #{task}: ruby #{Zr::RUBY} writes this table; this is ruby #{RUBY_VERSION}") unless RUBY_VERSION == Zr::RUBY
  end

  # One file of CRuby's own source, at that revision.
  def self.cruby(path)
    source = IO.popen(["git", "-C", CHECKOUT, "show", "#{REVISION}:#{path}"], &:read)
    abort("rake gen: #{CHECKOUT} has no #{path} at #{REVISION[0, 12]}") unless $?.success?
    source
  end

  # Every name `require` answers in the ruby the .ruby-version pins. zr
  # refuses a require of one it has no file for, and lets every other
  # name raise LoadError as ruby does.
  module Features
    module_function

    def write(io)
      require "rbconfig"
      require "rubygems"
      require "set"

      roots = [RbConfig::CONFIG["rubylibdir"], RbConfig::CONFIG["rubyarchdir"]]
      Gem::Specification.default_stubs.each { |stub| roots.concat(stub.full_require_paths) }

      names = roots.uniq.select { |root| File.directory?(root) }.flat_map do |root|
        Dir.glob("**/*.{rb,bundle,so}", base: root).grep_v(%r{\.dSYM/}).map { |rel| rel.sub(/\.(rb|bundle|so)\z/, "") }
      end
      arch = File.basename(RbConfig::CONFIG["rubyarchdir"])
      names = names.grep_v(%r{\A#{Regexp.escape(arch)}/})
      names.concat(%w[complex enumerator ractor rational thread])
      names = names.uniq.sort

      io.puts <<~HEAD
        # frozen_string_literal: true

        # Generated by `rake gen:features` from ruby #{RUBY_VERSION}. Do not edit.

        module Zr
          module Hir
            # Every name `require` answers in ruby itself.
            FEATURES = [
      HEAD
      names.each_slice(4) { |row| io.puts "      #{row.map(&:inspect).join(", ")}," }
      io.puts <<~TAIL
            ].to_set.freeze
          end
        end
      TAIL
      warn "#{names.size} feature(s)"
    end
  end

  # The encoding registry, read off ruby and written as a table the
  # runtime builds its Encoding objects from.
  module Encodings
    module_function

    def write(io)
      # `inspect` before anything touches an encoding says whether its
      # table is already in ruby, which is the state a fresh program
      # starts from.
      loaded = Encoding.list.to_h { |encoding| [encoding.name, !encoding.inspect.include?("(autoload)")] }

      # Whether one byte is always one character: no pair of bytes
      # anywhere in the encoding forms a single character.
      pairs = (0..255).flat_map { |a| (0..255).map { |b| [a, b].pack("CC") } }
      bytewise = Encoding.list.to_h do |encoding|
        [encoding.name, pairs.none? { |text| (text.force_encoding(encoding).length == 1 rescue false) }]
      end

      rows = Encoding.list.map do |encoding|
        names = encoding.names.map(&:inspect).join(", ")
        "  [[#{names}], #{encoding.dummy?}, #{encoding.ascii_compatible?}, " \
          "#{loaded[encoding.name]}, #{bytewise[encoding.name]}],"
      end

      # The constants, in the order ruby defines them, each naming the
      # encoding it stands for.
      constants = Encoding.constants.filter_map do |const|
        value = Encoding.const_get(const)
        next unless value.is_a?(Encoding)

        "  [#{const.to_s.inspect}, #{value.name.inspect}],"
      end

      io.puts "# frozen_string_literal: true"
      io.puts
      io.puts <<~HEADER
        # The encodings ruby knows, generated by `rake gen:encodings`, in
        # ruby's own index order. A row is the canonical name with its
        # aliases, whether the encoding is a dummy one, whether its bytes
        # below 128 are ASCII, whether a fresh program has its table
        # already, and whether one byte is always one character. The second
        # table is the constant each encoding answers to.
        class Encoding
          UNICODE_VERSION = #{Encoding::UNICODE_VERSION.inspect}

          ROWS = [
        #{rows.join("\n").gsub(/^/, "  ")}
          ].freeze
          private_constant :ROWS

          CONSTANTS = [
        #{constants.join("\n").gsub(/^/, "  ")}
          ].freeze
          private_constant :CONSTANTS
        end
      HEADER
    end
  end

  # The byte tables of the single-byte encodings, read off ruby. Bytes
  # below 128 stand for themselves in every one of them, so a row holds
  # bytes 128 to 255 alone: four hex digits for the code point the byte
  # reads as, `----` where the encoding leaves the byte out.
  module Transcode
    UNMAPPED = "\u{1F600}"

    module_function

    # How ruby words a conversion error for each encoding: the name its
    # converter answers to, and whether a one-step conversion reads as
    # `X from A to B` rather than as a chain. Both are read off a
    # deliberate failure. A converter that does not exist at all says so.
    def shape(encoding)
      message = (UNMAPPED.encode(encoding) rescue $!.message)
      return nil if message.start_with?("code converter not found")

      short = !message.include?(" in conversion from ")
      step = short ? encoding.name : message[/\AU\+\h+ to (.*?) in conversion from /, 1]
      [short, step, from_shape(encoding)]
    end

    # The same question for the other direction, asked with a byte the
    # encoding leaves out. An encoding with no such byte never raises
    # here, so its answer does not matter and follows the other
    # direction.
    def from_shape(encoding)
      byte = (128..255).find { |b| ([b].pack("C").force_encoding(encoding).encode("UTF-8") rescue nil).nil? }
      return true if byte.nil?

      message = ([byte].pack("C").force_encoding(encoding).encode("UTF-8") rescue $!.message)
      !message.include?(" in conversion from ")
    end

    def write(io)
      pairs = (0..255).flat_map { |a| (0..255).map { |b| [a, b].pack("CC") } }

      single = Encoding.list.reject(&:dummy?).select do |encoding|
        pairs.none? { |text| (text.force_encoding(encoding).length == 1 rescue false) }
      end

      rows = single.filter_map do |encoding|
        next if encoding == Encoding::BINARY || encoding == Encoding::US_ASCII

        points = (128..255).map do |byte|
          code = ([byte].pack("C").force_encoding(encoding).encode("UTF-8").ord rescue nil)
          code ? format("%04X", code) : "----"
        end
        "  #{encoding.name.inspect} => #{points.join.inspect},"
      end

      # Whether the encoding cases its non-ASCII characters at all. The
      # ones that do follow Unicode over their own code points; the rest
      # touch nothing but the ASCII half.
      cased = single.select do |encoding|
        next false if encoding == Encoding::BINARY || encoding == Encoding::US_ASCII

        (128..255).any? { |byte| [byte].pack("C").force_encoding(encoding).upcase.bytes != [byte] }
      end

      shapes = single.filter_map do |encoding|
        row = shape(encoding)
        next "  #{encoding.name.inspect} => nil," if row.nil?

        "  #{encoding.name.inspect} => [#{row[0]}, #{row[1].inspect}, #{row[2]}],"
      end

      io.puts "# frozen_string_literal: true"
      io.puts
      io.puts <<~HEADER
        # The single-byte encodings' tables, generated by `rake gen:transcode`.
        # A row holds bytes 128 to 255: four hex digits for the code point the
        # byte reads as, `----` where the encoding leaves the byte out. Bytes
        # below 128 stand for themselves in every one of these encodings.
        class Encoding
          HIGH = {
        #{rows.join("\n").gsub(/^/, "  ")}
          }.freeze
          private_constant :HIGH

          # How a conversion error reads: whether a one-step conversion to
          # this encoding words as `X from A to B` rather than as a chain,
          # the name the converter answers to, and the same short-form
          # question for a conversion away from it. A nil row is an encoding
          # with no converter at all.
          SHAPES = {
        #{shapes.join("\n").gsub(/^/, "  ")}
          }.freeze
          private_constant :SHAPES

          # The encodings that case their non-ASCII characters, which they do
          # as Unicode does. Every other single-byte encoding folds the ASCII
          # half alone.
          CASED = [
        #{cased.map { |e| "  #{e.name.inspect}," }.join("\n").gsub(/^/, "  ")}
          ].freeze
          private_constant :CASED
        end
      HEADER
    end
  end

  # The emoji the carriers' UTF-8 encodings exchange, read off ruby's
  # own enc/trans/emoji-exchange-tbl.rb. A row of a pair holds, in hex,
  # the code point a character has in the source, then `>` and the code
  # points it becomes; a code point alone is one the target has no emoji
  # for.
  module Emoji
    module_function

    def points(hex) = [hex].pack("H*").force_encoding(Encoding::UTF_8).codepoints.map { |point| format("%X", point) }

    def write(io)
      eval(Gen.cruby("enc/trans/emoji-exchange-tbl.rb"), TOPLEVEL_BINDING) # rubocop:disable Security/Eval

      pairs = EMOJI_EXCHANGE_TBL.flat_map do |from, targets|
        targets.map do |to, rows|
          cells = rows.map do |source, target|
            source = points(source).join
            target == :undef ? source : "#{source}>#{points(target).join("+")}"
          end
          lines = cells.each_slice(12).map { |slice| "      #{"#{slice.join(" ")} ".inspect}" }
          "    #{[from, to].inspect} =>\n#{lines.join(" \\\n")},"
        end
      end

      io.puts "# frozen_string_literal: true"
      io.puts
      io.puts <<~RUBY
        # The emoji UTF8-DoCoMo, UTF8-KDDI and UTF8-SoftBank exchange with each
        # other and with Unicode, from ruby's enc/trans/emoji-exchange-tbl.rb.
        # Generated by `rake gen:emoji`; do not edit.
        class Encoding
          CARRIERS = ["UTF8-DoCoMo", "UTF8-KDDI", "UTF8-SoftBank"].freeze

          # Each pair's rows: `from>to` in hex code points, `+` between the
          # code points of a target that takes two, and `from` alone for one
          # the target has no emoji for.
          EMOJI_ROWS = {
        #{pairs.join("\n")}
          }.freeze
          EMOJI = {}
          private_constant :CARRIERS, :EMOJI_ROWS, :EMOJI

          def self.carrier?(encoding)
            Primitive.attr! :hidden
            CARRIERS.include?(encoding.name)
          end

          # The exchange from one encoding to another, read once: each code
          # point it names, and the code points it becomes, or nil for none.
          def self.emoji(from, to)
            Primitive.attr! :hidden
            EMOJI[[from.name, to.name]] ||= EMOJI_ROWS.fetch([from.name, to.name]).split.to_h do |row|
              source, target = row.split(">")
              [source.hex, target&.split("+")&.map(&:hex)]
            end
          end
          private_class_method :carrier?, :emoji
        end
      RUBY
    end
  end

  # The lines of the methods CRuby writes in Ruby, read off its builtin
  # sources, for the :call and :return events TracePoint gives them.
  # Each method is keyed `Owner#name`, or `Owner.name` for a singleton
  # method, and holds its `<internal:file>` path, the line its def
  # starts on, and the line its body ends on, which is where ruby
  # reports the return.
  module BuiltinLines
    SOURCES = %w[ast dir gc numeric io marshal pack trace_point warning array hash kernel pathname_builtin ractor
                 symbol timev thread_sync nilclass prelude].freeze

    module_function

    # The defs of one file, with the class and module names around each.
    # Built on the first call, so that loading this file does not load
    # the prism port: `rake -T` would pay a quarter of a second for a
    # task nobody is running.
    def defs_class
      require_relative "../lib/zr/prism"
      @defs_class ||= Class.new(Prism::Visitor) do
        attr_reader :rows

        def initialize(path)
          super()
          @path = path
          @scope = []
          @singleton = false
          @rows = {}
        end

        def visit_class_node(node) = within(node.constant_path.slice) { super }

        # A def inside `with_jit` stands only while a JIT runs; without one
        # the method stays C's.
        def visit_call_node(node)
          super unless node.name == :with_jit && node.receiver.nil?
        end

        def visit_module_node(node) = within(node.constant_path.slice) { super }

        def visit_singleton_class_node(node)
          was = @singleton
          @singleton = node.expression.is_a?(Prism::SelfNode)
          super
        ensure
          @singleton = was
        end

        def visit_def_node(node)
          owner = @scope.join("::")
          owner = "Object" if owner.empty?
          singleton = @singleton || node.receiver.is_a?(Prism::SelfNode)
          key = "#{owner}#{singleton ? "." : "#"}#{node.name}"
          @rows[key] ||= [@path, call_line(node), node.location.end_line]
        end

        private

        # The def's own line, but for a method split on
        # `Primitive.mandatory_only?`, whose sequence starts at that test.
        def call_line(node)
          first = node.body.is_a?(Prism::StatementsNode) ? node.body.body.first : nil
          split = first.is_a?(Prism::IfNode) && first.predicate.slice == "Primitive.mandatory_only?"
          split ? first.location.start_line : node.location.start_line
        end

        def within(name)
          @scope.push(name)
          yield
        ensure
          @scope.pop
        end
      end
    end

    def write(io)
      rows = {}
      SOURCES.each do |name|
        defs = defs_class.new("<internal:#{name}>")
        Prism.parse(Gen.cruby("#{name}.rb")).value.accept(defs)
        rows.merge!(defs.rows) { |_key, first, _later| first }
      end

      io.puts "# frozen_string_literal: true"
      io.puts
      io.puts "# Generated by `rake gen:builtin_lines` from ruby 4.0.6's builtin sources. Do not edit."
      io.puts "#"
      io.puts "# Where CRuby's own Ruby methods stand: the path TracePoint names for"
      io.puts "# one, the line its :call reports, and the line its :return reports."
      io.puts "class TracePoint"
      io.puts "  BUILTIN_LINES = {"
      rows.sort.each { |key, (path, first, last)| io.puts "    #{key.inspect} => [#{path.inspect}, #{first}, #{last}]," }
      io.puts "  }.freeze"
      io.puts "  private_constant :BUILTIN_LINES"
      io.puts "end"
    end
  end

  # The Unicode case mappings, read off ruby and written as tables the
  # runtime maps characters through.
  module Unicode
    KINDS = {
      "UP" => ->(c) { c.upcase },
      "DOWN" => ->(c) { c.downcase },
      "TITLE" => ->(c) { c.capitalize },
      "SWAP" => ->(c) { c.swapcase },
      "FOLD" => ->(c) { c.downcase(:fold) }
    }.freeze

    module_function

    # The single-character mappings as runs of one delta, so a table
    # that holds 1,500 characters fits in a few hundred rows.
    def runs(table)
      table.keys.sort.each_with_object([]) do |cp, out|
        delta = table[cp] - cp
        last = out.last
        if last && last[0] + last[1] == cp && last[2] == delta
          last[1] += 1
        else
          out << [cp, 1, delta]
        end
      end
    end

    def rows(values, per_line)
      values.each_slice(per_line).map { |slice| "    #{slice.join(", ")}," }.join("\n")
    end

    def char(cp)
      cp.chr(Encoding::UTF_8)
    rescue RangeError
      nil
    end

    def mappings
      single = Hash.new { |h, k| h[k] = {} }
      multi = Hash.new { |h, k| h[k] = {} }
      (0..0x10FFFF).each do |cp|
        next if (0xD800..0xDFFF).cover?(cp)
        next unless (c = char(cp))

        KINDS.each do |name, map|
          mapped = map.call(c)
          next if mapped == c

          codepoints = mapped.codepoints
          codepoints.size == 1 ? single[name][cp] = codepoints[0] : multi[name][cp] = codepoints
        end
      end
      [single, multi]
    end

    # The codepoints ruby's own inspect escapes rather than shows: onigmo
    # calls a codepoint with no category of its own unprintable, and ruby
    # writes that one as \uXXXX. A codepoint under 128 is a byte the
    # escape table already covers, so the table starts at 128.
    def unprintable
      (128..0x10FFFF).each_with_object([]) do |cp, out|
        next if (0xD800..0xDFFF).cover?(cp)
        next unless (c = char(cp))
        next unless c.inspect.include?("\\u")

        last = out.last
        if last && last[0] + last[1] == cp
          last[1] += 1
        else
          out << [cp, 1]
        end
      end
    end

    def write(io)
      single, multi = mappings

      io.puts "# frozen_string_literal: true"
      io.puts
      io.puts "# The Unicode case mappings, generated by `rake gen:unicode`. Each"
      io.puts "# RUNS table is a flat list of (first codepoint, how many, how far"
      io.puts "# to move) triples; each MULTI table holds the characters that map"
      io.puts "# to more than one."
      io.puts "class String"
      KINDS.each_key do |name|
        io.puts "  #{name}_RUNS = ["
        io.puts rows(runs(single[name]).flatten, 12)
        io.puts "  ].freeze"
        io.puts
        pairs = multi[name].sort.map { |cp, to| "#{cp} => #{to.inspect}" }
        io.puts "  #{name}_MULTI = {"
        io.puts pairs.each_slice(3).map { |slice| "    #{slice.join(", ")}," }.join("\n")
        io.puts "  }.freeze"
        io.puts
        io.puts "  private_constant :#{name}_RUNS, :#{name}_MULTI"
        io.puts
      end
      io.puts "  # The tables by the name each case method asks for, and the two"
      io.puts "  # letters Turkish gives their own rules."
      io.puts "  CASE_RUNS = { up: UP_RUNS, down: DOWN_RUNS, title: TITLE_RUNS, swap: SWAP_RUNS, fold: FOLD_RUNS }.freeze"
      io.puts "  CASE_MULTI = { up: UP_MULTI, down: DOWN_MULTI, title: TITLE_MULTI, " \
              "swap: SWAP_MULTI, fold: FOLD_MULTI }.freeze"
      io.puts "  KERNEL_CASE = { up: 1, down: 2, title: 3 }.freeze"
      io.puts "  TURKIC = { up: { 105 => 304 }, title: { 105 => 304 }, down: { 73 => 305, 304 => 105 }, " \
              "fold: { 73 => 305, 304 => 105 }, swap: { 73 => 305, 105 => 304, 304 => 105 } }.freeze"
      io.puts
      io.puts "  private_constant :CASE_RUNS, :CASE_MULTI, :KERNEL_CASE, :TURKIC"
      io.puts
      io.puts "  # The codepoints inspect escapes rather than shows, as runs of a"
      io.puts "  # first codepoint and how many follow it. A byte under 128 has its"
      io.puts "  # own escape, so the table starts at 128."
      io.puts "  UNPRINTABLE_RUNS = ["
      io.puts rows(unprintable.flatten, 12)
      io.puts "  ].freeze"
      io.puts
      io.puts "  private_constant :UNPRINTABLE_RUNS"
      io.puts "end"
    end
  end
end

namespace :gen do
  {
    features: ["lib/zr/hir/features.rb", Gen::Features],
    encodings: ["rt/core/encodings.rb", Gen::Encodings],
    transcode: ["rt/core/transcode.rb", Gen::Transcode],
    emoji: ["rt/core/emoji.rb", Gen::Emoji],
    builtin_lines: ["rt/core/builtin_lines.rb", Gen::BuiltinLines],
    unicode: ["rt/core/unicode.rb", Gen::Unicode]
  }.each do |name, (path, mod)|
    desc "Write #{path}"
    task(name) do
      Gen.pinned!("gen:#{name}")
      zr_write(path) { |io| mod.write(io) }
    end
  end

  # Found by rubygems without the bundle, as a build finds them.
  desc "Write lib/zr/library_digests.rb"
  task(:libraries) do
    Gen.pinned!("gen:libraries")
    env = %w[RUBYOPT RUBYLIB BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_LOCKFILE BUNDLER_SETUP BUNDLER_VERSION].to_h { |n| [n, nil] }
    system(env, RbConfig.ruby, File.expand_path("../lib/zr/libraries/resolve.rb", __dir__), "--digests") or
      abort("rake gen:libraries: a pinned gem did not resolve")
  end
end
