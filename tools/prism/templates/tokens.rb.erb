<%-
  # The human names are C (templates/src/token_type.c.erb's
  # pm_token_type_human), where one return may follow several cases.
  source = File.read(File.join(upstream, "src/token_type.c.erb"))
  body = source[/pm_token_type_human\(.*\z/m]
  human = {}
  pending = []
  body.scan(/case PM_TOKEN_(\w+):|return "((?:[^"\\]|\\.)*)";/) do |name, text|
    if name
      pending << name
    else
      pending.each { |pending_name| human[pending_name] = text.gsub(/\\(.)/, "\\1") }
      pending.clear
    end
  end
  human.delete("MAXIMUM")
  raise "token_type.c.erb and config.yml disagree" unless human.keys.sort == tokens.map(&:name).sort
-%>
module Prism
  module Ruby
    # pm_token_type_t and token_type.c: the type of each token, as
    # `Prism.lex` names it, and the words an error message uses for it.
    module Tokens
      # The types in pm_token_type_t's order, from 1.
      TYPES = [
        nil,
        <%- tokens.each do |token| -%>
        <%= token.name.to_sym.inspect %>,
        <%- end -%>
      ].freeze

      # pm_token_type_human
      HUMAN = {
        <%- tokens.each do |token| -%>
        <%= token.name.to_sym.inspect %> => <%= human.fetch(token.name).inspect %>,
        <%- end -%>
      }.freeze
    end
  end
end
